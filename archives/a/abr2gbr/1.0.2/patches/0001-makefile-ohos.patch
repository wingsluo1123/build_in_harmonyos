+
+$(OBJDIR)/%.o: %.c | $(OBJDIR)
 	$(CC) -o $@ $(CFLAGS) -c $<
 
+
+abr2gbr: $(OBJDIR)/$(BIN)
+	cp -f $(OBJDIR)/$(BIN) abr2gbr
+	ln -sf $(OBJDIR)/$(BIN) jbr2gbr
+
+
