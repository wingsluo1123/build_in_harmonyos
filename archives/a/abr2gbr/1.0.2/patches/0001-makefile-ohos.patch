-CC				= gcc
-CDEBUG		= $(DEBUG) -g #-DDEBUG
-CCFLAGS		= -Wall -Wstrict-prototypes -Wmissing-declarations -I. $(CDEBUG)
-CLIBS			=
-SOURCES		= $(wildcard *.c)
+# Honor environment overrides for cross-compilation (Conan).
+# GLIB_CFLAGS / GLIB_LIBS may be passed in; otherwise fall back to pkg-config.
+GLIB_CFLAGS ?= $(shell pkg-config --cflags glib-2.0 2>/dev/null)
+GLIB_LIBS ?= $(shell pkg-config --libs glib-2.0 2>/dev/null)
 
-OBJDIR		= .obj
-BINDIR		=	/usr/bin
-CFLAGS		= $(CCFLAGS) $(shell $(BINDIR)/glib-config --cflags)
-LIBS			= $(CLIBS) $(shell $(BINDIR)/glib-config --libs)
-DESTS			= $(addprefix $(OBJDIR)/, $(SOURCES:.c=.o))
-BIN				= abr2gbr
-DEPEND		= $(OBJDIR)/.depend
+BIN = abr2gbr
+DESTS = $(addprefix $(OBJDIR)/, $(SOURCES:.c=.o))
+DEPEND = $(OBJDIR)/.depend
+
+CFLAGS ?= $(CCFLAGS) $(GLIB_CFLAGS)
+LDFLAGS ?=
+LIBS = $(CLIBS) $(GLIB_LIBS)
 
 
 default: all
@@ -40,21 +52,26 @@ $(OBJDIR):
 
