--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -445,20 +445,43 @@
         message(SEND_ERROR "This LLVM seems to be a development version; only LLVM releases are tested and supported. Use -DACPP_EXPERIMENTAL_LLVM=ON if you still wish to try your luck.")
       endif()
     endif()
   endif()
 
   message(STATUS "Using clang include directory: ${CLANG_INCLUDE_PATH}")
 
   # Check if building on Windows and LLVM_LIBS is set, if not, use LLVM_AVAILABLE_LIBS 
   if(WIN32 AND NOT LLVM_LIBS AND LLVM_AVAILABLE_LIBS)
     llvm_map_components_to_libnames(LLVM_LIBS analysis core support passes)
+  elseif(NOT LLVM_LIBS)
+    # When LLVM is consumed as an installed package (find_package(LLVM CONFIG)) no
+    # llvm-config style LLVM_LIBS variable is exported. Leaving the plugin without a
+    # single LLVM dependency makes it rely on the host process to resolve its LLVM
+    # symbols. That only works on glibc: musl's dynamic linker refuses to bind an
+    # unversioned reference to the versioned definitions exported by libLLVM.so
+    # (e.g. _ZN4llvm2cl18getGeneralCategoryEv@@LLVM_22.1), so loading the plugin
+    # fails with "Error relocating ...: symbol not found". Linking the LLVM shared
+    # library makes the plugin self-contained.
+    if(TARGET LLVM)
+      set(LLVM_LIBS LLVM)
+    elseif(LLVM_AVAILABLE_LIBS)
+      llvm_map_components_to_libnames(LLVM_LIBS analysis core support passes)
+    endif()
+    # The plugin also references symbols of the clang frontend library (for
+    # example clang::FrontendAction::FrontendAction()), which the host process
+    # would otherwise have to provide - same limitation as for libLLVM described
+    # above. Resolve libclang-cpp explicitly so the plugin links it by itself.
+    find_library(ACPP_CLANG_CPP_LIBRARY NAMES clang-cpp
+                 HINTS ${LLVM_LIBRARY_DIRS} NO_DEFAULT_PATH)
+    if(ACPP_CLANG_CPP_LIBRARY)
+      list(APPEND LLVM_LIBS ${ACPP_CLANG_CPP_LIBRARY})
+    endif()
   endif()
 endif()
 
