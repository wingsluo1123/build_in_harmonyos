@@ -514,20 +537,45 @@
 
 
 set(ROCM_LIBS "-L${ROCM_PATH}/lib -L${ROCM_PATH}/hip/lib -lamdhip64" CACHE STRING "Necessary libraries for ROCm")
 set(ACPP_FILESYSTEM_SEARCH_OPTIONS "Final;Experimental;Boost" CACHE STRING "Which filesystem libraries should be searched for")
 
 ##########################################################
 ## Do not define any variables that might be used by build
 ## targets below this line.
 ##########################################################
 add_subdirectory(src)
+
+# Give every shared library of this project an explicit SONAME.
+# The project does not set VERSION/SOVERSION on its libraries, so the linker
+# records the path it was handed (for example ../common/libacpp-common.so) in
+# DT_NEEDED. Such a relative path is meaningless after installation, and libcs
+# that require an exact name match for their dependencies (musl, as used by
+# OHOS) then cannot load the library at all.
+foreach(_acpp_soname_target acpp-common acpp-rt acpp-clang rt-backend-omp llvm-to-host llvm-to-backend)
+  if(TARGET ${_acpp_soname_target})
+    get_target_property(_acpp_output_name ${_acpp_soname_target} OUTPUT_NAME)
+    if(NOT _acpp_output_name)
+      set(_acpp_output_name ${_acpp_soname_target})
+    endif()
+    set_property(TARGET ${_acpp_soname_target} APPEND_STRING PROPERTY LINK_FLAGS
+                 " -Wl,-soname,lib${_acpp_output_name}.so")
+    # Make the installed libraries locate each other no matter where the package
+    # ends up. CMake's own RPATH handling never reached these targets in this
+    # project (the variable the project sets refers to an undefined 'base', and
+    # neither INSTALL_RPATH nor BUILD_WITH_INSTALL_RPATH took effect here), so the
+    # run path goes on the link line directly. The single quotes keep the shell
+    # from expanding $ORIGIN when the link command is executed.
+    set_property(TARGET ${_acpp_soname_target} APPEND_STRING PROPERTY LINK_FLAGS
+                 " -Wl,-rpath,'\$ORIGIN' -Wl,-rpath,'\$ORIGIN/..' -Wl,-rpath,'\$ORIGIN/llvm-to-backend' -Wl,-rpath,'\$ORIGIN/hipSYCL' -Wl,-rpath,'${LLVM_LIBRARY_DIRS}'")
+  endif()
+endforeach()
 
