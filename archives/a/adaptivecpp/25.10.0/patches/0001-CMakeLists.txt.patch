 set(DEFAULT_CUDA_LINK_LINE "-Wl,-rpath=$ACPP_CUDA_LIB_PATH -L$ACPP_CUDA_LIB_PATH -lcudart")
 
 set(DEFAULT_WIN32_HIP_LINK_LINE "-L$ACPP_ROCM_PATH/lib -lamdhip64")
 
 if(MINGW)
   set(DEFAULT_LINK_PREFIX "-l:")
 else()
   set(DEFAULT_LINK_PREFIX "-l")
