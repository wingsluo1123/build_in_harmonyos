+// LLVM 22 removed Instruction::getNextNonDebugInstruction(). Since LLVM 19 debug
+// records are no longer instructions, the regular successor already skips them.
+inline llvm::Instruction *nextNonDebugInstruction(llvm::Instruction *I) {
+#if LLVM_VERSION_MAJOR >= 22
+  return I ? I->getNextNode() : nullptr;
+#else
+  return I ? I->getNextNonDebugInstruction() : nullptr;
+#endif
+}
 
