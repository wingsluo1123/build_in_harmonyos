 HIPSYCL_SSCP_MAP_HOST_FLOAT_BUILTIN2_NAME(minmag,fmaxmagf,fmaxmag)
+#else
+// fmaxmag()/fminmag() are C23 additions and are not declared by the libc++
+// shipped for musl based systems such as OHOS, so provide them directly:
+//   fmaxmag(x, y) = (|x| > |y|) ? x : y
+//   fminmag(x, y) = (|x| < |y|) ? x : y
+// Both follow the C23 rule for NaN operands: the non-NaN operand is returned.
+HIPSYCL_SSCP_BUILTIN float __acpp_sscp_maxmag_f32(float x, float y) {
+  return ::fabsf(x) > ::fabsf(y) ? x : y;
+}
+HIPSYCL_SSCP_BUILTIN double __acpp_sscp_maxmag_f64(double x, double y) {
+  return ::fabs(x) > ::fabs(y) ? x : y;
+}
+HIPSYCL_SSCP_BUILTIN float __acpp_sscp_minmag_f32(float x, float y) {
+  return ::fabsf(x) < ::fabsf(y) ? x : y;
+}
+HIPSYCL_SSCP_BUILTIN double __acpp_sscp_minmag_f64(double x, double y) {
+  return ::fabs(x) < ::fabs(y) ? x : y;
+}
+#endif
 #endif
 
