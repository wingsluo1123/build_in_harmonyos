--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -48,20 +48,29 @@
 pkg_check_modules(pugixml REQUIRED pugixml)
 
 # LIBDRM
 pkg_check_modules(DRM REQUIRED libdrm)
 
 # GBM
 pkg_check_modules(GBM REQUIRED gbm)
 
 # LIBPCI
 pkg_check_modules(PCILIB REQUIRED libpci)
+
+# pkg_check_modules 把库搜索路径放进 <MOD>_LIBRARY_DIRS 而非 <MOD>_LIBRARIES，
+# 标准 Linux 发行版库在默认路径可命中；OHOS conan 缓存路径不在默认搜索范围，
+# 显式把各模块 LIBRARY_DIRS 加入全局链接路径（仅路径，无平台宏）。
+# 注：atkmm-2.36 在 OHOS 无对应包（pkg_check_modules 非 REQUIRED，未命中），
+# 其 LIBRARY_DIRS 恒为空，故不列入。
+link_directories(${GTKMM_LIBRARY_DIRS} ${pugixml_LIBRARY_DIRS}
+                 ${DRM_LIBRARY_DIRS} ${GBM_LIBRARY_DIRS} ${PCILIB_LIBRARY_DIRS}
+                 ${EGL_LIBRARY_DIRS})
 
 # INTL
 find_package(Intl REQUIRED)
 find_package(Gettext REQUIRED)
 include_directories(${INTL_INCLUDE_DIRS})
 link_directories(${INTL_LIBRARY_DIRS})
 
 #EGL
 pkg_check_modules(EGL REQUIRED egl)
 
