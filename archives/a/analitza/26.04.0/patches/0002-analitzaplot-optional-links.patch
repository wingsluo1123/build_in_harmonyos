--- a/analitzaplot/CMakeLists.txt
+++ b/analitzaplot/CMakeLists.txt
@@ -60,12 +60,24 @@
         Analitza
         Qt6::Core
         Qt6::Gui
-
-    PRIVATE
-        Qt6::PrintSupport # this pulls widgets
-        Qt6::OpenGL
 )
 
+# Optional Qt modules: link only when the Qt build provides them, keeping the
+# public API identical on every platform (capability check, no platform switch).
+if(TARGET Qt6::PrintSupport)
+    target_link_libraries(AnalitzaPlot PRIVATE Qt6::PrintSupport) # this pulls widgets
+endif()
+# The installed plotter3d_es.h exposes a class layout that depends on the
+# OpenGL module. Export that capability decision with the target so the
+# library and every consumer compile the same layout; the header keeps a
+# __has_include fallback for non-CMake consumers.
+if(TARGET Qt6::OpenGL)
+    target_link_libraries(AnalitzaPlot PRIVATE Qt6::OpenGL)
+    target_compile_definitions(AnalitzaPlot PUBLIC ANALITZA_HAVE_OPENGL=1)
+else()
+    target_compile_definitions(AnalitzaPlot PUBLIC ANALITZA_HAVE_OPENGL=0)
+endif()
+
 if(CMAKE_SYSTEM_NAME STREQUAL Android)
     target_link_libraries(AnalitzaPlot PRIVATE GLESv2)
 elseif(WIN32)
