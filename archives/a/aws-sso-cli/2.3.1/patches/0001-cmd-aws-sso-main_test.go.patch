+// TestMain sets up a temporary XDG_CONFIG_HOME so that config.ConfigDir()
+// returns a valid path for the storage lock file. On OHOS the default
+// config directory path does not exist in the sandbox, causing
+// storage.FlockFile() to fail.
+func TestMain(m *testing.M) {
+	tmpDir, err := os.MkdirTemp("", "aws-sso-test-config")
+	if err != nil {
+		panic(err)
+	}
+	defer os.RemoveAll(tmpDir)
+
+	// Create aws-sso subdirectory (ConfigDir returns {XDG_CONFIG_HOME}/aws-sso)
+	os.MkdirAll(tmpDir+"/aws-sso", 0700)
+
+	os.Setenv("XDG_CONFIG_HOME", tmpDir)
+
+	os.Exit(m.Run())
+}
