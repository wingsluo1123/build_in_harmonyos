--- a/ld/testsuite/ld-elf/compress.exp
+++ b/ld/testsuite/ld-elf/compress.exp
@@ -34,6 +34,14 @@
 # Check if compiler works
 if { ![check_compiler_available] } {
     return
+}
+
+set saved_CFLAGS_FOR_TARGET_TEST $CFLAGS_FOR_TARGET_TEST
+set saved_CXXFLAGS_FOR_TARGET_TEST $CXXFLAGS_FOR_TARGET_TEST
+if {[istarget "*-*-*ohos*"]
+    && [string match "clang*" [file tail [lindex $CC_FOR_TARGET 0]]]} {
+    append CFLAGS_FOR_TARGET_TEST " -fno-integrated-as"
+    append CXXFLAGS_FOR_TARGET_TEST " -fno-integrated-as"
 }
 
 if { ![ld_assemble $as "--compress-debug-sections $srcdir/$subdir/empty.s" tmpdir/empty.o ] } {
@@ -270,3 +278,6 @@
     run_cc_link_tests $build_tests
     run_ld_link_exec_tests $run_tests
 }
+
+set CFLAGS_FOR_TARGET_TEST $saved_CFLAGS_FOR_TARGET_TEST
+set CXXFLAGS_FOR_TARGET_TEST $saved_CXXFLAGS_FOR_TARGET_TEST
--- a/ld/testsuite/config/default.exp
+++ b/ld/testsuite/config/default.exp
@@ -85,13 +85,19 @@
     # previous LD_UNDER_TEST runs.
     file delete -force tmpdir/ld
     catch "exec mkdir tmpdir/ld" status
-    if [info exists env(LD_UNDER_TEST)] {
-	catch "exec ln -s $env(LD_UNDER_TEST) tmpdir/ld/ld" status
-    } else {
-	catch "exec ln -s ../../ld-new tmpdir/ld/ld" status
-    }
-    catch "exec ln -s ld tmpdir/ld/collect-ld" status
-    catch "exec ln -s ../../../gas/as-new tmpdir/ld/as" status
+    if {[istarget "*-*-*ohos*"]} {
+	file copy -force $ld tmpdir/ld/ld
+	file copy -force $ld tmpdir/ld/collect-ld
+	file copy -force $as tmpdir/ld/as
+    } else {
+	if [info exists env(LD_UNDER_TEST)] {
+	    catch "exec ln -s $env(LD_UNDER_TEST) tmpdir/ld/ld" status
+	} else {
+	    catch "exec ln -s ../../ld-new tmpdir/ld/ld" status
+	}
+	catch "exec ln -s ld tmpdir/ld/collect-ld" status
+	catch "exec ln -s ../../../gas/as-new tmpdir/ld/as" status
+    }
     set gcc_B_opt "-B[pwd]/tmpdir/ld/"
 }
 
