 static gboolean _check_group_button (G_GNUC_UNUSED gpointer data)
 {
+	// The "is the config window still active?" test is X11-specific: upstream
+	// compares the X11 window id of our main window with the id reported by the
+	// X window-manager backend.  On a GTK built without the X11 backend (OHOS
+	// ships a broadway-only gtk3, GDK_WINDOWING_X11 undefined) there is neither
+	// gdkx.h/GDK_WINDOW_XID nor an X11 window-manager backend, so fall back to
+	// the portable GTK activation state (available on every GDK backend).
+#ifdef GDK_WINDOWING_X11
 	GldiWindowActor *pActiveWindow = gldi_windows_get_active ();
 	Window Xid = GDK_WINDOW_XID (gtk_widget_get_window (s_pMainWindow));
-	if (gldi_window_get_id (pActiveWindow) != Xid)  // we're not the active window any more, so the 'leave' event was probably due to an Alt+Tab -> the mouse is really out of the button.
+	gboolean bWindowInactive = (gldi_window_get_id (pActiveWindow) != Xid);
+#else
+	gboolean bWindowInactive = ! gtk_window_is_active (GTK_WINDOW (s_pMainWindow));
+#endif
+	if (bWindowInactive)  // we're not the active window any more, so the 'leave' event was probably due to an Alt+Tab -> the mouse is really out of the button.
 	{
 		gtk_widget_hide (s_pPreviewBox);
 		
 		gldi_object_unref (GLDI_OBJECT(s_pDialog));
 		
 		s_pCurrentButton = NULL;
 	}
 	s_iSidCheckGroupButton = 0;
 	return FALSE;
 }
