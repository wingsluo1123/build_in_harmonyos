diff --git a/src/cascade/common/sockserver.h b/src/cascade/common/sockserver.h
index 54960a7..2358041 100644
--- a/src/cascade/common/sockserver.h
+++ b/src/cascade/common/sockserver.h
@@ -79,13 +79,22 @@ inline sockserver::sockserver(const char* path, size_t backlog) {
   struct sockaddr_un addr;
   bzero(&addr, sizeof(addr));
   addr.sun_family = AF_UNIX;
-  strncpy(addr.sun_path, path, sizeof(addr.sun_path)-1);
-  unlink(path);
+  const bool abstract = path[0] == '@';
+  const auto* const name = abstract ? path + 1 : path;
+  if (abstract) {
+    strncpy(addr.sun_path + 1, name, sizeof(addr.sun_path) - 2);
+  } else {
+    strncpy(addr.sun_path, name, sizeof(addr.sun_path) - 1);
+    unlink(path);
+  }
+  const auto name_length = std::strlen(abstract ? addr.sun_path + 1 : addr.sun_path);
+  const auto address_length = static_cast<socklen_t>(
+    offsetof(sockaddr_un, sun_path) + name_length + 1);
 
   fd_ = ::socket(AF_UNIX, SOCK_STREAM, 0);
   if (fd_ == -1) {
     return;
-  } else if (::bind(fd_, (struct sockaddr*) &addr, sizeof(addr)) != 0) {
+  } else if (::bind(fd_, (struct sockaddr*) &addr, address_length) != 0) {
     ::close(fd_);
     fd_ = -1;
   } else if (::listen(fd_, backlog) != 0) {
