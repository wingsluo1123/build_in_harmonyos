diff -ruN -U0 a/src/varray.h b/src/varray.h
--- a/src/varray.h	2026-07-19 15:44:13
+++ b/src/varray.h	2026-07-19 15:44:14
@@ -15,0 +16 @@
+#include <functional>
@@ -18 +19,63 @@
-namespace ranges = std::ranges;
+#ifdef __OHOS__
+namespace ranges
+{
+using greater = std::greater<>;
+using less = std::less<>;
+
+template <typename Range, typename Predicate>
+auto
+count_if(const Range &range, Predicate predicate)
+{
+  return std::count_if(range.begin(), range.end(), predicate);
+}
+
+template <typename Range, typename Value>
+void
+fill(Range &range, const Value &value)
+{
+  std::fill(range.begin(), range.end(), value);
+}
+
+template <typename Iterator, typename Size, typename Value>
+void
+fill_n(Iterator first, Size count, const Value &value)
+{
+  std::fill_n(first, count, value);
+}
+
+template <typename Range>
+auto
+minmax_element(Range &range)
+{
+  return std::minmax_element(range.begin(), range.end());
+}
+
+template <typename Range, typename OutputIterator, typename Operation>
+void
+transform(Range &range, OutputIterator output, Operation operation)
+{
+  std::transform(range.begin(), range.end(), output, operation);
+}
+
+template <typename Range, typename Compare = std::less<>, typename Projection = std::identity>
+void
+sort(Range &range, Compare compare = {}, Projection projection = {})
+{
+  std::sort(range.begin(), range.end(),
+            [&](const auto &left, const auto &right) { return std::invoke(compare, std::invoke(projection, left), std::invoke(projection, right)); });
+}
+
+template <typename Range, typename Compare = std::less<>, typename Projection = std::identity>
+void
+stable_sort(Range &range, Compare compare = {}, Projection projection = {})
+{
+  std::stable_sort(range.begin(), range.end(),
+                   [&](const auto &left, const auto &right) { return std::invoke(compare, std::invoke(projection, left), std::invoke(projection, right)); });
+}
+}
+#else
+namespace ranges
+{
+using namespace std::ranges;
+}
+#endif
