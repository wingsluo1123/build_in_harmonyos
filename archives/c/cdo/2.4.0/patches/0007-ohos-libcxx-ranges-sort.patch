@@ -17,0 +19,28 @@
+#ifdef __OHOS__
+namespace ranges
+{
+using std::ranges::count_if;
+using std::ranges::fill;
+using std::ranges::fill_n;
+using std::ranges::greater;
+using std::ranges::less;
+using std::ranges::minmax_element;
+using std::ranges::transform;
+
+template <typename Range, typename Compare = std::less<>, typename Projection = std::identity>
+void
+sort(Range &range, Compare compare = {}, Projection projection = {})
+{
+  std::sort(range.begin(), range.end(),
+            [&](const auto &left, const auto &right) { return std::invoke(compare, std::invoke(projection, left), std::invoke(projection, right)); });
+}
+
+template <typename Range, typename Compare = std::less<>, typename Projection = std::identity>
+void
+stable_sort(Range &range, Compare compare = {}, Projection projection = {})
+{
+  std::stable_sort(range.begin(), range.end(),
+                   [&](const auto &left, const auto &right) { return std::invoke(compare, std::invoke(projection, left), std::invoke(projection, right)); });
+}
+}
+#else
