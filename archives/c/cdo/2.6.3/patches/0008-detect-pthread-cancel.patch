--- a/configure.ac
+++ b/configure.ac
@@ -73,6 +73,7 @@
 AC_CHECK_FUNCS(mallinfo)
 AC_CHECK_FUNCS(backtrace)
 #  ----------------------------------------------------------------------
 # Checks for the availability of ANSI-C99 functions
+AC_CHECK_FUNCS(pthread_cancel)
 AC_CHECK_FUNCS(getrlimit)
 
 # Check compiler version
--- a/configure
+++ b/configure
@@ -27809,6 +27809,14 @@ fi
 
 #  ----------------------------------------------------------------------
 # Checks for the availability of ANSI-C99 functions
+ac_fn_c_check_func "$LINENO" "pthread_cancel" "ac_cv_func_pthread_cancel"
+if test "x$ac_cv_func_pthread_cancel" = xyes
+then :
+  printf '%s\n' "#define HAVE_PTHREAD_CANCEL 1" >>confdefs.h
+
+fi
+
+
 ac_fn_c_check_func "$LINENO" "getrlimit" "ac_cv_func_getrlimit"
 if test "x$ac_cv_func_getrlimit" = xyes
 then :
--- a/src/config.h.in
+++ b/src/config.h.in
@@ -169,6 +169,10 @@
 #undef HAVE_NETCDF_META_H
 
 /* Define to 1 if you have the <proj.h> header file. */
+/* Define to 1 if you have the 'pthread_cancel' function. */
+#undef HAVE_PTHREAD_CANCEL
+
+
 #undef HAVE_PROJ_H
 
 /* Define to 1 if you have the <pthread.h> header file. */
--- a/src/processManager.cc
+++ b/src/processManager.cc
@@ -192,8 +192,12 @@ ProcessManager::kill_processes()
   {
     if (threadID != pthread_self())
     {
+#ifdef HAVE_PTHREAD_CANCEL
       pthread_cancel(threadID);
-      Debug(PROCESS_MANAGER, "process killed: %ld", threadID);
+      Debug(PROCESS_MANAGER, "process cancel requested: %ld", threadID);
+#else
+      Debug(PROCESS_MANAGER, "process cancel skipped (pthread_cancel unavailable): %ld", threadID);
+#endif
     }
   }
 }
