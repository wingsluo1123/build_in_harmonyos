diff -ruN a/clipper/core/fftmap.cpp b/clipper/core/fftmap.cpp
--- a/clipper/core/fftmap.cpp	2026-10-18 02:31:03.505700938 +0800
+++ b/clipper/core/fftmap.cpp	2026-10-18 02:31:03.545701563 +0800
@@ -164,7 +164,17 @@
 			 FFTW_COMPLEX_TO_REAL, flags );
   mutex.unlock();
 
-  rfftwnd_one_complex_to_real(plan, (fftw_complex*)data_c, NULL);
+  /* OHOS: the FFTW2 library available in the dependency registry is
+     double-precision, while clipper::ffttype is float. Transform through
+     a double scratch buffer so the FFTW ABI matches, then copy back. */
+  {
+    int nr = grid_real_.size();
+    std::vector<std::complex<double> > tmp( n );
+    for ( int i = 0; i < n; i++ ) tmp[i] = std::complex<double>( data_c[i] );
+    rfftwnd_one_complex_to_real(plan, (fftw_complex*)&tmp[0], NULL);
+    const double* tr = (const double*)&tmp[0];
+    for ( int i = 0; i < nr; i++ ) data_r[i] = ffttype( tr[i] );
+  }
 
   mutex.lock();
   rfftwnd_destroy_plan(plan);
@@ -192,7 +202,16 @@
 			 FFTW_REAL_TO_COMPLEX, flags );
   mutex.unlock();
 
-  rfftwnd_one_real_to_complex(plan, (fftw_real*)data_r, NULL);
+  /* OHOS: double-precision FFTW2 scratch conversion (see fft_h_to_x). */
+  {
+    int n = grid_reci_.size();
+    int nr = grid_real_.size();
+    std::vector<std::complex<double> > tmp( n );
+    double* tr = (double*)&tmp[0];
+    for ( int i = 0; i < nr; i++ ) tr[i] = double( data_r[i] );
+    rfftwnd_one_real_to_complex(plan, (fftw_real*)tr, NULL);
+    for ( int i = 0; i < n; i++ ) data_c[i] = tmp[i];
+  }
 
   mutex.lock();
   rfftwnd_destroy_plan(plan);
