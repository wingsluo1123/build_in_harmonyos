   set(CL_REFLECT_SCAN_LIBS
     ${CL_REFLECT_SCAN_LIBS} pthread)
-endif(${CMAKE_SYSTEM_NAME} STREQUAL "Linux")
+endif()
 
 target_link_libraries(clReflectScan
