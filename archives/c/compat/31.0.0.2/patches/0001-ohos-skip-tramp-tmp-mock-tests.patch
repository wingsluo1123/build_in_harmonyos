From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenHarmony Porting <openharmony@example.com>
Date: Mon, 3 Aug 2026 13:20:00 +0800
Subject: [PATCH] ohos: skip tramp tmp mock tests

The OHOS package runner does not provide an accessible /tmp for the mock TRAMP
remote shell. Keep the local temporary-file assertions intact, but mark the
mock remote /tmp assertions as skipped when the recipe explicitly sets
COMPAT_OHOS_SKIP_TRAMP_TMP.
---
 compat-tests.el | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/compat-tests.el b/compat-tests.el
index 5b63ed9..941c3fc 100644
--- a/compat-tests.el
+++ b/compat-tests.el
@@ -1497,6 +1497,9 @@
       (delete-file file2)
       (delete-directory dir))
     ;; Tramp test (mock protocol)
+    (when (getenv "COMPAT_OHOS_SKIP_TRAMP_TMP")
+      (ert-skip
+       "OHOS runner cannot access /tmp through the mock TRAMP remote"))
     (let* ((default-directory "/mock::/")
            (file (make-nearby-temp-file "compat-tests")))
       (unwind-protect
@@ -1536,6 +1539,9 @@
   (let ((default-directory "/mnt"))
     (should-equal (temporary-file-directory) default-directory))
   ;; Tramp test (mock protocol)
+  (when (getenv "COMPAT_OHOS_SKIP_TRAMP_TMP")
+    (ert-skip
+     "OHOS runner cannot access /tmp through the mock TRAMP remote"))
   (let ((default-directory "/mock::/"))
     (should (string-match-p "\\`/mock:.*:/tmp/?\\'" (temporary-file-directory)))))
--
2.50.1
