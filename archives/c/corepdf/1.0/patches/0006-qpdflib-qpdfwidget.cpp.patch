+void QPdfWidget::renderCurrentPage()
+{
+    if (!m->pDocument) {
+        m->pPageLabel->clear();
+        return;
+    }
+
+    if (m->currentPage < 0 || m->currentPage >= m->totalPages) {
+        m->pPageLabel->clear();
+        return;
+    }
+
+    std::unique_ptr<Poppler::Page> p = m->pDocument->page(m->currentPage);
+    if (!p) {
+        qWarning() << "Unable to render page" << m->currentPage;
+        m->pPageLabel->clear();
+        return;
+    }
+
+    // Convert rotation to Poppler enum
+    Poppler::Page::Rotation popplerRotation = Poppler::Page::Rotate0;
+    switch (m->rotation) {
+        case 90:  popplerRotation = Poppler::Page::Rotate90; break;
+        case 180: popplerRotation = Poppler::Page::Rotate180; break;
+        case 270: popplerRotation = Poppler::Page::Rotate270; break;
+        default:  popplerRotation = Poppler::Page::Rotate0; break;
+    }
+
+    // Render at 72 DPI * scale factor
+    double dpi = 72.0 * m->scale;
+    m->currentImage = p->renderToImage(dpi, dpi, -1, -1, -1, -1, popplerRotation);
+
+    if (m->currentImage.isNull()) {
+        qWarning() << "Rendered image is null for page" << m->currentPage;
+        m->pPageLabel->clear();
+        return;
+    }
+
+    m->pPageLabel->setPixmap(QPixmap::fromImage(m->currentImage));
+    m->pPageLabel->adjustSize();
+    updateView();
+}
+
+void QPdfWidget::updateView()
+{
+    // Ensure scroll area updates its viewport
+    m->pScrollArea->ensureVisible(0, 0);
+    update();
+}
