+/* A lookup cache does not require the current caller to have a named
+ * account. Resolve process name/home only for callers requesting them;
+ * missing NSS data still fails without inventing either value. */
+static dbus_bool_t
+init_process_info (void)
+{
+  DBusError error = DBUS_ERROR_INIT;
+  const DBusUserInfo *info;
+
+  if (!init_system_db ())
+    return FALSE;
+  if (process_info_initialized)
+    return TRUE;
+  if (!_dbus_user_database_get_uid (system_db, _dbus_getuid (), &info, &error))
+    {
+#ifdef DBUS_ENABLE_EMBEDDED_TESTS
+      /* Preserve the actual failure before freeing it. The auth-script
+       * caller's generic warning must not disguise NSS as allocation. */
+      fprintf (stderr, "DBUS_USERNAME_UID_LOOKUP_FAILED uid=" DBUS_UID_FORMAT
+               " error=%s message=%s\n", _dbus_getuid (),
+               error.name ? error.name : "(unset)",
+               error.message ? error.message : "(unset)");
+#endif
+      dbus_error_free (&error);
+      return FALSE;
+    }
+  if (!_dbus_string_append (&process_username, info->username) ||
+      !_dbus_string_append (&process_homedir, info->homedir))
+    {
+      _dbus_string_set_length (&process_username, 0);
+      _dbus_string_set_length (&process_homedir, 0);
+      return FALSE;
+    }
+  process_info_initialized = TRUE;
+  return TRUE;
+}
