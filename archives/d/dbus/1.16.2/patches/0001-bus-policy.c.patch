+/* Group rules still fail closed if their real membership lookup fails. */
+static dbus_bool_t
+list_requires_unix_groups (DBusList **list)
+{
+  DBusList *link;
+  for (link = _dbus_list_get_first_link (list);
+       link != NULL;
+       link = _dbus_list_get_next_link (list, link))
+    {
+      BusPolicyRule *rule = link->data;
+      if (rule->type == BUS_POLICY_RULE_GROUP)
+        return TRUE;
+    }
+  return FALSE;
+}
