diff -ruN a/src/config.guess b/src/config.guess
--- a/src/config.guess
+++ b/src/config.guess
@@ -197,0 +198,10 @@
+    *:HarmonyOS:*:*|*:OHOS:*:*)
+    case "$UNAME_MACHINE" in
+        aarch64|arm64) MACHINE=aarch64 ;;
+        armv7*|armv8*) MACHINE=arm ;;
+        x86_64|amd64)  MACHINE=x86_64 ;;
+        i?86)          MACHINE=i686 ;;
+        *)             MACHINE="$UNAME_MACHINE" ;;
+    esac
+    GUESS=${MACHINE}-unknown-linux-ohos
+    ;;
diff -ruN a/src/config.sub b/src/config.sub
--- a/src/config.sub
+++ b/src/config.sub
@@ -122,9 +122,33 @@
 # Split fields of configuration type
-# shellcheck disable=SC2162
-saved_IFS=$IFS
-IFS="-" read field1 field2 field3 field4 <<EOF
-$1
-EOF
-IFS=$saved_IFS
+# Avoid a here-document: OHOS HMDFS shells may create its temporary file
+# under the read-only system temporary directory.
+case $1 in
+	*-*-*-*)
+		field1=${1%%-*}
+		rest=${1#*-}
+		field2=${rest%%-*}
+		rest=${rest#*-}
+		field3=${rest%%-*}
+		field4=${rest#*-}
+		;;
+	*-*-*)
+		field1=${1%%-*}
+		rest=${1#*-}
+		field2=${rest%%-*}
+		field3=${rest#*-}
+		field4=
+		;;
+	*-*)
+		field1=${1%%-*}
+		field2=${1#*-}
+		field3=
+		field4=
+		;;
+	*)
+		field1=$1
+		field2=
+		field3=
+		field4=
+		;;
+esac
-
 # Separate into logical components for further validation
@@ -156,0 +157,4 @@
+            ohos-linux)
+                basic_machine=$field1-unknown
+                basic_os=linux-ohos
+                ;;
@@ -968,8 +968,4 @@
	*-*)
-		# shellcheck disable=SC2162
-		saved_IFS=$IFS
-		IFS="-" read cpu vendor <<EOF
-$basic_machine
-EOF
-		IFS=$saved_IFS
+		cpu=${basic_machine%%-*}
+		vendor=${basic_machine#*-}
		;;
@@ -1336,8 +1336,4 @@
	*-*)
-		# shellcheck disable=SC2162
-		saved_IFS=$IFS
-		IFS="-" read kernel os <<EOF
-$basic_os
-EOF
-		IFS=$saved_IFS
+		kernel=${basic_os%%-*}
+		os=${basic_os#*-}
		;;
