 # Walks up the parent process tree, prints a r-xp line of /proc/pid/maps when
 # it finds the wanted name
 
+class ProcessInfo:
+
+	def __init__(self, pid):
+		self.pid = pid
+
+	def name(self):
+		return (Path('/proc') / str(self.pid) / 'comm').read_text().strip()
+
+	def cmdline(self):
+		data = (Path('/proc') / str(self.pid) / 'cmdline').read_bytes()
+		return [part.decode(errors='replace') for part in data.split(b'\0') if part]
+
+	def parent_pid(self):
+		stat = (Path('/proc') / str(self.pid) / 'stat').read_text()
+		fields = stat.rsplit(') ', 1)[1].split()
+		return int(fields[1])
+
+
+def parent_processes():
+	pid = ProcessInfo(os.getpid()).parent_pid()
+	while pid > 1:
+		process = ProcessInfo(pid)
+		yield process
+		pid = process.parent_pid()
+
+
