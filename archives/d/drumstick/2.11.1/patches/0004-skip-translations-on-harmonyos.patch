+# HarmonyOS: the qttools host tools (lrelease/lupdate) are cross-built ELF
+# binaries that cannot run on the OHOS build host, so skip the .qm
+# translations (Qt falls back to the embedded source strings at runtime).
+if(NOT CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+    if (QT_VERSION VERSION_LESS 5.15.0)
+        qt5_add_translation(QM_FILES ${TS_FILES})
+    else()
+        qt_add_translation(QM_FILES ${TS_FILES})
+    endif()
+
+    add_custom_target( update-widget-translations
+        COMMAND Qt${QT_VERSION_MAJOR}::lupdate ${CMAKE_CURRENT_SOURCE_DIR}
+            -I ${PROJECT_SOURCE_DIR}/library/include
+            -I ${CMAKE_CURRENT_SOURCE_DIR}
+            -I ${CMAKE_CURRENT_BINARY_DIR}
+            -ts ${TS_FILES}
+        WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}
+        COMMENT "Updating widget translations"
+    )
 
-add_custom_target( drumstick-widgets-translations ALL DEPENDS ${QM_FILES} )
+    add_custom_target( drumstick-widgets-translations ALL DEPENDS ${QM_FILES} )
 
-if (UNIX)
