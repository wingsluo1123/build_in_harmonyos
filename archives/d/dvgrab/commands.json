{
  "name": "dvgrab",
  "description": "Digital video capture tool for IEEE 1394 (FireWire) devices",
  "commands": [
    {
      "name": "dvgrab",
      "description": "Capture DV/HDV video from FireWire camcorders",
      "path": "bin/dvgrab",
      "usage": "dvgrab [options] [output_file]",
      "options": [
        {"flag": "--version", "description": "Print version and exit"},
        {"flag": "--help", "description": "Print help and exit"},
        {"flag": "--format", "description": "Specify output format (raw, dv1, dv2, avi, qt, jpeg, frames)"},
        {"flag": "--frames", "description": "Number of frames to capture"},
        {"flag": "--duration", "description": "Maximum capture duration"},
        {"flag": "--channel", "description": "IEEE 1394 channel number"},
        {"flag": "--card", "description": "IEEE 1394 card number"}
      ]
    }
  ]
}
