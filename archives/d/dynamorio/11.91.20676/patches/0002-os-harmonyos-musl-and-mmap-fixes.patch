+/* Returns true when a seccomp filter is installed for this process, read from
+ * /proc/self/status.  Queried very early, so raw syscalls are used and the result
+ * is cached.
+ */
+bool
+is_seccomp_enforcing(void)
+{
+    if (seccomp_enforcing_cached >= 0)
+        return seccomp_enforcing_cached != 0;
+    seccomp_enforcing_cached = 0;
+    {
+        static char status_buf[4096];
+        int fd = (int)dynamorio_syscall(SYS_openat, 4, PROC_AT_FDCWD, "/proc/self/status",
+                                       PROC_O_RDONLY, 0);
+        size_t total = 0;
+        if (fd >= 0) {
+            while (total < sizeof(status_buf) - 1) {
+                ssize_t got = (ssize_t)dynamorio_syscall(SYS_read, 3, fd,
+                                                        status_buf + total,
+                                                        sizeof(status_buf) - 1 - total);
+                if (got <= 0)
+                    break;
+                total += (size_t)got;
+            }
+            (void)dynamorio_syscall(SYS_close, 1, fd);
+        }
+        status_buf[total] = '\0';
+        /* "Seccomp:" is followed by tab (or spaces) and 0 (disabled), 1 (strict)
+         * or 2 (filter mode). */
+        for (size_t i = 0; i + 8 < total; i++) {
+            if (status_buf[i] == 'S') {
+                static const char key[] = "Seccomp:";
+                size_t k;
+                for (k = 0; k < 8 && i + k < total && status_buf[i + k] == key[k]; k++) {
+                }
+                if (k == 8) {
+                    size_t j = i + 8;
+                    while (j < total && (status_buf[j] == ' ' || status_buf[j] == '\t'))
+                        j++;
+                    if (j < total && status_buf[j] != '0')
+                        seccomp_enforcing_cached = 1;
+                    break;
+                }
+            }
+        }
+    }
+    return seccomp_enforcing_cached != 0;
+}
