 /* shared library init */
+/* Some loaders do not pass a usable argc/argv/envp to DT_INIT / .init_array
+ * entries.  /proc/self/environ is used as the portable source of the environment
+ * instead: DR only reads the environment (option parsing and propagation), so a
+ * snapshot is sufficient.  Raw syscalls are used because DR's heap and
+ * file-descriptor machinery is not up yet.
+ */
+#    define PROC_ENVIRON_BUF_SIZE 16384
+#    define PROC_ENVIRON_MAX_ENTRIES 512
+#    define PROC_AT_FDCWD (-100)
+#    define PROC_O_RDONLY 0
+static char proc_environ_buf[PROC_ENVIRON_BUF_SIZE];
+static char *proc_environ_vec[PROC_ENVIRON_MAX_ENTRIES];
+
+static char **
+read_proc_environ(void)
+{
+    int fd = (int)dynamorio_syscall(SYS_openat, 4, PROC_AT_FDCWD, "/proc/self/environ",
+                                   PROC_O_RDONLY, 0);
+    size_t total = 0;
+    int idx = 0;
+    if (fd >= 0) {
+        while (total < PROC_ENVIRON_BUF_SIZE - 1) {
+            ssize_t got = (ssize_t)dynamorio_syscall(
+                SYS_read, 3, fd, proc_environ_buf + total,
+                PROC_ENVIRON_BUF_SIZE - 1 - total);
+            if (got <= 0)
+                break;
+            total += (size_t)got;
+        }
+        (void)dynamorio_syscall(SYS_close, 1, fd);
+    }
+    proc_environ_buf[total] = '\0';
+    /* /proc/self/environ is NUL-separated. */
+    for (size_t i = 0; i < total && idx < PROC_ENVIRON_MAX_ENTRIES - 1;) {
+        proc_environ_vec[idx++] = &proc_environ_buf[i];
+        while (i < total && proc_environ_buf[i] != '\0')
+            i++;
+        i++;
+    }
+    proc_environ_vec[idx] = NULL;
+    return proc_environ_vec;
+}
 static int
 our_init(int argc, char **argv, char **envp)
 {
+    /* The entry point may be reached both through DT_INIT and through
+     * .init_array (see INITIALIZER_ATTRIBUTES in os_public.h); initialising the
+     * engine twice would be fatal, so only the first call runs the body.
+     */
+    static bool our_init_done;
+    if (our_init_done)
+        return 0;
+    our_init_done = true;
+    /* Prefer the kernel's environment snapshot: some loaders hand the init entry
+     * point an unusable envp pointer (see read_proc_environ above).
+     */
+    {
+        char **snapshot = read_proc_environ();
+        if (snapshot != NULL && snapshot[0] != NULL) {
+            envp = snapshot;
+            our_environ_is_proc_snapshot = true;
+        }
+    }
