+static void begin_aggr(DCCallVM* self, const DCaggr* ag)
+{
+  /* AAPCS64 reserves x8 for the result, independent of x0-x7. Its value
+   * is supplied at call time, so there is no argument-slot reservation. */
+  (void)self; (void)ag;
+}
+
+static void call_aggr(DCCallVM* in_self, DCpointer target, const DCaggr* ag, DCpointer ret)
+{
+  DCCallVM_arm64* p = (DCCallVM_arm64*)in_self;
+  unsigned long long registers[6] = { 0 };
+  DCsize i, width;
+  DCpointer indirect = (!ag || (!ag->arm64_hfa_count && ag->size > 16)) ? ret : NULL;
+  if(p->mInterface.mError != DC_ERROR_NONE) return;
+  dcCall_arm64_aggr(target, dcVecData(&p->mVecHead),
+                    (dcVecSize(&p->mVecHead)+15) & ~(DCsize)15,
+                    &p->u.S[0], indirect, registers);
+  if(!ag || indirect || !ag->size) return;
+  if(ag->arm64_hfa_count) {
+    width = ag->arm64_hfa_type == DC_SIGCHAR_FLOAT ? 4 : 8;
+    for(i = 0; i < ag->arm64_hfa_count; ++i)
+      memcpy((unsigned char*)ret+i*width, &registers[2+i], width);
+  } else {
+    memcpy(ret, registers, ag->size);
+  }
+}
