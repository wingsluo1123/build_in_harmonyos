+typedef struct DCArm64Copy {
+  struct DCArm64Copy* next;
+  unsigned char data[];
+} DCArm64Copy;
+
+static void free_copies(DCCallVM_arm64* p)
+{
+  while(p->copies) {
+    DCArm64Copy* copy = p->copies;
+    p->copies = copy->next;
+    dcFreeMem(copy);
+  }
+}
+
+static void stack_copy(DCCallVM_arm64* p, const void* data, DCsize size, DCsize alignment)
+{
+  DCsize at, padded;
+  alignment = alignment > 8 ? 16 : 8;
+  if(size > (DCsize)-1 - 7 || p->mVecHead.mSize > (DCsize)-1 - (alignment-1)) {
+    p->mInterface.mError = DC_ERROR_STACK_OVERFLOW;
+    return;
+  }
+  at = (p->mVecHead.mSize + alignment-1) & ~(alignment-1);
+  padded = (size + 7) & ~(DCsize)7;
+  if(at > p->mVecHead.mTotal || padded > p->mVecHead.mTotal-at) {
+    p->mInterface.mError = DC_ERROR_STACK_OVERFLOW;
+    return;
+  }
+  memset(dcVecAt(&p->mVecHead, p->mVecHead.mSize), 0, at+padded-p->mVecHead.mSize);
+  memcpy(dcVecAt(&p->mVecHead, at), data, size);
+  p->mVecHead.mSize = at+padded;
+}
+#endif
 
 
