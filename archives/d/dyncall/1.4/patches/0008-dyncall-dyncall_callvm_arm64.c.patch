+static void a_aggr(DCCallVM* in_self, const DCaggr* ag, const void* data)
+{
+  DCCallVM_arm64* p = (DCCallVM_arm64*)in_self;
+  DCsize i, width, words;
+  if(!ag) { a_pointer(in_self, (DCpointer)data); return; }
+  if(!ag->size) return; /* C empty aggregate extension uses no registers. */
+  if(ag->arm64_hfa_count) {
+    width = ag->arm64_hfa_type == DC_SIGCHAR_FLOAT ? 4 : 8;
+    if(p->f + ag->arm64_hfa_count <= 8) {
+      for(i = 0; i < ag->arm64_hfa_count; ++i) {
+        memset(&p->u.D[p->f], 0, 8);
+        memcpy(&p->u.D[p->f++], (const unsigned char*)data + i*width, width);
+      }
+    } else {
+      p->f = 8; /* C.3: do not spill into GP registers or split the HFA. */
+      stack_copy(p, data, ag->size, ag->alignment);
+    }
+    return;
+  }
+  if(ag->size > 16) {
+    DCArm64Copy* copy;
+    if(ag->size > (DCsize)-1 - sizeof(DCArm64Copy)) {
+      p->mInterface.mError = DC_ERROR_OUT_OF_MEMORY;
+      return;
+    }
+    copy = (DCArm64Copy*)dcAllocMem(sizeof(DCArm64Copy)+ag->size);
+    if(!copy) { p->mInterface.mError = DC_ERROR_OUT_OF_MEMORY; return; }
+    memcpy(copy->data, data, ag->size);
+    copy->next = p->copies;
+    p->copies = copy;
+    a_pointer(in_self, copy->data);
+    return;
+  }
+  words = (ag->size+7)/8;
+  if(ag->alignment >= 16) p->i = (p->i+1) & ~1u;
+  if(p->i + words <= 8) {
+    for(i = 0; i < words; ++i) {
+      DCsize n = ag->size-i*8;
+      if(n > 8) n = 8;
+      p->I[p->i] = 0;
+      memcpy(&p->I[p->i++], (const unsigned char*)data+i*8, n);
+    }
+  } else {
+    p->i = 8; /* C.13: composite arguments are not split at x7. */
+    stack_copy(p, data, ag->size, ag->alignment);
+  }
+}
