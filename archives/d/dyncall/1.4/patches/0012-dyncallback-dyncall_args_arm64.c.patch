-DCpointer   dcbArgAggr     (DCArgs* p, DCpointer target)                   { /* @@@AGGR not impl */ return NULL; }
-void        dcbReturnAggr  (DCArgs *args, DCValue *result, DCpointer ret)  { /* @@@AGGR not impl */ }
+#if defined(DC__Feature_Aggr_ARM64)
+DCpointer dcbArgAggr(DCArgs* p, DCpointer target)
+{
+  const DCaggr* ag = *(p->aggrs++);
+  DCsize i, width, words;
+  const void* src;
+  if(!ag) return dcbArgPointer(p); /* non-trivial C++ object, user's copy */
+  if(!ag->size) return target;
+  if(ag->arm64_hfa_count) {
+    width = ag->arm64_hfa_type == DC_SIGCHAR_FLOAT ? 4 : 8;
+    if(p->f + ag->arm64_hfa_count <= 8) {
+      for(i = 0; i < ag->arm64_hfa_count; ++i)
+        memcpy((unsigned char*)target+i*width, &p->F[p->f++], width);
+      return target;
+    }
+    p->f = 8;
+  } else if(ag->size > 16) {
+    src = dcbArgPointer(p);
+    memcpy(target, src, ag->size);
+    return target;
+  } else {
+    words = (ag->size+7)/8;
+    if(ag->alignment >= 16) p->i = (p->i+1) & ~1;
+    if(p->i + words <= 8) {
+      for(i = 0; i < words; ++i) {
+        DCsize n = ag->size-i*8;
+        if(n > 8) n = 8;
+        memcpy((unsigned char*)target+i*8, &p->I[p->i++], n);
+      }
+      return target;
+    }
+    p->i = 8;
+  }
+  if(ag->alignment > 8)
+    p->sp = (uint64_t*)(((uintptr_t)p->sp+15) & ~(uintptr_t)15);
+  memcpy(target, p->sp, ag->size);
+  p->sp += (ag->size+7)/8;
+  return target;
+}
 
+void dcbReturnAggr(DCArgs* args, DCValue* result, DCpointer ret)
+{
+  const DCaggr* ag = *(args->aggrs++);
+  DCsize i, width;
+  if(!ag || (!ag->arm64_hfa_count && ag->size > 16)) {
+    if(ag) memcpy(args->ret_ptr, ret, ag->size);
+    result->p = args->ret_ptr;
+    return;
+  }
+  memset(args->ret_regs, 0, sizeof(args->ret_regs));
+  if(ag->arm64_hfa_count) {
+    width = ag->arm64_hfa_type == DC_SIGCHAR_FLOAT ? 4 : 8;
+    for(i = 0; i < ag->arm64_hfa_count; ++i)
+      memcpy(&args->ret_regs[2+i], (const unsigned char*)ret+i*width, width);
+  } else if(ag->size) {
+    memcpy(args->ret_regs, ret, ag->size);
+  }
+}
+#else
+DCpointer dcbArgAggr(DCArgs* p, DCpointer target) { return NULL; }
+void dcbReturnAggr(DCArgs* args, DCValue* result, DCpointer ret) { }
+#endif
