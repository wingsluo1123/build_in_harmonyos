--- a/test/exponential/log_ax_x.h
+++ b/test/exponential/log_ax_x.h
@@ -22,31 +22,36 @@
 idxint exitflag;
  
 /* print test name */
 printf("=================================== log(ax)-x ===================================\n");
  
 /* set up data */
 mywork = ECOS_setup(logax_x_n, logax_x_m, logax_x_p, logax_x_l, logax_x_ncones, NULL, logax_x_nexc,
                     logax_x_Gpr, logax_x_Gjc, logax_x_Gir,
                     NULL,NULL,NULL,
                     logax_x_c, logax_x_h, NULL);
+mu_assert("log_ax_x: ECOS setup failed", mywork != NULL);
 if( mywork != NULL ){
 /*set precision*/
-	mywork->stgs->feastol = 1e-12;
+	/* Request tighter feasibility so the unchanged 1e-11 coordinate
+	 * assertion is meaningful; stopping at 1e-12 can leave 8e-11 error. */
+	mywork->stgs->feastol = 1e-14;
 /* solve */
 exitflag = ECOS_solve(mywork); 
 }
 else exitflag = ECOS_FATAL;
 
 /* Exact solution */
 pfloat true_x = -log(0.3)/0.3;
 pfloat ecos_x = mywork->x[0];
 pfloat abs_err = fabs(true_x-ecos_x);
 
+printf("LOGAX_DIAG: t=%.17g true=%.17g err=%.17g x=%.17g pres=%.17g dres=%.17g gap=%.17g relgap=%.17g feastol=%.17g abstol=%.17g reltol=%.17g status=%ld\n", ecos_x, true_x, abs_err, mywork->x[1], mywork->info->pres, mywork->info->dres, mywork->info->gap, mywork->info->relgap, mywork->stgs->feastol, mywork->stgs->abstol, mywork->stgs->reltol, (long)exitflag);
+
 /* clean up memory */
 ECOS_cleanup(mywork, 0);
 
 mu_assert("log_ax_x: ECOS failed to produce outputflag OPTIMAL", exitflag == ECOS_OPTIMAL );
 mu_assert("log_ax_x: ECOS failed to produce the desired precision", abs_err < 1e-11);
 
 return 0;
 }
