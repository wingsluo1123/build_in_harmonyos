diff -ruN a/lib/error.h b/lib/error.h
--- /dev/null
+++ b/lib/error.h
@@ -0,0 +1,22 @@
+/* error.h - compatibility header for OHOS/musl
+   Provides error() function declaration that elfutils expects.
+   The implementation is in lib/error.c */
+#ifndef _ERROR_H
+#define _ERROR_H 1
+
+#include <stdarg.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+extern int error_message_count;
+
+void error(int status, int errnum, const char *format, ...)
+    __attribute__ ((__format__ (__printf__, 3, 4)));
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* error.h */
