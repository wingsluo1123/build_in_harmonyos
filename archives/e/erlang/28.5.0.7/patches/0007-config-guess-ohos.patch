--- a/make/autoconf/config.guess
+++ b/make/autoconf/config.guess
@@ -150,6 +150,11 @@
 UNAME_VERSION=`(uname -v) 2>/dev/null` || UNAME_VERSION=unknown
 
 case $UNAME_SYSTEM in
+HarmonyOS|HarmonyOS/*|OpenHarmony|OpenHarmony/*|OHOS|OHOS/*)
+	# HarmonyOS reports its own name from uname -s; the
+	# compiler and the OHOS toolchain agree on <arch>-unknown-linux-ohos.
+	echo "$UNAME_MACHINE-unknown-linux-ohos"
+	exit ;;
 Linux|GNU|GNU/*)
 	LIBC=unknown
 
