--- a/tools/find_event_devices.c	2017-06-02 16:01:30.000000000 +0800
+++ b/tools/find_event_devices.c	2026-10-09 14:41:30.368410156 +0800
@@ -25,6 +25,9 @@
 #define _GNU_SOURCE
 #include <linux/input.h>
 #include <dirent.h>
+/* PATH_MAX: glibc pulls <limits.h> in transitively, the OHOS
+ * libc does not. */
+#include <limits.h>
 #include <string.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -41,6 +44,30 @@
 	return strncmp(EVENT_DEV_NAME, dir->d_name, 5) == 0;
 }
 
+/*
+ * scandir() ordering for /dev/input/eventNN.
+ *
+ * Upstream passes glibc's versionsort() here, a GNU extension that
+ * the OHOS libc does not provide.  The entries are always named
+ * "event<NN>", so compare the numeric suffix directly: that is the
+ * ordering versionsort() would give (event2 before event10) and it
+ * needs nothing beyond ISO C.
+ */
+static int eventdev_cmp(const struct dirent **a, const struct dirent **b)
+{
+	const char *na = (*a)->d_name + strlen(EVENT_DEV_NAME);
+	const char *nb = (*b)->d_name + strlen(EVENT_DEV_NAME);
+	char *end_a, *end_b;
+	long va = strtol(na, &end_a, 10);
+	long vb = strtol(nb, &end_b, 10);
+
+	if (end_a == na || end_b == nb)
+		return strcmp((*a)->d_name, (*b)->d_name);
+	if (va != vb)
+		return va < vb ? -1 : 1;
+	return strcmp((*a)->d_name, (*b)->d_name);
+}
+
 char* find_event_devices(void)
 {
 	struct dirent **namelist;
@@ -49,7 +76,7 @@
 	int max_device = 0;
 	int rc;
 
-	ndev = scandir(DEV_INPUT_EVENT, &namelist, is_event_device, versionsort);
+	ndev = scandir(DEV_INPUT_EVENT, &namelist, is_event_device, eventdev_cmp);
 	if (ndev <= 0)
 		return NULL;
 
