# Patch: Make STTY_BIN configurable at runtime via EXP_STTY environment variable
# Target: expect 5.45.4
# Author: AtomCode
# Date: 2026-07-23
# 
# Problem: Expect's spawn hardcodes /bin/stty at compile time via -DSTTY_BIN="/bin/stty".
# On HarmonyOS OHOS, /bin/stty does not exist, causing every spawn to emit
# 'sh: /bin/stty: inaccessible or not found' on stderr. DejaGNU's default_target_assemble
# treats this stderr as assembly failure, even when the tool succeeds (exit code 0).
#
# Fix: Before falling back to compile-time STTY_BIN, check the EXP_STTY environment
# variable. If EXP_STTY is set, use it as the stty path. If EXP_STTY is empty or unset,
# use the compile-time default (unchanged behavior on Linux/macOS).
#
# If the resolved stty binary does not exist or fails, skip stty initialization
# gracefully instead of crashing the spawn.

--- a/exp_tty.c
+++ b/exp_tty.c
@@ -313,6 +313,21 @@ struct tty_control {
  * exec_stty - execute the system's stty command
  */
 
+/* Resolve the stty binary path:
+ *   1. Use EXP_STTY environment variable if set.
+ *   2. Fall back to compile-time STTY_BIN.
+ *   3. If the resolved path doesn't exist, return NULL (skip stty).
+ */
+static const char *
+get_stty_bin(void)
+{
+    const char *env = getenv("EXP_STTY");
+    if (env && env[0] != '\0') {
+        return env;
+    }
+    return STTY_BIN;
+}
+
 static int
 exec_stty(
     Tcl_Interp *interp,
@@ -326,7 +341,14 @@ exec_stty(
 	Tcl_IncrRefCount(cmdObj);
 
 	Tcl_AppendStringsToObj(cmdObj,"exec ",(char *)0);
-	Tcl_AppendStringsToObj(cmdObj,STTY_BIN,(char *)0);
+
+	const char *stty_bin = get_stty_bin();
+	if (stty_bin == NULL || access(stty_bin, X_OK) != 0) {
+	    /* stty binary not available - skip stty initialization */
+	    Tcl_DecrRefCount(cmdObj);
+	    return TCL_OK;
+	}
+	Tcl_AppendStringsToObj(cmdObj,stty_bin,(char *)0);
 	for (i=1;i<argc;i++) {
 	    Tcl_AppendStringsToObj(cmdObj," ",argv[i],(char *)0);
 	}
--- a/pty_termios.c
+++ b/pty_termios.c
@@ -196,6 +196,21 @@
     return 0;
 }
 
+/* Resolve the stty binary path (same logic as exp_tty.c) */
+static const char *
+get_stty_bin(void)
+{
+    const char *env = getenv("EXP_STTY");
+    if (env && env[0] != '\0') {
+        return env;
+    }
+    return STTY_BIN;
+}
+
 /*
  * pty_stty() - execute stty command on a given pty
  */
@@ -210,7 +225,12 @@ pty_stty(s,name)
 	
 	old = signal(SIGCHLD, SIG_DFL);
 	switch (pid = fork()) {
-	case 0: /* child */
+	case 0: { /* child */
+	  const char *stty_bin = get_stty_bin();
+	  if (stty_bin == NULL || access(stty_bin, X_OK) != 0) {
+	    _exit(0); /* stty not available - skip */
+	  }
 	  exec_stty(STTY_BIN,STTY_BIN,s);
+	}
 		break;
 	case -1: /* fail */
 	default: /* parent */
