Description: Improve error message when fcheck db is not writable
Bug-Debian: http://bugs.debian.org/cgi-bin/bugreport.cgi?bug=105556
Forwarded: no
Author: Anthony Towns <aj@azure.humbug.org.au>
Last-Update: 2003-02-28

--- a/fcheck
+++ b/fcheck
@@ -1579,7 +1579,7 @@ if ($Verbose) { printf("debug: Processing host [%s]\n", $ThisHost); }
 if ($BaseLine)
   {
      # Open for write
-     open (DB, ">$DBFile") || &Error("no fcheck database exists! [$DBFile]");
+     open (DB, ">$DBFile") || &Error("could not open fcheck database for writing! [$DBFile]: $!");
      printf(DB "# - Host  %s\n",$ThisHost);
      printf(DB "# - OS  %s\n",$ThisOS);
      $#junk = -1;
