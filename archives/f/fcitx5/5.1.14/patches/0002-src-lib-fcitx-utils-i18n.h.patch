+namespace compat_detail {
+template <typename T>
+std::string argToString(const T &v) {
+    if constexpr (std::is_same_v<T, std::string>) {
+        return v;
+    } else if constexpr (std::is_same_v<T, const char *>) {
+        return v ? std::string(v) : std::string();
+    } else if constexpr (std::is_same_v<T, char>) {
+        return std::string(1, v);
+    } else if constexpr (std::is_same_v<T, bool>) {
+        return std::string(v ? "true" : "false");
+    } else if constexpr (std::is_same_v<T, std::filesystem::path>) {
+        return v.string();
+    } else if constexpr (std::is_arithmetic_v<T>) {
+        return std::to_string(v);
+    } else {
+        // Fallback: stream insertion
+        std::ostringstream os;
+        os << v;
+        return os.str();
+    }
+}
+
+template <typename... Args>
+std::string vformatCompat(const std::string &fmt, Args &&...args) {
+    std::string out;
+    out.reserve(fmt.size() + 16);
+    auto strs = {argToString(Args(std::forward<Args>(args)))...};
+    std::vector<std::string> argVec;
+    argVec.reserve(strs.size());
+    for (const auto &s : strs)
+        argVec.push_back(s);
+    size_t autoIndex = 0;
+    for (size_t i = 0; i < fmt.size(); ++i) {
+        if (fmt[i] == '{') {
+            size_t close = fmt.find('}', i + 1);
+            if (close == std::string::npos) {
+                out.push_back(fmt[i]);
+                continue;
+            }
+            std::string spec = fmt.substr(i + 1, close - i - 1);
+            std::string numPart = spec;
+            std::string fmtPart;
+            auto colon = spec.find(':');
+            if (colon != std::string::npos) {
+                numPart = spec.substr(0, colon);
+                fmtPart = spec.substr(colon + 1);
+            }
+            size_t idx = autoIndex;
+            if (!numPart.empty()) {
+                idx = static_cast<size_t>(std::strtoul(numPart.c_str(), nullptr, 10));
+                autoIndex = idx + 1;
+            } else {
+                ++autoIndex;
+            }
+            if (idx < argVec.size()) {
+                if (fmtPart == "X" || fmtPart == "x") {
+                    unsigned long long val =
+                        static_cast<unsigned long long>(
+                            std::strtoull(argVec[idx].c_str(), nullptr, 10));
+                    std::ostringstream os;
+                    if (fmtPart == "X")
+                        os << std::uppercase << std::hex << val;
+                    else
+                        os << std::hex << val;
+                    out += os.str();
+                } else {
+                    out += argVec[idx];
+                }
+            }
+            i = close;
+        } else {
+            out.push_back(fmt[i]);
+        }
+    }
+    return out;
+}
+} // namespace compat_detail
+
+template <typename... Args>
+auto translate(Args &&...args)
+    -> std::enable_if_t<(sizeof...(Args) >= 1), std::string> {
+    return compat_detail::vformatCompat(translate(""),
+                                        std::forward<Args>(args)...);
+}
+
+template <typename... Args>
+auto translateCtx(const char *ctx, Args &&...args)
+    -> std::enable_if_t<(sizeof...(Args) >= 1), std::string> {
+    return compat_detail::vformatCompat(translateCtx(ctx, ""),
+                                        std::forward<Args>(args)...);
+}
+
+template <typename... Args>
+auto translateDomain(const char *domain, Args &&...args)
+    -> std::enable_if_t<(sizeof...(Args) >= 1), std::string> {
+    return compat_detail::vformatCompat(translateDomain(domain, ""),
+                                        std::forward<Args>(args)...);
+}
+
+template <typename... Args>
+auto translateDomainCtx(const char *domain, const char *ctx, Args &&...args)
+    -> std::enable_if_t<(sizeof...(Args) >= 1), std::string> {
+    return compat_detail::vformatCompat(
+        translateDomainCtx(domain, ctx, ""), std::forward<Args>(args)...);
+}
