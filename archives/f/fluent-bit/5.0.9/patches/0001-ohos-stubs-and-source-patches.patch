--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,6 +1,14 @@
 cmake_minimum_required(VERSION 3.12)
 project(fluent-bit C)
 
+# OHOS adaptation: ensure generated monkey headers are resolvable via angle-bracket
+# includes used throughout lib/monkey (e.g. <monkey/mk_info.h> in mk_scheduler.h,
+# <mk_core/mk_core_info.h> in mk_getopt.h). Generated headers live under
+# ${CMAKE_BINARY_DIR}/include/monkey/ (mk_core_info.h, mk_info.h, mk_env.h).
+include_directories(BEFORE "${CMAKE_BINARY_DIR}/include/")
+include_directories(BEFORE "${CMAKE_BINARY_DIR}/include/monkey/")
+include_directories(BEFORE "${CMAKE_BINARY_DIR}/include/")  # for <openssl/*> stubs
+
 include(CheckCCompilerFlag)
 
 # CMP0069 ensures that LTO is enabled for all compilers
--- a/lib/chunkio/src/cio_utils.c
+++ b/lib/chunkio/src/cio_utils.c
@@ -26,6 +26,7 @@
 #include <fcntl.h>
 #include <errno.h>
 #ifndef _MSC_VER
+/* HarmonyOS musl lacks <fts.h>; use the shim in build/include/fts.h */
 #include <fts.h>
 #endif
 
