--- a/src/FXThread.cpp
+++ b/src/FXThread.cpp
@@ -49,6 +49,30 @@
 #endif
 
 
+// musl, the C library OHOS is built on, implements no POSIX thread
+// cancellation, so pthread_cancel() and the cancel state/type setters are not
+// declared there; glibc, macOS and the BSDs do provide them.  Where the
+// declarations are missing, the state and type setters are accepted (they only
+// tune behaviour that does not exist in the first place), while a cancel
+// request is refused rather than faked: FXThread::cancel() then reports failure
+// instead of blocking in pthread_join() on a thread that keeps running.
+#if !defined(WIN32) && !defined(__GLIBC__) && !defined(__APPLE__) && \
+    !defined(__FreeBSD__) && !defined(__NetBSD__) && !defined(__OpenBSD__) && \
+    !defined(__DragonFly__) && !defined(__sun)
+#if !defined(PTHREAD_CANCEL_ENABLE)
+#define PTHREAD_CANCEL_ENABLE 0
+#define PTHREAD_CANCEL_DISABLE 1
+#endif
+#if !defined(PTHREAD_CANCEL_ASYNCHRONOUS)
+#define PTHREAD_CANCEL_ASYNCHRONOUS 0
+#define PTHREAD_CANCEL_DEFERRED 1
+#endif
+static inline int pthread_setcancelstate(int,int*){ return 0; }
+static inline int pthread_setcanceltype(int,int*){ return 0; }
+static inline int pthread_cancel(pthread_t){ return ENOTSUP; }
+#endif
