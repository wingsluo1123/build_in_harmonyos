 FUNCTION(ASSERT_PYTHON3_MODULE_PRESENCE mod_ msg_)
     EXECUTE_PROCESS(COMMAND "python3" "-c" "import ${mod_}; import sys; sys.exit(0);" RESULT_VARIABLE _exit_code)
