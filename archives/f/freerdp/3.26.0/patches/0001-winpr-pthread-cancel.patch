--- a/winpr/CMakeLists.txt
+++ b/winpr/CMakeLists.txt
@@ -297,6 +297,9 @@
   endif(WINPR_HAVE_PTHREAD_MUTEX_TIMEDLOCK_SYMBOL OR WINPR_HAVE_PTHREAD_MUTEX_TIMEDLOCK_LIB
         OR WINPR_HAVE_PTHREAD_MUTEX_TIMEDLOCK_LIBS
   )
+  # musl (and thus OHOS) has no pthread_cancel; glibc / Bionic do.
+  check_symbol_exists(pthread_cancel pthread.h WINPR_HAVE_PTHREAD_CANCEL)
+
   list(REMOVE_ITEM CMAKE_REQUIRED_LIBRARIES pthread)
 endif()
 
--- a/winpr/include/config/config.h.in
+++ b/winpr/include/config/config.h.in
@@ -18,6 +18,7 @@
 #cmakedefine WINPR_HAVE_SYSLOG_H
 #cmakedefine WINPR_HAVE_JOURNALD_H
 #cmakedefine WINPR_HAVE_PTHREAD_MUTEX_TIMEDLOCK
+#cmakedefine WINPR_HAVE_PTHREAD_CANCEL
 #cmakedefine WINPR_HAVE_EXECINFO_H
 #cmakedefine WINPR_HAVE_GETLOGIN_R
 #cmakedefine WINPR_HAVE_GETPWUID_R
--- a/winpr/libwinpr/thread/thread.c
+++ b/winpr/libwinpr/thread/thread.c
@@ -1040,7 +1040,7 @@
 	if (!run_mutex_fkt(pthread_mutex_lock, &thread->mutex))
 		return FALSE;
 
-#ifndef ANDROID
+#ifdef WINPR_HAVE_PTHREAD_CANCEL
 	pthread_cancel(thread->thread);
 #else
 	WLog_ERR(TAG, "Function not supported on this platform!");
