{
  "$schema": "https://gitcode.com/OpenHarmonyPCDeveloper/build_in_harmonyos/raw/main/templates/commands.schema.json",
  "type": "tool",
  "name": "fwupdtool",
  "description": "Firmware update tool for OpenHarmony PC",
  "commands": [
    {
      "command": "fwupdtool --version",
      "description": "Show version information",
      "expected_output": "fwupd 2.1.6"
    },
    {
      "command": "fwupdtool --help",
      "description": "Show help message",
      "expected_output": "usage: fwupdtool"
    },
    {
      "command": "fwupdtool get-devices",
      "description": "Get all devices that support firmware updates",
      "expected_output": ""
    }
  ]
}
