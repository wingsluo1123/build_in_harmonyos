diff --git a/Makefile.in b/Makefile.in
index 146ba26..213b5e4 100644
--- a/Makefile.in
+++ b/Makefile.in
@@ -430,12 +430,13 @@ top_build_prefix = @top_build_prefix@
 top_builddir = @top_builddir@
 top_srcdir = @top_srcdir@
 ACLOCAL_AMFLAGS = -I m4 ${ACLOCAL_FLAGS}
+# OHOS: garcon-gtk (libxfce4ui -> xfconf chain, not packaged), docs
+# (gtk-doc) and tests (test-display-menu-gtk3 links the dropped
+# garcon-gtk; all three are noinst programs NOT wired into make check
+# — consumer smoke covers validation) are dropped from the build.
 SUBDIRS = \
 	garcon								\
-	garcon-gtk							\
-	docs								\
 	data								\
-	tests								\
 	po                                  \
 	icons
 
diff --git a/configure b/configure
index 540d507..3ffabfe 100755
