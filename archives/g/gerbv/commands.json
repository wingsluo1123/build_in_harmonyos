{
    "commands": [
        {
            "name": "gerbv",
            "version": "2.13.0",
            "description": "Gerber RS-274X file viewer - CLI export and GUI",
            "usage": "gerbv [OPTIONS...] [FILE...]",
            "examples": [
                "gerbv --version",
                "gerbv -x png -o output.png input.gbr",
                "gerbv -x pdf -o output.pdf input.gbr"
            ]
        }
    ]
}
