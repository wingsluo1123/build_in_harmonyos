From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Add HarmonyOS host support

---
diff --git a/meson.build b/meson.build
--- a/meson.build
+++ b/meson.build
@@ -66,7 +66,7 @@
 endif
 
 linux_libc = ''
-if host_system == 'linux'
+if host_system in ['linux', 'harmonyos']
   musl_test_code = '''#include <stdlib.h>
   #if defined __GLIBC__ || defined __UCLIBC__
   #error "Not in glibc or uclibc"
@@ -929,7 +929,7 @@
 endif
 message('Checking whether to use statfs or statvfs .. ' + stat_func_to_use)
 
-if host_system == 'linux'
+if host_system in ['linux', 'harmonyos']
   if cc.has_function('mkostemp',
                      prefix: '''#define _GNU_SOURCE
                                 #include <stdlib.h>''')
@@ -2277,7 +2277,7 @@
 # libmount is only used by gio, but we need to fetch the libs to generate the
 # pkg-config file below
 libmount_dep = []
-if host_system == 'linux'
+if host_system in ['linux', 'harmonyos']
   libmount_dep = dependency('mount', version : '>=2.23', required : get_option('libmount'))
   glib_conf.set('HAVE_LIBMOUNT', libmount_dep.found())
 
@@ -2293,7 +2293,7 @@
 endif
 
 selinux_dep = []
-if host_system == 'linux'
+if host_system in ['linux', 'harmonyos']
   selinux_dep = dependency('libselinux', version: '>=2.2', required: get_option('selinux'))
 
   glib_conf.set('HAVE_SELINUX', selinux_dep.found())
@@ -2660,7 +2660,7 @@
   summary('tapset dir', get_option('tapset_install_dir'), section: 'Directories')
 endif
 
-if host_system == 'linux'
+if host_system in ['linux', 'harmonyos']
   summary({
     'selinux' : selinux_dep.found(),
     'libmount' : libmount_dep.found(),
diff --git a/glib/meson.build b/glib/meson.build
--- a/glib/meson.build
+++ b/glib/meson.build
@@ -375,7 +375,7 @@
   platform_deps = []
 endif
 
-if host_system == 'linux'
+if host_system in ['linux', 'harmonyos']
   glib_sources += files('gjournal-private.c')
 endif
 
diff --git a/gio/meson.build b/gio/meson.build
--- a/gio/meson.build
+++ b/gio/meson.build
@@ -406,7 +406,7 @@
     gio_unix_include_headers += files('gdesktopappinfo.h')
     launch_desktop_sources = files('gio-launch-desktop.c')
 
-    if host_system == 'linux'
+    if host_system in ['linux', 'harmonyos']
       launch_desktop_sources += files('../glib/gjournal-private.c')
     endif
 
