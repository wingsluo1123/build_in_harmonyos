From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Run visibility generator with Meson Python

---
diff --git a/tools/meson.build b/tools/meson.build
--- a/tools/meson.build
+++ b/tools/meson.build
@@ -23,7 +23,7 @@
   )
 endif
 
-gen_visibility_macros = find_program('gen-visibility-macros.py')
+gen_visibility_macros = [python, files('gen-visibility-macros.py')]
 
 # This is only needed for 32-bit (x86) Windows builds
 if host_system == 'windows' and host_machine.cpu_family() == 'x86'
