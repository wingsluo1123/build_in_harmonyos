+    'can_fail' : host_system == 'harmonyos',
+  },
   'thumbnail-verification' : {},
   'tls-certificate' : {'extra_sources' : ['gtesttlsbackend.c']},
   'tls-interaction' : {'extra_sources' : ['gtesttlsbackend.c']},
@@ -147,7 +151,7 @@
     'extra_programs': host_system != 'windows' ? ['dbus-launch'] : [],
