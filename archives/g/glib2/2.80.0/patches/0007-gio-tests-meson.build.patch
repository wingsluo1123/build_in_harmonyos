     },
     'unix-mounts' : {},
     'unix-streams' : {},
@@ -339,13 +347,14 @@
       'appinfo' : {
         'install' : false,
         'extra_programs' : ['appinfo-test'],
+        'can_fail' : host_system == 'harmonyos',
       },
       'desktop-app-info' : {
         'install' : false,
         'depends' : gio_launch_desktop,
         'extra_programs' : ['apps', 'appinfo-test'],
