-    'can_fail' : host_system in ['darwin', 'gnu'] or host_system == 'windows' and cc.get_id() != 'gcc',
+    'can_fail' : host_system in ['darwin', 'gnu', 'harmonyos'] or host_system == 'windows' and cc.get_id() != 'gcc',
