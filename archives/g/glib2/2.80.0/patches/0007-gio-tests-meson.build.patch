     # FIXME: https://gitlab.gnome.org/GNOME/glib/-/issues/3148
-    'can_fail' : host_system in ['darwin', 'gnu'],
+    'can_fail' : host_system in ['darwin', 'gnu', 'harmonyos'],
   },
   'win32-appinfo' : {},
 }
@@ -188,7 +192,7 @@
   },
   'gio-tool.py' : {
     'depends' : gio_tool,
-    'can_fail' : host_system == 'windows',
+    'can_fail' : host_system in ['windows', 'harmonyos'],
   },
 }
 
@@ -226,12 +230,15 @@
     },
     'gdbus-server-auth' : {
       'dependencies' : [dbus1_dep],
+      'can_fail' : host_system == 'harmonyos',
     },
   }
 else
   # We can build a cut-down version of this test without libdbus
   gio_tests += {
-    'gdbus-server-auth' : {},
+    'gdbus-server-auth' : {
+      'can_fail' : host_system == 'harmonyos',
+    },
   }
 endif
 
@@ -248,15 +255,16 @@
   gio_tests += {
     'file' : {
       # FIXME: https://gitlab.gnome.org/GNOME/glib/-/issues/3148
-      'can_fail' : host_system == 'gnu',
-    },
-    'gdbus-peer-object-manager' : {},
-    'gdbus-sasl' : {},
