--- a/conanrunenv-release-armv8.sh
+++ b/conanrunenv-release-armv8.sh
@@ -0,0 +1,17 @@
+script_folder="/storage/Users/currentUser/tmp/builds/gnome-autoar-0.4.5.work"
+echo "echo Restoring environment" > "$script_folder/deactivate_conanrunenv-release-armv8.sh"
+for v in PATH LD_LIBRARY_PATH DYLD_LIBRARY_PATH
+do
+   is_defined="true"
+   value=$(printenv $v) || is_defined="" || true
+   if [ -n "$value" ] || [ -n "$is_defined" ]
+   then
+       echo export "$v='$value'" >> "$script_folder/deactivate_conanrunenv-release-armv8.sh"
+   else
+       echo unset $v >> "$script_folder/deactivate_conanrunenv-release-armv8.sh"
+   fi
+done
+
+export PATH="/storage/Users/currentUser/.conan2/p/glibcad7259522c98/p/bin${PATH:+:$PATH}"
+export LD_LIBRARY_PATH="/storage/Users/currentUser/.conan2/p/glibcad7259522c98/p/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
+export DYLD_LIBRARY_PATH="/storage/Users/currentUser/.conan2/p/glibcad7259522c98/p/lib${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"