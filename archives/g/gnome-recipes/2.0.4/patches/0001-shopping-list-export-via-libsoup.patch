+/* The Todoist sync requests below used to be issued through librest
+ * (RestProxy / RestProxyCall). librest is not available on this platform;
+ * every RestProxyCall here was an application/x-www-form-urlencoded POST
+ * to a fixed URL, so the same requests are built and dispatched directly
+ * with libsoup. */
+static SoupSession *
+get_soup_session (void)
+{
+        static SoupSession *session = NULL;
+
+        if (session == NULL)
+                session = soup_session_new ();
+
+        return session;
+}
+
+static void
+form_add_param (GString     *form,
+                const gchar *key,
+                const gchar *value)
+{
+        if (form->len > 0)
+                g_string_append_c (form, '&');
+
+        g_string_append (form, key);
+        g_string_append_c (form, '=');
+        g_string_append_uri_escaped (form, value, NULL, TRUE);
+}
+
+static SoupMessage *
+form_post_message (const gchar *url,
+                   GString     *form)
+{
+        SoupMessage *msg;
+
+        msg = soup_message_new ("POST", url);
+        soup_message_set_request (msg, "application/x-www-form-urlencoded",
+                                  SOUP_MEMORY_TAKE, form->str, form->len);
+        g_string_free (form, FALSE);
+
+        return msg;
+}
+
