--- a/meson.build
+++ b/meson.build
@@ -119,6 +119,17 @@
 # Must be unquoted for dbus service file
 conf.set('BINDIR', bindir)
 
+# 能力探测：_NL_MEASUREMENT_MEASUREMENT 是 glibc 专有的 langinfo 列表项（枚举
+# 成员，非宏，无法直接 #ifdef），部分 libc（如 OHOS）不提供 → 编译探测守卫。
+cc = meson.get_compiler('c')
+if cc.links('''#include <langinfo.h>
+int main (void)
+{
+  return (int) _NL_MEASUREMENT_MEASUREMENT;
+}''')
+  conf.set('HAVE__NL_MEASUREMENT_MEASUREMENT', true)
+endif
+
 configure_file(output : 'config.h', configuration : conf)
 
 subdir('src')
