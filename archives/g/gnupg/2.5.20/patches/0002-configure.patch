diff -ruN a/configure b/configure
--- a/configure
+++ b/configure
@@ -2901,21 +2901,21 @@
 
 # When changing the SWDB tag please also adjust the hard coded tags in
 # build-aux/speedo.mk, build-aux/getswdb.sh, and Makefile.am
 # As well as the source info for the man pages.
 
 cat >>confdefs.h <<_ACEOF
 #define GNUPG_SWDB_TAG "gnupg26"
 _ACEOF
 
 
-NEED_GPGRT_VERSION=1.56
+NEED_GPGRT_VERSION=1.55
 
 NEED_LIBGCRYPT_API=1
 NEED_LIBGCRYPT_VERSION=1.11.0
 
 NEED_LIBASSUAN_API=3
 NEED_LIBASSUAN_VERSION=3.0.0
 
 NEED_KSBA_API=1
 NEED_KSBA_VERSION=1.6.3
 
@@ -17731,26 +17731,26 @@
   tmp= ac_tmp=
   trap 'exit_status=$?
   : "${ac_tmp:=$tmp}"
   { test ! -d "$ac_tmp" || rm -fr "$ac_tmp"; } && exit $exit_status
 ' 0
   trap 'as_fn_exit 1' 1 2 13 15
 }
 # Create a (secure) tmp directory for tmp files.
 
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`(umask 022 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
   tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  (umask 022 && mkdir "$tmp")
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
 
 # Set up the scripts for CONFIG_FILES section.
 # No need to generate them if there are no CONFIG_FILES.
 # This happens for instance with `./config.status config.h'.
 if test -n "$CONFIG_FILES"; then
 
 
 ac_cr=`echo X | tr X '\015'`
