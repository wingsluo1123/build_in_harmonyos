 // installed maps from a dir name (as given to install) to a chan
 // closed when the dir's package is installed.
 var installed = make(map[string]chan struct{})
 var installedMu sync.Mutex
 
+// OHOS: signElfBinary strips and signs an ELF file for HarmonyOS.
+// Unsigned ELF binaries cannot execute on HarmonyOS due to code signing requirements.
+var signTool = "/data/service/hnp/bin/binary-sign-tool"
+var llvmObjcopy = "/data/service/hnp/bin/llvm-objcopy"
+var stripBin = "/data/service/hnp/bin/strip"
+
+func signElfBinary(path string) {
+	if !isfile(path) {
+		return
+	}
+	// Check if ELF by reading magic bytes
+	f, err := os.Open(path)
+	if err != nil {
+		return
+	}
+	magic := make([]byte, 4)
+	_, err = f.Read(magic)
+	f.Close()
+	if err != nil || string(magic) != "\x7fELF" {
+		return
+	}
+
+	// Strip to fix non-standard ELF format (Go binaries have SHT_STRTAB not null-terminated)
+	run("", 0, stripBin, path)
+
+	// Remove any existing .codesign section
+	run("", 0, llvmObjcopy, "--remove-section", ".codesign", path)
+
+	// Sign the binary
+	tmpFile := path + ".signed.tmp"
+	run("", CheckExit, signTool, "sign", "-inFile", path, "-outFile", tmpFile, "-selfSign", "1")
+	os.Rename(tmpFile, path)
+	os.Chmod(path, 0755)
+}
+
+// signToolchainDir signs all ELF files in the given directory.
+func signToolchainDir(dir string) {
+	if !isdir(dir) {
+		return
+	}
+	filepath.Walk(dir, func(path string, info os.FileInfo, err error) error {
+		if err != nil || info.IsDir() {
+			return nil
+		}
+		signElfBinary(path)
+		return nil
+	})
+}
+
 func install(dir string) {
 	<-startInstall(dir)
