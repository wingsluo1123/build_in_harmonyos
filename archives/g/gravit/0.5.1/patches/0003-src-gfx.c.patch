+#include <GL/osmesa.h>
+
+/* Offscreen GL backend: HarmonyOS PC has no window system (X11/Wayland/EGL)
+   and therefore no window-system OpenGL, so the SDL surface is a plain
+   software surface and the GL context is created by Mesa's OSMesa offscreen
+   software renderer.  Every frame is rendered into a private buffer and
+   published by copying it onto the SDL surface in gfxOffscreenSwap(), which
+   replaces SDL_GL_SwapBuffers().  The macro names the capability that is
+   needed, not the platform, and is defined by the recipe. */
+
+#define GRAVIT_OFFSCREEN_WIDTH 800
+#define GRAVIT_OFFSCREEN_HEIGHT 600
+
+#define GRAVIT_GL_GET_PROC_ADDRESS(name) OSMesaGetProcAddress(name)
+
+static OSMesaContext gfxOffscreenContext = NULL;
+static unsigned char *gfxOffscreenBuffer = NULL;
+static int gfxOffscreenWidth = 0;
+static int gfxOffscreenHeight = 0;
+
+static void gfxOffscreenFree() {
+
+    if (gfxOffscreenContext) {
+        OSMesaDestroyContext(gfxOffscreenContext);
+        gfxOffscreenContext = NULL;
+    }
+
+    if (gfxOffscreenBuffer) {
+        free(gfxOffscreenBuffer);
+        gfxOffscreenBuffer = NULL;
+    }
+
+    gfxOffscreenWidth = 0;
+    gfxOffscreenHeight = 0;
+
+}
+
+static int gfxOffscreenInit(int width, int height) {
+
+    gfxOffscreenFree();
+
+    gfxOffscreenBuffer = (unsigned char *) malloc((size_t) width * height * 4);
+    if (!gfxOffscreenBuffer) {
+        conAdd(LERR, "Could not allocate a %ix%i offscreen render buffer", width, height);
+        return 0;
+    }
+    memset(gfxOffscreenBuffer, 0, (size_t) width * height * 4);
+
+    /* 16 bit depth, no stencil/accumulator: what the fixed function pipeline
+       used below and the glReadPixels() screenshot path need. */
+    gfxOffscreenContext = OSMesaCreateContextExt(OSMESA_RGBA, 16, 0, 0, NULL);
+    if (!gfxOffscreenContext) {
+        conAdd(LERR, "Could not create an offscreen GL context");
+        gfxOffscreenFree();
+        return 0;
+    }
+
+    if (!OSMesaMakeCurrent(gfxOffscreenContext, gfxOffscreenBuffer, GL_UNSIGNED_BYTE, width, height)) {
+        conAdd(LERR, "Could not make the offscreen GL context current");
+        gfxOffscreenFree();
+        return 0;
+    }
+
+    gfxOffscreenWidth = width;
+    gfxOffscreenHeight = height;
+
+    /* Rows of the OSMesa buffer run top to bottom, matching both the SDL
+       surface layout and the upside-down trick the screenshot code uses. */
+    OSMesaPixelStore(OSMESA_Y_UP, 0);
+
+    conAdd(LNORM, "Offscreen GL context: %s", (char *) glGetString(GL_VERSION));
+
+    return 1;
+
+}
+
+/* There is no front/back buffer to swap on an offscreen context: publish the
+   finished frame by copying it onto the SDL software surface. */
+static void gfxOffscreenSwap() {
+
+    int x, y;
+    SDL_Surface *surface = video.sdlScreen;
+    unsigned char *destination;
+
+    glFinish();
+
+    if (!surface)
+        return;
+
+    if (SDL_MUSTLOCK(surface) && SDL_LockSurface(surface) < 0)
+        return;
+
+    destination = (unsigned char *) surface->pixels;
+
+    for (y = 0; y < gfxOffscreenHeight; y++) {
+
+        Uint32 *dst = (Uint32 *) (destination + (size_t) y * surface->pitch);
+        const unsigned char *src = gfxOffscreenBuffer + (size_t) y * gfxOffscreenWidth * 4;
+
+        for (x = 0; x < gfxOffscreenWidth; x++) {
+            dst[x] = SDL_MapRGBA(surface->format, src[0], src[1], src[2], src[3]);
+            src += 4;
+        }
+
+    }
+
+    if (SDL_MUSTLOCK(surface))
+        SDL_UnlockSurface(surface);
+
+    SDL_UpdateRect(surface, 0, 0, 0, 0);
+
+}
