 int fileExists(char *path) {
 
     FILE *fp;
     fp = fopen(path, "rb");
     if (!fp) return 0;
     fclose(fp);
     return 1;
 
 }
 
+#ifndef WIN32
+// Returns "<directory holding the running executable>/..", i.e. the install
+// prefix a relocatable package was unpacked into, or NULL when it cannot be
+// determined.
+static char *executablePrefixRoot() {
+
+    static char root[4096];
+    static int cached = 0;
+    char exe[4096];
+    char *slash;
+    ssize_t len;
+
+    if (cached)
+        return root[0] ? root : 0;
+
+    cached = 1;
+
+    len = readlink("/proc/self/exe", exe, sizeof(exe) - 1);
+    if (len <= 0)
+        return 0;
+
+    exe[len] = 0;
+    slash = strrchr(exe, '/');
+    if (!slash)
+        return 0;
+
+    *slash = 0;
+    snprintf(root, sizeof(root), "%s/..", exe);
+
+    return root;
+
+}
+#endif
