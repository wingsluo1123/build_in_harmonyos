+/* POSIX tmpfile() need not honor TMPDIR. Use the same task-root contract
+ * on every POSIX build; an explicitly invalid root must not fall back. */
+static FILE *
+h5tools_task_tmpfile(void)
+{
+    const char *directory = getenv("TMPDIR");
+    const char *suffix = "/h5tools-overflow-XXXXXX";
+    char *name;
+    int fd;
+    FILE *stream;
+    if (!directory || !directory[0])
+        return tmpfile();
+    if (directory[0] != '/')
+        return NULL;
+    name = malloc(strlen(directory) + strlen(suffix) + 1);
+    if (!name)
+        return NULL;
+    strcpy(name, directory);
+    strcat(name, suffix);
+    fd = mkstemp(name);
+    if (fd < 0) {
+        free(name);
+        return NULL;
+    }
+    if (unlink(name) != 0) {
+        close(fd);
+        free(name);
+        return NULL;
+    }
+    free(name);
+    stream = fdopen(fd, "w+");
+    if (!stream)
+        close(fd);
+    return stream;
+}
