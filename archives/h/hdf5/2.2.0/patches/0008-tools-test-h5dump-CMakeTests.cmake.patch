+# Source-backed HDFFV-9407 test-driver repair. Not a product-code bypass.
+# This script mode is reached only by the original precision test registration.
+if (DEFINED HDF5_PRECISION_PROGRAM)
+  if (NOT EXISTS "${HDF5_PRECISION_INPUT}" OR NOT HDF5_PRECISION_EXPECT)
+    message (FATAL_ERROR "Precision fixture or original numerical oracle missing")
+  endif ()
+  execute_process (
+      COMMAND "${HDF5_PRECISION_PROGRAM}" ${HDF5_PRECISION_ARGS} "${HDF5_PRECISION_INPUT}"
+      RESULT_VARIABLE precision_rc OUTPUT_VARIABLE precision_out ERROR_VARIABLE precision_err
+  )
+  string (FIND "${precision_out}" "${HDF5_PRECISION_EXPECT}" precision_match)
+  if (NOT precision_rc EQUAL 0 OR precision_match LESS 0 OR NOT "${precision_err}" STREQUAL "")
+    message (FATAL_ERROR "Precision RC/content oracle failed: rc=${precision_rc}; output=${precision_out}; error=${precision_err}")
+  endif ()
+  message (STATUS "${precision_out}")
+  return ()
+endif ()
