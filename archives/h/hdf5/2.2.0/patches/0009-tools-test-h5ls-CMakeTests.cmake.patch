+# Expand only the two original shell-glob cases, then use the unchanged upstream
+# RC/output comparison driver and source-derived reference files.
+if (DEFINED HDF5_H5LS_GLOB)
+  file (GLOB h5ls_glob_files RELATIVE "${TEST_FOLDER}" "${TEST_FOLDER}/${HDF5_H5LS_GLOB}")
+  list (SORT h5ls_glob_files)
+  if (NOT h5ls_glob_files)
+    message (FATAL_ERROR "Original wildcard fixture set is empty")
+  endif ()
+  list (APPEND TEST_ARGS ${h5ls_glob_files})
+  include ("${HDF5_H5LS_RUN_TEST}")
+  return ()
+endif ()
