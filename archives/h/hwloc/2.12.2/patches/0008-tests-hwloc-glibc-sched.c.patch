--- a/tests/hwloc/glibc-sched.c
+++ b/tests/hwloc/glibc-sched.c
@@ -72,18 +72,26 @@
   hwloc_bitmap_free(hwlocset);
 
 #ifdef HWLOC_HAVE_OLD_SCHED_SETAFFINITY
   err = sched_getaffinity(0, &schedset);
 #else
   err = sched_getaffinity(0, sizeof(schedset), &schedset);
 #endif
   assert(!err);
   hwlocset = hwloc_bitmap_alloc();
   hwloc_cpuset_from_glibc_sched_affinity(topology, hwlocset, &schedset, sizeof(schedset));
+  if (!hwloc_bitmap_isequal(hwlocset, obj->cpuset)) {
+    /* Some sandboxes report success from sched_setaffinity() without
+     * changing the effective affinity. Treat this as an unsupported
+     * runtime capability instead of hiding it behind a platform macro. */
+    hwloc_bitmap_free(hwlocset);
+    hwloc_topology_destroy(topology);
+    return 77;
+  }
   assert(hwloc_bitmap_isequal(hwlocset, obj->cpuset));
   hwloc_bitmap_free(hwlocset);
 
 #endif /* HWLOC_HAVE_CPU_SET */
 
   hwloc_topology_destroy(topology);
   return 0;
 }
