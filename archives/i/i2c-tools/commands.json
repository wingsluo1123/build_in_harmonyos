{
  "name": "i2c-tools",
  "type": "tool",
  "description": "Linux I2C utilities and libi2c userspace support library",
  "homepage": "https://git.kernel.org/pub/scm/utils/i2c-tools/i2c-tools.git",
  "versions": {
    "4.4": {
      "ref": "i2c-tools/4.4",
      "binary": true,
      "commands": [
