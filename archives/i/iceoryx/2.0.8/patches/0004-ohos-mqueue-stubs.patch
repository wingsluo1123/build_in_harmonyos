diff -ruN a/iceoryx_hoofs/platform/unix/include/iceoryx_hoofs/platform/mqueue.hpp b/iceoryx_hoofs/platform/unix/include/iceoryx_hoofs/platform/mqueue.hpp
--- a/iceoryx_hoofs/platform/unix/include/iceoryx_hoofs/platform/mqueue.hpp
+++ b/iceoryx_hoofs/platform/unix/include/iceoryx_hoofs/platform/mqueue.hpp
@@ -17,9 +17,132 @@
 #ifndef IOX_HOOFS_UNIX_PLATFORM_MQUEUE_HPP
 #define IOX_HOOFS_UNIX_PLATFORM_MQUEUE_HPP
 
+#include <errno.h>
 #include <mqueue.h>
+#include <sys/types.h>
+
+#if defined(IOX_NO_POSIX_MQ)
+
+// Compatibility fallback for C libraries whose <mqueue.h> only defines the
+// message queue types (`mqd_t`, `struct mq_attr`) without declaring - and
+// without implementing - a single mq_* function.  The generic POSIX platform
+// layer has to provide the whole interface itself then; the configure-time
+// probe in iceoryx_meta/CMakeLists.txt sets IOX_NO_POSIX_MQ only when
+// `mq_open` is not declared, so on any libc that has POSIX message queues this
+// file is identical to upstream.  Every call reports "not implemented"
+// (ENOSYS) instead of failing to compile or linking against a missing symbol;
+// iceoryx's posixCall wrapper turns that into a clean MessageQueueError.
+// (The mac/win platform layers use exactly the same technique.)
+//
+// <sys/types.h> is needed explicitly here: a <mqueue.h> without the mq_*
+// declarations does not pull in `mode_t` either.
+
+static inline mqd_t mq_open(const char* name, int oflag, ...)
+{
+    (void)name;
+    (void)oflag;
+    errno = ENOSYS;
+    return (mqd_t)-1;
+}
+
+static inline int mq_close(mqd_t mqdes)
+{
+    (void)mqdes;
+    errno = ENOSYS;
+    return -1;
+}
+
+static inline int mq_unlink(const char* name)
+{
+    (void)name;
+    errno = ENOSYS;
+    return -1;
+}
+
+static inline int mq_getattr(mqd_t mqdes, struct mq_attr* attr)
+{
+    (void)mqdes;
+    (void)attr;
+    errno = ENOSYS;
+    return -1;
+}
+
+static inline int mq_setattr(mqd_t mqdes, const struct mq_attr* newattr, struct mq_attr* oldattr)
+{
+    (void)mqdes;
+    (void)newattr;
+    (void)oldattr;
+    errno = ENOSYS;
+    return -1;
+}
+
+static inline int mq_notify(mqd_t mqdes, const struct sigevent* notification)
+{
+    (void)mqdes;
+    (void)notification;
+    errno = ENOSYS;
+    return -1;
+}
+
+static inline int mq_send(mqd_t mqdes, const char* msg_ptr, size_t msg_len, unsigned int msg_prio)
+{
+    (void)mqdes;
+    (void)msg_ptr;
+    (void)msg_len;
+    (void)msg_prio;
+    errno = ENOSYS;
+    return -1;
+}
+
+static inline ssize_t mq_receive(mqd_t mqdes, char* msg_ptr, size_t msg_len, unsigned int* msg_prio)
+{
+    (void)mqdes;
+    (void)msg_ptr;
+    (void)msg_len;
+    (void)msg_prio;
+    errno = ENOSYS;
+    return -1;
+}
+
+static inline int mq_timedsend(
+    mqd_t mqdes, const char* msg_ptr, size_t msg_len, unsigned int msg_prio, const struct timespec* abs_timeout)
+{
+    (void)mqdes;
+    (void)msg_ptr;
+    (void)msg_len;
+    (void)msg_prio;
+    (void)abs_timeout;
+    errno = ENOSYS;
+    return -1;
+}
+
+static inline ssize_t mq_timedreceive(
+    mqd_t mqdes, char* msg_ptr, size_t msg_len, unsigned int* msg_prio, const struct timespec* abs_timeout)
+{
+    (void)mqdes;
+    (void)msg_ptr;
+    (void)msg_len;
+    (void)msg_prio;
+    (void)abs_timeout;
+    errno = ENOSYS;
+    return -1;
+}
+
+static inline mqd_t iox_mq_open2(const char* name, int oflag)
+{
+    return mq_open(name, oflag);
+}
+
+static inline mqd_t iox_mq_open4(const char* name, int oflag, mode_t mode, struct mq_attr* attr)
+{
+    return mq_open(name, oflag, mode, attr);
+}
+
+#else
 
 mqd_t iox_mq_open2(const char* name, int oflag);
 mqd_t iox_mq_open4(const char* name, int oflag, mode_t mode, struct mq_attr* attr);
 
+#endif // defined(IOX_NO_POSIX_MQ)
+
 #endif // IOX_HOOFS_UNIX_PLATFORM_MQUEUE_HPP
