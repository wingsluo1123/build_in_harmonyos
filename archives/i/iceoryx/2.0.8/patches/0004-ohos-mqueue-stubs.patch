diff -ruN a/iceoryx_meta/CMakeLists.txt b/iceoryx_meta/CMakeLists.txt
--- a/iceoryx_meta/CMakeLists.txt
+++ b/iceoryx_meta/CMakeLists.txt
@@ -34,6 +34,37 @@
     endif()
 endif()
 
+# ── POSIX message queue capability detection ────────────────────────────────
+# Some C libraries ship a <mqueue.h> that only defines the message queue types
+# (mqd_t, struct mq_attr) without declaring - and without implementing - any
+# mq_* function.  The generic POSIX platform layer
+# (iceoryx_hoofs/platform/unix) calls those functions directly, so the build
+# would stop with "use of undeclared identifier 'mq_open'".
+#
+# Whether the interface exists is a property of the C library, not of a
+# platform name, so probe it at configure time: compile (do not link - on such a
+# library the interface is neither declared nor implemented, and a link probe
+# would conflate "declared but not implemented" with "absent") a translation
+# unit that calls mq_open, and compile the ENOSYS fallback of the platform layer
+# instead when it is not available.
+include(CheckCXXSourceCompiles)
+set(_iox_try_compile_target_type "${CMAKE_TRY_COMPILE_TARGET_TYPE}")
+set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
+check_cxx_source_compiles("
+#include <mqueue.h>
+#include <sys/types.h>
+int main()
+{
+    mqd_t handle = mq_open(\"/iceoryx-mq-probe\", 0);
+    (void)handle;
+    return 0;
+}" IOX_HAS_POSIX_MQ_OPEN)
+set(CMAKE_TRY_COMPILE_TARGET_TYPE "${_iox_try_compile_target_type}")
+if(NOT IOX_HAS_POSIX_MQ_OPEN)
+    message(STATUS "iceoryx: <mqueue.h> declares no mq_open -> POSIX message queue stubs enabled")
+    add_compile_definitions(IOX_NO_POSIX_MQ=1)
+endif()
+
 # ===== Core
 add_subdirectory(${CMAKE_CURRENT_SOURCE_DIR}/../iceoryx_hoofs ${CMAKE_BINARY_DIR}/hoofs)
 add_subdirectory(${CMAKE_CURRENT_SOURCE_DIR}/../iceoryx_posh ${CMAKE_BINARY_DIR}/posh)
