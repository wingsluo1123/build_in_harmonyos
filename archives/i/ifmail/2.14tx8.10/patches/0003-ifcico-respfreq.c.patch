+/* The mask matching below was written against the BSD re_comp()/re_exec()
+ * pair. POSIX never standardised them: glibc only exposes them behind
+ * _REGEX_RE_COMP and musl does not provide them at all (the link fails with
+ * "undefined symbol: re_comp"). Wrap the POSIX regcomp()/regexec() pair and
+ * keep the historical call shape so both call sites stay untouched: the mask
+ * is compiled once per search (an unparseable mask matches nothing, as
+ * before) and matching stays unanchored apart from the '^' the caller
+ * already prepends. Placed after the includes so logerr() is declared. */
+#include <regex.h>
+
+static regex_t req_mask_re;
+static int req_mask_ready=0;
+
+static void req_mask_comp(char *mask)
+{
+	if (req_mask_ready)
+	{
+		regfree(&req_mask_re);
+		req_mask_ready=0;
+	}
+	if (regcomp(&req_mask_re,mask,REG_NOSUB) == 0) req_mask_ready=1;
+	else logerr("invalid file request mask \"%s\"",mask);
+}
 
+static int req_mask_exec(char *str)
+{
+	if (!req_mask_ready) return 0;
+	return (regexec(&req_mask_re,str,0,NULL,0) == 0);
+}
+
+#define re_comp(mask) req_mask_comp(mask)
+#define re_exec(str) req_mask_exec(str)
+
 #ifndef S_ISDIR
