--- /dev/null
+++ b/iflib/testglue.c
@@ -0,0 +1,18 @@
+/* Glue for the iflib self-test targets (testconf, testscan).
+ *
+ * rdconfig.o references the symbols the real front ends supply: version.c
+ * (version/reldate/copyright) and each program's usage(). iflib ships
+ * neither, so `make testconf` and `make testscan` could never link -- on any
+ * platform. Provide the four symbols for test builds only; nothing in the
+ * shipped binaries links this object.
+ */
+#include <stdio.h>
+
+char *version="2.14-tx8.10";
+char *copyright="Eugene G. Crosser, 1993-1997";
+char *reldate="testglue";
+
+void usage(void)
+{
+	fprintf(stderr,"usage: testconf [configfile]\n");
+}
