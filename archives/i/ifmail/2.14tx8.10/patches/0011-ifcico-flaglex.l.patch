@@ -8,6 +8,12 @@
 static char *yyPTR = NULL;
 static int yyBUFL;
 
+/* flex emits "extern int yywrap(void);" in the generated scanner unless
+ * YY_SKIP_YYWRAP is defined. With the zero-argument macro below, that
+ * declaration expands to a syntax error ("too many arguments provided to
+ * function-like macro"), so tell the generated scanner to skip its own
+ * prototype and keep using the macro at the yywrap() call sites. */
+#define YY_SKIP_YYWRAP 1
 #ifndef yywrap
 #define yywrap() 1
 #endif
