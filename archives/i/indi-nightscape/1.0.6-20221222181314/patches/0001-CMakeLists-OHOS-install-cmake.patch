--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -94,9 +94,18 @@
 
 install(TARGETS indi_nightscape_ccd RUNTIME DESTINATION bin )
 
+# INDI_DATA_DIR is only set when the driver xml directory can be located. Fall back to
+# the standard share/indi layout so installation never targets "INDI_DATA_DIR-NOTFOUND".
+if(NOT INDI_DATA_DIR)
+set(INDI_DATA_DIR "share/indi")
+endif()
+
 install(FILES ${CMAKE_CURRENT_BINARY_DIR}/indi_nightscape.xml DESTINATION ${INDI_DATA_DIR})
 
-if (${CMAKE_SYSTEM_NAME} MATCHES "Linux")
+# udev rules require a writable /lib/udev/rules.d, which HarmonyOS PC does not provide.
+# Disable by default; enable explicitly on systems that ship a udev rules directory.
+option(NIGHTSCAPE_INSTALL_UDEV_RULES "Install udev rules into /lib/udev/rules.d" OFF)
+if (NIGHTSCAPE_INSTALL_UDEV_RULES AND (${CMAKE_SYSTEM_NAME} MATCHES "Linux"))
 set(UDEVRULES_INSTALL_DIR "/lib/udev/rules.d" CACHE STRING "Base directory for udev rules")
 install(FILES ${CMAKE_CURRENT_SOURCE_DIR}/99-nightscape.rules DESTINATION ${UDEVRULES_INSTALL_DIR})
 endif()
