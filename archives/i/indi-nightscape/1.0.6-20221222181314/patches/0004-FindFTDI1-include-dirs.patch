   else (FTDI1_INCLUDE_DIR AND FTDI1_LIBRARIES)
     set(FTDI1_FOUND FALSE)
   endif(FTDI1_INCLUDE_DIR AND FTDI1_LIBRARIES)
@@ -52,5 +56,5 @@
   endif (FTDI1_FOUND)
 
   mark_as_advanced(FTDI1_INCLUDE_DIR FTDI1_LIBRARIES)
