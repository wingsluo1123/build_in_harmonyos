+  get_filename_component(FTDI1_INCLUDE_DIRS "${FTDI1_INCLUDE_DIR}" DIRECTORY)
   message(STATUS "Found libftdi1: ${FTDI1_LIBRARIES}")
 
 else (FTDI1_INCLUDE_DIR AND FTDI1_LIBRARIES)
