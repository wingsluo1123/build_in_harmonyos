--- a/indi-pentax/CMakeLists.txt
+++ b/indi-pentax/CMakeLists.txt
@@ -1,53 +1,110 @@
-cmake_minimum_required(VERSION 2.8)
+cmake_minimum_required(VERSION 3.18)
+list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/cmake")
 PROJECT(indi_pentax CXX C)
 
 LIST(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/cmake_modules/")
 LIST(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/../cmake_modules/")
 
 include(GNUInstallDirs)
 
 set (INDI_PENTAX_VERSION_MAJOR 1)
 set (INDI_PENTAX_VERSION_MINOR 0)
 
-find_package(CFITSIO REQUIRED)
-find_package(INDI REQUIRED)
-find_package(LibRaw REQUIRED)
-find_package(JPEG REQUIRED)
-find_package(PENTAX REQUIRED)
+option(INDI_PENTAX_USE_CONAN "Use Conan dependency targets" OFF)
+if(INDI_PENTAX_USE_CONAN)
+    find_package(libindi CONFIG REQUIRED)
+    find_package(cfitsio CONFIG REQUIRED)
+    find_package(libraw CONFIG REQUIRED)
+    find_package(libjpeg CONFIG REQUIRED)
+    find_package(libpktriggercord CONFIG REQUIRED)
+    find_package(ZLIB CONFIG REQUIRED)
+    # libindi shared=False publishes both forms; select its requested static ABI.
+    find_file(INDI_DRIVER_ARCHIVE libindidriver.a PATHS ${INDI_STATIC_LIBRARY_DIR} NO_DEFAULT_PATH REQUIRED)
+    find_file(INDI_CLIENT_ARCHIVE libindiclient.a PATHS ${INDI_STATIC_LIBRARY_DIR} NO_DEFAULT_PATH REQUIRED)
+    find_package(libnova CONFIG REQUIRED)
+    find_package(libusb-1.0 CONFIG REQUIRED)
+    find_package(CURL CONFIG REQUIRED)
+    find_package(gsl CONFIG REQUIRED)
+    find_package(fftw CONFIG REQUIRED)
+    find_package(libev CONFIG REQUIRED)
+    # These published shared libraries have no DT_SONAME. Tell CMake to link
+    # by -l rather than embedding a private Conan cache path in DT_NEEDED.
+    get_property(dependency_targets DIRECTORY PROPERTY IMPORTED_TARGETS)
+    foreach(dependency_target IN LISTS dependency_targets)
+        if(dependency_target MATCHES "^CONAN_LIB::(libraw_raw|libraw_raw_r|libev_ev)_")
+            set_property(TARGET ${dependency_target} PROPERTY IMPORTED_NO_SONAME TRUE)
+        endif()
+    endforeach()
+    set(INDI_LIBRARIES ${INDI_DRIVER_ARCHIVE} ${INDI_CLIENT_ARCHIVE}
+        libnova::libnova libusb-1.0::libusb-1.0 CURL::libcurl gsl::gsl fftw::fftw libev::libev)
+    set(CFITSIO_LIBRARIES cfitsio::cfitsio)
+    set(LibRaw_LIBRARIES libraw::libraw)
+    set(JPEG_LIBRARIES libjpeg::libjpeg)
+    set(PENTAX_LIBRARIES libpktriggercord::libpktriggercord)
+    set(ZLIB_LIBRARY ZLIB::ZLIB)
+    find_path(INDI_INCLUDE_DIR indiccd.h PATHS ${libindi_INCLUDE_DIRS} PATH_SUFFIXES libindi REQUIRED)
+    find_path(LibRaw_INCLUDE_DIR libraw.h PATHS ${libraw_INCLUDE_DIRS} PATH_SUFFIXES libraw REQUIRED)
+    set(INDI_DATA_DIR "${CMAKE_INSTALL_DATADIR}/indi")
+else()
+    find_package(CFITSIO REQUIRED)
+    find_package(INDI REQUIRED)
+    find_package(LibRaw REQUIRED)
+    find_package(JPEG REQUIRED)
+    find_package(PENTAX REQUIRED)
+endif()
 
 configure_file(${CMAKE_CURRENT_SOURCE_DIR}/config.h.cmake ${CMAKE_CURRENT_BINARY_DIR}/config.h )
 configure_file(${CMAKE_CURRENT_SOURCE_DIR}/indi_pentax.xml.cmake ${CMAKE_CURRENT_BINARY_DIR}/indi_pentax.xml )
 
 include_directories( ${CMAKE_CURRENT_BINARY_DIR})
 include_directories( ${CMAKE_CURRENT_SOURCE_DIR})
 include_directories( ${INDI_INCLUDE_DIR})
 include_directories( ${CFITSIO_INCLUDE_DIR})
 include_directories( ${LibRaw_INCLUDE_DIR})
 include_directories( ${PENTAX_INCLUDE_DIR})
 include_directories( ${PKTRIGGERCORD_INCLUDE_DIR})
 
 include(CMakeCommon)
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
 ############# PENTAX CCD ###############
 set(indibase_SRCS
     ${CMAKE_CURRENT_SOURCE_DIR}/indi_pentax.cpp
     ${CMAKE_CURRENT_SOURCE_DIR}/pktriggercord_ccd.cpp
     ${CMAKE_CURRENT_SOURCE_DIR}/gphoto_readimage.cpp
 )
+if(INDI_PENTAX_USE_CONAN)
+    list(APPEND indibase_SRCS ${CMAKE_CURRENT_SOURCE_DIR}/capture_helpers.c)
+endif()
 set(indiricoh_SRCS
     ${CMAKE_CURRENT_SOURCE_DIR}/pentax_ccd.cpp
     ${CMAKE_CURRENT_SOURCE_DIR}/pentax_event_handler.cpp
 )
 #ricoh sdk does not have armv8 binary, so don't include it for aarch64 platforms
-if(${CMAKE_SYSTEM_PROCESSOR} MATCHES "^aarch64")
+include(CheckCXXSourceCompiles)
+check_cxx_source_compiles("#ifndef __aarch64__\n#error Not an AArch64 compiler\n#endif\nint main() { return 0; }" PENTAX_TARGET_AARCH64)
+if(PENTAX_TARGET_AARCH64)
     set(indipentax_SRCS ${indibase_SRCS})
 else()
     set(indipentax_SRCS ${indibase_SRCS} ${indiricoh_SRCS})
 endif()
 
 add_executable(indi_pentax ${indipentax_SRCS})
+if(INDI_PENTAX_USE_CONAN)
+    target_compile_definitions(indi_pentax PRIVATE INDI_PENTAX_MODERN_INDI)
+    target_link_options(indi_pentax PRIVATE "LINKER:--as-needed")
+    foreach(callback ISGetProperties ISNewSwitch ISNewText ISNewNumber ISNewBLOB ISSnoopDevice)
+        target_link_options(indi_pentax PRIVATE "LINKER:--wrap=${callback}")
+    endforeach()
+endif()
 
 target_link_libraries(indi_pentax pthread ${PENTAX_LIBRARIES} ${INDI_LIBRARIES} ${JPEG_LIBRARIES} ${LibRaw_LIBRARIES} ${CFITSIO_LIBRARIES} ${ZLIB_LIBRARY})
 
 install(TARGETS indi_pentax RUNTIME DESTINATION bin)
 
+add_executable(indi_pentax_image image_convert.cpp gphoto_readimage.cpp)
+target_compile_definitions(indi_pentax_image PRIVATE PENTAX_OFFLINE_IMAGE)
+target_link_libraries(indi_pentax_image PRIVATE ${JPEG_LIBRARIES} ${LibRaw_LIBRARIES} ${CFITSIO_LIBRARIES} ${ZLIB_LIBRARY})
+install(TARGETS indi_pentax_image RUNTIME DESTINATION bin)
+
 install(FILES ${CMAKE_CURRENT_BINARY_DIR}/indi_pentax.xml DESTINATION ${INDI_DATA_DIR})
