--- /dev/null
+++ b/indi-pentax/capture_helpers.c
@@ -0,0 +1,85 @@
+/* Driver-side helpers adapted from libpktriggercord/src/pktriggercord-cli.c.
+ * Copyright (C) 2011-2019 Andras Salamon, 2009 Ramiro Barreiro,
+ * with fragments by Pontus Lidman. LGPL-3.0-or-later.
+ * The published pslr library supplies the actual camera/SCSI implementation.
+ */
+#include "capture_helpers.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int save_buffer(pslr_handle_t camera, int buffer, int fd, pslr_status *status,
+                user_file_format format, int jpeg_stars)
+{
+    if (!camera || !status || fd < 0) return 1;
+    pslr_buffer_type type = format == USER_FILE_FORMAT_PEF ? PSLR_BUF_PEF :
+        format == USER_FILE_FORMAT_DNG ? PSLR_BUF_DNG : pslr_get_jpeg_buffer_type(camera, jpeg_stars);
+    if (pslr_buffer_open(camera, buffer, type, status->jpeg_resolution) != PSLR_OK) return 1;
+    const uint32_t length = pslr_buffer_get_size(camera);
+    uint32_t total = 0;
+    int failed = 0;
+    uint8_t data[65536];
+    while (total < length)
+    {
+        uint32_t count = pslr_buffer_read(camera, data, sizeof(data));
+        if (!count || count > length - total) { failed = 1; break; }
+        size_t offset = 0;
+        while (offset < count)
+        {
+            ssize_t written = write(fd, data + offset, count - offset);
+            if (written < 0 && errno == EINTR) continue;
+            if (written <= 0) { failed = 1; break; }
+            offset += (size_t)written;
+        }
+        if (failed) break;
+        total += count;
+    }
+    pslr_buffer_close(camera);
+    return failed || total != length || length == 0;
+}
+
+int open_file(char *prefix, int frame, user_file_format_t format)
+{
+    if (!prefix) return STDOUT_FILENO;
+    char path[4096];
+    const char *dot = strrchr(prefix, '.');
+    size_t length = dot && !strcmp(dot + 1, format.extension) ? (size_t)(dot - prefix) : strlen(prefix);
+    int count = snprintf(path, sizeof(path), "%.*s-%04d.%s", (int)length, prefix, frame, format.extension);
+    if (count < 0 || (size_t)count >= sizeof(path)) { errno = ENAMETOOLONG; return -1; }
+    return open(path, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+}
+
+void bulb_old(pslr_handle_t camera, pslr_rational_t shutter, struct timeval start)
+{
+    struct timeval current;
+    pslr_bulb(camera, true);
+    pslr_shutter(camera);
+    gettimeofday(&current, NULL);
+    double seconds = (double)shutter.nom / shutter.denom - timeval_diff_sec(&current, &start);
+    if (seconds > 0) sleep_sec(seconds);
+    pslr_bulb(camera, false);
+}
+
+void bulb_new(pslr_handle_t camera, pslr_rational_t shutter)
+{
+    if (pslr_has_setting_by_name(camera, "bulb_timer"))
+        pslr_set_setting_by_name(camera, "bulb_timer", 1);
+    else if (pslr_has_setting_by_name(camera, "astrotracer"))
+        pslr_set_setting_by_name(camera, "astrotracer", 1);
+    int seconds = (int)(shutter.nom / shutter.denom);
+    if (pslr_has_setting_by_name(camera, "bulb_timer_sec"))
+        pslr_set_setting_by_name(camera, "bulb_timer_sec", seconds);
+    else if (pslr_has_setting_by_name(camera, "astrotracer_timer_sec"))
+        pslr_set_setting_by_name(camera, "astrotracer_timer_sec", seconds);
+    pslr_shutter(camera);
+}
+
+void bulb_new_cleanup(pslr_handle_t camera)
+{
+    if (pslr_has_setting_by_name(camera, "bulb_timer"))
+        pslr_set_setting_by_name(camera, "bulb_timer", 0);
+    else if (pslr_has_setting_by_name(camera, "astrotracer"))
+        pslr_set_setting_by_name(camera, "astrotracer", 0);
+}
