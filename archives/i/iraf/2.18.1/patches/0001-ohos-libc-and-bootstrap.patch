--- /dev/null
+++ b/unix/os/rcmd_ssh.c
@@ -0,0 +1,117 @@
+/* POSIX stream transport for IRAF kernel servers on systems without rcmd.
+ * The peer is started with an SSH-compatible KSRSH command. */
+#include <errno.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <sys/socket.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+static void
+exec_error(int fd)
+{
+    int code = errno;
+    while (write(fd, &code, sizeof code) < 0 && errno == EINTR) {}
+    _exit(127);
+}
+
+int
+iraf_rcmd_ssh(char **host, int port, const char *localuser,
+              const char *remoteuser, const char *command, int *stderr_fd)
+{
+    int stream[2] = {-1, -1}, errors[2] = {-1, -1}, exec_status[2] = {-1, -1};
+    int status = 0, saved_errno;
+    ssize_t received;
+    long fd_limit = sysconf(_SC_OPEN_MAX);
+    pid_t child, waited;
+    const char *transport = getenv("KSRSH");
+    (void)port;       /* SSH port/options may be supplied by a KSRSH wrapper. */
+    (void)localuser;  /* SSH performs authentication for remoteuser. */
+    if (stderr_fd)
+        *stderr_fd = -1;
+    if (!host || !*host || !**host || !remoteuser || !command) {
+        errno = EINVAL;
+        return -1;
+    }
+    if (!transport || !*transport)
+        transport = "ssh";
+    if (socketpair(AF_UNIX, SOCK_STREAM, 0, stream) < 0)
+        return -1;
+    if (stderr_fd && socketpair(AF_UNIX, SOCK_STREAM, 0, errors) < 0)
+        goto failed;
+    if (pipe(exec_status) < 0 || fcntl(exec_status[1], F_SETFD, FD_CLOEXEC) < 0)
+        goto failed;
+    child = fork();
+    if (child < 0)
+        goto failed;
+    if (child == 0) {
+        pid_t worker = fork();
+        if (worker < 0)
+            exec_error(exec_status[1]);
+        if (worker > 0)
+            _exit(0);
+        /* Detach the transport lifetime from the short bootstrap child;
+         * init reaps it after the channel/remote command terminates. */
+        close(stream[0]);
+        if (errors[0] >= 0)
+            close(errors[0]);
+        if (dup2(stream[1], STDIN_FILENO) < 0 ||
+            dup2(stream[1], STDOUT_FILENO) < 0 ||
+            dup2(stderr_fd ? errors[1] : stream[1], STDERR_FILENO) < 0)
+            exec_error(exec_status[1]);
+        /* Inherited IRAF pipes must not stay open in another transport. */
+        for (long fd = 3; fd < (fd_limit > 0 ? fd_limit : 1024); ++fd)
+            if (fd != exec_status[1])
+                close((int)fd);
+        execlp(transport, transport, "-T", "-l", remoteuser, "--",
+               *host, command, (char *)0);
+        exec_error(exec_status[1]);
+    }
+    close(exec_status[1]);
+    exec_status[1] = -1;
+    close(stream[1]);
+    stream[1] = -1;
+    if (errors[1] >= 0) {
+        close(errors[1]);
+        errors[1] = -1;
+    }
+    do {
+        waited = waitpid(child, &status, 0);
+    } while (waited < 0 && errno == EINTR);
+    /* A pre-existing SIGCHLD handler may already have reaped this child. */
+    if ((waited < 0 && errno != ECHILD) ||
+        (waited == child && (!WIFEXITED(status) || WEXITSTATUS(status)))) {
+        errno = EIO;
+        goto failed;
+    }
+    do {
+        received = read(exec_status[0], &status, sizeof status);
+    } while (received < 0 && errno == EINTR);
+    close(exec_status[0]);
+    exec_status[0] = -1;
+    if (received != 0) {
+        if (received > 0)
+            errno = received == sizeof status ? status : EIO;
+        goto failed;
+    }
+    if (fcntl(stream[0], F_SETFD, FD_CLOEXEC) < 0)
+        goto failed;
+    if (stderr_fd) {
+        if (fcntl(errors[0], F_SETFD, FD_CLOEXEC) < 0)
+            goto failed;
+        *stderr_fd = errors[0];
+    }
+    return stream[0];
+
+failed:
+    saved_errno = errno;
+    if (stream[0] >= 0) close(stream[0]);
+    if (stream[1] >= 0) close(stream[1]);
+    if (errors[0] >= 0) close(errors[0]);
+    if (errors[1] >= 0) close(errors[1]);
+    if (exec_status[0] >= 0) close(exec_status[0]);
+    if (exec_status[1] >= 0) close(exec_status[1]);
+    errno = saved_errno;
+    return -1;
+}
