--- ../joe-4.6.orig/configure	2026-08-05 11:19:59.646450625 +0800
+++ configure	2026-08-05 11:19:59.854446094 +0800
@@ -8963,12 +8963,12 @@
 # Create a (secure) tmp directory for tmp files.
 
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`(umask 022 && mktemp -d "${TMPDIR:-$HOME/tmp}/confXXXXXX") 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
-  tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  tmp="${TMPDIR:-$HOME/tmp}/conf$$-$RANDOM"
+  (umask 022 && mkdir "$tmp")
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
 
