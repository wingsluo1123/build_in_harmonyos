+void kdirnotifyFilesAdded(const QUrl &directory)
+{
+    QDBusMessage msg = QDBusMessage::createSignal(QStringLiteral("/KDirNotify"),
+                                                  QStringLiteral("org.kde.KDirNotify"),
+                                                  QStringLiteral("FilesAdded"));
+    msg.setArguments({directory.toString()});
+    QDBusConnection::sessionBus().send(msg);
+}
+
+void kdirnotifyFilesRemoved(const QList<QUrl> &files)
+{
+    QDBusMessage msg = QDBusMessage::createSignal(QStringLiteral("/KDirNotify"),
+                                                  QStringLiteral("org.kde.KDirNotify"),
+                                                  QStringLiteral("FilesRemoved"));
+    QStringList list;
+    list.reserve(files.size());
+    for (const auto &file : files) {
+        list.append(file.toString());
+    }
+    msg.setArguments({list});
+    QDBusConnection::sessionBus().send(msg);
+}
+} // namespace
 
