 #include <QMimeDatabase>
 #include <QRegularExpression>
 #include <QStandardPaths>
 #include <QTemporaryDir>
 
 using namespace Qt::StringLiterals;
+
+// OHOS: QFile::copy() returns false on the HMDFS filesystem used on this
+// platform even for plain file names (the underlying kernel copy path fails),
+// which made the template generator silently produce nothing. Copy the
+// extracted file by reading and writing it explicitly instead.
+static bool copyTemplateFile(const QString &src, const QString &dst)
+{
+    QFile in(src);
+    if (!in.open(QIODevice::ReadOnly)) {
+        return false;
+    }
+    const QByteArray data = in.readAll();
+    QFile out(dst);
+    if (!out.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+        return false;
+    }
+    const bool written = out.write(data) == data.size();
+    out.close();
+    return written;
+}
 
