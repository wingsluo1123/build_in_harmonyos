 )
 
+# kconfigtest.cpp uses std::chrono calendar types (days/weeks/months/years,
+# C++20 chrono). The OHOS libc++ headers available to clang 15 with cppstd=17
+# do not provide them, so the test target cannot compile on HarmonyOS. The
+# test is already excluded at run time on OHOS; skip building the target too.
+if(NOT HARMONYOS)
+ecm_add_test(kconfigtest.cpp TEST_NAME kconfigtest LINK_LIBRARIES KF6::ConfigCore Qt6::Test Qt6::Concurrent)
+endif()
+
