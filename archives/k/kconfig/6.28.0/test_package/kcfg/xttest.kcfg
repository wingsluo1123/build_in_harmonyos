<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          https://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name="kconfigxttest_rc"/>
  <group name="General">
    <entry name="name" type="String">
      <label>Name written through the generated KConfig XT skeleton</label>
      <default>unset</default>
    </entry>
    <entry name="volume" type="Int">
      <label>Volume value written through the generated KConfig XT skeleton</label>
      <default>42</default>
    </entry>
  </group>
</kcfg>
