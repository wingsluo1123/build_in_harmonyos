-if(POLICY CMP0059) # Don’t treat DEFINITIONS as a built-in directory property.
+# CMake 4.0 removed the OLD behavior of CMP0059 entirely; setting it on
+# such versions is a hard error. Every add_definitions() call site in this
+# tree runs in the directory that also creates its targets, so the NEW
+# behavior (plain COMPILE_DEFINITIONS inheritance) is equivalent.
+if(POLICY CMP0059 AND CMAKE_VERSION VERSION_LESS "4.0") # Don’t treat DEFINITIONS as a built-in directory property.
     cmake_policy(SET CMP0059 OLD)
 endif()
