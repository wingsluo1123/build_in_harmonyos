--- a/autotests/headers/CMakeLists.txt
+++ b/autotests/headers/CMakeLists.txt
@@ -1,8 +1,13 @@
+# The target image refuses to execve() the script outright (the file
+# carries executable bits, yet spawning it fails with "Permission
+# denied", while ELF executables from the same tree run); handing it to
+# the POSIX shell is equivalent and portable.
+
 # Test if all the installed headers can be included individually. Requires installed headers.
 
 add_test(
     NAME HeadersTest
-    COMMAND ${CMAKE_CURRENT_SOURCE_DIR}/headers_test.sh
+    COMMAND sh ${CMAKE_CURRENT_SOURCE_DIR}/headers_test.sh
                 "${CMAKE_BINARY_DIR}" "${CMAKE_SOURCE_DIR}" KDb kdb .
     WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}"
 )
