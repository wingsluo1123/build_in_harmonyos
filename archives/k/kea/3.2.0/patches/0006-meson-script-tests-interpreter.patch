 PYTHON = find_program('python3', 'python', required: true)
+# The HarmonyOS PC kernel refuses to execute #! scripts whose interpreter
+# line names /bin/sh (EACCES); launch every script-based test through the
+# POSIX shell explicitly (the test() registrations in the subdirectories
+# pass this program as the test executable).
+SH = find_program('/bin/sh')
 SPHINX = find_program('sphinx-build', 'sphinx-build-3', required: false)
 SUDO = find_program('sudo', required: false)
