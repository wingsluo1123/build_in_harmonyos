--- a/src/lib/testutils/sandbox.h
+++ b/src/lib/testutils/sandbox.h
@@ -11,6 +11,7 @@
 
 #include <iostream>
 #include <string>
+#include <vector>
 #include <cstdlib>
 #include <cstdio>
 #include <unistd.h>
@@ -40,8 +41,25 @@
 public:
     /// @brief Sandbox constructor.
     Sandbox() {
-        char tmpl[] = {P_tmpdir "/kea-XXXXXX"};
-        path_ = mkdtemp(tmpl);
+        // Honor TMPDIR when set: POSIX defines it as the location for
+        // temporary files, and some sandboxed platforms provide no
+        // writable P_tmpdir (e.g. HarmonyOS PC, where /tmp is mounted
+        // read-only).  There mkdtemp() would return NULL; the failure is
+        // now reported explicitly below instead of crashing the
+        // std::string assignment.  Where TMPDIR is unset the built-in
+        // default is used as before.
+        const char* tmpdir = std::getenv("TMPDIR");
+        if ((tmpdir == NULL) || (*tmpdir == 0)) {
+            tmpdir = P_tmpdir;
+        }
+        std::string tmpl_str = std::string(tmpdir) + "/kea-XXXXXX";
+        std::vector<char> tmpl(tmpl_str.begin(), tmpl_str.end());
+        tmpl.push_back(0);
+        char* dir = mkdtemp(tmpl.data());
+        if (dir == NULL) {
+            isc_throw(Unexpected, "mkdtemp failed for the unit test sandbox directory");
+        }
+        path_ = dir;
     }
 
     /// @brief Destructor, it deletes temporary folder with its content.
