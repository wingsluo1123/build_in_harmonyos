+
+bool
+BaseServerTest::unixControlSocketsUsable() {
+    // Probe with the very operation the server performs: bind a
+    // path-based unix socket in the configured socket path
+    // directory and remove it again.  See the declaration
+    // comment for why.
+    std::string probe_path = UnixCommandConfig::getSocketPath() +
+                             "/kea6-socket-probe";
+    struct sockaddr_un addr;
+    memset(&addr, 0, sizeof(addr));
+    addr.sun_family = AF_UNIX;
+    if (probe_path.size() >= sizeof(addr.sun_path)) {
+        return (false);
+    }
+    memcpy(addr.sun_path, probe_path.c_str(), probe_path.size());
+    int fd = ::socket(AF_UNIX, SOCK_STREAM, 0);
+    if (fd < 0) {
+        return (false);
+    }
+    static_cast<void>(::unlink(probe_path.c_str()));
+    bool usable = (::bind(fd, reinterpret_cast<struct sockaddr*>(&addr),
+                          sizeof(addr)) == 0);
+    static_cast<void>(::close(fd));
+    static_cast<void>(::unlink(probe_path.c_str()));
+    return (usable);
 }
 
