+/// @brief Checks whether the host can host AF_UNIX pathname sockets in
+/// the configured socket path directory.
+///
+/// Some sandboxed platforms refuse bind() of path-based unix sockets
+/// outright (the HarmonyOS PC sandbox answers EPERM), and a probe path
+/// exceeding the sockaddr_un::sun_path size limit fails with
+/// ENAMETOOLONG.  Tests covering the unix command channel use this to
+/// detect such hosts and skip instead of failing there.
+///
+/// @return true if a probe socket can be created in the socket path
+/// directory and removed again.
+bool
+unixControlSocketsUsable() {
+    // Probe with the very operation the server performs: bind a
+    // path-based unix socket in the configured socket path
+    // directory and remove it again.  See the declaration
+    // comment for why.
+    std::string probe_path = UnixCommandConfig::getSocketPath() +
+                             "/kea-d2-socket-probe";
+    struct sockaddr_un addr;
+    memset(&addr, 0, sizeof(addr));
+    addr.sun_family = AF_UNIX;
+    if (probe_path.size() >= sizeof(addr.sun_path)) {
+        return (false);
+    }
+    memcpy(addr.sun_path, probe_path.c_str(), probe_path.size());
+    int fd = ::socket(AF_UNIX, SOCK_STREAM, 0);
+    if (fd < 0) {
+        return (false);
+    }
+    static_cast<void>(::unlink(probe_path.c_str()));
+    bool usable = (::bind(fd, reinterpret_cast<struct sockaddr*>(&addr),
+                          sizeof(addr)) == 0);
+    static_cast<void>(::close(fd));
+    static_cast<void>(::unlink(probe_path.c_str()));
+    return (usable);
+}
 
