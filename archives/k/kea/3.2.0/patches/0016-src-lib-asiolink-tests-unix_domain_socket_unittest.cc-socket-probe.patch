     /// @brief Removes unix socket descriptor.
     void removeUnixSocketFile() {
         static_cast<void>(remove(unixSocketFilePath().c_str()));
+    }
+
+    /// @brief Checks whether the host can host AF_UNIX pathname sockets
+    /// at the fixture's socket location.
+    ///
+    /// Some sandboxed platforms refuse bind() of path-based unix
+    /// sockets outright (the HarmonyOS PC sandbox answers EPERM).  The
+    /// tests which start a server socket probe with the very operation
+    /// the server performs, so that they can skip instead of failing on
+    /// such hosts.
+    ///
+    /// @return true if a probe socket can be created next to the test
+    /// socket location and removed again.
+    bool unixPathSocketsUsable() {
+        std::string probe_path = unixSocketFilePath() + "-probe";
+        struct sockaddr_un addr;
+        memset(&addr, 0, sizeof(addr));
+        addr.sun_family = AF_UNIX;
+        if (probe_path.size() >= sizeof(addr.sun_path)) {
+            return (false);
+        }
+        memcpy(addr.sun_path, probe_path.c_str(), probe_path.size());
+        int fd = ::socket(AF_UNIX, SOCK_STREAM, 0);
+        if (fd < 0) {
+            return (false);
+        }
+        static_cast<void>(::unlink(probe_path.c_str()));
+        bool usable = (::bind(fd, reinterpret_cast<struct sockaddr*>(&addr),
+                              sizeof(addr)) == 0);
+        static_cast<void>(::close(fd));
+        static_cast<void>(::unlink(probe_path.c_str()));
+        return (usable);
     }
 
     /// @brief Performs asynchronous receive on unix domain socket.
