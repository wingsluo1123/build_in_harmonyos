     // Initialize lease manager (false = v4, false = don't add leases)
     initLeaseMgr(false, false);
 
+    // Prefer the POSIX temporary directory when set: some sandboxed
+    // platforms provide no writable /tmp (HarmonyOS PC mounts /tmp
+    // read-only), while this test needs a writable full path.
+    const char* tmpdir = getenv("TMPDIR");
+    if ((tmpdir == NULL) || (*tmpdir == 0)) {
+        tmpdir = "/tmp";
+    }
+    const std::string data_dir = tmpdir;
+    const std::string file_path = data_dir + "/kea-lease-write-test.txt";
+
     // Filename must use supported path.
     std::string cmd =
         "{\n"
         "    \"command\": \"lease4-write\",\n"
         "    \"arguments\": {"
-        "        \"filename\": \"/tmp/kea-lease-write-test.txt\"\n"
+        "        \"filename\": \"" + file_path + "\"\n"
         "    }\n"
         "}";
 
     std::ostringstream os;
     os << "LEASE_CMDS_PATH_SECURITY_WARNING lease file path specified is NOT SECURE:"
-       << " invalid path specified: '/tmp', supported path is '"
+       << " invalid path specified: '" << data_dir << "', supported path is '"
        << CfgMgr::instance().getDataDir() << "'";
 
     testCommand(cmd, CONTROL_RESULT_SUCCESS,
-                "IPv4 lease database into '/tmp/kea-lease-write-test.txt'.");
+                "IPv4 lease database into '" + file_path + "'.");
 
     EXPECT_EQ(1U, countFile(os.str()));
 }
