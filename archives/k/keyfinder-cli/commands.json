{
  "commands": [
    {
      "name": "keyfinder-cli",
      "description": "Estimate the musical key of an audio file",
      "usage": "keyfinder-cli [-h] [-n key-notation] filename",
      "options": [
        {
          "flag": "-h, --help",
          "description": "Show help message"
        },
        {
          "flag": "-n, --notation",
          "description": "Key notation: standard (default), openkey, or camelot"
        }
      ],
      "examples": [
        "keyfinder-cli AMajor.mp3",
        "keyfinder-cli -n camelot song.wav"
      ]
    }
  ]
}
