 import os
 import sys
 import warnings
+def _ohc_locale_output_encoding():
+    """Return the encoding requested via LC_ALL when libc falls back to UTF-8.
+
+    HarmonyOS does not ship the pt_BR.iso88591 locale, so ``setlocale`` keeps
+    UTF-8 and ``locale.getpreferredencoding`` would report UTF-8 even though
+    the caller explicitly requested Latin-1.  Deriving the requested encoding
+    from LC_ALL preserves kitchen's gettext output on such platforms.
+    """
+    locale_name = os.environ.get("LC_ALL") or os.environ.get("LC_CTYPE", "")
+    normalized = locale_name.lower().replace("-", "").replace("_", "")
+    if "iso88591" in normalized or "latin1" in normalized:
+        return "latin1"
+    return locale.getpreferredencoding()
 
