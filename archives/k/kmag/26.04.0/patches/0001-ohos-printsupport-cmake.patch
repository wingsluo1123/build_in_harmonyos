--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -25,10 +25,14 @@
 
 option(BUILD_DOC "Whether to build the documentation" ON)
 
+# HarmonyOS PC: the published qtbase builds Qt with FEATURE_printsupport=OFF
+# and ships no Qt6PrintSupport module (ksystemlog 26.04.0 precedent), so
+# PrintSupport is removed from the required component list. The print UI
+# entry is dropped and the upstream QT_NO_PRINTER-guarded implementation
+# stays inert (see src/CMakeLists.txt).
 find_package(Qt6 ${QT_MIN_VERSION} CONFIG REQUIRED COMPONENTS
     Core
     Widgets
-    PrintSupport
 )
 
 find_package(KF6 ${KF_MIN_VERSION} REQUIRED COMPONENTS
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -35,8 +35,12 @@
     KF6::Crash
     Qt6::Core
     Qt6::Widgets
-    Qt6::PrintSupport
 )
+
+# HarmonyOS PC: no Qt6PrintSupport in the published qtbase; compile out
+# the print action and the QPrinter-backed slot. Upstream already guards
+# the implementation with QT_NO_PRINTER.
+target_compile_definitions(kmag PRIVATE QT_NO_PRINTER)
 
 if(QAccessibilityClient6_FOUND)
     target_link_libraries(kmag QAccessibilityClient6)
