 KNSCore::EntryInternal EntryInternal::fromEntry(const KNS3::Entry &entry)
 {
+#if KNEWSTUFF_OHOS_SCOPED
+    // Scoped build: the KNS3::Entry header present is the scoped stand-in
+    // carrying only the Status enum; the widgets library (and therefore a
+    // real KNS3::Entry with its internal data) does not exist, so callers
+    // from the widgets layer are themselves absent. Return a default
+    // EntryInternal; this path is unreachable in scoped builds.
+    (void)entry;
+    return KNSCore::EntryInternal();
+#else
     return entry.d->e;
+#endif
 }
 
