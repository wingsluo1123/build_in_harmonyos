<?xml version="1.0"?>
<!--
  Consumer end-to-end fixture for konclude on HarmonyOS PC (second input).

  A reduced TBox (Male and Female declared disjointFrom each other, Male
  subClassOf Person) plus one ABox individual asserted to be both Male and
  Female.  Because of the disjointness that knowledge base is INCONSISTENT — a
  fact that can only be derived by reasoning (the asserted axioms alone are
  satisfiable).
-->
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
     xml:base="http://example.org/konclude-ohos/inconsistent"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     ontologyIRI="http://example.org/konclude-ohos/inconsistent">
    <Prefix name="" IRI="http://example.org/konclude-ohos/inconsistent#"/>
    <Prefix name="owl" IRI="http://www.w3.org/2002/07/owl#"/>

    <Declaration><Class IRI="#Person"/></Declaration>
    <Declaration><Class IRI="#Male"/></Declaration>
    <Declaration><Class IRI="#Female"/></Declaration>
    <Declaration><NamedIndividual IRI="#alex"/></Declaration>

    <DisjointClasses>
        <Class IRI="#Male"/>
        <Class IRI="#Female"/>
    </DisjointClasses>

    <SubClassOf>
        <Class IRI="#Male"/>
        <Class IRI="#Person"/>
    </SubClassOf>

    <ClassAssertion>
        <Class IRI="#Person"/>
        <NamedIndividual IRI="#alex"/>
    </ClassAssertion>
    <ClassAssertion>
        <Class IRI="#Male"/>
        <NamedIndividual IRI="#alex"/>
    </ClassAssertion>
    <ClassAssertion>
        <Class IRI="#Female"/>
        <NamedIndividual IRI="#alex"/>
    </ClassAssertion>
</Ontology>
