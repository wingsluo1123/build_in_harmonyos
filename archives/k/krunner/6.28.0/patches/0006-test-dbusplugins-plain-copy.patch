+// QFile::copy() goes through QSaveFile's temporary-file + rename path, which
+// fails silently in this build environment even though the destination
+// directory exists and is writable. Install the fixture with a plain
+// read/write copy and surface the error string if anything goes wrong.
+bool installTestDataFile(const QString &source, const QString &destination)
+{
+    QFile in(source);
+    if (!in.open(QIODevice::ReadOnly)) {
+        qWarning() << "test data source open failed:" << source << in.errorString();
+        return false;
+    }
+    const QByteArray contents = in.readAll();
+    in.close();
+    QFile out(destination);
+    if (!out.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+        qWarning() << "test data destination open failed:" << destination << out.errorString();
+        return false;
+    }
+    const qint64 written = out.write(contents);
+    out.close();
+    if (written != contents.size()) {
+        qWarning() << "test data short write:" << destination << written << contents.size();
+        return false;
+    }
+    return true;
+}
