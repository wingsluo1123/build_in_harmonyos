diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4510768..eb44ff6 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -12,6 +12,9 @@ set(KF6_MIN_VERSION "6.26.0")
 set(CMAKE_CXX_STANDARD 23)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 
+option(KSCREENLOCKER_BUILD_GREETER "Build the greeter (requires PlasmaQuick, LayerShellQt, KF6Screen and PAM)" ON)
+option(KSCREENLOCKER_BUILD_KCM "Build the KCM settings module (requires KCMUtils)" ON)
+
 find_package(ECM ${KF6_MIN_VERSION} REQUIRED NO_MODULE)
 set(CMAKE_MODULE_PATH ${CMAKE_CURRENT_SOURCE_DIR}/cmake ${ECM_MODULE_PATH} )
 
@@ -48,10 +51,11 @@ if (Qt6Gui_VERSION VERSION_GREATER_EQUAL "6.10.0")
     find_package(Qt6GuiPrivate ${REQUIRED_QT_VERSION} REQUIRED NO_MODULE)
 endif()
 
+# Crash / KIO / Svg are only used by the greeter, KCMUtils only by the
+# KCM; their find_package calls moved into the corresponding
+# KSCREENLOCKER_BUILD_* blocks below so that the core library builds
+# without them.
 find_package(KF6 ${KF6_MIN_VERSION} REQUIRED COMPONENTS
-    Crash
-    KCMUtils
-    KIO
     GlobalAccel
     I18n
     IdleTime
@@ -59,10 +63,14 @@ find_package(KF6 ${KF6_MIN_VERSION} REQUIRED COMPONENTS
     Solid
     WindowSystem
     XmlGui
-    Svg
 )
 
-find_package(PlasmaQuick ${PROJECT_DEP_VERSION} REQUIRED)
+if (KSCREENLOCKER_BUILD_GREETER)
+    find_package(KF6 ${KF6_MIN_VERSION} REQUIRED COMPONENTS Crash KIO Svg)
+endif ()
+if (KSCREENLOCKER_BUILD_GREETER)
+    find_package(PlasmaQuick ${PROJECT_DEP_VERSION} REQUIRED)
+endif ()
 
 find_package(X11)
 set_package_properties(X11 PROPERTIES DESCRIPTION "X11 libraries"
@@ -85,8 +93,10 @@ endif ()
 
 find_package(WaylandScanner)
 find_package(Wayland 1.3 COMPONENTS Client Server)
-find_package(LayerShellQt REQUIRED)
-find_package(KF6Screen REQUIRED)
+if (KSCREENLOCKER_BUILD_GREETER)
+    find_package(LayerShellQt REQUIRED)
+    find_package(KF6Screen REQUIRED)
+endif ()
 
 set_package_properties(Wayland PROPERTIES
                        TYPE REQUIRED
@@ -118,12 +128,14 @@ add_feature_info("Unlock broken screenlocker"
                  HAVE_UNLOCK_CAPABILITY
                  "Needed for emergency unlock in case that the greeter is broken. In case your distribution does not provide loginctl or consolekit please contact plasma-devel@kde.org to discuss alternatives.")
 
-find_package(PAM REQUIRED)
-set_package_properties(PAM PROPERTIES DESCRIPTION "PAM Libraries"
-                       URL "https://www.kernel.org/pub/linux/libs/pam/"
-                       TYPE REQUIRED
-                       PURPOSE "Required for screen unlocking"
-                      )
+if (KSCREENLOCKER_BUILD_GREETER)
+    find_package(PAM REQUIRED)
+    set_package_properties(PAM PROPERTIES DESCRIPTION "PAM Libraries"
+                           URL "https://www.kernel.org/pub/linux/libs/pam/"
+                           TYPE REQUIRED
+                           PURPOSE "Required for screen unlocking"
+                          )
+endif ()
 macro(define_pam_service APP)
     string(TOUPPER ${APP}_PAM_SERVICE var)
     set(cvar ${var})
@@ -163,8 +175,13 @@ ecm_set_disabled_deprecation_versions(QT 6.11.0
     KF 6.23.0
 )
 
-add_subdirectory(greeter)
-add_subdirectory(kcm)
+if (KSCREENLOCKER_BUILD_GREETER)
+    add_subdirectory(greeter)
+endif ()
+if (KSCREENLOCKER_BUILD_KCM)
+    find_package(KF6 ${KF6_MIN_VERSION} REQUIRED COMPONENTS KCMUtils)
+    add_subdirectory(kcm)
+endif ()
 add_subdirectory(settings)
 
 add_definitions(-DTRANSLATION_DOMAIN=\"kscreenlocker\")
diff --git a/autotests/CMakeLists.txt b/autotests/CMakeLists.txt
index ffda77d..94a6db0 100644
--- a/autotests/CMakeLists.txt
+++ b/autotests/CMakeLists.txt
@@ -22,7 +22,7 @@ ecm_mark_as_test(logindTest)
 pkg_search_module(PamWrapper pam_wrapper)
 # We're turning it off on the CI until pam_wrapper 1.15 is available on our image (which adds sanitizer support.)
 # see https://invent.kde.org/plasma/kscreenlocker/-/issues/11 for more details
-if (PamWrapper_FOUND AND NOT "$ENV{KDECI_BUILD}" STREQUAL "TRUE")
+if (PamWrapper_FOUND AND NOT "$ENV{KDECI_BUILD}" STREQUAL "TRUE" AND KSCREENLOCKER_BUILD_GREETER)
     pkg_get_variable(PamWrapperModuleDir pam_wrapper "modules")
     configure_file(data/test_service.in ./test_service)
     add_executable(pamTest pamtest.cpp)
diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index 704746b..ea66e81 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -2,7 +2,9 @@ add_executable(kscreenlocker_test kscreenlocker_main.cpp)
 target_link_libraries(kscreenlocker_test KScreenLocker Qt::Gui KF6::I18n)
