 using namespace std::chrono_literals;
 using namespace Qt::StringLiterals;
 
+// OHOS: 该环境下 QFile::copy() 可能失败（其 link() 快速路径不被支持），
+// 退化为逐字节拷贝，避免夹具投放失败导致整条用例红。
+static bool ohosCopyFixture(const QString &source, const QString &target)
+{
+    if (QFile::copy(source, target))
+        return true;
+    QFile in(source);
+    if (!in.open(QIODevice::ReadOnly))
+        return false;
+    QFile out(target);
+    if (!out.open(QIODevice::WriteOnly | QIODevice::Truncate))
+        return false;
+    const QByteArray data = in.readAll();
+    return out.write(data) == data.size();
+}
+
+
 QTEST_MAIN(KServiceTest)
 
 extern KSERVICE_EXPORT int ksycoca_ms_between_checks;
