 add_project_arguments('-DKYWC_VERSION=@0@'.format(version), language: 'c')
 
+# OHOS packaging: ukui-quick and other consumers only need the libkywc client
+# library (they link -lkywc and resolve it through kywc.pc). The compositor
+# half requires wlroots 0.17 and the full desktop stack, so the package
+# builds only libkywc/. The unmodified upstream build stays in the else
+# branch below.
+if get_option('libkywc_only')
+  subdir('libkywc')
+else
+
 wlroots = dependency(
   'wlroots',
   default_options: ['default_library=static', 'examples=false', 'renderers=vulkan'],
