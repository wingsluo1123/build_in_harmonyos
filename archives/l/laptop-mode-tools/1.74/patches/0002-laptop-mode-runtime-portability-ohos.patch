--- a/usr/sbin/laptop_mode	2020-07-18 21:49:46.000000000 +0800
+++ b/usr/sbin/laptop_mode	2026-09-26 19:18:23.330686874 +0800
@@ -237,9 +237,22 @@
 # We don't want to discard all the remaining 4 events, but at least honor 1 so that we can act to the changes
 # that occured in the last 7 seconds.
 # So, Event-2 acquire LMT_REQ_LOCK and waits to acquire LMT_INVOC_LOCK (which is acquire by Event-1)
-LMT_REQ_LOCK="/var/lock/lmt-req.lock"
-LMT_INVOC_LOCK="/var/lock/lmt-invoc.lock"
-LMT_BATTPOLL_LOCK="/var/lock/lmt-battpoll.lock"
+LMT_LOCK_DIR="${LMT_LOCK_DIR:-/var/lock}"
+LMT_RUN_DIR="${LMT_RUN_DIR:-/var/run/laptop-mode-tools}"
+# OHOS: if the lock directory is not writable (e.g. read-only rootfs),
+# fall back to a writable location instead of failing on exec redirection.
+if ! ( : > "$LMT_LOCK_DIR/.lmt-lock-probe" ) 2>/dev/null; then
+	for _lmt_lock_fb in /tmp/laptop-mode-tools-locks "$HOME/.lmt-locks"; do
+		if mkdir -p "$_lmt_lock_fb" 2>/dev/null && ( : > "$_lmt_lock_fb/.lmt-lock-probe" ) 2>/dev/null; then
+			LMT_LOCK_DIR="$_lmt_lock_fb"
+			break
+		fi
+	done
+fi
+rm -f "$LMT_LOCK_DIR/.lmt-lock-probe" 2>/dev/null
+LMT_REQ_LOCK="$LMT_LOCK_DIR/lmt-req.lock"
+LMT_INVOC_LOCK="$LMT_LOCK_DIR/lmt-invoc.lock"
+LMT_BATTPOLL_LOCK="$LMT_LOCK_DIR/lmt-battpoll.lock"
 if checkCmd "flock"; then
     FLOCK=`which flock`;
 else
@@ -283,6 +296,10 @@
 
 	if [ -r /etc/laptop-mode/laptop-mode.conf ] ; then
 		. /etc/laptop-mode/laptop-mode.conf
