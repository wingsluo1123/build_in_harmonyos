+		# OHOS: version/help must work without an installed configuration file.
+		DEBUG=0
+		VERBOSE_OUTPUT=0
 	else
 		log "ERR" "$0: Configuration file /etc/laptop-mode/laptop-mode.conf not present or not readable."
 		exit 1
