--- a/etc/laptop-mode/laptop-mode.conf	2020-07-18 21:49:46.000000000 +0800
+++ b/etc/laptop-mode/laptop-mode.conf	2026-09-26 19:18:23.330686874 +0800
@@ -288,7 +288,7 @@
 # Should laptop mode tools control the hard drive power management settings?
 #
 # Set to 0 to disable
-CONTROL_HD_POWERMGMT="auto"
+CONTROL_HD_POWERMGMT=0 # OHOS: hdparm/udevadm unavailable, disable HD power management module
 
 
 #
--- a/etc/laptop-mode/conf.d/runtime-pm.conf	2020-07-18 21:49:46.000000000 +0800
+++ b/etc/laptop-mode/conf.d/runtime-pm.conf	2026-09-26 19:18:23.330686874 +0800
@@ -26,7 +26,7 @@
 
 # Enable Runtime autosuspend feature?
 # Set to 0 to disable
-CONTROL_RUNTIME_AUTOSUSPEND=1
+CONTROL_RUNTIME_AUTOSUSPEND=0 # OHOS: sysfs runtime autosuspend not manageable, disable
 
 # Set this to use opt-in/whitelist instead of opt-out/blacklist for deciding
 # which devices should be autosuspended.
--- a/etc/laptop-mode/conf.d/dpms-standby.conf	2020-07-18 21:49:46.000000000 +0800
+++ b/etc/laptop-mode/conf.d/dpms-standby.conf	2026-09-26 19:18:23.330686874 +0800
@@ -35,7 +35,7 @@
 # Should laptop mode tools control DPMS standby settings for X displays?
 #
 # Set to 0 to disable
-CONTROL_DPMS_STANDBY="auto"
+CONTROL_DPMS_STANDBY=0 # OHOS: xset unavailable, disable
 
 
 #
--- a/etc/laptop-mode/conf.d/terminal-blanking.conf	2020-07-18 21:49:46.000000000 +0800
+++ b/etc/laptop-mode/conf.d/terminal-blanking.conf	2026-09-26 19:18:23.330686874 +0800
@@ -27,7 +27,7 @@
 # Should laptop mode tools control terminal blanking settings?
 #
 # Set to 0 to disable
-CONTROL_TERMINAL="auto"
+CONTROL_TERMINAL=0 # OHOS: setterm unavailable, disable
 
 
 #
--- a/etc/laptop-mode/conf.d/wireless-power.conf	2020-07-18 21:49:46.000000000 +0800
+++ b/etc/laptop-mode/conf.d/wireless-power.conf	2026-09-26 19:18:23.330686874 +0800
@@ -20,7 +20,7 @@
 DEBUG=0
 
 # Control generic wireless interface power saving mode?
-CONTROL_WIRELESS_POWER_SAVING="auto"
+CONTROL_WIRELESS_POWER_SAVING=0 # OHOS: iw/iwconfig unavailable, disable
 
 WIRELESS_AC_POWER_SAVING=0
 WIRELESS_BATT_POWER_SAVING=1
--- a/etc/laptop-mode/conf.d/wireless-ipw-power.conf	2020-07-18 21:49:46.000000000 +0800
+++ b/etc/laptop-mode/conf.d/wireless-ipw-power.conf	2026-09-26 19:18:23.330686874 +0800
@@ -20,7 +20,7 @@
 
 # Control Intel IPW wireless power?
 # Set to 0 to disable
-CONTROL_IPW_POWER="auto"
+CONTROL_IPW_POWER=0 # OHOS: iwconfig unavailable, disable
 
 # Levels passed to "iwpriv set_power" for the IPW3945 and IPW2100 wireless
 # chipsets. The allowed values are different for each chipset.
--- a/etc/laptop-mode/conf.d/wireless-iwl-power.conf	2020-07-18 21:49:46.000000000 +0800
+++ b/etc/laptop-mode/conf.d/wireless-iwl-power.conf	2026-09-26 19:18:23.334688124 +0800
@@ -25,7 +25,7 @@
 
 # Control Intel IWL wireless power?
 # Set to 0 to disable
-CONTROL_IWL_POWER="auto"
+CONTROL_IWL_POWER=0 # OHOS: iwconfig unavailable, disable
 
 # Levels passed to "/sys/class/net/*/device/power_level" for the iwlwifi
 # wireless chipsets. The allowed values are:
--- a/etc/laptop-mode/conf.d/hal-polling.conf	2020-07-18 21:49:46.000000000 +0800
+++ b/etc/laptop-mode/conf.d/hal-polling.conf	2026-09-26 19:18:23.334688124 +0800
@@ -26,7 +26,7 @@
 
 # Control HAL polling?
 # Set to 0 to disable.
-CONTROL_HAL_POLLING="auto"
+CONTROL_HAL_POLLING=0 # OHOS: HAL (hal-disable-polling) unavailable, disable
 
 # Disable HAL polling on battery?
 BATT_DISABLE_HAL_POLLING=1
