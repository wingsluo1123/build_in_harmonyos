diff --git a/configure b/configure
--- a/configure
+++ b/configure
@@ -1,4 +1,69 @@
 #! /bin/sh
+# [HMBS/OHOS] Device-local HMDFS/FUSE trees cannot resolve the working
+# directory via getcwd().  Force a portable shell, pin the working
+# directory derived from our own absolute path, and use the standard
+# /bin coreutils so configure/make never execute the unreadable shadow
+# tools (e.g. /storage/Users/currentUser/usr/local/bin/mkdir).
+PATH=/bin:$PATH; export PATH
+if test -x /bin/mkdir; then MKDIR_P="/bin/mkdir -p"; export MKDIR_P; fi
+CONFIG_SHELL=/bin/sh; SHELL=/bin/sh; export CONFIG_SHELL SHELL
+case "$0" in
+  */source/configure) PWD="${0%/source/configure}/build" ;;
+esac
+export PWD
+# [HMBS/OHOS] gpgrt-config forks a subshell for nearly every command
+# substitution and exhausts the constrained OHOS worker process table
+# ("can't fork - try again"), which then makes config.status unable to
+# create the Makefiles.  libgpg-error 1.55 installs only gpgrt-config by
+# default (src/Makefile.am: bin_SCRIPTS = gpgrt-config unless built with
+# --enable-install-gpg-error-config), so prefer the legacy
+# gpg-error-config when present and otherwise generate an equivalent
+# fork-free shim for the prefix supplied by Conan.
+hmbs_gpg_error_prefix=
+for hmbs_arg in "$@"; do
+  case "$hmbs_arg" in
+    --with-libgpg-error-prefix=*) hmbs_gpg_error_prefix=${hmbs_arg#*=} ;;
+    --with-gpg-error-prefix=*)    hmbs_gpg_error_prefix=${hmbs_arg#*=} ;;
+  esac
+done
+if test -n "$hmbs_gpg_error_prefix"; then
+  if test -x "$hmbs_gpg_error_prefix/bin/gpg-error-config"; then
+    hmbs_gpg_error_cmd="$hmbs_gpg_error_prefix/bin/gpg-error-config"
+  else
+    hmbs_gpg_error_version=1.55
+    hmbs_gpg_error_pc="$hmbs_gpg_error_prefix/lib/pkgconfig/gpg-error.pc"
+    if test -f "$hmbs_gpg_error_pc"; then
+      while IFS= read -r hmbs_line; do
+        case "$hmbs_line" in
+          Version:*) hmbs_gpg_error_version=${hmbs_line#Version: }; hmbs_gpg_error_version=${hmbs_gpg_error_version# }; break ;;
+        esac
+      done < "$hmbs_gpg_error_pc"
+    fi
+    hmbs_gpg_error_shim="${PWD:-.}/hmbs-gpg-error-config"
+    cat > "$hmbs_gpg_error_shim" <<HMBS_OHOS_EOF
+#!/bin/sh
+hmbs_prefix='$hmbs_gpg_error_prefix'
+case "\$1" in
+  --version|--modversion) echo '$hmbs_gpg_error_version' ;;
+  --host) echo aarch64-unknown-linux-musl ;;
+  --prefix) echo "\$hmbs_prefix" ;;
+  --exec-prefix) echo "\$hmbs_prefix" ;;
+  --cflags) echo "-I\$hmbs_prefix/include" ;;
+  --libs) echo "-L\$hmbs_prefix/lib -lgpg-error" ;;
+  --mt)
+    shift
+    case "\$1" in
+      --cflags) echo "-I\$hmbs_prefix/include" ;;
+      --libs) echo "-L\$hmbs_prefix/lib -lgpg-error" ;;
+    esac ;;
+esac
+HMBS_OHOS_EOF
+    hmbs_gpg_error_cmd="sh $hmbs_gpg_error_shim"
+  fi
+  GPG_ERROR_CONFIG="$hmbs_gpg_error_cmd"; export GPG_ERROR_CONFIG
+  ac_cv_path_GPG_ERROR_CONFIG="$hmbs_gpg_error_cmd"; export ac_cv_path_GPG_ERROR_CONFIG
+  ac_cv_path_GPGRT_CONFIG=no; export ac_cv_path_GPGRT_CONFIG
+fi
 # Guess values for system-dependent variables and create Makefiles.
 # Generated by GNU Autoconf 2.71 for libassuan 3.0.2.
 #
@@ -1319,7 +1384,8 @@
