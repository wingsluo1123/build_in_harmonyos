<?xml version="1.0" encoding="UTF-8"?>
<!--
  shared-mime-info 格式的最小 mime 包（libcontentaction 上游测试夹具）

  上游 test-info / test-action 期望 GIO 返回 shared-mime-info 的类型描述与
  内容探测结果（"Plain text document" / "PNG image" 等）。Sailfish 测试环境
  由系统 shared-mime-info 提供该数据库；OHOS 无此组件，故随测试夹具提供
  覆盖上游用例所需类型的最小 mime 包（comment 文案与上游期望一致，
  glob/magic 规则取自 freedesktop.org.xml 同名条目）。
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="text/plain">
    <comment>Plain text document</comment>
    <glob pattern="*.txt"/>
    <magic priority="40">
      <match type="string" value="This is plain text" offset="0"/>
    </magic>
  </mime-type>
  <mime-type type="image/png">
    <comment>PNG image</comment>
    <glob pattern="*.png"/>
    <magic priority="50">
      <match type="string" value="\x89PNG\r\n\x1a\n" offset="0"/>
    </magic>
  </mime-type>
  <mime-type type="audio/mpeg">
    <comment>MPEG audio</comment>
    <glob pattern="*.mp3"/>
  </mime-type>
  <mime-type type="application/pdf">
    <comment>PDF document</comment>
    <glob pattern="*.pdf"/>
    <magic priority="50">
      <match type="string" value="%PDF-" offset="0"/>
    </magic>
  </mime-type>
</mime-info>
