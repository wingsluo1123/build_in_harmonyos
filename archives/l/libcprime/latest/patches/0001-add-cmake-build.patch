--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,98 @@
+cmake_minimum_required(VERSION 3.16)
+project(cprime VERSION 2.3.0 LANGUAGES CXX)
+
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+set(CMAKE_AUTOMOC ON)
+set(CMAKE_AUTOUIC ON)
+set(CMAKE_AUTORCC ON)
+
+find_package(Qt6 REQUIRED COMPONENTS Core Gui Widgets)
+
+set(SOURCES
+    cprime/settingsmanage.cpp
+    cprime/bookmarkmanage.cpp
+    cprime/bookmarkdialog.cpp
+    cprime/applicationdialog.cpp
+    cprime/desktopfile.cpp
+    cprime/properties.cpp
+    cprime/mimeutils.cpp
+    cprime/stringfunc.cpp
+    cprime/themefunc.cpp
+    cprime/sortfunc.cpp
+    cprime/validityfunc.cpp
+    cprime/appopenfunc.cpp
+    cprime/infofunc.cpp
+    cprime/filefunc.cpp
+    cprime/trashmanager.cpp
+)
+
+set(HEADERS
+    cprime/settingsmanage.h
+    cprime/bookmarkmanage.h
+    cprime/bookmarkdialog.h
+    cprime/applicationdialog.h
+    cprime/desktopfile.h
+    cprime/properties.h
+    libcprime_global.h
+    cprime/mimeutils.h
+    cprime/stringfunc.h
+    cprime/cprime.h
+    cprime/themefunc.h
+    cprime/sortfunc.h
+    cprime/validityfunc.h
+    cprime/appopenfunc.h
+    cprime/infofunc.h
+    cprime/filefunc.h
+    cprime/trashmanager.h
+)
+
+set(FORMS
+    cprime/bookmarkdialog.ui
+)
+
+add_library(cprime SHARED ${SOURCES} ${HEADERS} ${FORMS})
+
+target_include_directories(cprime PUBLIC
+    ${CMAKE_CURRENT_SOURCE_DIR}
+    ${CMAKE_CURRENT_BINARY_DIR}
+)
+
+target_link_libraries(cprime PUBLIC
+    Qt6::Core
+    Qt6::Gui
+    Qt6::Widgets
+)
+
+target_compile_definitions(cprime PRIVATE LIBCPRIME_LIBRARY)
+
+set(THEME_FOLDER "${CMAKE_INSTALL_PREFIX}/share/coreapps/theme")
+target_compile_definitions(cprime PRIVATE COREAPPS_THEME_FOLDER="${THEME_FOLDER}")
+
+install(TARGETS cprime
+    LIBRARY DESTINATION lib
+    ARCHIVE DESTINATION lib
+    RUNTIME DESTINATION bin
+)
+
+install(FILES
+    cprime/settingsmanage.h
+    cprime/bookmarkmanage.h
+    cprime/bookmarkdialog.h
+    cprime/applicationdialog.h
+    cprime/desktopfile.h
+    cprime/properties.h
+    libcprime_global.h
+    cprime/mimeutils.h
+    cprime/stringfunc.h
+    cprime/cprime.h
+    cprime/themefunc.h
+    cprime/sortfunc.h
+    cprime/validityfunc.h
+    cprime/appopenfunc.h
+    cprime/infofunc.h
+    cprime/filefunc.h
+    cprime/trashmanager.h
+    DESTINATION include/cprime
+)
