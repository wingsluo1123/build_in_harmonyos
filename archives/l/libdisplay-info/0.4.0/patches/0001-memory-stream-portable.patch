diff --git a/memory-stream.c b/memory-stream.c
index ba72eb1..0fe67af 100644
--- a/memory-stream.c
+++ b/memory-stream.c
@@ -1,31 +1,56 @@
+#include <stdarg.h>
+#include <stdio.h>
 #include <stdlib.h>
+#include <string.h>
 
 #include "memory-stream.h"
 
+#define MEMORY_STREAM_INITIAL_CAP 64
+
+static bool
+memory_stream_reserve(struct memory_stream *m, size_t extra)
+{
+	size_t needed, cap;
+	char *str;
+
+	if (extra > SIZE_MAX - m->str_len - 1)
+		return false;
+
+	needed = m->str_len + extra + 1;
+	if (needed <= m->str_cap)
+		return true;
+
+	cap = m->str_cap > 0 ? m->str_cap : MEMORY_STREAM_INITIAL_CAP;
+	while (cap < needed) {
+		if (cap > SIZE_MAX / 2)
+			return false;
+		cap *= 2;
+	}
+
+	str = realloc(m->str, cap);
+	if (!str)
+		return false;
+
+	m->str = str;
+	m->str_cap = cap;
+	m->str[m->str_len] = '\0';
+
+	return true;
+}
+
 bool
 memory_stream_open(struct memory_stream *m)
 {
 	*m = (struct memory_stream){ 0 };
-	m->fp = open_memstream(&m->str, &m->str_len);
-
-	return m->fp != NULL;
+	return memory_stream_reserve(m, 0);
 }
 
 char *
 memory_stream_close(struct memory_stream *m)
 {
-	char *str;
-	int ret;
+	char *str = m->str;
 
-	ret = fclose(m->fp);
-	str = m->str;
 	*m = (struct memory_stream){ 0 };
-
-	if (ret != 0) {
-		free(str);
-		str = NULL;
-	}
-
 	return str;
 }
 
@@ -34,3 +59,48 @@ memory_stream_cleanup(struct memory_stream *m)
 {
 	free(memory_stream_close(m));
 }
+
+bool
+memory_stream_is_empty(const struct memory_stream *m)
+{
+	return m->str_len == 0;
+}
+
+void
+memory_stream_puts(struct memory_stream *m, const char *str)
+{
+	size_t len = strlen(str);
+
+	if (!memory_stream_reserve(m, len))
+		return;
+
+	memcpy(&m->str[m->str_len], str, len + 1);
+	m->str_len += len;
+}
+
+void
+memory_stream_vprintf(struct memory_stream *m, const char fmt[], va_list args)
+{
+	va_list args_copy;
+	int len;
+
+	va_copy(args_copy, args);
+	len = vsnprintf(NULL, 0, fmt, args_copy);
+	va_end(args_copy);
+
+	if (len < 0 || !memory_stream_reserve(m, (size_t)len))
+		return;
+
+	vsnprintf(&m->str[m->str_len], (size_t)len + 1, fmt, args);
+	m->str_len += (size_t)len;
+}
+
+void
+memory_stream_printf(struct memory_stream *m, const char fmt[], ...)
+{
+	va_list args;
+
+	va_start(args, fmt);
+	memory_stream_vprintf(m, fmt, args);
+	va_end(args);
+}
