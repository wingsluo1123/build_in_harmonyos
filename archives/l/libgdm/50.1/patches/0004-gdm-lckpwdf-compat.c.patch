diff --git a/daemon/gdm-lckpwdf-compat.c b/daemon/gdm-lckpwdf-compat.c
new file mode 100644
index 0000000..971a0a8
--- /dev/null
+++ b/daemon/gdm-lckpwdf-compat.c
@@ -0,0 +1,66 @@
+/* -*- Mode: C; tab-width: 8; indent-tabs-mode: nil; c-basic-offset: 8 -*-
+ *
+ * HarmonyOS PC (OHOS) compat: the OHOS musl libc.so does not export the
+ * lckpwdf()/ulckpwdf() shadow-password database lock API, and the SDK
+ * sysroot ships an empty libcrypt.a.  Provide an equivalent implementation
+ * with flock(2) on /etc/passwd.lock, matching the semantics of the musl
+ * upstream lckpwdf/ulckpwdf so gdm-dynamic-user-store.c keeps working.
+ */
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/file.h>
+#include <unistd.h>
+
+#ifndef O_CLOEXEC
+#define O_CLOEXEC 0
+#endif
+
+/* fd of the held lock; -1 while not locked.  Kept in a file-scope static so
+ * that ulckpwdf() can release and close it (the fd must not be lost). */
+static int lckpwdf_lock_fd = -1;
+
+int
+lckpwdf (void)
+{
+        int fd;
+
+        /* A second lock attempt within the same process would deadlock on
+         * flock() (flock is per open-file-description, even in one process);
+         * fail fast with EDEADLK instead of blocking forever. */
+        if (lckpwdf_lock_fd >= 0) {
+                errno = EDEADLK;
+                return -1;
+        }
+
+        fd = open ("/etc/passwd.lock", O_RDWR | O_CREAT | O_CLOEXEC, 0600);
+        if (fd < 0)
+                return -1;
+
+        if (flock (fd, LOCK_EX) != 0) {
+                int saved_errno = errno;
+
+                close (fd);
+                errno = saved_errno;
+                return -1;
+        }
+
+        lckpwdf_lock_fd = fd;
+        return 0;
+}
+
+int
+ulckpwdf (void)
+{
+        int fd;
+
+        if (lckpwdf_lock_fd < 0) {
+                errno = EINVAL;
+                return -1;
+        }
+
+        fd = lckpwdf_lock_fd;
+        lckpwdf_lock_fd = -1;
+        flock (fd, LOCK_UN);
+        close (fd);
+        return 0;
+}
