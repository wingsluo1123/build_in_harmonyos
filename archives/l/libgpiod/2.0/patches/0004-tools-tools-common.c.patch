 #include "tools-common.h"
 
+/* musl libc compatibility: provide program_invocation_name (glibc extension) */
+#ifndef __GLIBC__
+static char __ohos_prog_name[256] = "unknown";
+static char __ohos_prog_short_name[256] = "unknown";
+
+static void __attribute__((constructor)) __ohos_init_prog_name(void)
+{
+	FILE *f = fopen("/proc/self/cmdline", "r");
+	if (f) {
+		if (fgets(__ohos_prog_name, sizeof(__ohos_prog_name), f)) {
+			char *base = strrchr(__ohos_prog_name, '/');
+			if (base)
+				base++;
+			else
+				base = __ohos_prog_name;
+			snprintf(__ohos_prog_short_name,
+				 sizeof(__ohos_prog_short_name), "%s", base);
+		}
+		fclose(f);
+	}
+}
+
+#define program_invocation_name __ohos_prog_name
+#define program_invocation_short_name __ohos_prog_short_name
+#endif /* !__GLIBC__ */
+
 const char *get_progname(void)
 {
 	return program_invocation_name;
