 target_include_directories(KSaneWidgets
     INTERFACE
         "$<INSTALL_INTERFACE:${KSANEWIDGETS_INSTALL_INCLUDEDIR}>"
     PRIVATE
         ${CMAKE_CURRENT_SOURCE_DIR}/widgets
 )
 
+# OHOS adaptation: link the soname-less KF6 dependencies by basename with a
+# PRIVATE -L (KSANE_DEP_LIB_DIRS is provided by the recipe) so ld records
+# `libKF6<Name>.so` in DT_NEEDED instead of the machine-private package path.
+# Their include directories are pulled in as SYSTEM PRIVATE so those paths are
+# used for compilation only and never exported to consumers.
+target_link_directories(KSaneWidgets PRIVATE ${KSANE_DEP_LIB_DIRS})
+target_include_directories(KSaneWidgets SYSTEM PRIVATE
+    "$<TARGET_PROPERTY:KF6::I18n,INTERFACE_INCLUDE_DIRECTORIES>"
+    "$<TARGET_PROPERTY:KF6::WidgetsAddons,INTERFACE_INCLUDE_DIRECTORIES>"
+    "$<TARGET_PROPERTY:KF6::TextWidgets,INTERFACE_INCLUDE_DIRECTORIES>"
+)
+
 target_link_libraries(KSaneWidgets
     PUBLIC
         Qt6::Core
         Qt6::Gui
         Qt6::Widgets
     PRIVATE
-        KF6::I18n
-        KF6::WidgetsAddons
-        KF6::TextWidgets
+        -lKF6I18n
+        -lKF6WidgetsAddons
+        -lKF6TextWidgets
         ${KSANECORE_TARGET}
 )
 
 ecm_generate_headers(KSane_HEADERS
     HEADER_NAMES
         KSaneWidget
     REQUIRED_HEADERS KSane_HEADERS
     RELATIVE "../src/"
 )
 
