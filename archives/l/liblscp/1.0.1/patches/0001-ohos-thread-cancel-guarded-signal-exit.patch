+//-------------------------------------------------------------------------
+// OHOS fallback cancellation.
+//
+// The OHOS NDK dynamic libc exports none of the pthread cancellation family:
+// llvm-nm -D --defined-only libc.so gives 0 hits for pthread_cancel,
+// pthread_testcancel and pthread_setcanceltype (the first and the third exist
+// only in the static libc.a, which is not what an executable links against),
+// while pthread_create() and pthread_join() are present.  Stubbing the
+// cancellation out is not an option: knowledge/doc/E513.md records that a no-op
+// stub, or merely returning an error, changes the lifecycle of a joinable
+// worker - the caller keeps waiting in pthread_join() and cannot reclaim the
+// thread.  A fallback must preserve both targeted exit and join semantics, so
+// what is used here is E513's own recipe, 方法=guarded-signal-thread-exit: an
+// async-signal-safe thread-exit handler is installed for a reserved signal
+// before the joinable worker is created, lscp_thread_cancel() delivers that
+// signal to the worker with pthread_kill(), and the untouched
+// lscp_thread_join() then reclaims it.
+//
+// Application-side condition, same as the one E513 states: the process must not
+// block the reserved signal, otherwise the request stays pending forever and
+// cancellation cannot terminate the worker.
+
+#define LSCP_THREAD_CANCEL_SIGNAL	SIGUSR1
+
+static void _lscp_thread_cancel_handler ( int iSignal )
+{
+	(void) iSignal;
+	// Runs on the targeted worker's own stack and never returns, which is why
+	// the handler needs nothing but pthread_exit() and is installed without
+	// SA_RESTART.
+	pthread_exit(NULL);
+}
+#endif
+
