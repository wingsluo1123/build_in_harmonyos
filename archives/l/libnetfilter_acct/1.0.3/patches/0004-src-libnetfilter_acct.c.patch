diff -ruN a/src/libnetfilter_acct.c b/src/libnetfilter_acct.c
--- a/src/libnetfilter_acct.c
+++ b/src/libnetfilter_acct.c
@@ -15,6 +15,22 @@
 #include <string.h>
 #include <inttypes.h>
 
+#include <sys/socket.h>  /* fix the HarmonyOS kernel/libc header conflict */
+
+/* The sysroot's kernel uapi <linux/socket.h> unconditionally defines
+ * struct sockaddr_storage, while musl <sys/socket.h> defines its own copy.
+ * The two headers share no guard macro (the musl side has no
+ * _UAPI_LINUX_SOCKET_H), so both expand exactly once regardless of the
+ * include order -- reordering alone cannot fix it.  <libmnl/libmnl.h>
+ * pulls in <sys/socket.h> and then <linux/netlink.h> -> <linux/socket.h>
+ * in this translation unit.  Suppress the redundant uapi copy and provide
+ * the single typedef <linux/netlink.h> needs from it (for struct
+ * sockaddr_nl); musl already supplies every other symbol. */
+#ifndef _UAPI_LINUX_SOCKET_H
+#define _UAPI_LINUX_SOCKET_H
+typedef unsigned short __kernel_sa_family_t;
+#endif
+
 #include <libmnl/libmnl.h>
 #include <linux/netfilter/nfnetlink.h>
 #include <linux/netfilter/nfnetlink_acct.h>
