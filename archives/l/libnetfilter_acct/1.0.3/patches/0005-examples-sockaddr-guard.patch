diff -ruN a/examples/nfacct-get.c b/examples/nfacct-get.c
--- a/examples/nfacct-get.c
+++ b/examples/nfacct-get.c
@@ -2,6 +2,18 @@
 #include <stdlib.h>
 #include <string.h>
 #include <time.h>
+/* OHOS: the sysroot's kernel uapi <linux/socket.h> unconditionally defines
+ * struct sockaddr_storage, while musl <sys/socket.h> defines its own copy and
+ * the two headers share no guard macro.  <libmnl/libmnl.h> pulls in
+ * <sys/socket.h> and then <linux/netlink.h> -> <linux/socket.h>, so the
+ * redundant uapi copy is suppressed here and the single typedef
+ * <linux/netlink.h> needs from it (for struct sockaddr_nl) is supplied. */
+#include <sys/socket.h>
+#ifndef _UAPI_LINUX_SOCKET_H
+#define _UAPI_LINUX_SOCKET_H
+typedef unsigned short __kernel_sa_family_t;
+#endif
+
 #include <libmnl/libmnl.h>
 #include <libnetfilter_acct/libnetfilter_acct.h>
 
