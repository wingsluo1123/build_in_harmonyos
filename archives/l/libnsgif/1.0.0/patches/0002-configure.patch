diff -ruN a/configure b/configure
--- a/configure
+++ b/configure
@@ -0,0 +1,34 @@
+#!/bin/sh
+# Configure wrapper for NetSurf Makefile projects on OpenHarmony
+# Translates configure-style --prefix to Makefile variables
+# Created for OpenHarmony platform adaptation
+
+PREFIX="/usr/local"
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --prefix=*)
+            PREFIX="${1#--prefix=}"
+            ;;
+        *)
+            # Ignore unknown options
+            ;;
+    esac
+    shift
+done
+
+# Determine compiler and archiver
+CC_BIN="${CC:-clang}"
+AR_BIN="${AR:-llvm-ar}"
+
+# Write Makefile.config with resolved variables
+cat > Makefile.config << EOF
+# Auto-generated by configure for OpenHarmony
+PREFIX = $PREFIX
+BUILD_CC = $CC_BIN
+AR = $AR_BIN
+EOF
+
+echo "Configuration:"
+echo "  PREFIX = $PREFIX"
+echo "  BUILD_CC = $CC_BIN"
+echo "  AR = $AR_BIN"
