+
+/*
+ * POSIX thread cancellation fallback (E127/E513): environments without a
+ * pthread_cancel implementation are served by a signal-based shim.  Fallback
+ * keeps join semantics: a reserved signal handler only records a per-thread
+ * request (async-signal-safe); the worker thread observes it at the existing
+ * pthread_testcancel() point in normal context and calls pthread_exit(), which
+ * runs the cleanup handler (pthread_cleanup_push) and lets wait_workers()
+ * pthread_join() reclaim the thread as usual.  Applied unconditionally so the
+ * behaviour is identical on every platform.
+ */
+#include <signal.h>
+#include <strings.h>
+
+static __thread sig_atomic_t zc_cancel_requested;
+
+static void zc_pthread_exit_handler(int sig)
+{
+	(void)sig;
+	zc_cancel_requested = 1;
+}
+
+static int zc_pthread_setcanceltype(int type, int *oldtype)
+{
+	(void)type;
+	(void)oldtype;
+	return 0;
+}
+
+static int zc_pthread_setcancelstate(int state, int *oldstate)
+{
+	(void)state;
+	(void)oldstate;
+	return 0;
+}
+
+static void zc_pthread_testcancel(void)
+{
+	if (zc_cancel_requested)
+		pthread_exit(NULL);
+}
+
+static int zc_pthread_cancel(pthread_t thread)
+{
+	static sig_atomic_t handler_installed;
+
+	if (!handler_installed) {
+		struct sigaction sa;
+
+		bzero(&sa, sizeof(sa));
+		sa.sa_handler = zc_pthread_exit_handler;
+		sigemptyset(&sa.sa_mask);
+		sigaction(SIGUSR1, &sa, NULL);
+		handler_installed = 1;
+	}
+	return pthread_kill(thread, SIGUSR1);
+}
+
+#define pthread_setcanceltype zc_pthread_setcanceltype
+#define pthread_setcancelstate zc_pthread_setcancelstate
+#define pthread_testcancel zc_pthread_testcancel
+#define pthread_cancel zc_pthread_cancel
 
