+Boolean BasicTaskScheduler::setupEventTriggerWakeupChannel() {
+#if defined(__WIN32__) || defined(_WIN32)
+  return False;
+#else
+  int sockets[2] = {-1, -1};
+  if (socketpair(AF_UNIX, SOCK_DGRAM, 0, sockets) < 0) return False;
+
+  for (unsigned i = 0; i < 2; ++i) {
+    int statusFlags = fcntl(sockets[i], F_GETFL, 0);
+    int descriptorFlags = fcntl(sockets[i], F_GETFD, 0);
+    if (statusFlags < 0 || descriptorFlags < 0
+        || fcntl(sockets[i], F_SETFL, statusFlags|O_NONBLOCK) < 0
+        || fcntl(sockets[i], F_SETFD, descriptorFlags|FD_CLOEXEC) < 0) {
+      close(sockets[0]);
+      close(sockets[1]);
+      return False;
+    }
+  }
+
+#ifdef FD_SETSIZE
+  if (sockets[0] >= (int)FD_SETSIZE || sockets[1] >= (int)FD_SETSIZE) {
+    close(sockets[0]);
+    close(sockets[1]);
+    return False;
+  }
+#endif
+
+  fEventTriggerWakeupSockets[0] = sockets[0];
+  fEventTriggerWakeupSockets[1] = sockets[1];
+  setBackgroundHandling(fEventTriggerWakeupSockets[0], SOCKET_READABLE,
+                        eventTriggerWakeupHandler, this);
+  if (!FD_ISSET(fEventTriggerWakeupSockets[0], &fReadSet)) {
+    closeEventTriggerWakeupChannel();
+    return False;
+  }
+  return True;
+#endif
+}
+
+void BasicTaskScheduler::closeEventTriggerWakeupChannel() {
+#if !defined(__WIN32__) && !defined(_WIN32)
+  if (fEventTriggerWakeupSockets[0] >= 0) {
+    disableBackgroundHandling(fEventTriggerWakeupSockets[0]);
+    close(fEventTriggerWakeupSockets[0]);
+    fEventTriggerWakeupSockets[0] = -1;
+  }
+  if (fEventTriggerWakeupSockets[1] >= 0) {
+    close(fEventTriggerWakeupSockets[1]);
+    fEventTriggerWakeupSockets[1] = -1;
+  }
+#endif
+}
+
+void BasicTaskScheduler::eventTriggerWasSignaled() {
+#if !defined(__WIN32__) && !defined(_WIN32)
+  if (fEventTriggerWakeupSockets[1] < 0) return;
+
+  unsigned char byte = 1;
+  ssize_t result;
+  do {
+#ifdef MSG_NOSIGNAL
+    result = send(fEventTriggerWakeupSockets[1], &byte, 1,
+                  MSG_DONTWAIT|MSG_NOSIGNAL);
+#else
+    result = send(fEventTriggerWakeupSockets[1], &byte, 1, MSG_DONTWAIT);
+#endif
+  } while (result < 0 && errno == EINTR);
+
+  // EAGAIN means that the level-triggered channel remains readable.  The
+  // event loop drains it, dispatches one pending trigger, and rearms it while
+  // any enumerable pending state remains.
+  if (result < 0 && errno != EAGAIN && errno != EWOULDBLOCK) {
+    static char const message[] =
+      "BasicTaskScheduler: event-trigger wakeup channel failed\n";
+    ssize_t ignored = write(STDERR_FILENO, message, sizeof message - 1);
+    (void)ignored;
+  }
+#endif
+}
+
+void BasicTaskScheduler::eventTriggerWakeupHandler(void* clientData, int /*mask*/) {
+  ((BasicTaskScheduler*)clientData)->eventTriggerWakeupHandler();
+}
+
+void BasicTaskScheduler::eventTriggerWakeupHandler() {
+#if !defined(__WIN32__) && !defined(_WIN32)
+  unsigned char byte;
+  for (;;) {
+    ssize_t result = recv(fEventTriggerWakeupSockets[0], &byte, 1, 0);
+    if (result > 0) continue;
+    if (result < 0 && errno == EINTR) continue;
+    if (result < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) break;
+    break;
+  }
+  // Coalesce all queued notifications. SingleStep() dispatches one trigger
+  // and rearms this level-triggered channel if pending state remains.
+#endif
+}
+
+Boolean BasicTaskScheduler::eventTriggersRemainPending() const {
+  if (!fEventTriggersAreBeingUsed) return False;
+  for (unsigned i = 0; i < MAX_NUM_EVENT_TRIGGERS; ++i) {
+#ifndef NO_STD_LIB
+    if (fTriggersAwaitingHandling[i].test()) return True;
+#else
+    if (fTriggersAwaitingHandling[i]) return True;
+#endif
+  }
+  return False;
+}
