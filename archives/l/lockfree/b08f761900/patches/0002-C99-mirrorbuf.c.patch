+/** OHOS: /tmp is a read-only erofs mount; honor TMPDIR when set (E002). */
+static void mirrorbuf_tmpl(char *buf, size_t buflen)
+{
+   const char *tmpdir = getenv("TMPDIR");
+   if (tmpdir == NULL || tmpdir[0] == '\0') {
+      tmpdir = "/tmp";
+   }
+   snprintf(buf, buflen, "%s/SPSC-XXXXXX", tmpdir);
+}
