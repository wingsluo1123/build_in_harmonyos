+# OHOS: dependencies are resolved through Conan.  pkg-config is not
+# available on this host, so every library is located with plain
+# find_path/find_library calls, which search the CMAKE_INCLUDE_PATH /
+# CMAKE_LIBRARY_PATH cache variables injected by the conan recipe.
+# The taglib headers live in <prefix>/include/taglib while the sources
+# include them flat (<taglib.h>), hence PATH_SUFFIXES taglib.
+find_path(LAVC_INCLUDE_DIR libavcodec/avcodec.h REQUIRED)
+find_library(LAVC_LIBRARIES avcodec REQUIRED)
+find_path(LAVF_INCLUDE_DIR libavformat/avformat.h REQUIRED)
+find_library(LAVF_LIBRARIES avformat REQUIRED)
+find_path(LAVR_INCLUDE_DIR libswresample/swresample.h REQUIRED)
+find_library(LAVR_LIBRARIES swresample REQUIRED)
+find_path(LAVU_INCLUDE_DIR libavutil/avutil.h REQUIRED)
+find_library(LAVU_LIBRARIES avutil REQUIRED)
+find_path(LTAG_INCLUDE_DIR taglib.h REQUIRED PATH_SUFFIXES taglib)
+find_library(LTAG_LIBRARIES tag REQUIRED)
+# The ohpcd taglib package is static (libtag.a) and its own zlib
+# (used by ID3v2 frame decompression) must be linked by the final
+# executable.
+find_library(LZ_LIBRARIES z REQUIRED)
 
