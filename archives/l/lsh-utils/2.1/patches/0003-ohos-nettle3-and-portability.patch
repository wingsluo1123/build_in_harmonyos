diff --git a/src/unix_interact.c b/src/unix_interact.c
index e8b66d5..6090aae 100644
--- a/src/unix_interact.c
+++ b/src/unix_interact.c
@@ -30,6 +30,9 @@
 #include <assert.h>
 #include <errno.h>
 
+#include <stdio.h>
+#include <string.h>
+
 #include <signal.h>
 
 #include <fcntl.h>
@@ -167,6 +170,57 @@ do_kill_window_subscriber(struct resource *s)
 
 #define IS_TTY(self) ((self)->tty_fd >= 0)
 
+/* OHOS/musl provides neither a declaration nor an implementation of the
+ * historical getpass(3).  Keep the interactive password prompt working with
+ * a minimal local equivalent: read one line from /dev/tty with echo
+ * switched off, into a static buffer (the classic getpass contract).
+ * The askpass-program path is unaffected. */
+static char *
+lsh_interact_getpass(const char *prompt)
+{
+  static char buffer[256];
+  struct termios old, noecho;
+  FILE *tty;
+  int fd, restore = 0;
+  size_t length;
+
+  tty = fopen("/dev/tty", "r+");
+  if (!tty)
+    return NULL;
+  fd = fileno(tty);
+
+  fputs(prompt, tty);
+  fflush(tty);
+
+  if (tcgetattr(fd, &old) == 0)
+    {
+      noecho = old;
+      noecho.c_lflag &= ~ECHO;
+      if (tcsetattr(fd, TCSAFLUSH, &noecho) == 0)
+	restore = 1;
+    }
+
+  if (!fgets(buffer, sizeof(buffer), tty))
+    {
+      if (restore)
+	tcsetattr(fd, TCSAFLUSH, &old);
+      fputc('\n', tty);
+      fclose(tty);
+      return NULL;
+    }
+
+  if (restore)
+    tcsetattr(fd, TCSAFLUSH, &old);
+  fputc('\n', tty);
+  fclose(tty);
+
+  length = strlen(buffer);
+  if (length > 0 && buffer[length - 1] == '\n')
+    buffer[length - 1] = '\0';
+
+  return buffer;
+}
+
 static int
 unix_is_tty(struct interact *s)
 {
@@ -223,7 +277,7 @@ read_password(struct unix_interact *self,
 	return NULL;
 
       /* NOTE: This function uses a static buffer. */
-      password = getpass(cprompt);
+      password = lsh_interact_getpass(cprompt);
   
       if (!password)
 	return NULL;
