+	while ((pid = waitpid(-1, &script_status, WNOHANG)) != 0) {
 		if(pid == -1) {
 			if(cfg.debug >= 9 && errno != ECHILD)
 				syslog(LOG_ERR, "%s: %s: %d: waitpid failed %s", __FILE__, __FUNCTION__, __LINE__, strerror(errno));
