--- a/forkexec.c
+++ b/forkexec.c
@@ -108,7 +108,10 @@ static void sigchld_hdl(int sig)
 	int script_status;
 	pid_t pid;
 
-	while ((pid = waitpid(WAIT_ANY, &script_status, WNOHANG)) != 0) {
+	/* WAIT_ANY is a BSD/glibc extension ((pid_t)-1); musl and the
