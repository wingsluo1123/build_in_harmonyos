+enum raw_frame_status
+{
+    RAW_FRAME_ERROR = -1,
+    RAW_FRAME_INCOMPLETE = 0,
+    RAW_FRAME_COMPLETE = 1,
+};
+
+static int remaining_timeout_ms(const struct timespec *deadline)
+{
+    struct timespec now;
+    long long milliseconds;
+
+    if (clock_gettime(CLOCK_MONOTONIC, &now) != 0)
+        return -1;
+
+    milliseconds = (deadline->tv_sec - now.tv_sec) * 1000LL;
+    milliseconds += (deadline->tv_nsec - now.tv_nsec) / 1000000LL;
+    if (milliseconds <= 0)
+        return 0;
+    if (milliseconds > INT_MAX)
+        return INT_MAX;
+    return (int) milliseconds;
+}
+
+static enum raw_frame_status raw_frame_length(const unsigned char *buffer,
+                                               size_t length,
+                                               size_t capacity,
+                                               size_t *frame_length)
+{
+    size_t i;
+    size_t digits;
+    size_t payload_length = 0;
+    size_t header_length;
+
+    if (length == 0)
+        return RAW_FRAME_INCOMPLETE;
+
+    if (buffer[0] != '#')
+    {
+        for (i = 0; i < length; i++)
+        {
+            if (buffer[i] == '\n')
+            {
+                *frame_length = i + 1;
+                return RAW_FRAME_COMPLETE;
+            }
+        }
+        return length == capacity ? RAW_FRAME_ERROR : RAW_FRAME_INCOMPLETE;
+    }
+
+    if (length < 2)
+        return RAW_FRAME_INCOMPLETE;
+    if (buffer[1] < '0' || buffer[1] > '9')
+        return RAW_FRAME_ERROR;
+
+    digits = (size_t) (buffer[1] - '0');
+    /* Indefinite blocks cannot be framed on a persistent RAW connection. */
+    if (digits == 0)
+        return RAW_FRAME_ERROR;
+    header_length = 2 + digits;
+    if (length < header_length)
+        return RAW_FRAME_INCOMPLETE;
+
+    for (i = 0; i < digits; i++)
+    {
+        unsigned char c = buffer[2 + i];
+        if (c < '0' || c > '9')
+            return RAW_FRAME_ERROR;
+        if (payload_length > (capacity - (size_t) (c - '0')) / 10)
+            return RAW_FRAME_ERROR;
+        payload_length = payload_length * 10 + (size_t) (c - '0');
+    }
+
+    if (payload_length > capacity - header_length)
+        return RAW_FRAME_ERROR;
+    *frame_length = header_length + payload_length;
+    return length >= *frame_length ? RAW_FRAME_COMPLETE : RAW_FRAME_INCOMPLETE;
+}
+
+static int receive_raw_response(int device, unsigned char *response,
+                                size_t capacity, int timeout)
+{
+    struct timespec deadline;
+    size_t received = 0;
+    size_t frame_length = 0;
+
+    if (timeout <= 0 || clock_gettime(CLOCK_MONOTONIC, &deadline) != 0)
+        return -1;
+    deadline.tv_sec += timeout / 1000;
+    deadline.tv_nsec += (long) (timeout % 1000) * 1000000L;
+    if (deadline.tv_nsec >= 1000000000L)
+    {
+        deadline.tv_sec++;
+        deadline.tv_nsec -= 1000000000L;
+    }
+
+    while (received < capacity)
+    {
+        int remaining = remaining_timeout_ms(&deadline);
+        int chunk;
+        enum raw_frame_status status;
+
+        if (remaining <= 0)
+            return -1;
+        chunk = lxi_receive(device, (char *) (response + received),
+                            (int) (capacity - received), remaining);
+        if (chunk <= 0)
+            return -1;
+        received += (size_t) chunk;
+
+        status = raw_frame_length(response, received, capacity, &frame_length);
+        if (status == RAW_FRAME_ERROR)
+            return -1;
+        if (status == RAW_FRAME_COMPLETE)
+            return frame_length > INT_MAX ? -1 : (int) frame_length;
+    }
+
+    return -1;
+}
