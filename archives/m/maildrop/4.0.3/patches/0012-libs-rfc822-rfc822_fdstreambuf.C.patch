+FILE *rfc822::create_tmpfile()
+{
+	const char *tmpdir=getenv("TMPDIR");
+
+	if (tmpdir && *tmpdir)
+	{
+		std::string s{tmpdir};
+
+		s += "/tmp.XXXXXX";
+
+		int fd=mkstemp(s.data());
+
+		unlink(s.c_str());
+
+		if (fd >= 0)
+		{
+			FILE *fp=::fdopen(fd, "w+b");
+
+			if (fp)
+				return fp;
+			close(fd);
+		}
+	}
+	return ::tmpfile();
+}
+
 rfc822::fdstreambuf rfc822::fdstreambuf::tmpfile()
 {
-	FILE *fp=::tmpfile();
+	FILE *fp=create_tmpfile();
 
 	rfc822::fdstreambuf tmpfilebuf{dup(::fileno(fp))};
 
 	fclose(fp);
 	return tmpfilebuf;
 }
 
