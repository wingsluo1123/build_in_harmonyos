     return &resp_protocol_version;
   if ((r = load_backend(&session.backend, backend_name)) != 0)
     return r;
   session.flags |= session.backend->flags;
   while (*plugins != 0)
     if ((r = load_plugins(*plugins++)) != 0)
       return r;
