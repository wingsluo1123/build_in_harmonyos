 #include <mailutils/iterator.h>
 #include <mailutils/mailbox.h>
 #include <mailutils/mu_auth.h>
 #include <mailutils/errno.h>
 
 /* System database */
+/* HarmonyOS developer shells may have no passwd entry for the process UID.
+   Use an explicit LOGNAME/USER identity when resolving the current account. */
+static struct passwd *
+mu_auth_system_current_user (uid_t uid)
+{
+  static struct passwd pw;
+  const char *name = getenv ("LOGNAME");
+  const char *home = getenv ("HOME");
+
+  if (!name || !*name)
+    name = getenv ("USER");
+  if (!name || !*name || (uid != getuid () && uid != geteuid ()))
+    return NULL;
+
+  memset (&pw, 0, sizeof pw);
+  pw.pw_name = (char *) name;
+  pw.pw_passwd = (char *) "";
+  pw.pw_uid = uid;
+  pw.pw_gid = getegid ();
+  pw.pw_gecos = (char *) name;
+  pw.pw_dir = (char *) (home && *home ? home : ".");
+  pw.pw_shell = (char *) "/bin/sh";
+  return &pw;
+}
+
+
