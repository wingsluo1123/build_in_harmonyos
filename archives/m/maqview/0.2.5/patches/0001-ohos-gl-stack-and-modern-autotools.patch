diff -ruN a/configure.ac b/configure.ac
--- a/configure.ac
+++ b/configure.ac
@@ -1,5 +1,5 @@
 AC_INIT(MAQVIEW, 0.2.5)
-AM_CONFIG_HEADER(config.h)
+AC_CONFIG_HEADERS([config.h])
 AM_INIT_AUTOMAKE
 
 AC_CANONICAL_HOST
@@ -11,10 +11,10 @@
 is_static=0
 case ${prefix} in
