+      1) GLLIBS="-Wl,-Bstatic -lfreeglut-gles -Wl,-Bdynamic -lOSMesa -lglapi -lGLU -lm";;
+	  0) GLLIBS="-lOSMesa -lglapi -lfreeglut-gles -lGLU -lm";;
     esac
 	AC_SUBST([GLLIBS]);;
