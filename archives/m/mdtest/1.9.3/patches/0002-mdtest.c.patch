+static double phase_rate(int enabled, double elapsed, double operations) {
+    double critical_elapsed = elapsed;
+
+    if (!enabled) {
+        return 0;
+    }
+
+    if (barriers) {
+        MPI_Allreduce(&elapsed, &critical_elapsed, 1, MPI_DOUBLE, MPI_MAX,
+                      testcomm);
+    }
+
+    return operations / critical_elapsed;
+}
