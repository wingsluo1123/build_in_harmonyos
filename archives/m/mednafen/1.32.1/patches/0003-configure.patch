+##
+## OHOS aarch64：上游这段会强制 -fno-pic/-fno-pie/-no-pie（注释里的理由是
+## "significant performance overhead"）。但在 OHOS SDK 的 clang 15 + ld.lld + musl
+## libc 上，非 PIC 目标文件对 libc 数据符号（stdout/stderr 等）产生
+## R_AARCH64_LDST64_ABS_LO12_NC，而 copy relocation 的落点只有 4 字节对齐，
+## ld.lld 直接失败：improper alignment for relocation R_AARCH64_LDST64_ABS_LO12_NC。
+## 最小复现：三行 fprintf(stdout,...) 加 -fno-pic -fno-pie -no-pie 链接即复现，
+## 去掉这组开关即通过（本机 clang 15 实测）。
+## 同族先例：archives/d/demumble/1.3.0 的 0001-ohos-keep-pie-on-aarch64.patch
+## （CMake 侧同款处置：OHOS 上保留 SDK 的 PIE/PIC 默认值，其他平台行为不变）。
+##
+case $host in
+  *-ohos*)
+    NOPICPIE_FLAGS=""
+    NOPICPIE_LDFLAGS=""
+    ;;
+esac
 if test "x$NOPICPIE_FLAGS" != "x" || test "x$NOPICPIE_LDFLAGS" != "x"; then
 	{ $as_echo "$as_me:${as_lineno-$LINENO}: checking if compiling and linking works with PIC/PIE-disabling flags" >&5
 $as_echo_n "checking if compiling and linking works with PIC/PIE-disabling flags... " >&6; }
 	ac_save_CFLAGS="$CFLAGS"
 	ac_save_CXXFLAGS="$CXXFLAGS"
 	ac_save_LDFLAGS="$LDFLAGS"
