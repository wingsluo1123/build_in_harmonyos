--- a/GNUmakefile
+++ b/GNUmakefile
@@ -6,23 +6,23 @@
 # *sigh* Those debian folks are really tidy on their licenses.
 
 name=		mg
 
 prefix=		/usr/local
 bindir=		$(prefix)/bin
 libdir=		$(prefix)/lib
 includedir=	$(prefix)/include
 mandir=		$(prefix)/man
 
-PKG_CONFIG=	/usr/bin/pkg-config --silence-errors
-INSTALL=	/usr/bin/install
-STRIP=		/usr/bin/strip
+PKG_CONFIG=	pkg-config --silence-errors
+INSTALL=	install
+STRIP=		strip
 
 UNAME:=		$(shell uname)
 ifeq ($(UNAME),FreeBSD)
   BSD_CPPFLAGS:= -DHAVE_UTIL_H
   BSD_LIBS:=	 -lutil
 else
   BSD_CPPFLAGS:= $(shell $(PKG_CONFIG) --cflags libbsd-overlay) -DHAVE_PTY_H
   BSD_LIBS:=	 $(shell $(PKG_CONFIG) --libs libbsd-overlay) -lutil
 endif
 
