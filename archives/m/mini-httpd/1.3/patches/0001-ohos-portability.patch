+/* getpass is not available on OHOS (musl). Provide a local replacement. */
+static char*
+my_getpass( const char* prompt )
+{
+    static char buf[256];
+    (void) fprintf( stderr, "%s", prompt );
+    if ( fgets( buf, sizeof(buf), stdin ) == NULL )
+	return NULL;
+    buf[strcspn( buf, "\n" )] = '\0';
+    return buf;
+}
