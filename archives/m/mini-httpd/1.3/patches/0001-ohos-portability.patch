--- htpasswd.c	2017-12-14 00:36:22.000000000 +0800
+++ htpasswd.c	2026-08-05 09:59:56.774780155 +0800
@@ -15,6 +15,34 @@
 #include <stdlib.h>
 #include <time.h>
 #include <unistd.h>
+#include <termios.h>
+
+/* getpass is not available on OHOS (musl). Local replacement that
+** suppresses terminal echo via termios when stdin is a TTY. */
+static char*
+my_getpass( const char* prompt )
+{
+    static char buf[256];
+    struct termios tio, saved;
+    int have_tio = 0;
+
+    (void) fprintf( stderr, "%s", prompt );
+    if ( isatty( fileno( stdin ) ) && tcgetattr( fileno( stdin ), &saved ) == 0 )
+	{
+	tio = saved;
+	tio.c_lflag &= ~( ECHO | ECHONL );
+	if ( tcsetattr( fileno( stdin ), TCSAFLUSH, &tio ) == 0 )
+	    have_tio = 1;
+	}
+    if ( fgets( buf, sizeof(buf), stdin ) == NULL )
+	buf[0] = '\0';
+    else
+	buf[strcspn( buf, "\n" )] = '\0';
+    if ( have_tio )
+	(void) tcsetattr( fileno( stdin ), TCSAFLUSH, &saved );
+    (void) fputc( '\n', stderr );
+    return buf;
+}
 
 #define LF 10
 #define CR 13
