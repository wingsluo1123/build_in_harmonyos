+/*
+ * The libc <netinet/if_ether.h> header defines struct ethhdr itself, while
+ * the kernel UAPI <linux/if_ether.h> defines the same struct under the
+ * __UAPI_DEF_ETHHDR switch. glibc's libc-compat header sets that switch to
+ * 0 once the libc header is in use; not every libc does the same, so apply
+ * the guard here to keep a single definition.
+ */
+# ifndef __UAPI_DEF_ETHHDR
+#  define __UAPI_DEF_ETHHDR 0
+# endif
+
 # include <linux/if_tun.h> // TUNSETIFF - Linux tunnel driver
