+/* Some Linux libcs (e.g. the one shipped with HarmonyOS) omit the POSIX
+ * thread cancellation functions. Provide harmless fallbacks so that this
+ * file still links there. */
+#ifndef __GLIBC__
+static inline int pthread_cancel (pthread_t thread)
+{
+	(void)thread;
+	return 0;
+}
+
+static inline int pthread_setcancelstate (int state, int *oldstate)
+{
+	if (oldstate != NULL)
+		*oldstate = (state == PTHREAD_CANCEL_DISABLE)
+			? PTHREAD_CANCEL_ENABLE : PTHREAD_CANCEL_DISABLE;
+	return 0;
+}
