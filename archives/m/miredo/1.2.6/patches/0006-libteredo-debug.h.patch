+# ifdef __linux__
+/* The PTHREAD_CANCEL_* constants are widely available, but the matching
+ * functions are not: some Linux libcs (e.g. the one shipped with HarmonyOS)
+ * omit pthread_cancel(), pthread_setcancelstate() and pthread_testcancel()
+ * altogether, so any program using them fails to link. Provide harmless
+ * fallbacks there; the threads that used to be cancelled stop cooperatively
+ * through their own stop flags instead (see peerlist.c). */
+#  include <pthread.h>
+#  ifndef __GLIBC__
+static inline int pthread_cancel (pthread_t thread)
+{
+	(void)thread;
+	return 0;
+}
+
+static inline int pthread_setcancelstate (int state, int *oldstate)
+{
+	if (oldstate != NULL)
+		*oldstate = (state == PTHREAD_CANCEL_DISABLE)
+			? PTHREAD_CANCEL_ENABLE : PTHREAD_CANCEL_DISABLE;
+	return 0;
+}
+
+static inline void pthread_testcancel (void)
+{
+}
+#  endif
+# endif
