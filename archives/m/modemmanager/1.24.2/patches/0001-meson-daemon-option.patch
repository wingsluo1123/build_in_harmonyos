--- a/meson.build	2026-10-14 22:22:13.741690313 +0800
+++ b/meson.build	2026-10-14 22:22:13.765686719 +0800
@@ -403,6 +403,9 @@
   'VERSION': mm_version,
 }
 
+# ModemManager daemon and mmcli; when disabled, only libmm-glib is built
+enable_daemon = get_option('daemon')
+
 subdir('po')
 subdir('data')
 if get_option('examples')
@@ -419,15 +422,42 @@
 endif
 
 subdir('libmm-glib')
-subdir('src')
-subdir('cli')
+
+if enable_daemon
+  subdir('src')
+  subdir('cli')
+endif
+
+if not enable_daemon
+  # The headers-only ModemManager pkg-config file is normally generated by
+  # src/meson.build; with the daemon disabled libmm-glib.pc still lists it
+  # in its requires, so generate it here instead.
+  pkg.generate(
+    version: mm_version,
+    name: mm_name,
+    description: 'Common headers provided by ModemManager',
+    subdirs: mm_name,
+    variables: 'exec_prefix=${prefix}',
+  )
+endif
 
 if enable_tests
-  subdir('test')
-  subdir('tools/tests')
+  if enable_daemon
+    # The programs under test/ link against internal daemon libraries
+    # declared in src/meson.build (libhelpers, libkerneldevice, libport)
+    # and expect real TTY/udev devices at runtime; tools/tests is the
+    # D-Bus service level suite run through test-wrapper.sh (session bus
+    # + ModemManager stub). Both belong to the daemon side and are only
+    # built when the daemon is enabled; the offline suites (libmm-glib/
+    # tests, libqcdm/tests) do not need any of that.
+    subdir('test')
+    subdir('tools/tests')
+  endif
 endif
 
-subdir('examples/sms-c')
+if enable_daemon
+  subdir('examples/sms-c')
+endif
 
 enable_man = get_option('man')
 if enable_man
--- a/meson_options.txt	2026-10-14 22:22:13.789685157 +0800
+++ b/meson_options.txt	2026-10-14 22:22:13.813684219 +0800
@@ -80,3 +80,5 @@
 option('bash_completion', type: 'boolean', value: true, description: 'install bash completion files')
 
 option('fuzzer', type: 'boolean', value: false, description: 'build fuzzer tests')
+
+option('daemon', type: 'boolean', value: true, description: 'build the ModemManager daemon and the mmcli command line tool')
