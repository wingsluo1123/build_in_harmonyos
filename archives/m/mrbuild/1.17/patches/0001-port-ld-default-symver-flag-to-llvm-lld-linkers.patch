--- a/Makefile.common.footer
+++ b/Makefile.common.footer
@@ -202,8 +202,19 @@
 .PHONY: all
 .DEFAULT_GOAL := all
 
+# Portability (HarmonyOS/LLVM): --default-symver is a GNU ld extension that
+# LLVM lld rejects ("unknown argument"), which breaks the shared-library link
+# on OHOS NDK toolchains. Probe the linker once and keep the flag only when
+# it is accepted.
+SYMVER_PROBE_SRC := .$(PROJECT_NAME)_symver_probe.c
+SYMVER_PROBE_SO  := .$(PROJECT_NAME)_symver_probe.so
+SYMVER_PROBE := $(shell echo "int _symver_probe(void) { return 0; }" > $(SYMVER_PROBE_SRC) && $(CC_LINKER) -Wl,--default-symver -shared -fPIC -o $(SYMVER_PROBE_SO) $(SYMVER_PROBE_SRC) 2>/dev/null && echo yes)
+EXTRA_CLEAN += $(SYMVER_PROBE_SRC) $(SYMVER_PROBE_SO)
+
 ifeq ($(COND_DARWIN),)
-  $(LIB_TARGET_SO_FULL): LDFLAGS += -Wl,--default-symver
+  ifneq ($(SYMVER_PROBE),)
+    $(LIB_TARGET_SO_FULL): LDFLAGS += -Wl,--default-symver
+  endif
 else
   $(LIB_TARGET_SO_FULL): LDFLAGS += -dynamiclib
 endif
