--- /dev/null
+++ b/tests/tcp_queue_test.c
@@ -0,0 +1,258 @@
+#include "qwsvdef.h"
+
+#include "net_tcp_queue.h"
+#include "net_tcp_stream.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/select.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#define QUEUE_SIZE 7000
+#define PREFILL_SIZE 1024
+#define IDLE_PROBES 128
+
+typedef struct scripted_send_s
+{
+	unsigned char output[32];
+	int used;
+	int step;
+} scripted_send_t;
+
+static int scripted_send(int socketnum, const void *buffer, int length,
+	int flags, void *context)
+{
+	scripted_send_t *script = context;
+	int sent;
+
+	(void)socketnum;
+	(void)flags;
+	if (script->step++ == 0)
+	{
+		errno = EINTR;
+		return -1;
+	}
+	if (script->step == 2)
+	{
+		sent = length < 3 ? length : 3;
+		memcpy(script->output + script->used, buffer, sent);
+		script->used += sent;
+		return sent;
+	}
+	if (script->step == 3)
+	{
+		errno = EAGAIN;
+		return -1;
+	}
+	memcpy(script->output + script->used, buffer, length);
+	script->used += length;
+	return length;
+}
+
+static int fatal_send(int socketnum, const void *buffer, int length,
+	int flags, void *context)
+{
+	(void)socketnum;
+	(void)buffer;
+	(void)length;
+	(void)flags;
+	(void)context;
+	errno = EPIPE;
+	return -1;
+}
+
+static int make_nonblocking(int fd)
+{
+	int flags = fcntl(fd, F_GETFL, 0);
+	return flags < 0 ? -1 : fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+}
+
+static int drain_available(int fd, unsigned char *output, int capacity, int *used)
+{
+	for (;;)
+	{
+		int received;
+		if (output && *used == capacity)
+			return 0;
+		received = recv(fd, output ? output + *used : NULL,
+			output ? capacity - *used : PREFILL_SIZE, 0);
+		if (received > 0)
+		{
+			if (output)
+				*used += received;
+			continue;
+		}
+		if (received == 0)
+			return -1;
+		if (errno == EINTR)
+			continue;
+		return (errno == EAGAIN || errno == EWOULDBLOCK) ? 0 : -1;
+	}
+}
+
+int main(void)
+{
+	int sockets[2];
+	int buffer_size = 256;
+	int received = 0;
+	int prefilled = 0;
+	int busy_wakeups = 0;
+	int conditional_wakeups = 0;
+	unsigned char prefill[PREFILL_SIZE];
+	unsigned char expected[QUEUE_SIZE];
+	unsigned char actual[QUEUE_SIZE];
+	svtcpstream_t stream;
+	svtcpstream_t ignored;
+	svtcpstream_t guarded;
+	scripted_send_t script;
+	int i;
+
+	{
+		char queue[] = "abcdefgh";
+		char fatal_queue[] = "fatal";
+		int queue_length = 8;
+		int fatal_length = 5;
+
+		memset(&script, 0, sizeof(script));
+		if (NET_TCP_FlushQueueWithSender(0, queue, &queue_length,
+			scripted_send, &script) != NET_TCP_FLUSH_PENDING ||
+			queue_length != 5 || memcmp(queue, "defgh", 5) != 0 ||
+			script.used != 3 || memcmp(script.output, "abc", 3) != 0)
+			return 1;
+		if (NET_TCP_FlushQueueWithSender(0, queue, &queue_length,
+			scripted_send, &script) != NET_TCP_FLUSH_DRAINED ||
+			queue_length != 0 || script.used != 8 ||
+			memcmp(script.output, "abcdefgh", 8) != 0)
+			return 2;
+		if (NET_TCP_FlushQueueWithSender(0, fatal_queue, &fatal_length,
+			fatal_send, NULL) != NET_TCP_FLUSH_FATAL || fatal_length != 5)
+			return 3;
+	}
+
+	memset(prefill, 0xa5, sizeof(prefill));
+	for (i = 0; i < QUEUE_SIZE; ++i)
+		expected[i] = (unsigned char)((i * 37 + 11) & 0xff);
+	memset(&stream, 0, sizeof(stream));
+	memset(&ignored, 0, sizeof(ignored));
+	memset(&guarded, 0, sizeof(guarded));
+	stream.outlen = QUEUE_SIZE;
+	memcpy(stream.outbuffer, expected, sizeof(expected));
+	stream.next = &ignored;
+	ignored.socketnum = INVALID_SOCKET;
+	ignored.outlen = 1;
+	guarded.socketnum = FD_SETSIZE;
+	guarded.outlen = 1;
+	ignored.next = &guarded;
+
+	{
+		fd_set guarded_fds;
+		int guarded_maxfd = 0;
+		FD_ZERO(&guarded_fds);
+		if (NET_TCP_AddStreamWriteInterests(&ignored, &guarded_fds,
+			&guarded_maxfd) != -1 || !guarded.drop || guarded_maxfd != 0)
+			return 4;
+	}
+
+	if (socketpair(AF_UNIX, SOCK_STREAM, 0, sockets) != 0 ||
+		make_nonblocking(sockets[0]) != 0 || make_nonblocking(sockets[1]) != 0)
+		return 5;
+	stream.socketnum = sockets[0];
+	setsockopt(sockets[0], SOL_SOCKET, SO_SNDBUF, &buffer_size, sizeof(buffer_size));
+	setsockopt(sockets[1], SOL_SOCKET, SO_RCVBUF, &buffer_size, sizeof(buffer_size));
+
+	for (;;)
+	{
+		int sent = send(sockets[0], prefill, sizeof(prefill), 0);
+		if (sent > 0)
+		{
+			prefilled += sent;
+			continue;
+		}
+		if (sent < 0 && errno == EINTR)
+			continue;
+		if (sent < 0 && (errno == EAGAIN || errno == EWOULDBLOCK))
+			break;
+		return 6;
+	}
+
+	/* Arm A: one optimistic flush preserves the tail but has no liveness trigger. */
+	if (NET_TCP_FlushQueue(stream.socketnum, stream.outbuffer, &stream.outlen) != NET_TCP_FLUSH_PENDING ||
+		stream.outlen != QUEUE_SIZE)
+		return 7;
+	while (prefilled > 0)
+	{
+		unsigned char scratch[PREFILL_SIZE];
+		int got = recv(sockets[1], scratch,
+			prefilled < (int)sizeof(scratch) ? prefilled : (int)sizeof(scratch), 0);
+		if (got > 0)
+		{
+			prefilled -= got;
+			continue;
+		}
+		if (got < 0 && errno == EINTR)
+			continue;
+		return 8;
+	}
+	{
+		fd_set readfds;
+		struct timeval delay = {0, 100000};
+		FD_ZERO(&readfds);
+		FD_SET(sockets[1], &readfds);
+		if (select(sockets[1] + 1, &readfds, NULL, NULL, &delay) != 0)
+			return 9;
+	}
+
+	/* Arm C: monitor writability only while bytes are queued. */
+	while (stream.outlen > 0)
+	{
+		fd_set writefds;
+		int maxfd = 0;
+		struct timeval delay = {1, 0};
+		FD_ZERO(&writefds);
+		if (NET_TCP_AddStreamWriteInterests(&stream, &writefds, &maxfd) != 1 ||
+			maxfd != stream.socketnum || !FD_ISSET(stream.socketnum, &writefds) ||
+			select(maxfd + 1, NULL, &writefds, NULL, &delay) != 1)
+			return 10;
+		if (NET_TCP_FlushReadyStreams(&stream, &writefds) != 0 || stream.drop)
+			return 11;
+		if (drain_available(sockets[1], actual, sizeof(actual), &received) != 0)
+			return 12;
+	}
+	if (drain_available(sockets[1], actual, sizeof(actual), &received) != 0 ||
+		received != QUEUE_SIZE || memcmp(actual, expected, QUEUE_SIZE) != 0)
+		return 13;
+
+	/* Arm B: unconditional POLLOUT subscription continuously wakes an idle loop. */
+	for (i = 0; i < IDLE_PROBES; ++i)
+	{
+		fd_set writefds;
+		struct timeval immediate = {0, 0};
+		FD_ZERO(&writefds);
+		FD_SET(sockets[0], &writefds);
+		if (select(sockets[0] + 1, NULL, &writefds, NULL, &immediate) == 1)
+			++busy_wakeups;
+	}
+	for (i = 0; i < IDLE_PROBES; ++i)
+	{
+		fd_set writefds;
+		int maxfd = 0;
+		struct timeval immediate = {0, 0};
+		FD_ZERO(&writefds);
+		if (NET_TCP_AddStreamWriteInterests(&stream, &writefds, &maxfd) != 0 ||
+			select(maxfd + 1, NULL, &writefds, NULL, &immediate) != 0)
+			++conditional_wakeups;
+	}
+	if (busy_wakeups != IDLE_PROBES || conditional_wakeups != 0)
+		return 14;
+
+	close(sockets[0]);
+	close(sockets[1]);
+	printf("tcp queue arms: scripted_short_write=1 scripted_eintr=1 scripted_eagain=1 "
+		"scripted_fatal=1 fd_guard=1 original_stalled=1 false_fix_wakeups=%d "
+		"fixed_bytes=%d idle_wakeups=%d\n", busy_wakeups, received,
+		conditional_wakeups);
+	return 0;
+}
