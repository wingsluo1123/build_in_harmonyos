 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
 #include <sys/stat.h>
 
+const char *test_tmpdir(void) {
+    static sds tmpdir = NULL;
+
+    if (tmpdir == NULL) {
+        const char *env = getenv("TMPDIR");
+        if (env != NULL && env[0] != '\0') {
+            tmpdir = sdscatfmt(sdsempty(), "%s/mympd-test", env);
+        }
+        else {
+            tmpdir = sdsnew("/tmp/mympd-test");
+        }
+    }
+
+    return tmpdir;
+}
+
+sds test_tmpfile(const char *suffix) {
+    return sdscatfmt(sdsempty(), "%s%s", test_tmpdir(), suffix);
+}
