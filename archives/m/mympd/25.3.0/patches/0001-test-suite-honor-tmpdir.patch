+    mkdir(path, 0770);
+    sdsclear(path);
+    path = sdscatfmt(path, "%s/state", tmpdir);
+    mkdir(path, 0770);
+    sdsclear(path);
+    path = sdscatfmt(path, "%s/state/default", tmpdir);
+    mkdir(path, 0770);
+    sdsclear(path);
+    path = sdscatfmt(path, "%s/webradios", tmpdir);
+    mkdir(path, 0770);
+    sdsfree(path);
     unsetenv("TESTVAR");
 }
 
+// nftw callback: remove every entry, depth first
+static int clean_testenv_cb(const char *fpath, const struct stat *sb, int typeflag, struct FTW *ftwbuf) {
+    (void)sb;
+    (void)typeflag;
+    (void)ftwbuf;
+    return remove(fpath);
+}
+
 void clean_testenv(void) {
-    if (system("rm -rf /tmp/mympd-test") != 0) {
-        printf("Failure cleaning /tmp/mympd-test\n");
+    // The scratch directory follows TMPDIR; removing the tree in-process
+    // avoids depending on an external rm and shell
+    if (nftw(test_tmpdir(), clean_testenv_cb, 64, FTW_DEPTH | FTW_PHYS) == -1 &&
+        errno != ENOENT)
+    {
+        printf("Failure cleaning %s\n", test_tmpdir());
     }
     unsetenv("TESTVAR");
 }
 
