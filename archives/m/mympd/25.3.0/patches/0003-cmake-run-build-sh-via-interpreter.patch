--- a/CMakeLists.txt	2026-10-11 03:19:46.310879900 +0800
+++ b/CMakeLists.txt	2026-10-11 03:51:11.811306600 +0800
@@ -89,6 +89,14 @@
 # custom cmake modules
 set(CMAKE_MODULE_PATH ${CMAKE_MODULE_PATH} "${PROJECT_SOURCE_DIR}/cmake/")
 
+# OHOS/portability: build.sh must be invoked through a shell
+# interpreter -- direct execution of script files is rejected on
+# platforms without binfmt_script support.
+find_program(MYMPD_SHELL_EXECUTABLE NAMES bash sh)
+if(NOT MYMPD_SHELL_EXECUTABLE)
+  message(FATAL_ERROR "Could not find a bash/sh interpreter to run build.sh")
+endif()
+
 # required dependencies
 find_library(MATH_LIB m REQUIRED)
 find_package(Threads REQUIRED)
@@ -215,7 +223,7 @@
