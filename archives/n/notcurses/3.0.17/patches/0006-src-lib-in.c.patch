 int stop_inputlayer(tinfo* ti){
   int ret = 0;
   if(ti){
     // FIXME cancellation on shutdown does not yet work on windows #2192
 #ifndef __MINGW32__
     if(ti->ictx){
       loginfo("tearing down input thread");
+#ifdef __OHOS__
+      // OHOS: pthread_cancel 被禁用，detach 代替 cancel_and_join
+      pthread_detach(ti->ictx->tid);
+#else
       ret |= cancel_and_join("input", ti->ictx->tid, NULL);
       ret |= set_fd_nonblocking(ti->ictx->stdinfd, ti->stdio_blocking_save, NULL);
       free_inputctx(ti->ictx);
+#endif
       ti->ictx = NULL;
     }
 #endif
   }
   return ret;
 }
+
+#ifdef __OHOS__
+// OHOS: Clear initdata so input thread processes keyboard input normally.
+// Called after skipping handle_responses (no queries were sent).
+void inputlayer_clear_initdata(inputctx* ictx){
+  if(ictx){
+    pthread_mutex_lock(&ictx->ilock);
+    if(ictx->initdata){
+      free(ictx->initdata);
+      ictx->initdata = NULL;
+      ictx->coutstanding = 0;
+    }
+    pthread_mutex_unlock(&ictx->ilock);
+    pthread_cond_broadcast(&ictx->icond);
+    loginfo("OHOS: cleared initdata, input thread ready for normal input");
+  }
+}
+#endif
 
 int inputready_fd(const inputctx* ictx){
 #ifndef __MINGW32__
   return ictx->readypipes[0];
 #else
   (void)ictx;
   logerror("readiness descriptor unavailable on windows");
   return -1;
 #endif
 }
