--- a/odb-2.4.0/config/config.guess
+++ b/odb-2.4.0/config/config.guess
@@ -883,6 +883,26 @@
     i*86:Minix:*:*)
 	echo ${UNAME_MACHINE}-pc-minix
 	exit ;;
+    *:HarmonyOS:*:*)
+		case "$UNAME_MACHINE" in
+		    aarch64|arm64)
+			MACHINE=aarch64
+			;;
+		    armv7*|armv8*)
+			MACHINE=arm
+			;;
+		    x86_64|amd64)
+			MACHINE=x86_64
+			;;
+		    i?86)
+			MACHINE=i686
+			;;
+		    *)
+			MACHINE="$UNAME_MACHINE"
+			;;
+		esac
+		GUESS=${MACHINE}-unknown-linux-ohos
+		;;
     aarch64:Linux:*:*)
 	echo ${UNAME_MACHINE}-unknown-linux-${LIBC}
 	exit ;;

