+	/*
+	 * Some systems mount /tmp read-only (e.g. HarmonyOS), where the
+	 * compiled-in template is not writable.  Try $TMPDIR, then the
+	 * compiled-in directory, then $HOME so that ed stays usable there.
+	 * On systems with a writable /tmp the first attempt succeeds and
+	 * behaviour is unchanged.
+	 */
+	tmpdir = getenv("TMPDIR");
+	home = getenv("HOME");
+	if (tmpdir != NULL && *tmpdir != '\0')
+		dirs[ndirs++] = tmpdir;
+	dirs[ndirs++] = SCRATCH_DIR;
+	if (home != NULL && *home != '\0')
+		dirs[ndirs++] = home;
+	for (i = 0; i < ndirs; i++) {
+		if (strlen(dirs[i]) + 1 + strlen(SCRATCH_NAME) >= sizeof sfn)
+			continue;
+		snprintf(sfn, sizeof sfn, "%s/%s", dirs[i], SCRATCH_NAME);
+		if ((fd = mkstemp(sfn)) != -1)
+			break;
+	}
+	if (fd == -1)
+		strlcpy(sfn, SCRATCH_TEMPLATE, sizeof sfn);
+	if (fd == -1 ||
 	    (sfp = fdopen(fd, "w+")) == NULL) {
 		if (fd != -1)
 			close(fd);
 		perror(sfn);
 		seterrmsg("cannot open temp file");
 		return ERR;
 	}
 	return 0;
 }
 
