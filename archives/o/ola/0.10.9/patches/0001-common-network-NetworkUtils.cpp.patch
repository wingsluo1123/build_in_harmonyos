+    // before constructing. __builtin_bswap32 is a clang builtin (no
+    // libc dependency); ntohl() cannot be used here because it is a
+    // no-op stub on OHOS bionic libc.so.
+    *default_gateway = IPV4Address(
+        static_cast<in_addr_t>(__builtin_bswap32(gateway)));
+    *if_index = Interface::DEFAULT_INDEX;  // resolved by caller if needed
