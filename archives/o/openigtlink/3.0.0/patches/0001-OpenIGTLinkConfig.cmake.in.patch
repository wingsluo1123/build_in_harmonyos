--- a/OpenIGTLinkConfig.cmake.in
+++ b/OpenIGTLinkConfig.cmake.in
@@ -41,11 +41,17 @@
 
 # Path to CableSwig configuration used by OpenIGTLink.
 SET(OpenIGTLink_CableSwig_DIR "@OpenIGTLink_CableSwig_DIR_CONFIG@")
 
 # A list of all libraries for OpenIGTLink.  Those listed here should
 # automatically pull in their dependencies.
 SET(OpenIGTLink_LIBRARIES OpenIGTLink)
 
 # The OpenIGTLink library targets.
 SET(OpenIGTLink_LIBRARY_TARGETS_FILE "@OpenIGTLink_LIBRARY_TARGETS_FILE@")
-include(${OpenIGTLink_LIBRARY_TARGETS_FILE})
+# Import the targets file only when OpenIGTLink is not already a target in this
+# build tree: including a file produced by export() is rejected since CMake
+# policy CMP0024 (in-tree the exported targets file is not includable; the
+# installed install(EXPORT)-generated file still is).
+if(NOT TARGET OpenIGTLink)
+  include(${OpenIGTLink_LIBRARY_TARGETS_FILE})
+endif()
