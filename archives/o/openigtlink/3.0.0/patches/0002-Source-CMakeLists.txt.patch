 SET(OpenIGTLink_INCLUDE_FILES)
-IF( MSVC OR ${CMAKE_GENERATOR} MATCHES "Xcode" )
+# Upstream only collected the public header list for the MSVC and Xcode
+# generators, so on POSIX systems (Linux, OpenHarmony/HarmonyOS) the installed
+# package carried no library headers at all and could not be consumed:
+# INSTALL(FILES ${OpenIGTLink_INCLUDE_FILES}) below then installed nothing.
+# The headers are plain C/C++ declarations, they are the same on every
+# generator, and the in-tree build already exposes Source/ and Source/igtlutil/
+# as include dirs, so collect them unconditionally.
+IF(TRUE)
   LIST(APPEND OpenIGTLink_INCLUDE_FILES
