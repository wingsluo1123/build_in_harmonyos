+
+#ifdef __OHOS__
+/* HarmonyOS doesn't have fgetpwent - provide a simple implementation */
+struct passwd *fgetpwent(FILE *fp)
+{
+	static char line[1024];
+	static struct passwd pw;
+
+	if (fgets(line, sizeof(line), fp) == NULL)
+		return NULL;
+
+	char *nl = strchr(line, '\n');
+	if (nl) *nl = '\0';
+
+	char *saveptr;
+	char *tok = strtok_r(line, ":", &saveptr);
+	char *fields[7];
+	int n = 0;
+	while (tok && n < 7) {
+		fields[n++] = tok;
+		tok = strtok_r(NULL, ":", &saveptr);
+	}
+	if (n < 7)
+		return NULL;
+
+	pw.pw_name = fields[0];
+	pw.pw_passwd = fields[1];
+	pw.pw_uid = (uid_t)strtoul(fields[2], NULL, 10);
+	pw.pw_gid = (gid_t)strtoul(fields[3], NULL, 10);
+	pw.pw_gecos = fields[4];
+	pw.pw_dir = fields[5];
+	pw.pw_shell = fields[6];
+
+	return &pw;
+}
 #endif
 
 #include "_seap.h"
