diff --git a/cmake/dependencies/CMakeLists.txt b/cmake/dependencies/CMakeLists.txt
index 6621130..9b378f9 100644
--- a/cmake/dependencies/CMakeLists.txt
+++ b/cmake/dependencies/CMakeLists.txt
@@ -579,6 +579,14 @@ if(BUILD_protobuf_matchers)
     "${CMAKE_CURRENT_LIST_DIR}/../../patches/protobuf-matchers-v0.1.1.patch"
     SYSTEM
   )
+  # Build protobuf-matchers statically: upstream forces BUILD_SHARED_LIBS ON
+  # for all FetchContent deps (cmake/dependencies.cmake), which produces a
+  # libprotobuf-matchers.so with a path-bearing DT_NEEDED (../../bin/...) that
+  # the HarmonyOS loader resolves against the CWD (verified: fails when the
+  # process CWD is not the layout the relative path assumes). A static library
+  # removes the runtime .so loading entirely, so the 175+ upstream ctest
+  # binaries run correctly regardless of the consumer CWD.
+  set(BUILD_SHARED_LIBS OFF)
   FetchContent_MakeAvailable(protobuf-matchers)
   list(POP_BACK CMAKE_MESSAGE_INDENT)
   message(CHECK_PASS "fetched")
