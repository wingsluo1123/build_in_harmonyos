--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -195,6 +195,21 @@
 add_subdirectory(include)
 add_subdirectory(src)
 if(ENABLE_UNIT_TESTS)
+	# CMakeDeps exports the public library only, but the published package
+	# also ships this real tester archive and its headers.
+	if(NOT TARGET bctoolbox-tester)
+		find_package(bcunit CONFIG REQUIRED)
+		add_library(bctoolbox-tester UNKNOWN IMPORTED)
+		set_target_properties(bctoolbox-tester PROPERTIES
+			IMPORTED_LOCATION "${BCTOOLBOX_TESTER_LIBRARY}"
+			INTERFACE_INCLUDE_DIRECTORIES "${BCTOOLBOX_TESTER_INCLUDE_DIRS}"
+			INTERFACE_LINK_LIBRARIES "bctoolbox;bcunit::bcunit")
+	endif()
+	if(NOT COMMAND bc_apply_compile_flags)
+		# Same advisory-flags fallback as src/ with ENABLE_STRICT=OFF.
+		macro(bc_apply_compile_flags)
+		endmacro()
+	endif()
 	add_subdirectory(tester)
 endif()
 
