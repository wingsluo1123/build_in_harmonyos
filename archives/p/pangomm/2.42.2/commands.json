{
  "name": "pangomm",
  "version": "2.42.2",
  "description": "C++ bindings for Pango（pangomm-1.4 旧 ABI 线，2.42 老线补位，gtkmm 老版本线前置）",
  "homepage": "https://gitlab.gnome.org/GNOME/pangomm",
  "upstream_repo": "https://gitlab.gnome.org/GNOME/pangomm",
  "license": "LGPL-2.1-or-later",
  "type": "library",
  "build_system": "meson",
  "cxx_standard": 11,
  "dependencies": {
    "glibmm": "2.66.9",
    "cairomm": "1.14.5.1",
    "pango": "1.50.14.1.1",
    "libsigc": "2.12.1 (override)"
  },
  "build_options": {
    "default_library": "shared",
    "maintainer-mode": "false",
    "build-documentation": "false",
    "wrap_mode": "nodownload"
  },
  "commands": {
    "conan_create": {
      "description": "Build and package pangomm 2.42.2 for OHOS aarch64",
      "command": "conan create archives/p/pangomm/2.42.2 -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing",
      "env": [
        "export PATH=/storage/Users/currentUser/usr/local/bin:/data/service/hnp/bin:$PATH",
        "export TMPDIR=$HOME/tmp"
      ],
      "cwd": "/storage/Users/currentUser/huawei/build_in_harmonyos"
    }
  },
  "patches": {
    "count": 0,
    "type": "none",
    "directory": ""
  },
  "test_package": {
    "assertion_count": 18,
    "upstream_test_in_build": false,
    "upstream_cases": 0,
    "test_binaries": ["test_probe", "test_ohos_probe"]
  }
}
