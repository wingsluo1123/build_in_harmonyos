+/* vring_need_event() is missing from sysroot's linux/virtio_ring.h.
+ * Copied from upstream kernel header (include/uapi/linux/virtio_ring.h). */
+static inline bool vring_need_event(uint16_t event_idx, uint16_t new_idx,
+				   uint16_t old_idx)
+{
+	return (uint16_t)(new_idx - event_idx - 1) < (uint16_t)(new_idx - old_idx);
+}
