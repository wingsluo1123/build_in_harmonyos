--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -22,7 +22,26 @@
 set(QT_MINIMUM_VERSION "6.6.0")

-find_package(Qt6 ${QT_MINIMUM_VERSION} COMPONENTS REQUIRED Widgets LinguistTools)
+find_package(Qt6 ${QT_MINIMUM_VERSION} COMPONENTS REQUIRED Widgets)
+find_package(Qt6 ${QT_MINIMUM_VERSION} COMPONENTS LinguistTools)
+if(NOT Qt6LinguistTools_FOUND)
+    message(STATUS "Qt6 LinguistTools not found - translations will be skipped")
+    function(lxqt_translate_ts _var)
+        set(${_var} "" PARENT_SCOPE)
+    endfunction()
+    function(lxqt_translate_desktop _var)
+        set(_sources "")
+        set(_collect FALSE)
+        foreach(_arg ${ARGN})
+            if(_arg STREQUAL "SOURCES")
+                set(_collect TRUE)
+            elseif(_collect)
+                set(_sources ${_sources} ${_arg})
+            endif()
+        endforeach()
+        foreach(_src ${_sources})
+            get_filename_component(_name ${_src} NAME_WE)
+            set(_dest ${CMAKE_CURRENT_BINARY_DIR}/${_name})
+            configure_file(${_src} ${_dest} COPYONLY)
+            set(${_var} ${${_var}} ${_dest} PARENT_SCOPE)
+        endforeach()
+    endfunction()
+endif()
 find_package(lxqt2-build-tools ${LXQTBT_MINIMUM_VERSION} REQUIRED)
