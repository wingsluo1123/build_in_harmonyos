 find_package(OpenSSL REQUIRED)
+# Workaround: Conan's openssl package provides openssl::openssl but not OpenSSL::SSL/OpenSSL::Crypto
+if(TARGET openssl::openssl AND NOT TARGET OpenSSL::SSL)
+    add_library(OpenSSL::SSL INTERFACE IMPORTED)
+    target_link_libraries(OpenSSL::SSL INTERFACE openssl::openssl)
+    add_library(OpenSSL::Crypto INTERFACE IMPORTED)
+    target_link_libraries(OpenSSL::Crypto INTERFACE openssl::openssl)
+endif()
 find_package(ZLIB REQUIRED)
 find_package(Freetype REQUIRED)
+# Workaround: Conan's freetype provides freetype::freetype but not Freetype::Freetype
+if(TARGET freetype::freetype AND NOT TARGET Freetype::Freetype)
+    add_library(Freetype::Freetype INTERFACE IMPORTED)
+    target_link_libraries(Freetype::Freetype INTERFACE freetype::freetype)
+endif()
 find_package(OpenJPEG CONFIG REQUIRED)
+# Workaround: Conan's OpenJPEG provides OPENJPEG::OpenJPEG but pdf4qt uses openjp2 library name
+if(TARGET OPENJPEG::OpenJPEG AND NOT TARGET openjp2)
+    add_library(openjp2 INTERFACE IMPORTED)
+    target_link_libraries(openjp2 INTERFACE OPENJPEG::OpenJPEG)
+endif()
 find_package(JPEG REQUIRED)
+# Workaround: Conan's libjpeg provides libjpeg::libjpeg but not JPEG::JPEG
+if(TARGET libjpeg::libjpeg AND NOT TARGET JPEG::JPEG)
+    add_library(JPEG::JPEG INTERFACE IMPORTED)
+    target_link_libraries(JPEG::JPEG INTERFACE libjpeg::libjpeg)
+endif()
