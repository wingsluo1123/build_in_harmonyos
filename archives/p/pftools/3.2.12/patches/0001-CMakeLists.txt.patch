 #########################################################################################
 # CMAKE
 #
 CMAKE_MINIMUM_REQUIRED(VERSION 3.7)
 PROJECT(PFTOOLS Fortran C)
 IF(COMMAND cmake_policy)
 	CMAKE_POLICY(SET CMP0003 NEW)
 ENDIF(COMMAND cmake_policy)
 SET(CMAKE_MODULE_PATH ${PFTOOLS_SOURCE_DIR}/cmake)
+
+#########################################################################################
+# Portable SIMD shim for non-x86 targets
+#
+# The pftoolsV3 alignment kernels (src/C/sse2, src/C/sse41) are written against the
+# x86 SSE2 / SSE4.1 intrinsics and <emmintrin.h> / <smmintrin.h> are x86-only headers.
+# On targets without SSE (e.g. AArch64) the headers in src/C/simd/ redirect those
+# includes to sse2neon.h, an SSE->NEON translation layer (MIT), so the very same
+# kernels can be compiled for ARM NEON.
+#
+IF(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64|i686|i386|X86)$")
+  SET(PFTOOLS_SIMD_SHIM OFF)
+ELSE(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64|i686|i386|X86)$")
+  SET(PFTOOLS_SIMD_SHIM ON)
+ENDIF(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64|i686|i386|X86)$")
+
+IF(PFTOOLS_SIMD_SHIM)
+  MESSAGE(STATUS "Non-x86 architecture (${CMAKE_SYSTEM_PROCESSOR}): using portable SIMD shim (sse2neon)")
+  INCLUDE_DIRECTORIES(${PFTOOLS_SOURCE_DIR}/src/C/simd)
+  LIST(APPEND CMAKE_REQUIRED_INCLUDES ${PFTOOLS_SOURCE_DIR}/src/C/simd)
+  SET(HAVE_MM_MALLOC_H 1)
+ENDIF(PFTOOLS_SIMD_SHIM)
 
 #########################################################################################
 # Architectures
 #
 INCLUDE(CMakeDetermineSystem)
 #INCLUDE(CMakePrintSystemInformation)
 IF(CMAKE_SYSTEM_PROCESSOR)
 	MESSAGE(STATUS "Compilation on architecture ${CMAKE_SYSTEM_PROCESSOR}.")
 ENDIF(CMAKE_SYSTEM_PROCESSOR)
 
@@ -86,20 +108,29 @@
 	CHECK_C_COMPILER_FLAG("${flag}" HANDLE_SSE41)
