 ENDIF(NOT DEFINED CMAKE_C_SSE41_FLAGS)
 
+# On non-x86 targets the SSE flag probe above only emits "argument unused" warnings
+# (clang accepts -msse / -msse2 / -msse4.1 for any target). Drop the flags so that the
+# portable SIMD shim supplied through src/C/simd/ is used instead of x86 code paths.
+IF(PFTOOLS_SIMD_SHIM)
+	SET(CMAKE_C_SSE_FLAGS "")
+	SET(CMAKE_C_SSE2_FLAGS "")
+	SET(CMAKE_C_SSE41_FLAGS "")
+ENDIF(PFTOOLS_SIMD_SHIM)
+
 CHECK_C_COMPILER_FLAG("-std=c99" HANDLE_C99)
