 extern __inline __m128 __ALWAYS_INLINE
 _my_insert_ss_ps_POS1(__m128 __A, const __m128 __B)
 {
   __m128 __y = _mm_unpacklo_ps(__A, __B);
   __A        = (__m128) _mm_move_sd ((__m128d)__A, (__m128d) __y);
   return __A;
 }
 
