--- a/cmake/FindTHREAD.cmake	2026-08-08 00:40:38.450614999 +0800
+++ b/cmake/FindTHREAD.cmake	2026-08-08 00:40:38.486616718 +0800
@@ -2,14 +2,26 @@
 # pthread support
 #
 
+# HarmonyOS: dynamically find OHOS SDK sysroot paths
+if(${CMAKE_SYSTEM_NAME} STREQUAL "HarmonyOS")
+  file(GLOB _OHOS_SYSROOT_LIBS "/data/service/hnp/ohos-sdk.org/*/ohos/native/sysroot/usr/lib/aarch64-linux-ohos")
+  file(GLOB _OHOS_SYSROOT_INCS "/data/service/hnp/ohos-sdk.org/*/ohos/native/sysroot/usr/include")
+endif()
+
 find_path(THREAD_INCLUDE_DIR
   NAMES
     pthread.h
+  HINTS
+    ${_OHOS_SYSROOT_INCS}
+    /usr/local/include
+    /opt/local/include
+    /usr/include
 )
 find_library(THREAD_LIBRARY
   NAMES
     pthread pthread.so.0 libpthread.so.0
   HINTS
+    ${_OHOS_SYSROOT_LIBS}
     /usr/local/lib64
     /usr/local/lib
     /opt/local/lib64
