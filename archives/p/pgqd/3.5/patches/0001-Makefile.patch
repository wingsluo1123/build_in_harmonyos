--- a/Makefile
+++ b/Makefile
@@ -1,20 +1,28 @@
 
 -include config.mak
 
 PG_CONFIG ?= pg_config
 PG_INCDIR = $(shell $(PG_CONFIG) --includedir)
 PG_LIBDIR = $(shell $(PG_CONFIG) --libdir)
 RST2MAN = rst2man
 
 bin_PROGRAMS = pgqd
+
+# The bundled man page is rendered from README.rst with rst2man (docutils).
+# OpenHarmony ships no python3-docutils, so degrade gracefully instead of
+# failing the build; behaviour is unchanged wherever rst2man is present.
+ifneq ($(shell command -v $(RST2MAN) 2>/dev/null),)
 man_MANS = pgqd.1
+else
+man_MANS =
+endif
 
 pgqd_SOURCES = src/pgqd.c src/maint.c src/ticker.c src/retry.c \
 	       src/pgsocket.c src/pgsocket.h \
 	       src/pgqd.h
 nodist_pgqd_SOURCES = pgqd.ini.h
 pgqd_CPPFLAGS = -I$(PG_INCDIR) -Isrc -I.
 pgqd_LDFLAGS = -L$(PG_LIBDIR)
 pgqd_LIBS = -lpq -lm
 
 pgqd_EMBED_LIBUSUAL = 1
