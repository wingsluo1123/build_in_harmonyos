     def _compare_value(self, v1, v2):
+        # Pillow >= 6 returns rational EXIF values (and nested rational
+        # tuples) as IFDRational objects, while upstream requirements.txt
+        # pins Pillow 4.2.1, which returned plain (numerator, denominator)
+        # tuples.  Normalize IFDRational back to tuples so the original
+        # assertions keep their exact semantics under the Pillow build
+        # available for OHOS.
+        def normalize(v):
+            if hasattr(v, "numerator") and hasattr(v, "denominator") \
+                    and not isinstance(v, int):
+                return (v.numerator, v.denominator)
+            if isinstance(v, tuple):
+                return tuple(normalize(x) for x in v)
+            return v
+        v1 = normalize(v1)
+        v2 = normalize(v2)
