--- a/libpkgconf/meson.build
+++ b/libpkgconf/meson.build
@@ -1,3 +1,10 @@
+# OHOS musl provides these BSD functions but meson cross-check fails
+# due to cross-compilation, causing bsdstubs.c to redefine them as static
+cdata.set('HAVE_STRLCAT', 1)
+cdata.set('HAVE_DECL_STRLCAT', 1)
+cdata.set('HAVE_STRLCPY', 1)
+cdata.set('HAVE_DECL_STRLCPY', 1)
+cdata.set('HAVE_STRNDUP', 1)
+cdata.set('HAVE_DECL_STRNDUP', 1)
+
 configure_file(input : 'config.h.meson',
   output : 'config.h',
   configuration : cdata)
