diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9aca4f2..8a87ffa 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -40,7 +40,13 @@ if (debug)
     set (LIBRARY_COMPILE_DEFINITIONS  "${LIBRARY_COMPILE_DEFINITIONS} -g -p")
     message("-- COMPILATION IN DEBUG MODE")
 else()
-    set (LIBRARY_COMPILE_DEFINITIONS  "${LIBRARY_COMPILE_DEFINITIONS} -O3 -funroll-loops  -fomit-frame-pointer  -msse3 ")
+    set (LIBRARY_COMPILE_DEFINITIONS  "${LIBRARY_COMPILE_DEFINITIONS} -O3 -funroll-loops  -fomit-frame-pointer")
+    # -msse3 is an x86 only flag. Other targets get the SSE kernels through the
+    # SIMDe translation headers (see src/algo/hits/.../*.cpp), so no ISA flag is
+    # needed there and passing one would break the compiler invocation.
+    if (CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64|i[3-6]86)$")
+        set (LIBRARY_COMPILE_DEFINITIONS "${LIBRARY_COMPILE_DEFINITIONS} -msse3")
+    endif()
 #  -DOBSFUCATION  -DJNI_OBSFUCATION
 endif()
 
