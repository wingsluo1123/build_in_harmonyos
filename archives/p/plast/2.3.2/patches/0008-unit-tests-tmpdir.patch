diff --git a/test/unit/src/cppunit.h b/test/unit/src/cppunit.h
index 2cbbe27..92fe7c7 100644
--- a/test/unit/src/cppunit.h
+++ b/test/unit/src/cppunit.h
@@ -31,5 +31,30 @@ using namespace CppUnit;
 #include <stdio.h>
 #define TRACE(format, args...)   //printf ("[%s] ", __PRETTY_FUNCTION__);  printf (format, args)
 
+#include <stdlib.h>
+#include <string>
+
+/** Builds the path of a file living in the process temporary directory.
+ *
+ *  The tests below need a writable directory for the files they produce.  They
+ *  used to hard code "/tmp"; on platforms where /tmp is mounted read only
+ *  (HarmonyOS for instance) the writable directory has to be provided through
+ *  the TMPDIR environment variable instead.
+ */
+static inline std::string plastTmpPath (const char* name)
+{
+    const char* dir = getenv ("TMPDIR");
+    if (dir == 0 || dir[0] == 0)  {  dir = "/tmp";  }
+
+    std::string result (dir);
+    while (result.empty() == false && result[result.size()-1] == '/')
+    {
+        result.erase (result.size()-1);
+    }
+
+    result += '/';
+    result += name;
+    return result;
+}
 
 #endif /* CPPUNIT_H_ */
