     return result;
 }
 
+/** Provided by main.cpp: builds the path of a fixture of the test/db corpus. */
+extern const char* getPath (const char* file);
+
+/** Tells whether a fixture of the test/db corpus is available.
+ *
+ *  Upstream downloads the full corpus from plast.gforge.inria.fr, a host that
+ *  no longer resolves, and the release archive only ships a subset of it.
+ *  Tests that need one of the missing files are skipped with an explicit
+ *  message instead of failing on a file that cannot be obtained.
+ */
+static inline bool plastFixtureAvailable (const char* file, const char* testName)
+{
+    FILE* probe = fopen (getPath (file), "r");
+    if (probe != 0)  {  fclose (probe);  return true;  }
+
+    printf ("[skip] %s: fixture '%s' is not shipped in the release archive\n", testName, file);
+    return false;
+}
+
+/** Same as plastFixtureAvailable() for a whole list of fixtures. */
+static inline bool plastFixturesAvailable (const char* testName, const char* const* files, size_t nb)
+{
+    for (size_t i = 0; i < nb; i++)
+    {
+        if (plastFixtureAvailable (files[i], testName) == false)  {  return false;  }
+    }
+    return true;
+}
+
 #endif /* CPPUNIT_H_ */
