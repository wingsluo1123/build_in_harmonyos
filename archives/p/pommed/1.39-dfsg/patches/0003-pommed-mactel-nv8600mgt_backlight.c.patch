 static unsigned char
 nv8600mgt_backlight_get()
 {
   unsigned char value;
 
   if (nv8600mgt_inited == 0)
     return 0;
 
+#ifndef NV8600MGT_NO_PORT_IO
   outb(0x03, bl_port + 1);
   outb(0xbf, bl_port);
 
   value = inb(bl_port + 1) >> 4;
+#else
+  value = 0;
+#endif
 
   return value;
 }
 
 static void
 nv8600mgt_backlight_set(unsigned char value)
 {
   if (nv8600mgt_inited == 0)
     return;
 
+#ifndef NV8600MGT_NO_PORT_IO
   outb(0x04 | (value << 4), bl_port + 1);
   outb(0xbf, bl_port);
+#endif
 }
 
 
