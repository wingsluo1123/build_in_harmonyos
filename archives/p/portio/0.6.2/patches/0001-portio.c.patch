 #include "Python.h"
+#include <errno.h>
+
+/* Port I/O is an x86-only userspace facility: <sys/io.h> provides the in/out
+   instruction wrappers on x86 only (on other architectures the header exists
+   but is empty, so the calls would link as unresolved symbols).  On non-x86
+   the module is built with PORTIO_HAS_PORT_IO = 0: every I/O entry point
+   keeps its documented signature but fails explicitly instead of returning
+   arbitrary data. */
+#if defined(__i386__) || defined(__x86_64__)
 #include <sys/io.h>
+#define PORTIO_HAS_PORT_IO 1
+#else
+#define PORTIO_HAS_PORT_IO 0
+#endif
+
+/* module specific exception (declared here so that the unsupported platform
+   implementations below can raise it; registered into the module in
+   PyInit_portio / initportio) */
+static PyObject *Error;
+
+#if !PORTIO_HAS_PORT_IO
+#if defined(__aarch64__)
+#define PIO_ARCH "aarch64"
+#elif defined(__arm__)
+#define PIO_ARCH "arm"
+#elif defined(__riscv)
+#define PIO_ARCH "riscv"
+#else
+#define PIO_ARCH "non-x86"
+#endif
+
+/* Raise portio.error and return NULL, so that callers never mistake a
+   silently ignored access for a successful port operation. */
+static PyObject *
+pio_unsupported (const char *name)
+{
+  PyErr_Format(Error,
+    "%s: port I/O is not available on this architecture (%s): the x86 "
+    "in/out instructions and <sys/io.h> do not exist here", name, PIO_ARCH);
+  return NULL;
+}
+#endif
+
 
 static PyObject *pio_outb(PyObject *self,PyObject *args)
 {
