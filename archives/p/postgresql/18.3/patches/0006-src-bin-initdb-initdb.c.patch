@@ -1075,6 +1075,13 @@
 static const char *
 choose_dsm_implementation(void)
 {
+#ifdef HAVE_BROKEN_SHM_OPEN
+	/*
+	 * shm_open is detected but causes SIGSYS (unimplemented syscall).
+	 * Use mmap-based DSM directly, bypassing shm_open test.
+	 */
+	return "mmap";
+#else
 #if defined(HAVE_SHM_OPEN) && !defined(__sun__)
 	int			ntries = 10;
 	pg_prng_state prng_state;
@@ -1107,6 +1114,7 @@
 #else
 	return "sysv";
 #endif
+#endif /* HAVE_BROKEN_SHM_OPEN */
 }

