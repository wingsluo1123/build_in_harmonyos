--- a/src/port/pgmkdirp.c
+++ b/src/port/pgmkdirp.c
@@ -132,11 +132,34 @@
 				break;
 			}
 		}
-		else if (mkdir(path, last ? omode : S_IRWXU | S_IRWXG | S_IRWXO) < 0)
+		else if (mkdir(path, last ? omode : (
+#ifdef HAVE_BROKEN_UMASK
+			/* hmdfs doesn't support group/other permissions in mkdir */
+			S_IRWXU
+#else
+			S_IRWXU | S_IRWXG | S_IRWXO
+#endif
+			)) < 0)
 		{
 			retval = -1;
 			break;
 		}
+#ifdef HAVE_BROKEN_UMASK
+		else
+		{
+			/*
+			 * hmdfs creates directories with abnormal S-bit permissions.
+			 * Need to chmod to correct the permissions after mkdir.
+			 * Note: chmod is only done when we actually created the directory,
+			 * not when it already existed (handled by the stat branch above).
+			 */
+			if (chmod(path, last ? omode : S_IRWXU) < 0)
+			{
+				retval = -1;
+				break;
+			}
+		}
+#endif
 		if (!last)
 			*p = '/';
 	}
