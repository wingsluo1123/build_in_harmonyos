 # Create a (secure) tmp directory for tmp files.
+# The 077 umask makes mktemp create a 0700 directory, which on the HarmonyOS PC
+# (HMDFS) sandbox is handed back as an unwritable one, so every file written
+# into it afterwards fails with EACCES. The directory is private to this script
+# run either way, hence the 022 umask.
 
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`(umask 022 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
   test -d "$tmp"
 }  ||
