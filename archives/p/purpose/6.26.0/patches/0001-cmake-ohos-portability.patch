-ecm_find_qmlmodule(org.kde.prison REQUIRED)
-ecm_find_qmlmodule(org.kde.kitemmodels REQUIRED)
-ecm_find_qmlmodule(org.kde.kcmutils REQUIRED)
+# OHOS baseline: ecm_find_qmlmodule() only looks in two places - the consumer's
+# own install prefix (<KDE_INSTALL_FULL_QMLDIR>/<module>) and Qt's own
+# QT_INSTALL_QML - so a QML module that Conan ships as its own package
+# (org.kde.prison from prison/6.18.0, org.kde.kitemmodels from
+# kitemmodels/6.26.0, org.kde.kcmutils from kcmutils/6.26.0) can never be seen
+# at configure time. The modules are resolved at runtime through
+# QML2_IMPORT_PATH, which the recipe exports for consumers; org.kde.kitemmodels
+# is a real import of src/quick/AlternativesView.qml and the recipe asserts
+# that its qmldir is present in the kitemmodels package before configuring.
+ecm_find_qmlmodule(org.kde.prison)
+ecm_find_qmlmodule(org.kde.kitemmodels)
+ecm_find_qmlmodule(org.kde.kcmutils)
 
