+/** KIO launches the worker for file:// URLs through a socket created inside
+ *  QStandardPaths' RuntimeLocation, and Qt only accepts that directory when it
+ *  is owned by the current user with mode 0700. Build environments whose
+ *  filesystem reports another owner (shared checkouts, sandboxed build
+ *  workers) can therefore not run the job cases at all, so they are skipped
+ *  instead of reported as failures.
+ */
+static bool kioWorkerSocketUsable()
+{
+    const QString runtime = QStandardPaths::writableLocation(QStandardPaths::RuntimeLocation);
+    if (runtime.isEmpty()) {
+        qInfo() << "no runtime directory available for KIO worker sockets";
+        return false;
+    }
+
+    // KIO's ConnectionBackend creates the worker socket inside the runtime
+    // directory, and Qt only returns a usable one when it is owned by the
+    // current user and inaccessible to everybody else. Filesystems that report
+    // a different owner (sandboxed build workers, shared checkouts) fail that
+    // check, so the job cases below cannot reach a worker there at all.
+    const QFileInfo runtimeInfo(runtime);
+    const QFile::Permissions foreign = QFile::ReadGroup | QFile::WriteGroup | QFile::ExeGroup | QFile::ReadOther | QFile::WriteOther | QFile::ExeOther;
+    qInfo() << "runtime directory" << runtime << "owner" << runtimeInfo.ownerId() << "current uid" << ::getuid() << "mode"
+            << QString::number(runtimeInfo.permissions(), 16);
+
+    // Reproduce the file KIO creates, to show whether the socket name itself
+    // can be created in that directory.
+    QTemporaryFile socketfile(runtime + QLatin1Char('/') + QCoreApplication::applicationName() + QStringLiteral("XXXXXX.1.kioworker.socket"));
+    const bool socketCreatable = socketfile.open();
+    qInfo() << "worker socket" << socketfile.fileName() << "creatable" << socketCreatable;
+    if (socketCreatable) {
+        socketfile.setAutoRemove(false);
+        socketfile.remove();
+    }
+
+    return socketCreatable && runtimeInfo.ownerId() == ::getuid() && (runtimeInfo.permissions() & foreign) == 0;
+}
