diff -ruN a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -119,8 +119,13 @@
   find_package(OpenSSL REQUIRED)
   include_directories(${OPENSSL_INCLUDE_DIR})

   if (NOT APPLE)
-    find_package(Magic REQUIRED)
-    include_directories(${MAGIC_INCLUDE_DIRS})
