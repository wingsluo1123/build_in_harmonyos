--- a/torch/lib/libshm/CMakeLists.txt
+++ b/torch/lib/libshm/CMakeLists.txt
@@ -66,7 +66,14 @@
   # we need to link directly to c10 here otherwise we miss symbols
   target_link_libraries(torch_shm_manager PRIVATE shm c10)
 endif()
+# OHOS: manager.cpp calls std::erase_if, a C++20 library feature. The conan
+# toolchain pins CMAKE_CXX_STANDARD to the profile value (17), and the
+# project-wide set(CMAKE_CXX_STANDARD 20 CACHE ...) cannot override it, so a
+# target only gets C++20 if it asks for it explicitly -- the sibling `shm`
+# target above does (CXX_STANDARD 20), this executable did not.
 set_target_properties(torch_shm_manager PROPERTIES
+  CXX_STANDARD 20
+  CXX_STANDARD_REQUIRED ON
   INSTALL_RPATH "${_rpath_portable_origin}/../lib")
 
 install(TARGETS shm LIBRARY DESTINATION ${LIBSHM_INSTALL_LIB_SUBDIR})
