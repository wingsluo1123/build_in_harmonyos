--- a/third_party/gloo/gloo/transport/tcp/CMakeLists.txt
+++ b/third_party/gloo/gloo/transport/tcp/CMakeLists.txt
@@ -1,4 +1,10 @@
-if(NOT ${CMAKE_SYSTEM_NAME} STREQUAL "Linux")
+# OHOS is Linux-ABI compatible for this purpose: this transport only needs
+# epoll(2) plus the usual POSIX socket API, all of which the OHOS musl sysroot
+# provides. Without OHOS in this condition the TCP transport sources (device.cc
+# -> CreateLazyDevice, loop.cc, ...) are silently skipped, so libgloo.a is built
+# without them and every consumer fails to load libtorch_cpu.so with
+# "Error relocating ... gloo::transport::tcp::CreateLazyDevice ... symbol not found".
+if(NOT ${CMAKE_SYSTEM_NAME} STREQUAL "Linux" AND NOT ${CMAKE_SYSTEM_NAME} MATCHES "^(OHOS|HarmonyOS)$")
     message(WARNING "Gloo TCP transport is supported only on Linux(uses epoll API)")
 else()
     list(APPEND GLOO_TRANSPORT_SRCS
--- a/third_party/gloo/gloo/common/CMakeLists.txt
+++ b/third_party/gloo/gloo/common/CMakeLists.txt
@@ -13,7 +13,10 @@
   "${CMAKE_CURRENT_SOURCE_DIR}/utils.h"
   )
 
-if(${CMAKE_SYSTEM_NAME} STREQUAL "Linux")
+# OHOS: linux.cc implements the device/interface enumeration that gloo's TCP
+# transport pulls in via gloo/common/linux.h (device.cc includes it); it builds
+# unmodified against the OHOS musl sysroot (getifaddrs/ioctl).
+if(${CMAKE_SYSTEM_NAME} STREQUAL "Linux" OR ${CMAKE_SYSTEM_NAME} MATCHES "^(OHOS|HarmonyOS)$")
   list(APPEND GLOO_COMMON_SRCS
     "${CMAKE_CURRENT_SOURCE_DIR}/linux.cc"
     )
