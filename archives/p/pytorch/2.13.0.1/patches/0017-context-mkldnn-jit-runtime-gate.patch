 bool Context::userEnabledMkldnn() const {
+#if AT_MKLDNN_ENABLED()
+  // A process that cannot obtain executable memory cannot run oneDNN's JIT-ed
+  // aarch64 kernels at all (see isMKLDNNJitUsable above), so report the
+  // effective state -- "requested *and* possible here" -- rather than the raw
+  // request. Otherwise every mkldnn dispatch site (convolution, activation,
+  // blas, ...) would route work to kernels that abort on first use.
+  return enabled_mkldnn && isMKLDNNJitUsable();
+#else
   return enabled_mkldnn;
+#endif
 }
 
