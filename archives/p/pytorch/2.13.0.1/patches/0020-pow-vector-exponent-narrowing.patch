--- a/aten/src/ATen/native/cpu/PowKernel.cpp
+++ b/aten/src/ATen/native/cpu/PowKernel.cpp
@@ -1,5 +1,6 @@
 #define TORCH_ASSERT_NO_OPERATORS
 #include <cmath>
+#include <type_traits>
 #include <ATen/Dispatch.h>
 #include <ATen/Parallel.h>
 #include <ATen/cpu/vec/vec.h>
@@ -75,14 +76,41 @@
         [](Vec base) -> Vec { return (base * base).reciprocal(); }
     );
   } else {
-    cpu_kernel_vec(iter,
-        [=](scalar_t base) -> scalar_t {
-          return std::pow(base, static_cast<cast_scalar_t>(exp));
-        },
-        [=](Vec base) -> Vec {
-          return base.pow(static_cast<cast_scalar_t>(exp));
-        }
-    );
+    // The exponent is carried in cast_scalar_t, which is wider than scalar_t
+    // whenever a float tensor is raised to a double exponent (which is what an
+    // integer scalar becomes). The vectorized overload only takes a scalar_t
+    // exponent, so handing it cast_scalar_t exp would round the exponent to
+    // float first -- e.g. -2147483647 is odd but rounds to the even -2^31,
+    // flipping the sign of the result for a negative base -- and then the
+    // vector body and the scalar tail of the *same* call would disagree.
+    // Measured before the fix: tensor of 15 elements, base -1, exp -2147483647
+    // (not representable in float) returned +1 for the first 8 lanes (vector)
+    // and -1 for the remaining 7 (scalar), while tensor.pow(scalar) must equal
+    // pow(double) for every element (see aten/src/ATen/test/pow_test.cpp).
+    // When the exponent does not survive the round trip through scalar_t, keep
+    // the whole tensor on the scalar path so both halves agree.
+    const auto cast_exp = static_cast<cast_scalar_t>(exp);
+    bool exp_represents_scalar_t = true;
+    if constexpr (
+        std::is_floating_point_v<scalar_t> &&
+        !std::is_same_v<scalar_t, cast_scalar_t>) {
+      exp_represents_scalar_t =
+          static_cast<cast_scalar_t>(static_cast<scalar_t>(cast_exp)) == cast_exp;
+    }
+    if (exp_represents_scalar_t) {
+      cpu_kernel_vec(iter,
+          [=](scalar_t base) -> scalar_t {
+            return std::pow(base, cast_exp);
+          },
+          [=](Vec base) -> Vec {
+            return base.pow(cast_exp);
+          }
+      );
+    } else {
+      cpu_kernel(iter, [=](scalar_t base) -> scalar_t {
+        return std::pow(base, cast_exp);
+      });
+    }
   }
 }
 
