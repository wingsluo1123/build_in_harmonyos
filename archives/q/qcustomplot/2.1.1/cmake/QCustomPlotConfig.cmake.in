@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Qt6 COMPONENTS Core Gui Widgets)
if("@QCUSTOMPLOT_WITH_PRINTSUPPORT@" STREQUAL "ON")
  find_dependency(Qt6 COMPONENTS PrintSupport)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/QCustomPlotTargets.cmake")

check_required_components(QCustomPlot)
