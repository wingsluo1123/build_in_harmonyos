+
+#include <headers.hh>
+#include <helpbrowser.hh>
+#include <terminal.hh>
+
+HelpBrowser::HelpBrowser()
+{
+  QVBoxLayout * layout = new QVBoxLayout(this);
+  layout->addWidget(new QLabel(
+    "The embedded help browser is not available in this build", this));
+}
+
+void HelpBrowser::browseLocation(const QString &)
+{
+  Terminal::out << "The embedded help browser is not available in this build"
+                << endl;
+}
+
+void HelpBrowser::browseCommand(const Command *)
+{
+  browseLocation(QString());
+}
+
+QString HelpBrowser::collectionFile()
+{
+  return QString();
+}
+
+void HelpBrowser::dumpHelp()
+{
+  browseLocation(QString());
+}
+
+TipsDisplay::TipsDisplay()
+  : QWidget(NULL)
+{
+  setWindowTitle("QSoas tips");
+  QVBoxLayout * layout = new QVBoxLayout(this);
+  layout->addWidget(new QLabel(
+    "Generated QSoas help content is not installed in this build", this));
+}
+
+TipsDisplay::~TipsDisplay() = default;
+
+TipsDisplay * TipsDisplay::getDisplay(bool activate)
+{
+  static TipsDisplay * display = NULL;
+  if(! display)
+    display = new TipsDisplay;
+  if(activate)
+    display->show();
+  return display;
+}
+
+void TipsDisplay::showStartupTips()
+{
+  getDisplay(false);
+}
+
+void TipsDisplay::showRandomTip()
+{
+  getDisplay(true);
+}
+
+void TipsDisplay::showRandomKeyword(const QString &)
+{
+  getDisplay(true);
+}
