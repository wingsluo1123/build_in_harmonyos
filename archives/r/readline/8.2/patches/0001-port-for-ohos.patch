--- a/support/config.guess
+++ b/support/config.guess
@@ -271,6 +271,26 @@ case $UNAME_MACHINE:$UNAME_SYSTEM:$UNAME_RELEASE:$UNAME_VERSION in
 	UNAME_MACHINE_ARCH=`arch | sed 's/Bitrig.//'`
 	GUESS=$UNAME_MACHINE_ARCH-unknown-bitrig$UNAME_RELEASE
 	;;
+	*:HarmonyOS:*:*)
+		case "$UNAME_MACHINE" in
+			aarch64|arm64)
+			MACHINE=aarch64
+			;;
+			armv7*|armv8*)
+			MACHINE=arm
+			;;
+			x86_64|amd64)
+			MACHINE=x86_64
+			;;
+			i?86)
+			MACHINE=i686
+			;;
+			*)
+			MACHINE="$UNAME_MACHINE"
+			;;
+		esac
+		GUESS=${MACHINE}-unknown-linux-ohos
+	;;
     *:OpenBSD:*:*)
 	UNAME_MACHINE_ARCH=`arch | sed 's/OpenBSD.//'`
 	GUESS=$UNAME_MACHINE_ARCH-unknown-openbsd$UNAME_RELEASE
diff --git a/support/config.sub b/support/config.sub
--- a/support/config.sub
+++ b/support/config.sub
@@ -142,7 +142,7 @@ case $1 in
 		# parts
 		maybe_os=$field2-$field3
 		case $maybe_os in
