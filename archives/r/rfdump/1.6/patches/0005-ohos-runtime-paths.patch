diff --git a/src/tools.h b/src/tools.h
index 6aabebf..c9a6796 100644
--- a/src/tools.h
+++ b/src/tools.h
@@ -32,3 +32,23 @@ do { \
 } while(0)
 
 #endif
+
+/* Resolve a data file that the package installs in <prefix>/share/rfdump.
+   The Conan package is relocatable, so probe next to the running executable
+   (<bindir>/../share/rfdump/<name>) before falling back to absolute system
+   paths.  Returns a malloc()ed string, or NULL when it cannot be built. */
+static inline char *exe_relative_data_file(const char *name)
+{
+  char exe[PATH_MAX];
+  const ssize_t n = readlink("/proc/self/exe", exe, sizeof(exe) - 1);
+  if(n <= 0)
+    return NULL;
+  exe[n] = 0;
+  char *slash = strrchr(exe, '/');
+  if(!slash)
+    return NULL;
+  *slash = 0;
+  char out[PATH_MAX];
+  SNPRINTF(out, sizeof(out), "%s/../share/rfdump/%s", exe, name);
+  return strdup(out);
+}
