 {
-  printf("\nusage: rfdump [--setupreader] [-p /dev/tty...] [file.xml]\n");
+  usage(stdout);
   exit(1);
 }
 
+/* Headless reader probe: exercises exactly the three code paths that matter
+   on a machine without a graphical session - the packaged GtkBuilder
+   resource, the expat driven tag-type table, and the termios serial bring-up.
+   No window is ever realised.  Exit codes: 0 all good, 2 GUI resource, 3 tag
+   types, 4 no reader attached, 5 no serial device node. */
+static int probe_reader(const char *device)
+{
+  int rc=0;
+  int fd;
+  struct RFIDTagType *types[100];
+  int noTagTypes;
+
+  {
+    GError *error=0;
+    GtkBuilder *probe_builder=gtk_builder_new();
+    char *fn=exe_relative_data_file("rfdump.ui");
+    if(!fn)
+      {
+	fprintf(stderr, "PROBE ui=MISSING exe-relative rfdump.ui not found\n");
+	rc=2;
+      }
+    else if(!gtk_builder_add_from_file(probe_builder, fn, &error))
+      {
+	fprintf(stderr, "PROBE ui=FAIL %s\n", error?error->message:"unknown");
+	rc=2;
+      }
+    else
+      {
+	const char *ids[]={"windowRFDump","treeview1","statusbar","keya","entryTagID",0};
+	int i, found=0;
+	for(i=0; ids[i]; ++i)
+	  if(gtk_builder_get_object(probe_builder, ids[i]))
+	    ++found;
+	printf("PROBE ui=OK widgets=%d/5 file=%s\n", found, fn);
+	if(found < 5)
+	  rc=2;
+      }
+    g_free(fn);
+    g_object_unref(probe_builder);
+  }
+
+  noTagTypes=readTagTypes(types, sizeof_array(types));
+  printf("PROBE tagtypes=%d\n", noTagTypes);
+  if(noTagTypes <= 0)
+    rc=3;
+
+  fd=rfidConnectReader(device, 9600, 0);
+  printf("PROBE serial_device=%s fd=%d\n", device, fd);
+  if(fd < 0)
+    {
+      printf("PROBE reader=ABSENT\n");
+      if(rc == 0)
+	rc=4;
+      if(access(device, F_OK) != 0)
+	{
+	  printf("PROBE device_node=MISSING\n");
+	  if(rc == 4)
+	    rc=5;
+	}
+    }
+  else
+    {
+      printf("PROBE reader=PRESENT\n");
+      serial_cleanup();
+    }
+  return rc;
+}
