--- rsyslog-8.2604.0.orig/configure	2026-08-07 23:56:17.725681719 +0800
+++ rsyslog-8.2604.0.work/configure	2026-08-07 23:57:11.137680625 +0800
@@ -37778,15 +37778,17 @@
   trap 'as_fn_exit 1' 1 2 13 15
 }
 # Create a (secure) tmp directory for tmp files.
+# E011 HMDFS fix: HMDFS does not support umask 077 + relative mktemp;
+# use $TMPDIR absolute path and umask 000 (OHOS adaptation).
 
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`(umask 000 && mktemp -d "$TMPDIR/confXXXXXX") 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
-  tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
-} || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
+  tmp=$TMPDIR/conf$$-$RANDOM
+  (umask 000 && mkdir -p "$tmp")
+} || as_fn_error $? "cannot create a temporary directory in $TMPDIR" "$LINENO" 5
 ac_tmp=$tmp
 
 # Set up the scripts for CONFIG_FILES section.
