new file mode 100644
index 0000000..97ca1de
--- /dev/null
+++ b/sysdep/ohosAarch64/install
@@ -0,0 +1,4 @@
+#!/bin/bash
+echo "Installing ohosAarch64 system dependent files ..."
+'cp' -f GC.c $saclib/src/
+'cp' -f sysdep.h $saclib/include
