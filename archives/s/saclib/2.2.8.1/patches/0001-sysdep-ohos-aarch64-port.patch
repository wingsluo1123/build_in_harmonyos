diff --git a/sysdep/ohosAarch64/GC.c b/sysdep/ohosAarch64/GC.c
new file mode 100644
index 0000000..b67e975
--- /dev/null
+++ b/sysdep/ohosAarch64/GC.c
@@ -0,0 +1,56 @@
+/*======================================================================
+                           GC()  --  OpenHarmony / AArch64 port
+
+Garbage collection entry-point.
+
+GCSI() (the collector proper) finds its roots by treating every aligned word in
+[EACSTACK, BACSTACK] as a potential SACLIB object, so GC() must make sure that
+every register and stack slot holding a live object is inside that range by the
+time GCSI() runs.  That is the system- and compiler-dependent part, and on
+AArch64/AAPCS64 it needs two things that the x86_64 port does not provide.
+
+1. Every callee-saved register has to be written into the frame.  The upstream
+   x86_64 port declares 16 dummy integer locals and passes them to gc_dummy(),
+   relying on the System V AMD64 convention to spill them; measured on device
+   with clang 15 for aarch64-linux-ohos, that construction lets the collector
+   reclaim live objects at -O1 and later (the shipped test_package passed at -O0
+   and dumped core deterministically at -O1/-O2/-Os, with GC() removed from the
+   test the very same builds passed everywhere).  AAPCS64 gives the calling
+   function callee-saved registers x19-x28, and it is free to keep live Words
+   there across the call, where a stack scan cannot see them.
+
+   setjmp() is therefore used to force the spill: the ABI requires every
+   callee-saved register to survive a setjmp(), so a compiler must store each
+   one it uses into the frame first — exactly the registers that can still hold
+   a live Word here.  This is the same technique the classic conservative
+   collectors use to capture register roots.
+
+2. GCSI() must scan down to the lowest slot that can hold a caller's live data.
+   AAPCS64 grants a leaf function a 16-byte red zone below sp and compilers keep
+   spill slots there, so the address of GC()'s own local — which lies below any
+   red-zone slot of its caller — is passed as EACSTACK.  The volatile array
+   keeps that frame real and stops the local from being optimised away.
+
+The jmp_buf is deliberately not restored: the setjmp() result is ignored and
+control simply continues, which is what makes the spill observable.
+======================================================================*/
+
+#include "saclib.h"
+
+#include <setjmp.h>
+
+void GC(void)
+{
+     jmp_buf regs;
+     volatile Word frame_reserve[8];
+     Word top_of_stack;
+     int i;
+
+     for (i = 0; i < 8; i++)
+	  frame_reserve[i] = 0;
+
+     /* force every live callee-saved register into the frame */
+     (void)setjmp(regs);
+
+     GCSI(sizeof(Word),(char *)&top_of_stack);
+}
diff --git a/sysdep/ohosAarch64/cleanup b/sysdep/ohosAarch64/cleanup
new file mode 100644
index 0000000..aebe151
--- /dev/null
+++ b/sysdep/ohosAarch64/cleanup
@@ -0,0 +1,4 @@
+#!/bin/bash
+echo "Removing any ohosAarch64 system dependent files ..."
+'rm' -f $saclib/src/GC.c
+'rm' -f $saclib/include/sysdep.h
