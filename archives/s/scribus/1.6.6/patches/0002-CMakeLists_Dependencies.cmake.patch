 #<< FreeType2
 find_package(Freetype REQUIRED)
-if (FREETYPE_FOUND)
+# OHOS/conan: CMakeDeps exports *_FOUND with package-name casing
+# (freetype_FOUND); upstream checks the all-caps variant
+# (FREETYPE_FOUND). Accept either.
+if(FREETYPE_FOUND OR freetype_FOUND)
 	message(STATUS "FreeType2 Library Found OK")
 else()
 	message(FATAL_ERROR "No Freetype Found")
 endif()
