-pkg_check_modules(HARFBUZZ REQUIRED harfbuzz>=1.0.5 harfbuzz-icu)
+pkg_check_modules(HARFBUZZ REQUIRED harfbuzz>=1.0.5)
 if (HARFBUZZ_FOUND)
