 		message(STATUS "PoDoFo Found OK, Version: " ${LIBPODOFO_VERSION})
 		set(HAVE_PODOFO ON)
 		if(LIBPODOFO_VERSION VERSION_GREATER_EQUAL "0.10.0")
 			if (CMAKE_CXX_STANDARD LESS 17)
@@ -43,21 +50,28 @@
