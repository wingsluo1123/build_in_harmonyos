-pkg_check_modules(ICU REQUIRED icu-uc)
+# OHOS: the published harfbuzz package disables the ICU module
+# (harfbuzz-icu), and textshaper.cpp converts UScriptCode via the ICU
+# short name + hb_script_from_iso15924_tag, so the ICU submodule is
+# optional here. Keep the probe for informational purposes.
+pkg_check_modules(HARFBUZZ_ICU QUIET harfbuzz-icu)
+if (HARFBUZZ_ICU_FOUND)
+	message("Harfbuzz-icu library Found OK")
+endif()
+# ICU: the conan icu package exports a single aggregated icu.pc
+# (libicuuc + libicui18n + libicudata); upstream probes the icu-uc
+# submodule name which is not generated by PkgConfigDeps. Use "icu".
+pkg_check_modules(ICU REQUIRED icu)
 
