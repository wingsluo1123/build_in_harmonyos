 #<< Qt
 #Qt less than 6
-set(CMAKE_PREFIX_PATH "${QT_PREFIX}/lib/cmake")
+# OHOS/conan: append Qt prefix to CMAKE_PREFIX_PATH instead of overwriting,
+# so conan-generated package configs (zlib/libjpeg/etc.) remain discoverable.
+# Upstream overwrites with set() which drops the conan toolchain paths.
+# QT_PREFIX points at the qtbase package folder (its lib/cmake/Qt5Config.cmake
+# layout is found via <prefix>/lib/cmake/<Module>/<Module>Config.cmake).
+if(QT_PREFIX)
+	list(APPEND CMAKE_PREFIX_PATH "${QT_PREFIX}")
+endif()
 set(CMAKE_INCLUDE_CURRENT_DIR ON)
 
 if (NOT WANT_QT6)
 	message(STATUS "Qt5 Requested")
 	set(QT_MIN_VERSION "5.14.0")
 	add_compile_definitions(QT_DISABLE_DEPRECATED_BEFORE=0x050E00)
 	find_package(Qt5Core ${QT_MIN_VERSION} REQUIRED)
 	if(NOT Qt5Core_FOUND)
 		message(FATAL_ERROR "ERROR: No QT 5 found")
 	endif()
@@ -74,23 +88,28 @@
