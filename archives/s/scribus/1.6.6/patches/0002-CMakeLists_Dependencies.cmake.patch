--- a/CMakeLists_Dependencies.cmake
+++ b/CMakeLists_Dependencies.cmake
@@ -1,12 +1,19 @@
 ##############################################################################################################
 ########## Find Dependencies                                                                        ##########
+
+# pkg-config: upstream Findpoppler/Findcairo/Findhunspell etc. each call
+# find_package(PkgConfig), but when conan CMakeDeps configs satisfy those
+# find_package() calls the custom Find modules are never loaded and the
+# pkg_check_modules macro stays undefined (breaking the librevenge /
+# harfbuzz / icu probes below). Load it explicitly up front.
+find_package(PkgConfig REQUIRED)
 
