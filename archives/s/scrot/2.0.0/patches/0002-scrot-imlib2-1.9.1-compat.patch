+/* scrot_imlib_compat.h: build scrot 2.0.0 against X-less imlib2 1.9.1.
+ *
+ * Upstream 2.0.0 requires imlib2 >= 1.11.0 with X (see deps.pc): it calls
+ * imlib_context_set_display/visual/colormap/drawable,
+ * imlib_create_image_from_drawable/ximage and imlib_save_image_fd(), none
+ * of which exist in an X-less imlib2 1.9.1 (its Imlib2.h hides the X entry
+ * points behind X_DISPLAY_MISSING and it predates imlib_save_image_fd()).
+ *
+ * This header selects the compat path and declares the in-source shims
+ * (defined at the end of scrot.c, linked into the same binary):
+ *  - X context setters: stored in static globals for the grab shims;
+ *  - grab shims: XGetImage + generic TrueColor/PseudoColor conversion using
+ *    only Xlib and the display-independent imlib2 core;
+ *  - fd-save shim: imlib_save_image() to a temp file, spliced to the fd.
+ *
+ * The compat path self-disables (SCROT_USE_IMLIB_COMPAT stays undefined)
+ * once the graph resolves imlib2 >= 1.11 without X_DISPLAY_MISSING, so the
+ * same patch is forward-compatible with the future native dependency.
+ * IMLIB2_VERSION is MAJOR*10000 + MINOR*100 + MICRO; 1.11.0 == 11100.
+ * A header without IMLIB2_VERSION counts as 0 (undefined -> 0 in #if).
+ */
+#ifndef SCROT_IMLIB_COMPAT_H
+#define SCROT_IMLIB_COMPAT_H
+
+#include <Imlib2.h>
+
+#if !defined(IMLIB2_VERSION) || (IMLIB2_VERSION < 11100) || \
+    defined(X_DISPLAY_MISSING)
+#define SCROT_USE_IMLIB_COMPAT 1
+#endif
+
+#ifdef SCROT_USE_IMLIB_COMPAT
+#include <X11/Xlib.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+void imlib_context_set_display(Display *display);
+void imlib_context_set_visual(Visual *visual);
+void imlib_context_set_colormap(Colormap colormap);
+void imlib_context_set_drawable(Drawable drawable);
+Imlib_Image imlib_create_image_from_drawable(Drawable d, int x, int y, int w,
+    int h, char need_to_grab_x);
+Imlib_Image imlib_create_image_from_ximage(XImage *ximage, XImage *mask,
+    int x, int y, int w, int h, char need_to_grab_x);
+void imlib_save_image_fd(int fd, const char *file);
+int scrot_compat_get_error(void);
+const char *scrot_compat_strerror(int err);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SCROT_USE_IMLIB_COMPAT */
+#endif /* SCROT_IMLIB_COMPAT_H */
