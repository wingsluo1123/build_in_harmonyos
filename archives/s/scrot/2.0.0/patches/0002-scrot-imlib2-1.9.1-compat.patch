 // save image to fd, filename only used for logging
 // fd will be closed after calling this function
 static void scrotSaveImage(int fd, const char *filename)
 {
+#ifdef SCROT_USE_IMLIB_COMPAT
+    /* imlib2 < 1.11 (e.g. X-less 1.9.1) has no imlib_save_image_fd():
+       forward to the temp-file splice in scrot_imlib_compat.h and read
+       back the recorded errno instead of imlib_get_error(). */
+    imlib_save_image_fd(fd, filename);
+    int imErr = scrot_compat_get_error();
+    if (imErr)
+        errx(EXIT_FAILURE, "failed to save image: %s: %s",
+            filename, scrot_compat_strerror(imErr));
+#else
     imlib_save_image_fd(fd, filename);
     int imErr = imlib_get_error();
     if (imErr) {
         const char *errmsg = imlib_strerror(imErr);
         const char imlibPrefix[] = "Imlib2: ";
         if (strncmp(errmsg, imlibPrefix, sizeof(imlibPrefix) - 1) == 0)
             errmsg += sizeof(imlibPrefix) - 1;
         errx(EXIT_FAILURE, "failed to save image: %s: %s",
             filename, errmsg);
     }
+#endif
 }
