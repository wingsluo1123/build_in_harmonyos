--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -78,7 +78,7 @@
 include(GNUInstallDirs)
 set(CMAKE_INSTALL_CMAKEDIR "${CMAKE_INSTALL_LIBDIR}/cmake/sentry")

-if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
+if(CMAKE_SYSTEM_NAME STREQUAL "Linux" OR CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
 	set(LINUX TRUE)
 elseif(CMAKE_SYSTEM_NAME STREQUAL "AIX" OR CMAKE_SYSTEM_NAME STREQUAL "OS400")
 	set(AIX TRUE)
--- a/vendor/libunwind/CMakeLists.txt
+++ b/vendor/libunwind/CMakeLists.txt
@@ -23,6 +23,11 @@
 elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "i[3-6]86|x86")
     set(UNWIND_ARCH "x86")
     set(UNWIND_ELF "elf32")
+elseif(CMAKE_SYSTEM_PROCESSOR STREQUAL "unknown" AND CMAKE_SIZEOF_VOID_P EQUAL 8)
+    # OHOS: CMake lacks Platform/HarmonyOS module, project() resets
+    # CMAKE_SYSTEM_PROCESSOR to "unknown". Use pointer size as fallback.
+    set(UNWIND_ARCH "aarch64")
+    set(UNWIND_ELF "elf64")
 else()
     message(FATAL_ERROR "Unsupported architecture for vendored libunwind: ${CMAKE_SYSTEM_PROCESSOR}")
 endif()
