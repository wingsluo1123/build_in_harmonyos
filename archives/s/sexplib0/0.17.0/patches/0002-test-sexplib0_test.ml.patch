+let normalize s =
+  let b = Buffer.create (String.length s) in
+  let in_ws = ref false in
+  String.iter
+    (fun c ->
+       match c with
+       | ' ' | '\t' | '\n' | '\r' ->
+         if not !in_ws
+         then (
+           Buffer.add_char b ' ';
+           in_ws := true)
+       | c ->
+         Buffer.add_char b c;
+         in_ws := false)
+    s;
+  String.trim (Buffer.contents b)
+;;
+
+let hum_int n =
+  let s = string_of_int (abs n) in
+  let l = String.length s in
+  let b = Buffer.create (l + (l / 3)) in
+  String.iteri
+    (fun i c ->
+       if i > 0 && (l - i) mod 3 = 0 then Buffer.add_char b '_';
+       Buffer.add_char b c)
+    s;
+  (if n < 0 then "-" else "") ^ Buffer.contents b
+;;
+
+let expect expected =
+  incr checks;
+  if normalize !last_output <> normalize expected
+  then (
+    incr failures;
+    Printf.printf
+      "MISMATCH (check #%d):\nexpected: %s\nactual:   %s\n"
+      !checks
+      (normalize expected)
+      (normalize !last_output))
+  else print_endline (Printf.sprintf "ok %d" !checks)
