+(* Minimal s-expression reader: stand-in for Parsexp.Single.parse_string_exn.
+   The upstream test uses it only to parse its own literal inputs (plain
+   atoms/lists, no strings or comments), which this reader covers. *)
+let parse s =
+  let n = String.length s in
+  let pos = ref 0 in
+  let peek () = if !pos < n then Some s.[!pos] else None in
+  let skip_ws () =
+    while (match peek () with
+           | Some (' ' | '\t' | '\n' | '\r') -> true
+           | _ -> false)
+    do
+      incr pos
+    done
+  in
+  let rec parse_sexp () =
+    skip_ws ();
+    match peek () with
+    | None -> failwith "parse: unexpected end of input"
+    | Some '(' ->
+      incr pos;
+      let rec loop acc =
+        skip_ws ();
+        match peek () with
+        | Some ')' ->
+          incr pos;
+          Sexp.List (List.rev acc)
+        | None -> failwith "parse: unclosed paren"
+        | _ -> loop (parse_sexp () :: acc)
+      in
+      loop []
+    | Some ')' -> failwith "parse: unexpected )"
+    | Some _ ->
+      let start = !pos in
+      let is_tok c = not (List.mem c [ ' '; '\t'; '\n'; '\r'; '('; ')' ]) in
+      while (match peek () with
+             | Some c when is_tok c -> true
+             | _ -> false)
+      do
+        incr pos
+      done;
+      Sexp.Atom (String.sub s start (!pos - start))
+  in
+  let sx = parse_sexp () in
+  skip_ws ();
+  if !pos <> n then failwith "parse: trailing input";
+  sx
