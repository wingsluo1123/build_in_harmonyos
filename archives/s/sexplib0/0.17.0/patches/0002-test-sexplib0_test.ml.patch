+let result_of_sexp ok_of error_of = function
+  | Sexp.List [ Sexp.Atom "Ok"; v ] -> Ok (ok_of v)
+  | Sexp.List [ Sexp.Atom "Error"; v ] -> Error (error_of v)
+  | sexp -> of_sexp_error "Result.t_of_sexp: expected (Ok ..) or (Error ..)" sexp
