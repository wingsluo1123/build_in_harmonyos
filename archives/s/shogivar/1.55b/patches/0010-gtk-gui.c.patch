+/* Asset directory (boards, pieces, titles, help images, *.dat / *.rul).
+   The compile-time default is the --datadir of configure; InitDataDir()
+   re-points it at the share/games/shogivar tree that lives next to the
+   executable, so an installed package keeps working from any prefix
+   (conan cache, $HOME/usr/local, a flat release tarball, ...). */
+char shogivarDataDir[MSG_SIZ] = DATADIR;
+
+char *
+DataPath (const char *fmt, ...)
+{   // compose a path below the (possibly relocated) asset directory
+    static char path[MSG_SIZ];
+    va_list ap;
+    size_t used = strlen(shogivarDataDir);
+
+    snprintf(path, MSG_SIZ, "%s", shogivarDataDir);
+    va_start(ap, fmt);
+    vsnprintf(path + used, MSG_SIZ - used, fmt, ap);
+    va_end(ap);
+    return path;
+}
+
+void
+InitDataDir (const char *argv0)
+{   // prefer <directory-of-executable>/../share/games/shogivar
+    char exe[MSG_SIZ], candidate[MSG_SIZ];
+    struct stat st;
+    ssize_t len;
+    char *slash;
+
+    len = readlink("/proc/self/exe", exe, sizeof(exe) - 1);
+    if(len > 0) exe[len] = '\0';
+    else if(argv0 && *argv0 && strlen(argv0) < sizeof(exe)) strcpy(exe, argv0);
+    else return;                // keep the compile-time default
+
+    slash = strrchr(exe, '/');
+    if(slash == NULL) return;   // no directory component: keep default
+    *slash = '\0';
+
+    snprintf(candidate, MSG_SIZ, "%s/../share/games/shogivar", exe);
+    if(stat(candidate, &st) == 0 && S_ISDIR(st.st_mode)) {
+        if(realpath(candidate, shogivarDataDir) == NULL)
+            snprintf(shogivarDataDir, MSG_SIZ, "%s", candidate);
+    }
+    /* keep the game/rules file directory (backend.c: `Direct`) in step */
+    snprintf(Direct, sizeof(Direct), "%s", shogivarDataDir);
+}
