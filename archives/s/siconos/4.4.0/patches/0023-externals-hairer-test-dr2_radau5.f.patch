--- a/externals/hairer/test/dr2_radau5.f
+++ b/externals/hairer/test/dr2_radau5.f
@@ -76,20 +76,21 @@
         DO 10 I=1,20
         IWORK(I)=0
   10    WORK(I)=0.D0
 C --- CALL OF THE SUBROUTINE RADAU5
         CALL RADAU5(N,FAMPL,X,Y,XEND,H,
      &                  RTOL,ATOL,ITOL,
      &                  JBAMPL,IJAC,MLJAC,MUJAC,
      &                  BBAMPL,IMAS,MLMAS,MUMAS,
      &                  SOLOUT,IOUT,
      &                  WORK,LWORK,IWORK,LIWORK,RPAR,IPAR,IDID)
+        IF (IDID .LT. 0) STOP 1
 C --- PRINT FINAL SOLUTION
         WRITE (6,99) X,Y(1),Y(2)
