 C --- PRINT STATISTICS
         WRITE (6,90) RTOL
  90     FORMAT('       tol=',D8.2)
         WRITE (6,91) (IWORK(J),J=14,20)
  91     FORMAT(' fcn=',I5,' jac=',I4,' step=',I4,
      &        ' accpt=',I4,' rejct=',I3,' dec=',I4,
      &        ' sol=',I5)
