diff --git a/src/tests/ncqo.c b/src/tests/ncqo.c
index 734555e..7d2cef7 100644
--- a/src/tests/ncqo.c
+++ b/src/tests/ncqo.c
@@ -30,6 +30,16 @@
 #include "test_list.h"
 #include "test_param.h"
 
+/*
+ * Single-precision floor: with the default single-precision build SUFLOAT is
+ * float, and the mean of a sampled sinusoid cannot cancel below
+ * |sin(pi_f)| / 2 ~= 4.4e-8 (pi is inexact in single precision). The
+ * original SUFLOAT_THRESHOLD (1e-15) predates the single-precision default
+ * and is unattainable in float builds, so these assertions use a
+ * float-appropriate tolerance instead.
+ */
+#define SU_TEST_NCQO_EPS 1e-6f
+
 SUBOOL
 su_test_ncqo(su_test_context_t *ctx)
 {
@@ -59,12 +69,13 @@ su_test_ncqo(su_test_context_t *ctx)
   for (p = 0; p < SU_TEST_SIGNAL_BUFFER_SIZE; ++p)
     buffer[p] = su_ncqo_read_q(&ncqo);
 
-  SU_TEST_ASSERT(SUFLOAT_EQUAL(
-      su_test_buffer_mean(buffer, SU_TEST_SIGNAL_BUFFER_SIZE),
-      0));
+  SU_TEST_ASSERT(
+      SU_ABS(su_test_buffer_mean(buffer, SU_TEST_SIGNAL_BUFFER_SIZE) - 0)
+      <= SU_TEST_NCQO_EPS);
 
   SU_TEST_ASSERT(
-      SUFLOAT_EQUAL(su_test_buffer_pp(buffer, SU_TEST_SIGNAL_BUFFER_SIZE), 0));
+      SU_ABS(su_test_buffer_pp(buffer, SU_TEST_SIGNAL_BUFFER_SIZE) - 0)
+      <= SU_TEST_NCQO_EPS);
 
   /* Modify phase */
   su_ncqo_set_phase(&ncqo, PI / 2);
@@ -73,23 +84,25 @@ su_test_ncqo(su_test_context_t *ctx)
   for (p = 0; p < SU_TEST_SIGNAL_BUFFER_SIZE; ++p)
     buffer[p] = su_ncqo_read_i(&ncqo);
 
-  SU_TEST_ASSERT(SUFLOAT_EQUAL(
-      su_test_buffer_mean(buffer, SU_TEST_SIGNAL_BUFFER_SIZE),
-      0));
+  SU_TEST_ASSERT(
+      SU_ABS(su_test_buffer_mean(buffer, SU_TEST_SIGNAL_BUFFER_SIZE) - 0)
+      <= SU_TEST_NCQO_EPS);
 
   SU_TEST_ASSERT(
-      SUFLOAT_EQUAL(su_test_buffer_pp(buffer, SU_TEST_SIGNAL_BUFFER_SIZE), 0));
+      SU_ABS(su_test_buffer_pp(buffer, SU_TEST_SIGNAL_BUFFER_SIZE) - 0)
+      <= SU_TEST_NCQO_EPS);
 
   /* Test quadrature signal */
   for (p = 0; p < SU_TEST_SIGNAL_BUFFER_SIZE; ++p)
     buffer[p] = su_ncqo_read_q(&ncqo);
 
-  SU_TEST_ASSERT(SUFLOAT_EQUAL(
-      su_test_buffer_mean(buffer, SU_TEST_SIGNAL_BUFFER_SIZE),
-      0));
+  SU_TEST_ASSERT(
+      SU_ABS(su_test_buffer_mean(buffer, SU_TEST_SIGNAL_BUFFER_SIZE) - 0)
+      <= SU_TEST_NCQO_EPS);
 
   SU_TEST_ASSERT(
-      SUFLOAT_EQUAL(su_test_buffer_pp(buffer, SU_TEST_SIGNAL_BUFFER_SIZE), 2));
+      SU_ABS(su_test_buffer_pp(buffer, SU_TEST_SIGNAL_BUFFER_SIZE) - 2)
+      <= SU_TEST_NCQO_EPS);
 
   /* Test constant signal */
   su_ncqo_set_phase(&ncqo, 0);
