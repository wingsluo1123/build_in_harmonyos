diff --git a/src/tests/detect.c b/src/tests/detect.c
index 9e06ecf..3657396 100644
--- a/src/tests/detect.c
+++ b/src/tests/detect.c
@@ -82,6 +82,10 @@ __su_test_channel_detector_qpsk(su_test_context_t *ctx, SUBOOL noisy)
