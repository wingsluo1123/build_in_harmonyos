+/*
+ * Must match the directory used by the sircbot daemon; the daemon accepts a
+ * run-time override so this one has to follow it.
+ */
+#ifndef DEFAULT_RUNDIR
+#define DEFAULT_RUNDIR "/var/run/sircbot"
+#endif
+
+static const char *rundir(void)
+{
+	const char *value = getenv("SIRCBOT_RUNDIR");
+
+	return (value != NULL && value[0] != '\0') ? value : DEFAULT_RUNDIR;
+}
+
+/* Abstract-namespace address; mirrors abstract_addr() in sircbot.c. */
+static socklen_t abstract_addr(struct sockaddr_un *sun, const char *name)
+{
+	size_t len = strlen(name);
+
+	if (len > sizeof(sun->sun_path) - 1)
+		len = sizeof(sun->sun_path) - 1;
+	memset(sun, 0, sizeof(*sun));
+	sun->sun_family = AF_UNIX;
+	sun->sun_path[0] = '\0';
+	memcpy(sun->sun_path + 1, name, len);
+	return (socklen_t) (offsetof(struct sockaddr_un, sun_path) + 1 + len);
+}
 
