+static void run_hook_dir(const char *dir, const char *user,
+			 const char *data, const char *rcpt)
+{
+	DIR *d = opendir(dir);
+	struct dirent *ent;
+
+	if (d == NULL) {
+		log_err(dir);
+		return;
+	}
+	while ((ent = readdir(d)) != NULL) {
+		char path[PATH_MAX];
+		struct stat st;
+		pid_t pid;
