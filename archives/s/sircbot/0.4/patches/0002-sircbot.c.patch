+/*
+ * A pathname AF_UNIX socket is not allowed in every environment: some
+ * kernels refuse to bind one outside of privileged directories (HarmonyOS
+ * answers EPERM for user directories).  The abstract namespace, where
+ * available, carries the very same name and has no such restriction.  The
+ * historical pathname address is therefore tried first, and the abstract
+ * address is used only when that first bind(2) is rejected.
+ */
+static socklen_t abstract_addr(struct sockaddr_un *sun, const char *name)
+{
+	size_t len = strlen(name);
+
+	if (len > sizeof(sun->sun_path) - 1)
+		len = sizeof(sun->sun_path) - 1;
+	memset(sun, 0, sizeof(*sun));
+	sun->sun_family = AF_UNIX;
+	sun->sun_path[0] = '\0';
+	memcpy(sun->sun_path + 1, name, len);
+	return (socklen_t) (offsetof(struct sockaddr_un, sun_path) + 1 + len);
+}
