     def clip(self):
         s = 0
         e = 0
         typ = 'H'
         isCorrect = False
         ms = Sam.CLIPSTART.match(self.cigar)
         if ms:
             s = int(ms.group(1))
             typ = ms.group(2)
         
         me = Sam.CLIPSTART.search(self.cigar)
         if me:
             e = int(me.group(1))
             if ms and ms.group(2) == me.group(2):
                 isCorrect = True
         return (typ, isCorrect, s, e)
 
