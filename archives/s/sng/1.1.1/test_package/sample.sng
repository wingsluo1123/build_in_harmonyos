#SNG: sng 1.1.1 OHOS consumer sample
# 4x2 paletted image.  Three palette entries are X11 colour *names*, so
# compiling this file makes sng look up rgb.txt (the rgb package).
IHDR: {
	width: 4;
	height: 2;
	bitdepth: 8;
	using color: palette;
}
PLTE: {
	"red"
	"dark slate gray"
	"gold"
	(0, 0, 255)
}
IMAGE: {
	pixels base64
0123
3210
}
tEXt: {
	keyword: "Title";
	text: "ohos-consumer";
}
