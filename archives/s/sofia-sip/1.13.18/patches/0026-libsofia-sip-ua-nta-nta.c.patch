+/* Re-SUBSCRIBE refreshes the existing notifier dialog. Respond to the
+ * in-dialog request before waiting for the resulting NOTIFY transaction.
+ */
+static int accept_refresh_until_notify_responded(CONDITION_PARAMS)
+{
+  void *with = nua_current_request(nua);
+
+  save_event_in_list(ctx, event, ep, call);
+
+  if (event == nua_i_subscribe && status < 200)
+    RESPOND(ep, call, nh, SIP_200_OK,
+            NUTAG_WITH(with),
+            SIPTAG_EXPIRES_STR("365"),
+            TAG_END());
+
+  return event == nua_r_notify && status >= 200;
+}
+
+/* The application owns the in-dialog unsubscribe request as well. */
+static int accept_unsubscribe_until_notify_responded(CONDITION_PARAMS)
+{
+  void *with = nua_current_request(nua);
+
+  save_event_in_list(ctx, event, ep, call);
+
+  if (event == nua_i_subscribe && status < 200)
+    RESPOND(ep, call, nh, SIP_200_OK,
+            NUTAG_WITH(with),
+            SIPTAG_EXPIRES_STR("0"),
+            TAG_END());
+
+  return event == nua_r_notify && status >= 200;
+}
