 static void skip_line(FILE *fp)
 {
-  fgetc(fp);
-  for ( ; fgetc(fp)!='\n' ; ) ;
-  return;
+  int ch;
+
+  /* Also consume the newline left by fscanf before the next header. */
+  if (fgetc(fp)!=EOF) {
+    while ((ch=fgetc(fp))!=EOF) {
+      if (ch=='\n') return;
+    }
+  }
+  fprintf(stderr,"\n\nERROR: Could not read required checkpoint header.\n");
+  terminate();
 }
 
 
