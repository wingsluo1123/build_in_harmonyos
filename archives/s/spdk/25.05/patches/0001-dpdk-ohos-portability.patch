+
+	if (tid <= 0)
+		return ESRCH;
+	rc = sched_getaffinity(tid, sizeof(*cpuset), cpuset);
+	return rc == 0 ? 0 : errno;
+#else
+	(void)thread_id;
+	(void)cpuset;
+	return ENOTSUP;
