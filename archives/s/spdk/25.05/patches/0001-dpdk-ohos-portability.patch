@@ -394,14 +395,42 @@
 rte_thread_set_affinity_by_id(rte_thread_t thread_id,
 		const rte_cpuset_t *cpuset)
 {
+#ifdef RTE_HAS_PTHREAD_SETAFFINITY_NP
 	return pthread_setaffinity_np((pthread_t)thread_id.opaque_id,
 		sizeof(*cpuset), cpuset);
+#elif defined(RTE_HAS_PTHREAD_GETTID_NP)
+	pid_t tid = pthread_gettid_np((pthread_t)thread_id.opaque_id);
+	int rc;
+
+	if (tid <= 0)
+		return ESRCH;
+	rc = sched_setaffinity(tid, sizeof(*cpuset), cpuset);
+	return rc == 0 ? 0 : errno;
+#else
+	(void)thread_id;
+	(void)cpuset;
+	return ENOTSUP;
+#endif
 }
 
