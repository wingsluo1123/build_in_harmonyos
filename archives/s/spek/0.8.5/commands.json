{
  "commands": [
    {
      "name": "spek-cli",
      "version": "0.8.5",
      "description": "Acoustic spectrum analyser (headless CLI)",
      "usage": "spek-cli [options] <audio-file>",
      "options": [
        {"flag": "--stream", "arg": "N", "desc": "Audio stream index"},
        {"flag": "--channel", "arg": "N", "desc": "Channel index"},
        {"flag": "--samples", "arg": "N", "desc": "FFT samples (power of 2)"},
        {"flag": "--window", "arg": "TYPE", "desc": "Window function"},
        {"flag": "--output", "arg": "FILE", "desc": "Output file"},
        {"flag": "--info", "desc": "Print file info"},
        {"flag": "--help", "desc": "Show help"}
      ]
    }
  ]
}
