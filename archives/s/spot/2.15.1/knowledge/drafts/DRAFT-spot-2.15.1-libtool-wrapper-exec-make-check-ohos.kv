last_updated:           2026-10-04
source_event:           spot/2.15.1 upstream full `make check` reproduction on OHOS PC real device (contrib task 10869)
source_package:         archives/s/spot/2.15.1
evidence:               reports/run-upstream-tests.sh, reports/upstream-test-run.md, reports/upstream-test.out (round 1: ./run 127 + musl relocating failures; round 2 after fixes: all green), conan-create.log (test_package 12/12), l2-smoke.log (L2 16/16 + codesign 20/20)
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.9
draft:                  true
