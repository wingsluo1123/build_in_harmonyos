+# HarmonyOS PC adaptation: consume the Conan-published libpq / libpqxx /
+# Boost.Regex packages instead of the upstream find_package(PostgreSQL)/
+# find_package(PQXX)/find_package(Boost) targets (the latter are not provided
+# by the OHOS package registry). libpqxx/8.0.1 and libpq/18.1 are the exact
+# versions already consumed by other packages in this registry; sqlsmith
+# links both (postgres.cc uses pqxx::connection and the libpq C API PQ*).
+find_package(libpq CONFIG REQUIRED)
+find_package(libpqxx CONFIG REQUIRED)
+target_link_libraries(sqlsmith PRIVATE libpq::libpq libpqxx::pqxx)
+set(HAVE_LIBPQXX8 TRUE)
+
+# sqlsmith always uses boost::regex: log.cc / monetdb.cc / sqlite.cc /
+# sqlsmith.cc include <boost/regex.hpp> unconditionally (only the top of
+# postgres.cc is guarded by HAVE_BOOST_REGEX). So require Boost.Regex
+# regardless of the std::regex configure probe result.
+find_package(boost1.84-regex CONFIG REQUIRED)
+target_link_libraries(sqlsmith PRIVATE boost1.84-regex::boost1.84-regex)
+set(HAVE_BOOST TRUE)
+set(HAVE_BOOST_REGEX TRUE)
