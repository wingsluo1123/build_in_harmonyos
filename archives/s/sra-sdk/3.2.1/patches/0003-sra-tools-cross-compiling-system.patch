--- a/build/env.cmake
+++ b/build/env.cmake
@@ -64,49 +64,58 @@
 set(CMAKE_CXX_EXTENSIONS OFF)
 
 # determine OS
-if ( ${CMAKE_HOST_SYSTEM_NAME} STREQUAL  "Darwin" )
+# OpenHarmony PC: honor the target system when cross-compiling, since the
+# build host reports its own (HarmonyOS/unknown) identification.
+if ( CMAKE_CROSSCOMPILING )
+    set( _SRA_SYSTEM_NAME ${CMAKE_SYSTEM_NAME} )
+    set( _SRA_SYSTEM_PROCESSOR ${CMAKE_SYSTEM_PROCESSOR} )
+else()
+    set( _SRA_SYSTEM_NAME ${_SRA_SYSTEM_NAME} )
+    set( _SRA_SYSTEM_PROCESSOR ${_SRA_SYSTEM_PROCESSOR} )
+endif()
+if ( ${_SRA_SYSTEM_NAME} STREQUAL  "Darwin" )
     set(OS "mac")
     set(LIBPFX "lib")
     set(SHLX "dylib")
     set(STLX "a")
-elseif ( ${CMAKE_HOST_SYSTEM_NAME} STREQUAL  "FreeBSD" )
+elseif ( ${_SRA_SYSTEM_NAME} STREQUAL  "FreeBSD" )
     set(OS "bsd")
     set(LIBPFX "lib")
     set(SHLX "so")
     set(STLX "a")
-elseif ( ${CMAKE_HOST_SYSTEM_NAME} STREQUAL  "Linux" )
+elseif ( ${_SRA_SYSTEM_NAME} STREQUAL  "Linux" )
     set(OS "linux")
     set(LIBPFX "lib")
     set(SHLX "so")
     set(STLX "a")
-elseif ( ${CMAKE_HOST_SYSTEM_NAME} STREQUAL  "NetBSD" )
+elseif ( ${_SRA_SYSTEM_NAME} STREQUAL  "NetBSD" )
     set(OS "bsd")
     set(LIBPFX "lib")
     set(SHLX "so")
     set(STLX "a")
-elseif ( ${CMAKE_HOST_SYSTEM_NAME} STREQUAL  "Windows" )
+elseif ( ${_SRA_SYSTEM_NAME} STREQUAL  "Windows" )
     set(OS "windows")
     set(LIBPFX "")
     set(STLX "lib")
 else()
-    message ( FATAL_ERROR "unknown OS " ${CMAKE_HOST_SYSTEM_NAME})
+    message ( FATAL_ERROR "unknown OS " ${_SRA_SYSTEM_NAME})
 endif()
 
 # determine architecture
-if ( ${CMAKE_HOST_SYSTEM_PROCESSOR} STREQUAL "armv7l")
+if ( ${_SRA_SYSTEM_PROCESSOR} STREQUAL "armv7l")
 	set(ARCH "armv7l")
-elseif ( ${CMAKE_HOST_SYSTEM_PROCESSOR} STREQUAL "arm64")
+elseif ( ${_SRA_SYSTEM_PROCESSOR} STREQUAL "arm64")
     set(ARCH "arm64")
-elseif ( ${CMAKE_HOST_SYSTEM_PROCESSOR} STREQUAL "aarch64")
+elseif ( ${_SRA_SYSTEM_PROCESSOR} STREQUAL "aarch64")
     set(ARCH "arm64")
-elseif ( ${CMAKE_HOST_SYSTEM_PROCESSOR} STREQUAL "x86_64")
+elseif ( ${_SRA_SYSTEM_PROCESSOR} STREQUAL "x86_64")
     set(ARCH "x86_64")
-elseif ( ${CMAKE_HOST_SYSTEM_PROCESSOR} STREQUAL "amd64")
+elseif ( ${_SRA_SYSTEM_PROCESSOR} STREQUAL "amd64")
     set(ARCH "x86_64")
-elseif ( ${CMAKE_HOST_SYSTEM_PROCESSOR} STREQUAL "AMD64")
+elseif ( ${_SRA_SYSTEM_PROCESSOR} STREQUAL "AMD64")
     set(ARCH "x86_64")
 else()
-    message ( FATAL_ERROR "unknown architecture " ${CMAKE_HOST_SYSTEM_PROCESSOR})
+    message ( FATAL_ERROR "unknown architecture " ${_SRA_SYSTEM_PROCESSOR})
 endif ()
 
 if( "arm64" STREQUAL "${ARCH}" )
