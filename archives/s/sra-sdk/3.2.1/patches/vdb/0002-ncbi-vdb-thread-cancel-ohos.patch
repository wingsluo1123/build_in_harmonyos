@@ -67,6 +67,18 @@
 
 
 #GenerateStaticLibs( ksproc "${SPROC_SRC}" )
+# Detect pthread cancellation at build time (musl does not implement it).
+include( CheckCSourceCompiles )
+set( CMAKE_REQUIRED_LIBRARIES pthread )
+check_c_source_compiles(
+    "#include <pthread.h>
+     int main ( void ) { pthread_t t = pthread_self (); return pthread_cancel ( t ); }"
+    HAVE_PTHREAD_CANCEL )
+unset( CMAKE_REQUIRED_LIBRARIES )
+if ( HAVE_PTHREAD_CANCEL )
+    add_compile_definitions( HAVE_PTHREAD_CANCEL=1 )
+endif()
+
 GenerateStaticLibs( kproc "${PROC_SRC}" )
 GenerateStaticLibs( kq queue )
 
