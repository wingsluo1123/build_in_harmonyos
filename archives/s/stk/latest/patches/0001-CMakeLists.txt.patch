--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -160,6 +160,9 @@
   add_definitions(-D__LITTLE_ENDIAN__)
 endif()
 add_definitions(-D_USE_MATH_DEFINES)
+
+# STK_HAVE_PTHREAD_CANCEL is supplied on the cmake command line by the
+# Conan recipe (as a cache variable), NOT probed here.  A link-time
+# check_symbol_exists() is unsafe on musl/OHOS, where pthread_cancel is
+# present as a symbol but undeclared in <pthread.h>; the recipe instead
+# probes for the *declaration* and defines the macro accordingly so the
+# cancel paths compile out on platforms that lack them.
 if(INSTALL_HEADERS)
     file(GLOB STK_HEADERS "include/*.h")
     install(FILES ${STK_HEADERS} DESTINATION include/stk)
