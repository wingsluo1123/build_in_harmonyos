@@ -0,0 +1,16 @@
+#include <stlink.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+int main() {
+    stlink_t *sl = NULL;
+    sl = stlink_open_usb(0, 0, NULL, 0);
+    if (sl) {
+        printf("Successfully opened ST-LINK device.\n");
+        stlink_close(sl);
+    } else {
+        printf("No ST-LINK device found, but library loaded correctly.\n");
+    }
+    return 0;
+}
