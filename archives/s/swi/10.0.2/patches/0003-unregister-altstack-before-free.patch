+#ifdef O_C_STACK_GUARDED
+/* Alternate signal stacks belong to OS threads, not movable Prolog engines. */
+static bool
+release_signal_stack(void *memory)
+{ stack_t current;
+
+  if ( sigaltstack(NULL, &current) != 0 )
+    return false;
+  if ( !(current.ss_flags & SS_DISABLE) && current.ss_sp == memory )
+  { stack_t disabled = {0};
+    disabled.ss_flags = SS_DISABLE;
+    if ( sigaltstack(&disabled, NULL) != 0 )
+      return false; /* Keep backing memory alive while it remains registered. */
+  }
+  free(memory);
+  return true;
+}
+
+#ifdef O_PLMT
+static pthread_key_t signal_stack_key;
+static pthread_once_t signal_stack_once = PTHREAD_ONCE_INIT;
+static bool signal_stack_key_ready = false;
+
+static void
+destroy_signal_stack(void *memory)
+{ (void)release_signal_stack(memory);
+}
+
+static void
+create_signal_stack_key(void)
+{ signal_stack_key_ready =
+    pthread_key_create(&signal_stack_key, destroy_signal_stack) == 0;
+}
+#endif
+#endif
