diff --git a/swift-package-manager-swift-6.0.3-RELEASE/Sources/PackageLoading/PackageDescriptionSerialization.swift b/swift-package-manager-swift-6.0.3-RELEASE/Sources/PackageLoading/PackageDescriptionSerialization.swift
