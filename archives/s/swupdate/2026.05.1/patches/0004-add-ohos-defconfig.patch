diff --git a/configs/ohos_defconfig b/configs/ohos_defconfig
new file mode 100644
index 0000000..6d1f8d8
--- /dev/null
+++ b/configs/ohos_defconfig
@@ -0,0 +1,27 @@
+# SPDX-FileCopyrightText: 2026 OpenHarmony PC Developer
+# SPDX-License-Identifier: CC0-1.0
+#
+# Configuration for OpenHarmony / HarmonyOS PC (aarch64).
+# Feature set is limited to what the OHOS package repository provides:
+# openssl, libconfig, json-c, libcurl, libarchive, lua, zlib.
+# libubootenv / libmtd / libubi / zeromq / librsync / libwebsockets /
+# uriparser / zstd / zck / wolfssl / mbedtls are not available and the
+# corresponding faces are left disabled.
+CONFIG_HW_COMPATIBILITY=y
+CONFIG_DOWNLOAD=y
+CONFIG_WEBSERVER=y
+CONFIG_MONGOOSESSL=y
+CONFIG_HASH_VERIFY=y
+CONFIG_SIGNED_IMAGES=y
+CONFIG_SIGALG_RAWRSA=y
+CONFIG_ENCRYPTED_IMAGES=y
+CONFIG_SURICATTA=y
+CONFIG_LUAEXTERNAL=y
+CONFIG_ARCHIVE=y
+CONFIG_LUASCRIPTHANDLER=y
+CONFIG_RAW=y
+CONFIG_SHELLSCRIPTHANDLER=y
+# MTD/UBI faces: libmtd + libubi are available on the OHOS package repo
+CONFIG_MTD=y
+CONFIG_CFI=y
+CONFIG_UBIVOL=y
