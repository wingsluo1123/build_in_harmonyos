 #
 macro(configure_xorg_libs)
 
+  # OHOS: the conan-provided X11 client headers and libraries live outside
+  # the compiler's default search path. The recipe exports their locations
+  # through these cache variables; put them on the directory-level include
+  # and link paths so every target below inherits them (upstream assumes
+  # /usr/include and bare -l names resolve system-wide).
+  if(SYNERGY_CONAN_INCLUDE_DIRS)
+    include_directories(${SYNERGY_CONAN_INCLUDE_DIRS})
+  endif()
+  if(SYNERGY_CONAN_LIB_DIRS)
+    link_directories(${SYNERGY_CONAN_LIB_DIRS})
+  endif()
+
   # Set include dir for BSD-derived systems
-  set(CMAKE_REQUIRED_INCLUDES "/usr/local/include")
+  # OHOS: append instead of overwriting so the dependency include directories
+  # injected through the toolchain stay on the probe path; /usr/local/include
+  # only resolves on BSD hosts and is a no-op here.
+  list(APPEND CMAKE_REQUIRED_INCLUDES "/usr/local/include")
 
   set(XKBlib "X11/Xlib.h;X11/XKBlib.h")
   set(CMAKE_EXTRA_INCLUDE_FILES "${XKBlib};X11/extensions/Xrandr.h")
   check_type_size("XRRNotifyEvent" X11_EXTENSIONS_XRANDR_H)
+  # OHOS: normalize to a numeric value; an absent Xrandr leaves the size
+  # empty, which would emit an empty #define and an empty controlling
+  # expression in XWindowsConfig.h.
+  if(NOT X11_EXTENSIONS_XRANDR_H)
+    set(X11_EXTENSIONS_XRANDR_H 0)
+  endif()
   set(HAVE_X11_EXTENSIONS_XRANDR_H "${X11_EXTENSIONS_XRANDR_H}")
   set(CMAKE_EXTRA_INCLUDE_FILES)
 
