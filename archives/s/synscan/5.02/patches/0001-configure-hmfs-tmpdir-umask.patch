--- a/configure	2026-10-12 05:50:32.581182612 +0000
+++ b/configure	2026-10-12 05:50:32.589182454 +0000
@@ -4289,14 +4289,13 @@
   trap 'as_fn_exit 1' 1 2 13 15
 }
 # Create a (secure) tmp directory for tmp files.
+# OHOS/HMFS: a dir produced with umask 077 cannot be written afterwards (a setgid
+# + 077 dir comes out owner-unwritable), so config.status dies in ./conf*/subs1.awk:
+# Permission denied.  Drop the mktemp branch and always mkdir under umask 022.
 
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
-  test -d "$tmp"
-}  ||
-{
   tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  (umask 022 && mkdir "$tmp")
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
 
