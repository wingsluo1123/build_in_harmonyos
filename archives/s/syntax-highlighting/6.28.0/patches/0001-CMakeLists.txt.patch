--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -3,6 +3,12 @@
 set(KF_VERSION "6.28.0")
 project(KSyntaxHighlighting VERSION ${KF_VERSION})
 
+# OHOS: the Conan/CMake toolchain may carry a lower C++ standard (profile
+# cppstd=17) that shadows library-only cache settings; indexer code uses
+# std::strong_ordering (C++20), so force the project standard here.
+set(CMAKE_CXX_STANDARD 20)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+
 find_package(ECM 6.28.0 REQUIRED NO_MODULE)
 set(CMAKE_MODULE_PATH ${ECM_MODULE_PATH})
 
