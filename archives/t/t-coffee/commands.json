{
  "name": "t-coffee",
  "description": "提供 `t_coffee` 命令行工具：T-COFFEE 多序列比对（MSA）程序，用树一致目标函数（tree-based consistency objective function）做渐进式比对，支持蛋白/核酸/RNA 序列与结构（3D-Coffee / Expresso 家族的核心引擎），输出 CLUSTAL W / FASTA / GCG / PHYLIP / SRAM 等多种格式",
  "homepage": "https://www.tcoffee.org",
  "type": "tool",
  "versions": {
    "13.45.0.484626413.41.0.28bdc39": {
      "ref": "t-coffee/13.45.0.484626413.41.0.28bdc39",
      "binary": false,
      "commands": [
        "t_coffee -version",
        "t_coffee -h",
        "t_coffee seqs.fasta -output clustalw -outfile aln.aln",
        "t_coffee seqs.fasta -output fasta -outfile aln.fasta",
        "t_coffee seqs.fasta -method fasta_pair_wise -output clustalw -outfile aln.aln",
        "t_coffee -lib_only -in seqs.fasta",
        "t_coffee seqs.fasta -quicktree -outfile tree.dnd",
        "t_coffee seqs.fasta -n_core 1 -output phylip -outfile aln.phy"
      ]
    }
  }
}
