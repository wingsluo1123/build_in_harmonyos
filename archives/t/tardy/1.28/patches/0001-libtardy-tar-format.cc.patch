+//
+// Some tar implementations store numeric header fields that do not fit in
+// the fixed-width octal representation using the GNU "base-256" extension:
+// the high bit of the first byte is set and the value is a big-endian
+// binary number in the remaining bytes.  GNU tar emits this for uids/gids
+// above 2097151, and this platform's tar (toybox) does the same because the
+// build user's uid is 20001006.  Without this, tardy refuses such archives
+// with "corrupted uid field".
+//
+static long
+numeric(const char *buf, long len)
+{
+    if (len > 0 && (static_cast<unsigned char>(buf[0]) & 0x80))
+    {
+        long value = static_cast<unsigned char>(buf[0]) & 0x7F;
+        for (long j = 1; j < len; ++j)
+            value = (value << 8) | static_cast<unsigned char>(buf[j]);
+        return value;
+    }
+    return octal(buf, len);
+}
+
+
 static void
 padded_octal(char pad, char *buf, long len, long n)
 {
     assert(len >= 2);
     --len;
     buf[len] = 0;
     memset(buf, pad, len);
     while (len > 0)
     {
         buf[--len] = '0' + (n & 7);
