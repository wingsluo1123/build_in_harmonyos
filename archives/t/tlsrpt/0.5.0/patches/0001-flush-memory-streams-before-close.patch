+/* Flush publishes the buffer even on libcs whose memory-stream close
+ * returns EBADF. A failed flush must remain an error; always close the stream
+ * to release its resources, preserving the first failure's errno. */
+static int tlsrpt_close_memstream(FILE *stream) {
+  int flush_result = fflush(stream);
+  int flush_errno = errno;
+  int close_result = fclose(stream);
+  if (flush_result != 0) {
+    errno = flush_errno;
+    return EOF;
+  }
+  if (close_result != 0 && errno == EBADF) return 0;
+  return close_result;
+}
