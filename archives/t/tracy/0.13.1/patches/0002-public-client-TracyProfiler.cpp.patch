+#elif defined __OHOS__
+    // OHOS bionic does not expose program_invocation_short_name; fall back to
+    // /proc/self/cmdline which contains argv[0] (the executable basename) as
+    // the first null-terminated token.
+    static char cmdlineBuf[1024];
+    int fd = open( "/proc/self/cmdline", O_RDONLY );
+    if( fd >= 0 )
+    {
+        int len = read( fd, cmdlineBuf, sizeof( cmdlineBuf ) - 1 );
+        close( fd );
+        if( len > 0 )
+        {
+            cmdlineBuf[len] = '\0';
+            // Strip leading path components to mirror program_invocation_short_name.
+            // Stop at the first NUL byte: cmdline entries are separated by '\0',
+            // and scanning past argv[0] could land on a '/' inside a later arg
+            // (e.g. `--config=/etc/foo`).
+            const char* base = cmdlineBuf;
+            for( int i = 0; i < len && cmdlineBuf[i] != '\0'; ++i )
+            {
+                if( cmdlineBuf[i] == '/' ) base = cmdlineBuf + i + 1;
+            }
+            processName = base;
+        }
+    }
 #elif defined __linux__ && defined _GNU_SOURCE
     if( program_invocation_short_name ) processName = program_invocation_short_name;
 #elif defined __APPLE__ || defined BSD
     auto buf = getprogname();
     if( buf ) processName = buf;
 #elif defined __QNX__
     processName = __progname;
 #endif
     return processName;
 }
 
