+	int i, j, qlen = q->qlen, m_b = 0, n_b = 0, te = -1, gmax = 0, minsc, endsc;
+	uint64_t *b = 0;
+	int16_t *H0 = (int16_t*)q->H0, *H1 = (int16_t*)q->H1, *E = (int16_t*)q->E, *Hmax = (int16_t*)q->Hmax;
+	int16_t *qp = (int16_t*)q->qp;
+	int gapoe = _gapo + _gape, gape = _gape;
+	kswr_t r = g_defr;
+
+	// initialization
+	minsc = (xtra&KSW_XSUBO)? xtra&0xffff : 0x10000;
+	endsc = (xtra&KSW_XSTOP)? xtra&0xffff : 0x10000;
+	for (i = 0; i < qlen; ++i) E[i] = H0[i] = Hmax[i] = 0;
+	// the core loop
+	for (i = 0; i < tlen; ++i) {
+		int16_t *S = qp + target[i] * qlen; // S is the score vector of target[i]
+		int imax = 0, f = 0;
+		for (j = 0; j < qlen; ++j) {
+			int e, h = j == 0? 0 : (int)H0[j-1];
+			h = KSW_ADDS_I16(h, (int)S[j]);
+			if (h < (int)E[j]) h = E[j];
+			if (h < f) h = f; // h=H(i,j)
+			H1[j] = (int16_t)h;
+			if (h > imax) imax = h;
+			e = KSW_SUBS_U16(E[j], gape);
+			h = KSW_SUBS_U16(h, gapoe);
+			E[j] = (int16_t)(e > h? e : h); // E(i+1,j)
+			f = KSW_SUBS_U16(f, gape);
+			if (f < h) f = h; // F(i,j+1)
+		}
+		if (imax >= minsc) {
+			if (n_b == 0 || (int32_t)b[n_b-1] + 1 != i) {
+				if (n_b == m_b) {
+					m_b = m_b? m_b<<1 : 8;
+					b = (uint64_t*)realloc(b, 8 * m_b);
+				}
+				b[n_b++] = (uint64_t)imax<<32 | i;
+			} else if ((int)(b[n_b-1]>>32) < imax) b[n_b-1] = (uint64_t)imax<<32 | i; // modify the last
+		}
+		if (imax > gmax) {
+			gmax = imax; te = i;
+			memcpy(Hmax, H1, qlen * sizeof(int16_t));
+			if (gmax >= endsc) break;
+		}
+		{ int16_t *t = H0; H0 = H1; H1 = t; } // swap H0 and H1
+	}
+	r.score = gmax; r.te = te;
+	{
+		int max = -1, low, high;
+		int16_t *t = Hmax;
+		for (i = 0, r.qe = -1; i < qlen; ++i, ++t)
+			if ((int)*t > max) max = *t, r.qe = i;
+		if (b) {
+			i = (r.score + q->max - 1) / q->max;
+			low = te - i; high = te + i;
+			for (i = 0; i < n_b; ++i) {
+				int e = (int32_t)b[i];
+				if ((e < low || e > high) && (int)(b[i]>>32) > r.score2)
