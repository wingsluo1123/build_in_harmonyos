+#define KSW_ADDS_U8(a, b) ((a) + (b) > 255? 255 : (a) + (b))
+#define KSW_SUBS_U8(a, b) ((a) > (b)? (a) - (b) : 0)
+#define KSW_ADDS_I16(a, b) ((a) + (b) > 32767? 32767 : ((a) + (b) < -32768? -32768 : (a) + (b)))
+#define KSW_SUBS_U16(a, b) ((a) > (b)? (a) - (b) : 0)
+
+/**
+ * Initialize the query data structure
+ *
+ * @param size   Number of bytes used to store a score; valid valures are 1 or 2
+ * @param qlen   Length of the query sequence
+ * @param query  Query sequence
+ * @param m      Size of the alphabet
+ * @param mat    Scoring matrix in a one-dimention array
+ *
+ * @return       Query data structure
+ */
+kswq_t *ksw_qinit(int size, int qlen, const uint8_t *query, int m, const int8_t *mat)
+{
+	kswq_t *q;
+	int a, k, tmp;
+
+	size = size > 1? 2 : 1;
+	q = (kswq_t*)calloc(1, sizeof(kswq_t) + 256 + qlen * (m + 4) * (size == 1? 1 : 2)); // a single block of memory
+	q->qp = (void*)(((size_t)q + sizeof(kswq_t) + 15) >> 4 << 4); // align memory
+	q->H0 = (uint8_t*)q->qp + qlen * m * (size == 1? 1 : 2);
+	q->H1 = (uint8_t*)q->H0 + qlen * (size == 1? 1 : 2);
+	q->E  = (uint8_t*)q->H1 + qlen * (size == 1? 1 : 2);
+	q->Hmax = (uint8_t*)q->E + qlen * (size == 1? 1 : 2);
+	q->slen = qlen; q->qlen = qlen; q->size = size;
+	// compute shift
+	tmp = m * m;
+	for (a = 0, q->shift = 127, q->mdiff = 0; a < tmp; ++a) { // find the minimum and maximum score
+		if (mat[a] < (int8_t)q->shift) q->shift = mat[a];
+		if (mat[a] > (int8_t)q->mdiff) q->mdiff = mat[a];
+	}
+	q->max = q->mdiff;
+	q->shift = 256 - q->shift; // NB: q->shift is uint8_t
+	q->mdiff += q->shift; // this is the difference between the min and max scores
+	// unlike the SSE2 path, the profile is stored linearly: row a holds the
+	// score of every query position against residue a
+	if (size == 1) {
+		uint8_t *t = (uint8_t*)q->qp;
+		for (a = 0; a < m; ++a) {
+			const int8_t *ma = mat + a * m;
+			for (k = 0; k < qlen; ++k)
+				*t++ = (uint8_t)(ma[query[k]] + q->shift);
+		}
+	} else {
+		int16_t *t = (int16_t*)q->qp;
+		for (a = 0; a < m; ++a) {
+			const int8_t *ma = mat + a * m;
+			for (k = 0; k < qlen; ++k)
+				*t++ = ma[query[k]];
+		}
+	}
+	return q;
+}
