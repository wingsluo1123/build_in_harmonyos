+#define RTP_HDR_SZ     12
+#define RTP_PACKET_MAX 65535
+#define RTP_MP2T_PT    33
+
+static uint8_t ts_packet[RTP_PACKET_MAX];
+
+static int rtp_payload(uint8_t *packet, ssize_t *packet_len, uint16_t *sequence) {
+	size_t i, header_len, payload_len, padding_len;
+	uint16_t extension_words;
+	uint8_t csrc_count;
+
+	if (*packet_len < RTP_HDR_SZ)
+		return 0;
+	if ((packet[0] >> 6) != 2 || (packet[1] & 0x7f) != RTP_MP2T_PT)
+		return 0;
+
+	csrc_count = packet[0] & 0x0f;
+	header_len = RTP_HDR_SZ + (size_t)csrc_count * 4;
+	if (header_len > (size_t)*packet_len)
+		return 0;
+
+	if (packet[0] & 0x10) {
+		if ((size_t)*packet_len - header_len < 4)
+			return 0;
+		extension_words = (packet[header_len + 2] << 8) | packet[header_len + 3];
+		if (extension_words > ((size_t)*packet_len - header_len - 4) / 4)
+			return 0;
+		header_len += 4 + (size_t)extension_words * 4;
+	}
+
+	payload_len = (size_t)*packet_len - header_len;
+	if (packet[0] & 0x20) {
+		padding_len = packet[*packet_len - 1];
+		if (padding_len == 0 || padding_len > payload_len)
+			return 0;
+		payload_len -= padding_len;
+	}
+	if (payload_len == 0 || payload_len > FRAME_SIZE || payload_len % 188 != 0)
+		return 0;
+	for (i = 0; i < payload_len; i += 188) {
+		if (packet[header_len + i] != 0x47)
+			return 0;
+	}
+
+	*sequence = (packet[2] << 8) | packet[3];
+	memmove(packet, packet + header_len, payload_len);
+	*packet_len = payload_len;
+	return 1;
+}
 
