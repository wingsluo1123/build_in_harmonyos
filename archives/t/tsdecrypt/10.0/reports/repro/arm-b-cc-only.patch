+	csrc_count = packet[0] & 0x0f;
+	header_len = RTP_HDR_SZ + (size_t)csrc_count * 4;
+	if (header_len > (size_t)*packet_len)
+		return 0;
+
+	payload_len = (size_t)*packet_len - header_len;
+	if (payload_len == 0 || payload_len > FRAME_SIZE || payload_len % 188 != 0)
+		return 0;
+	for (i = 0; i < payload_len; i += 188) {
+		if (packet[header_len + i] != 0x47)
+			return 0;
+	}
