+static int rtp_payload(uint8_t *packet, ssize_t *packet_len, uint16_t *sequence) {
+	size_t i, header_len, payload_len;
+	uint8_t csrc_count;
+
+	if (*packet_len < RTP_HDR_SZ)
+		return 0;
+	if ((packet[0] >> 6) != 2 || (packet[1] & 0x7f) != RTP_MP2T_PT)
+		return 0;
