 #! /bin/sh -e
+
+# OpenHarmony worker spawn pressure. The CI worker runs at ~670 live processes
+# with only a handful of free process slots, so what decides whether a step
+# succeeds is how many processes it needs *at the same time*: a plain compile
+# needs three (this shell -> clang -> clang -cc1) and those always pass, while
+# the final link used to need five (this shell -> command substitution ->
+# link.sh -> clang -> linker) and died with
+# `posix_spawn failed: Resource temporarily unavailable`. See notes.md #9.
+#
+# Hence the two rules for everything wrapped in retry_spawn():
+#   1. hold no extra process of our own while the fragile spawn happens, and
+#   2. keep the chain no longer than the compile steps that already work.
+# Rule 1 is why the diagnostics are replayed with shell builtins instead of
+# `out=$(...)`: a command substitution keeps a subshell alive for as long as
+# the command runs, i.e. exactly one process slot too many at the moment that
+# matters. Rule 2 is why link.sh is inlined at its one call site below.
+# TUP_SPAWN_ATTEMPTS/TUP_SPAWN_WAIT/TUP_SPAWN_WAIT_MAX tune the retry loop.
+spawn_attempts=${TUP_SPAWN_ATTEMPTS:-15}
+spawn_wait=${TUP_SPAWN_WAIT:-20}
+spawn_wait_max=${TUP_SPAWN_WAIT_MAX:-60}
+spawn_log=${TUP_SPAWN_LOG:-spawn.log}
+
+retry_spawn() {
+	tries=0
+	wait=$spawn_wait
+	while :; do
+		tries=$((tries + 1))
+		# 必须放在条件上下文里：本脚本以 `sh -e` 运行（配方 `{shell} -e ./build.sh`，
+		# shebang 也是 `#! /bin/sh -e`），裸写 `"$@"` 一旦失败就会在 set -e 下直接
+		# 结束脚本，下面的回放与重试全都不可达（构建日志里也就看不到失败特征）。
+		if "$@" >"$spawn_log" 2>&1; then
+			rc=0
+		else
+			rc=$?
+		fi
+		# Replay and classify in one pass: `read`, `printf` and `case` are
+		# all builtins, so this part costs no process slot at all.
+		exhausted=0
+		while IFS= read -r line || [ -n "$line" ]; do
+			printf '%s\n' "$line"
+			case "$line" in
+			*"Resource temporarily unavailable"*|*"can't fork"*|*"cannot fork"*)
+				exhausted=1
+				;;
+			esac
+		done < "$spawn_log"
+		if [ "$rc" -eq 0 ]; then
+			return 0
+		fi
+		if [ "$exhausted" -ne 1 ]; then
+			return "$rc"
+		fi
+		if [ "$tries" -ge "$spawn_attempts" ]; then
+			echo "spawn-resource exhaustion persisted through $tries attempts" 1>&2
+			return "$rc"
+		fi
+		# A single-process probe records, for the next round of triage,
+		# whether the whole host is out of slots or whether this step alone
+		# asks for more than the compile steps do.
+		probe="cannot fork"
+		if /bin/sh -c : 2>/dev/null; then
+			probe="can fork"
+		fi
+		echo "  spawn-resource exhaustion; retrying in ${wait}s (attempt $tries of $spawn_attempts, probe: $probe)" 1>&2
+		sleep "$wait"
+		wait=$((wait * 2))
+		if [ "$wait" -gt "$spawn_wait_max" ]; then
+			wait=$spawn_wait_max
+		fi
+	done
+}
 
