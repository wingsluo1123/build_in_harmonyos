+/* Return non-zero if an open() carrying O_CREAT would have to create the
+ * file, i.e. the path does not exist yet. The probe goes through a plain
+ * libc call so it does not raise a dependency event of its own.
+ *
+ * open(name, O_CREAT) without O_WRONLY/O_RDWR is how the toybox userland
+ * shipped by OpenHarmony creates a missing file (e.g. `touch newfile`).
+ * Creating a file is a write, but the flag test above cannot see it, so
+ * the caller needs to know whether the open is about to create the target.
+ */
+static int will_create(int dirfd, const char *path)
+{
+	struct stat st;
+
+	if(fstatat(dirfd, path, &st, 0) == 0)
+		return 0;
+	return errno == ENOENT;
+}
