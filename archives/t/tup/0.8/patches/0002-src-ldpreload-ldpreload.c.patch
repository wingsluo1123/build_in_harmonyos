+static int open_depfd(void)
+{
+	if(depfd >= 0)
+		return 0;
+	if(!depfile_path)
+		return -1;
+	/* WRAP() can call open() itself, so guard against re-entrancy by
+	 * resolving the real symbol without touching the wrapper above. */
+	if(!s_open)
