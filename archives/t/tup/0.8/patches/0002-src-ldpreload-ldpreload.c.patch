+/* OpenHarmony ships toybox as its core userland. Unlike GNU coreutils
+ * touch -- which opens the target with O_WRONLY|O_CREAT and is caught by
+ * the open() wrapper above -- toybox touch updates timestamps with a bare
+ * utimensat() on an existing file, and creates a missing file with
+ * open(name, O_CREAT). Neither path used to raise a dependency event, so
+ * every rule whose command created its output with `touch` was reported as
+ * "Expected to write to file ... but didn't". Record a successful
+ * timestamp change as a write, matching what the FUSE server does in
+ * tup_fs_utimens().
+ */
+int utimensat(int dirfd, const char *pathname, const struct timespec times[2], int flags)
+{
+	struct stat st;
+	int rc;
+
+	WRAP(s_utimensat, "utimensat");
+	rc = s_utimensat(dirfd, pathname, times, flags);
+	if(rc != 0)
+		return rc;
+	/* tup tracks files, not directories. `touch dir` on the toybox
+	 * userland ends up here, and turning that into a write event makes
+	 * tup create a node for the directory whose create_list flag is
+	 * never cleared. Only report regular-ish targets. */
+	if(fstatat(dirfd, pathname, &st, 0) < 0)
+		return rc;
+	if(!S_ISDIR(st.st_mode))
+		handle_file_dirfd(dirfd, pathname, "", ACCESS_WRITE);
+	return rc;
+}
 
