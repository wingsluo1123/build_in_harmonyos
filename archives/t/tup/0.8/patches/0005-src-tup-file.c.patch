+/* tmpfile() with a configurable directory.
+ *
+ * libc's tmpfile() hard-codes /tmp (P_tmpdir) on both glibc and musl, so it is
+ * unusable wherever /tmp is not writable. That is the case on OpenHarmony PCs,
+ * where /tmp is a read-only erofs mount. Fall back through:
+ *
+ *   1. $TMPDIR      - the standard override, and what the platform expects
+ *                     (OpenHarmony build tooling sets TMPDIR=$HOME/tmp)
+ *   2. .tup/tmp     - tup's own scratch directory, always writable since tup
+ *                     has to write .tup/db into the same tree. This makes tup
+ *                     work out of the box on platforms without a usable /tmp.
+ *   3. /tmp         - last resort, keeping the historical behaviour.
+ *
+ * Semantics match tmpfile(): the file is unnamed and removed on close (or
+ * immediately after opening), so callers only see the FILE*.
+ */
+FILE *tup_tmpfile(void)
+{
+	const char *dirs[] = {
+		getenv("TMPDIR"),
+		".tup/tmp",
+		"/tmp",
+	};
+	unsigned int i;
+
+	for(i = 0; i < sizeof(dirs) / sizeof(dirs[0]); i++) {
+		const char *dir = dirs[i];
+		char path[PATH_MAX];
+		int fd;
+
+		if(!dir || !dir[0])
+			continue;
+
+		if(i == 1) {
+			/* .tup/tmp may not exist yet (it is created on demand,
+			 * like the graph dumps and command backups).
+			 */
+			if(mkdir(dir, 0777) < 0 && errno != EEXIST)
+				continue;
+		}
+
+		if(snprintf(path, sizeof(path), "%s/tup-tmp-XXXXXX", dir)
+		   >= (int)sizeof(path)) {
+			errno = ENAMETOOLONG;
+			continue;
+		}
+		fd = mkstemp(path);
+		if(fd < 0)
+			continue;
+		if(unlink(path) < 0) {
+			close(fd);
+			continue;
+		}
+		return fdopen(fd, "w+b");
+	}
+	return NULL;
+}
