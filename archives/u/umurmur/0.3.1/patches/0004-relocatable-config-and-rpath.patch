diff --git a/src/conf.c b/src/conf.c
index e645364..1bda129 100644
--- a/src/conf.c
+++ b/src/conf.c
@@ -32,0 +33 @@
+#include <limits.h>
@@ -35,0 +37 @@
+#include <unistd.h>
@@ -51 +53,22 @@ static config_t configuration;
-const char defaultconfig[] = DEFAULT_CONFIG;
+const char *Conf_getDefaultPath(void)
+{
+	static char resolved[PATH_MAX];
+	char executable[PATH_MAX];
+	char *separator;
+	ssize_t length;
+	int written;
+
+	length = readlink("/proc/self/exe", executable, sizeof(executable) - 1);
+	if (length <= 0 || (size_t)length >= sizeof(executable))
+		return DEFAULT_CONFIG;
+	executable[length] = '\0';
+	separator = strrchr(executable, '/');
+	if (separator == NULL)
+		return DEFAULT_CONFIG;
+	*separator = '\0';
+	written = snprintf(resolved, sizeof(resolved),
+		"%s/../etc/umurmur/umurmur.conf", executable);
+	if (written < 0 || (size_t)written >= sizeof(resolved))
+		return DEFAULT_CONFIG;
+	return resolved;
+}
@@ -57 +80 @@ void Conf_init(const char *conffile)
-		conffile = defaultconfig;
+		conffile = Conf_getDefaultPath();
@@ -69 +92 @@ bool_t Conf_ok(const char *conffile)
-		conffile = defaultconfig;
+		conffile = Conf_getDefaultPath();
