 int main(int argc,const char **argv)
 {
+	#ifdef GNUSTEP
+	// GNUstep's date and calendar APIs resolve the default time zone from
+	// the TZ environment variable or the system zone files. On systems
+	// that provide neither, they raise an exception instead of falling
+	// back to UTC (the missing zone data results in a NULL string).
+	// Default to UTC when no usable time zone source is present.
+	if(!getenv("TZ")
+	&&access("/etc/localtime",F_OK)!=0
+	&&access("/usr/lib/zoneinfo",F_OK)!=0)
+		setenv("TZ","UTC",0);
+	#endif
