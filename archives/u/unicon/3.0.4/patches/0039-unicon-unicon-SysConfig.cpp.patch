+/* Read one line into szLine (null-terminated, newline stripped).
+ * Returns szLine on success, NULL at EOF of an empty line.
+ * (Replaces the C++98 member gets(), removed in C++11; the char*
+ * overloads of std::getline are not offered by the OHOS libc++ header
+ * set, so use the always-present istream::get(char*) member.) */
+static char *ReadConfigLine (std::istream &a, char *szLine, int n)
+{
+    int i = 0;
+    int c = a.get ();
+    while (c != EOF && c != '\n' && i < n - 1) {
+        szLine [i++] = (char) c;
+        c = a.get ();
+    }
+    szLine [i] = '\0';
+    if (c == EOF && i == 0)
+        return NULL;
+    return szLine;
+}
