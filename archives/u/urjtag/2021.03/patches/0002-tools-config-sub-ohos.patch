--- a/tools/config.sub
+++ b/tools/config.sub
@@ -110,6 +110,16 @@
     exit 1;;
 esac
 
+# The HarmonyOS OHOS platform (host triplet aarch64-linux-ohos) postdates this
+# bundled config.sub (2018-02-22, no `ohos` system); pass its triples through
+# unchanged (same fix as a52dec/0.7.4).
+case $1 in
+  aarch64-*-ohos*)
+    echo "$1"
+    exit 0
+    ;;
+esac
+
 # Separate what the user gave into CPU-COMPANY and OS or KERNEL-OS (if any).
 # Here we must recognize all the valid KERNEL-OS combinations.
 maybe_os=`echo "$1" | sed 's/^\(.*\)-\([^-]*-[^-]*\)$/\2/'`
