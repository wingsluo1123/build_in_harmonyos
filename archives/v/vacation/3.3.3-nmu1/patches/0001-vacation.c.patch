+/* Apply policy only after a complete, unfolded logical header is available. */
+void process_header(char *buf, int *tome)
+{
+	ALIAS *cur;
+	char *p, *q, *end;
+
+	switch(*buf) {
+		case 'F':		/* "From " */
+			if (!strncmp(buf, "From ", 5)) {
+				for (p = buf + 5; *p && *p != ' '; ++p);
+				*p = '\0';
+				if (snprintf(from, sizeof(from), "%s", buf + 5) >=
+				    (int)sizeof(from))
+					discard_exit();
+				if (junkmail())
+					discard_exit();
+			}
+			break;
+		case 'r':
+		case 'R':		/* "Return-Path:" */
+					/* EvB: this may use Name <addr@host> */
+			if (strncasecmp(buf, "Return-Path:", 12) ||
+			    (buf[12] != '\0' && buf[12] != ' ' && buf[12] != '\t'))
+				break;
+			for (p = buf + 12; *p && isspace(*p); ++p);
+			if ((q = strchr(p, '<'))) 
+				p = q + 1;
+			if (snprintf(from, sizeof(from), "%s", p) >= (int)sizeof(from))
+				discard_exit();
+			if ((p = strchr(from, '>')))
+				*p = '\0';
+			if (junkmail())
+				discard_exit();
+			break;
+		case 'p':
+		case 'P':		/* "Precedence:" */
+			if (strncasecmp(buf, "Precedence", 10) ||
+			    (buf[10] != ':' && buf[10] != ' ' &&
+			     buf[10] != '\t'))
+				break;
+			if (!(p = strchr(buf, ':')))
+				break;
+			while (*++p && isspace(*p));
+			if (!*p)
+				break;
+			end = p + strlen(p);
+			while (end > p && isspace((unsigned char)end[-1]))
+				*--end = '\0';
+			if (!strcasecmp(p, "junk") || !strcasecmp(p, "bulk") ||
+			    !strcasecmp(p, "list"))
+				discard_exit();
+			break;
+		case 'a':
+		case 'A':		/* "Auto-submitted:" */
+			if (strncasecmp(buf, "Auto-submitted", 14) ||
+			    (buf[14] != ':' && buf[14] != ' ' &&
+			     buf[14] != '\t'))
+				break;
+			if (!(p = strchr(buf, ':')))
+				break;
+			while (*++p && isspace(*p));
+			end = p + strlen(p);
+			while (end > p && isspace((unsigned char)end[-1]))
+				*--end = '\0';
+			if (strcasecmp(p, "no")) /* Suppress every value except exact no. */
+				discard_exit();
+			break;
+		case 'x':
+		case 'X':		/* "X-Spam-Flag:" */
+			if (strncasecmp(buf, "X-Spam-Flag", 11) ||
+			    (buf[11] != ':' && buf[11] != ' ' && buf[11] != '\t'))
+				break;
+			if (!(p = strchr(buf, ':')))
+				break;
+			while (*++p && isspace(*p));
+			end = p + strlen(p);
+			while (end > p && isspace((unsigned char)end[-1]))
+				*--end = '\0';
+			if (!strcasecmp(p, "yes"))
+				discard_exit();
+			break;
+		case 's':
+		case 'S':		/* "Subject" */
+			if (strncasecmp(buf, "Subject:", 8) ||
+			    (buf[8] != ' ' && buf[8] != '\t'))
+				break;
+			for (p = buf + 8; *p && isspace(*p); ++p);
+			if (snprintf(subj, sizeof(subj), "%s", p) >= (int)sizeof(subj))
+				discard_exit();
+			break;
+		case 'c':
+		case 'C':		/* "Cc:" */
+			if (strncasecmp(buf, "Cc:", 3))
+				break;
+			goto findme;
+		case 't':
+		case 'T':		/* "To:" */
+			if (strncasecmp(buf, "To:", 3))
+				break;
+			goto findme;
+		default:
+			break;
+findme:		for (cur = names; !*tome && cur; cur = cur->next)
+			*tome += nsearch(cur->name, buf);
 	}
 }
 
