--- a/none/tests/pth_cancel1.c
+++ b/none/tests/pth_cancel1.c
@@ -8,31 +8,34 @@
   printf("cleaning up 0x%lx\n", (long)arg);
 
   return;
 }
 
 static void *thread_main(void *arg)
 {
   pthread_cleanup_push(thread_cleanup, (void *)0x1234);
   pthread_cleanup_push(thread_cleanup, (void *)0x5678);
 
+#if !defined(__OHOS__)
+  /* OHOS: libc 为 musl 变体，无 pthread_setcanceltype/setcancelstate 符号 */
   if (pthread_setcanceltype(PTHREAD_CANCEL_ASYNCHRONOUS, NULL) != 0)
     {
       perror("pthread_setcanceltype");
       return NULL;
     }
   
   if (pthread_setcancelstate(PTHREAD_CANCEL_ENABLE, NULL) != 0)
     {
       perror("pthread_setcancelstate");
       return NULL;
     }
+#endif
 
   pause();
 
   pthread_cleanup_pop(0);
   pthread_cleanup_pop(0);
 
   return NULL;
 }
 
 int main(int argc, char **argv)
@@ -41,25 +44,31 @@
   void *result;
   
   if (pthread_create(&tid, NULL, thread_main, NULL) != 0)
     {
       perror("pthread_create");
       exit(1);
     }
 
   sleep(1);
 
+#if defined(__OHOS__)
+  /* OHOS: libc 为 musl 变体，无 pthread_cancel 符号，跳过取消测试 */
+  printf("result is %s\n", "skipped (no pthread_cancel on OHOS)");
+  exit(0);
+#else
   if (pthread_cancel(tid) != 0)
     {
       perror("pthread_cancel");
       exit(1);
     }
+#endif
 
   if (pthread_join(tid, &result) != 0)
     {
       perror("pthread_join");
       exit(1);
     }
 
   printf("result is %s\n", result == PTHREAD_CANCELED ? "correct" : "incorrect");
   
   exit(0);
