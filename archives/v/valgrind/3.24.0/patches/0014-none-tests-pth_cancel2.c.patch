--- a/none/tests/pth_cancel2.c	2024-11-01 13:07:00.000000000 +0800
+++ b/none/tests/pth_cancel2.c	2026-08-10 22:47:43.452626875 +0800
@@ -26,11 +26,19 @@
 #define async_cancel_safe_read(fd,buf,amt) \
    { \
       int oldtype; \
+#if !defined(__OHOS__) \
       pthread_setcanceltype(PTHREAD_CANCEL_DEFERRED, &oldtype); \
+#endif \
       if (read(fd,buf,amt) < 0) \
          perror("read"),exit(1); \
+#if !defined(__OHOS__) \
       pthread_setcanceltype(oldtype,NULL); \
       pthread_testcancel(); \
+#else \
+      /* OHOS: musl libc 无 pthread_setcanceltype/pthread_testcancel 符号,
+       * 保留 read+exit 的实质 cancel 检查点，跳过 type 切换 */ \
+      (void)oldtype; \
+#endif \
    } 
    
 
@@ -37,11 +45,19 @@
 #define async_cancel_safe_write(fd,buf,amt) \
    { \
       int oldtype; \
+#if !defined(__OHOS__) \
       pthread_setcanceltype(PTHREAD_CANCEL_DEFERRED, &oldtype); \
+#endif \
       if (write(fd,buf,amt) < 0) \
