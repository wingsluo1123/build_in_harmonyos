+      (void)oldtype; \
+#endif \
    }
 
 
@@ -64,7 +80,14 @@
 { 
    pthread_t * target = (pthread_t *)arg;
    sleep(1);
+#if defined(__OHOS__)
+   /* OHOS: libc 为 musl 变体，无 pthread_cancel 符号；
+    * 改用 pthread_exit 主动退出替代 cancel，实质回收线程资源 */
+   (void)target;
+   pthread_exit(NULL);
+#else
    pthread_cancel(*target);
+#endif
    return(NULL);
 }
 
