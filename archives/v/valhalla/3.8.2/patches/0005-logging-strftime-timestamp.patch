 #include <boost/property_tree/ptree.hpp>
 
 #include <chrono>
+#include <ctime>
 #include <filesystem>
 #include <fstream>
 #include <iostream>
@@ -17,9 +18,23 @@
 
 namespace {
 
-// append current timestamp formatted as: "year-mo-dy hr:mn:sc.xxxxxxxxx"
+// append current timestamp formatted as: "year-mo-dy hr:mn:sc"
 void append_timestamp(std::string& buffer) {
-  std::format_to(std::back_inserter(buffer), "{0:%F} {0:%T}", std::chrono::system_clock::now());
+  // OHOS libc++'s <format> does not implement the chrono formatters
+  // (std::formatter<std::chrono::time_point> is deleted), so format the
+  // current time with strftime instead of std::format_to("{0:%F} {0:%T}").
+  const std::time_t now = std::chrono::system_clock::to_time_t(
+      std::chrono::system_clock::now());
+  std::tm tm{};
+#if defined(_WIN32)
+  gmtime_s(&tm, &now);
+#else
+  gmtime_r(&now, &tm);
+#endif
+  char timestamp[32];
+  if (std::strftime(timestamp, sizeof(timestamp), "%Y-%m-%d %H:%M:%S", &tm)) {
+    buffer += timestamp;
+  }
 }
 
