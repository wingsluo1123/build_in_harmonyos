+# Read a file without spawning an external helper.
+#
+# Tcl reports EPERM as "not owner" when exec fails to spawn cat; the upstream
+# harness polls `exec cat` every 100 ms per live server while waiting for
+# startup, so a full parallel suite keeps spawning short-lived processes on a
+# device that restricts executing foreign binaries. Reading inside the
+# interpreter keeps the same observable content (exec strips one trailing
+# newline, so we strip it too).
+proc read_file_text {path} {
+    set fd [open $path r]
+    fconfigure $fd -translation binary
+    set data [read $fd]
+    close $fd
+    if {[string match "*\n" $data]} {
+        set data [string range $data 0 end-1]
+    }
+    return $data
+}
+
