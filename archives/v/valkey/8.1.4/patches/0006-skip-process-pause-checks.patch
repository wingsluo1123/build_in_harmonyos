 proc test {name code {okpattern undefined} {tags {}}} {
+    # OHOS suspends the process on SIGSTOP, but never reports the stopped
+    # state: /proc/<pid>/stat, /proc/<pid>/status and ps all keep showing
+    # "S (sleeping)", and toybox ps lacks the BSD j / -o state= forms this
+    # suite polls. A body that waits for the suspended state cannot proceed,
+    # and neither can the later cases of the same file that consume the state
+    # the skipped case was meant to produce (skipping a prerequisite without
+    # its dependents leaves the client waiting forever). Allocator- and
+    # load-sensitive assertions cannot be reproduced on the same host either.
+    # Fail closed: once a case of a file is skipped, the remaining cases of
+    # that file are skipped as well, and every skip is explicit and visible
+    # in the test totals.
+    if {[info exists ::env(VALKEY_TEST_SKIP_PROCESS_PAUSE)]} {
+        if {[info exists ::curfile] && [info exists ::ohos_pause_file] &&
