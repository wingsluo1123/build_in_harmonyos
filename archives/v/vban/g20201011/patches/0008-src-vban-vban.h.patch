+static inline int vban_header_has_magic(struct VBanHeader const* header)
+{
+    return (header->vban[0] == VBAN_HEADER_MAGIC_0)
+        && (header->vban[1] == VBAN_HEADER_MAGIC_1)
+        && (header->vban[2] == VBAN_HEADER_MAGIC_2)
+        && (header->vban[3] == VBAN_HEADER_MAGIC_3);
+}
+
+static inline void vban_header_set_magic(struct VBanHeader* header)
+{
+    header->vban[0] = VBAN_HEADER_MAGIC_0;
+    header->vban[1] = VBAN_HEADER_MAGIC_1;
+    header->vban[2] = VBAN_HEADER_MAGIC_2;
+    header->vban[3] = VBAN_HEADER_MAGIC_3;
+}
+
+static inline uint32_t vban_header_get_frame(struct VBanHeader const* header)
+{
+    return (uint32_t)header->nuFrame[0]
+        | ((uint32_t)header->nuFrame[1] << 8)
+        | ((uint32_t)header->nuFrame[2] << 16)
+        | ((uint32_t)header->nuFrame[3] << 24);
+}
+
+static inline void vban_header_set_frame(struct VBanHeader* header, uint32_t frame)
+{
+    header->nuFrame[0] = (uint8_t)(frame & 0xff);
+    header->nuFrame[1] = (uint8_t)((frame >> 8) & 0xff);
+    header->nuFrame[2] = (uint8_t)((frame >> 16) & 0xff);
+    header->nuFrame[3] = (uint8_t)((frame >> 24) & 0xff);
+}
 
 
