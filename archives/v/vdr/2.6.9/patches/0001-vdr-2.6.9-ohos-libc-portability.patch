+// --- Non-glibc C library portability (e.g. the musl based OpenHarmony libc) ---
+// VDR is written against glibc and uses a few glibc only helpers. Provide
+// minimal equivalents when <features.h> did not define __GLIBC_PREREQ.
+#ifndef __GLIBC_PREREQ
+#define __GLIBC_PREREQ(maj, min) 1 // no glibc: always take the modern code path
+#define VDR_NO_GLIBC 1
+#ifndef DEFFILEMODE
+#define DEFFILEMODE (S_IRUSR | S_IWUSR | S_IRGRP | S_IWGRP | S_IROTH | S_IWOTH) // 0666
+#endif
+#ifndef ACCESSPERMS
+#define ACCESSPERMS (S_IRWXU | S_IRWXG | S_IRWXO) // 0777
+#endif
+typedef int (*__compar_fn_t)(const void *, const void *);
+#endif
+#ifndef __attribute_format_arg__
+#define __attribute_format_arg__(x) __attribute__((format_arg(x)))
+#endif
+
 typedef unsigned char uchar;
 
