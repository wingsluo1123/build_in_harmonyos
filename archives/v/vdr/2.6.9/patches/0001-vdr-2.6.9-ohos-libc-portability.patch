 cIpAddress::cIpAddress(void)
 {
+#ifdef VDR_NO_GLIBC
+  // INADDR_ANY expands to ((in_addr_t) 0x00000000), a *non literal* null
+  // pointer constant, which clang rejects in C++11 and later. Clang selects
+  // the overload from the argument types, so hand over the wildcard address
+  // in its text form instead.
+  Set("0.0.0.0", 0);
+#else
   Set(INADDR_ANY, 0);
+#endif
 }
 
