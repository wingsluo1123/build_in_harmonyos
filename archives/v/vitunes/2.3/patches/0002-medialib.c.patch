+/* maximum directory nesting the scan will descend into */
+#define SCAN_MAX_DEPTH   128
+
+/*
+ * Handle a single regular file found by the directory scan: compare it against
+ * the database and add, update or forget it as needed.  See
+ * medialib_db_scan_dirs() for the meaning of the counters.
+ */
+static void
+scan_file(const char *path, const struct stat *sb, struct scan_stats *stats)
+{
    meta_info  *mi;
    char        fullname[PATH_MAX];
    int         i, idx;
 
+   /* get the full name for the file */
+   if (realpath(path, fullname) == NULL) {
+      err(1, "medialib_db_scan_dirs: realpath failed for '%s'", path);
+   }
+
+   /* check if the file already exists in the db */
+   idx = -1;
+   for (i = 0; i < mdb.library->nfiles; i++) {
+      if (strcmp(fullname, mdb.library->files[i]->filename) == 0)
+         idx = i;
+   }
+
+   if (idx != -1) {
+      /* file already exists in library database - update */
+
+      if (sb->st_mtime > mdb.library->files[idx]->last_updated) {
+
+         /* file has been modified since we last extracted info */
+
+         mi = mi_extract(path);
+
+         if (mi == NULL) {
+            /* file now has no meta-info, remove from library */
+            playlist_files_remove(mdb.library, idx, 1, false);
+            printf("- %s\n", path);
+            stats->removed_lost_info++;
+         } else {
+            /* file's meta-info has changed, update it */
+            mi_sanitize(mi);
+            playlist_file_replace(mdb.library, idx, mi);
+            printf("u %s\n", path);
+            stats->updated++;
+         }
+      } else {
+         printf(". %s\n", path);
+         stats->skipped_not_updated++;
+      }
+
+   } else {
+
+      /* file does NOT exists in library database - add it */
+
+      mi = mi_extract(path);
+
+      if (mi == NULL) {
+         /* file has no info */
+         printf("s %s\n", path);
+         stats->skipped_no_info++;
+      } else {
+         /* file does have info, add it to library */
+         mi_sanitize(mi);
+         playlist_files_append(mdb.library, &mi, 1, false);
+         printf("+ %s\n", path);
+         stats->added++;
+      }
+   }
+}
+
+/*
+ * Recursively scan the directory 'path'.  Symbolic links are followed, and the
+ * dev/inode pairs of the directories we are already inside of are kept in
+ * devs[]/inos[] (of which 'depth' entries are valid) so that a symbolic link
+ * loop ends the descent instead of recursing forever.
+ */
+static void
+scan_dir(const char *path, struct scan_stats *stats, dev_t *devs, ino_t *inos,
+    int depth)
+{
+   struct dirent *de;
+   struct stat    sb;
+   char           child[PATH_MAX];
+   DIR           *dir;
+   int            i;
+
+   printf("Checking Directory: %s\n", path);
+
+   dir = opendir(path);
+   if (dir == NULL) {
+      printf("Directory '%s' Unreadable\n", path);
+      stats->skipped_dir++;
+      return;
+   }
+
+   while ((de = readdir(dir)) != NULL) {
+
+      if (strcmp(de->d_name, ".") == 0 || strcmp(de->d_name, "..") == 0)
+         continue;
+
+      if (snprintf(child, sizeof(child), "%s/%s", path, de->d_name) >=
+          (int)sizeof(child)) {
+         printf("? %s/%s\n", path, de->d_name);
+         stats->skipped_error++;
+         continue;
+      }
+
+      if (stat(child, &sb) != 0) {
+         /*
+          * a symbolic link with no target is skipped silently, just like the
+          * fts(3) based traversal did; anything else is an error
+          */
+         if (lstat(child, &sb) == 0 && S_ISLNK(sb.st_mode))
+            continue;
+         printf("? %s\n", child);
+         stats->skipped_error++;
+         continue;
+      }
+
+      if (S_ISDIR(sb.st_mode)) {
+
+         /* don't descend into a directory we are already inside of */
+         for (i = 0; i < depth; i++) {
+            if (devs[i] == sb.st_dev && inos[i] == sb.st_ino)
+               break;
+         }
+         if (i < depth)
+            continue;
+
+         if (depth == SCAN_MAX_DEPTH) {
+            printf("? %s\n", child);
+            stats->skipped_error++;
+            continue;
+         }
+
+         devs[depth] = sb.st_dev;
+         inos[depth] = sb.st_ino;
+         scan_dir(child, stats, devs, inos, depth + 1);
+
+      } else if (S_ISREG(sb.st_mode)) {
+         scan_file(child, &sb, stats);
+      }
+   }
+
+   closedir(dir);
+}
