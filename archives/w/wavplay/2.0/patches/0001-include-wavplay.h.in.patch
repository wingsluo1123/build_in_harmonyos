 /*
  * This structure manages an opened DSP device.
  */
 typedef struct {
-	int	fd;				/* Open fd of /dev/dsp */
+	int	fd;				/* Open fd of /dev/dsp (unused on OHOS) */
 	int	dspblksiz;			/* Size of the DSP buffer */
 	char	*dspbuf;			/* The buffer */
+	/*
+	 * OHOS native audio backend (OH_AudioRenderer / OH_AudioCapturer):
+	 * populated only when built with -DHAVE_OHOS_AUDIO (capability macro
+	 * supplied by the build system, not a platform macro); unused on
+	 * other platforms, which see exactly the upstream structure.
+	 */
+#ifdef HAVE_OHOS_AUDIO
+	void	*renderer;			/* OH_AudioRenderer* (playback) */
+	void	*capturer;			/* OH_AudioCapturer* (recording) */
+	/* Playback callback sync (callback thread <-> main thread) */
+	void	*play_wfile;		/* WAVFILE* source the callback reads */
+	int	play_bps;			/* bytes per sample incl. channels */
+	unsigned long play_remain;	/* bytes not yet handed to renderer */
+	volatile int play_done;		/* callback sets when source exhausted */
+	int	play_cb_active;		/* in-flight playback callbacks (drain) */
+	pthread_mutex_t play_mutex;
+	pthread_cond_t play_cond;
+	/* Recording callback sync */
+	void	*rec_wfile;		/* WAVFILE* sink the callback writes */
+	int	rec_bps;			/* bytes per sample incl. channels */
+	volatile unsigned long rec_bytes;	/* bytes captured so far */
+	unsigned long rec_total;	/* target capture bytes (0 = until stop) */
+	volatile int rec_stop;		/* main thread sets to stop capture */
+	volatile int rec_err;		/* set by callback on a failed write */
+	int	rec_cb_active;		/* in-flight capture callbacks (drain on close) */
+	pthread_mutex_t rec_mutex;
+	pthread_cond_t rec_cond;
+#endif /* HAVE_OHOS_AUDIO */
 } DSPFILE;
 
