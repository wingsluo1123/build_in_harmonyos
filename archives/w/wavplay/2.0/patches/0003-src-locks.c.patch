+#ifdef HAVE_OHOS_AUDIO
+#include <sys/types.h>
+#include "wavplay.h"
+
+/*
+ * OHOS: there is no /dev/dsp on OHOS - the audio device is owned by the
+ * audio service, which enforces exclusive access itself (binder IPC)
+ * rather than via user-space POSIX semaphores on a device file. There is
+ * therefore no user-space lock to take: returning 0 is the correct
+ * device-exclusivity semantics on this platform, not a stub. The caller
+ * only invokes these when wavopts->ipc >= 0 (server/GUI mode), so they
+ * are defensive no-ops.
+ */
+int
+OpenDSPLocks(key_t LockIPCKey,int SemUndoFlag,ErrFunc erf) {
+	(void) LockIPCKey; (void) SemUndoFlag; (void) erf;
+	return 0;	/* fake IPC id; LockDSP/UnlockDSP are no-ops on OHOS */
+}
+
+int
+LockDSP(int ipc,int playrecx,ErrFunc erf,unsigned timeout_secs) {
+	(void) ipc; (void) playrecx; (void) erf; (void) timeout_secs;
+	return 0;
+}
+
+int
+UnlockDSP(int ipc,int playrecx,ErrFunc erf) {
+	(void) ipc; (void) playrecx; (void) erf;
+	return 0;
+}
+#endif /* HAVE_OHOS_AUDIO */
 
