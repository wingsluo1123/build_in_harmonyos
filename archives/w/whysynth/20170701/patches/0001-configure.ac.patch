 AC_ARG_ENABLE(developer, AC_HELP_STRING([--enable-developer], [enable developer functions, default=no]),
               [ if test $enableval = "yes"; then
                 AC_DEFINE(DEVELOPER, 1, [Define to 1 to enable developer-only functions.])
                 fi ])
 
