 dnl Check for GTK+
 with_gtk=no
-AM_PATH_GTK_2_0(2.24.0, with_gtk='yes', AC_MSG_WARN([GUI will not be built; GTK+ 2.24 or later needed]))
+dnl GTK+ 2's m4 macros (gtk-2.0.m4) are not installed on every build machine.
+dnl Guard the lookup so a machine without them can still bootstrap -- autoconf
+dnl otherwise aborts with "possibly undefined macro: AM_PATH_GTK_2_0" -- and
+dnl simply skips the optional GUI, exactly as the GTK+-not-found path does.
+m4_ifdef([AM_PATH_GTK_2_0],
+         [AM_PATH_GTK_2_0(2.24.0, with_gtk='yes', AC_MSG_WARN([GUI will not be built; GTK+ 2.24 or later needed]))],
+         [AC_MSG_WARN([GTK+ 2 m4 macros not found; GUI will not be built])])
 AM_CONDITIONAL(BUILD_GUI, test "x${with_gtk}" != 'xno')
 
