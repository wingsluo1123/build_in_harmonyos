+++ b/configure.ac
@@ -16,21 +16,27 @@
 AC_C_BIGENDIAN
 
 dnl Require DSSI, liblo, and FFTW3
 AC_CHECK_HEADERS(ladspa.h)
 PKG_CHECK_MODULES(COMMON, dssi >= 0.9)
 PKG_CHECK_MODULES(PLUGIN, fftw3f >= 3.0.1)
