From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: patch <patch@local>
Date: Sun, 18 Oct 2026 11:56:46 +0800
Subject: [PATCH 1/3] 0001 setup.sh cross-compile guard

---
 setup.sh | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/setup.sh b/setup.sh
index 26ce30f..ac577da 100644
--- a/setup.sh
+++ b/setup.sh
@@ -1,5 +1,15 @@
 #!/usr/bin/env bash
 
+# Cross-compile guard: when WIT_SETUP_SKIP=1 and a Makefile.setup already
+# exists, keep it and skip all host probing. The Conan recipe pre-generates
+# a deterministic Makefile.setup for the target; running the host probes
+# here would use the build host compiler/headers and overwrite SYSTEM,
+# HAVE_* and DEFINES1 with values for the wrong machine.
+if [[ $WIT_SETUP_SKIP = 1 && -s Makefile.setup ]]
+then
+    exit 0
+fi
+
 revision=0
 
 if [[ -d .svn ]] && which svn >/dev/null 2>&1
