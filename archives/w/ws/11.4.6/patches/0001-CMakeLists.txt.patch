@@ -203,23 +203,36 @@
       # set(CMAKE_LIBRARY_PATH ${CMAKE_LIBRARY_PATH} /opt/local/lib/openssl-1.0)
       # set(CMAKE_INCLUDE_PATH ${CMAKE_INCLUDE_PATH} /opt/local/include/openssl-1.0)
     endif()
 
     # This OPENSSL_FOUND check is to help find a cmake manually configured OpenSSL
     if (NOT OPENSSL_FOUND)
       find_package(OpenSSL REQUIRED)
     endif()
     message(STATUS "OpenSSL: " ${OPENSSL_VERSION})
 
-    add_definitions(${OPENSSL_DEFINITIONS})
-    target_include_directories(ixwebsocket PUBLIC $<BUILD_INTERFACE:${OPENSSL_INCLUDE_DIR}>)
-    target_link_libraries(ixwebsocket PRIVATE ${OPENSSL_LIBRARIES})
+    if (TARGET openssl::openssl)
+      # conan's OpenSSL package provides the openssl::openssl imported target,
+      # which carries the interface include dirs and libraries; the module
+      # variables (OPENSSL_LIBRARIES/OPENSSL_INCLUDE_DIR/OPENSSL_DEFINITIONS)
+      # are not set in that case. Keep the link private, but expose the
+      # OpenSSL include dirs as build-interface includes since the public
+      # IXSocketOpenSSL.h header includes <openssl/*.h> (in-tree consumers:
+      # tests, ws CLI).
+      target_link_libraries(ixwebsocket PRIVATE openssl::openssl)
+      target_include_directories(ixwebsocket PUBLIC
+        $<BUILD_INTERFACE:$<TARGET_PROPERTY:openssl::openssl,INTERFACE_INCLUDE_DIRECTORIES>>)
+    else()
+      add_definitions(${OPENSSL_DEFINITIONS})
+      target_include_directories(ixwebsocket PUBLIC $<BUILD_INTERFACE:${OPENSSL_INCLUDE_DIR}>)
+      target_link_libraries(ixwebsocket PRIVATE ${OPENSSL_LIBRARIES})
+    endif()
   elseif (USE_MBED_TLS)
     message(STATUS "TLS configured to use mbedtls")
 
     # This MBEDTLS_FOUND check is to help find a cmake manually configured MbedTLS
     if (NOT MBEDTLS_FOUND)
       find_package(MbedTLS REQUIRED)
       
       if (MBEDTLS_VERSION_GREATER_THAN_3)
         target_compile_definitions(ixwebsocket PRIVATE IXWEBSOCKET_USE_MBED_TLS_MIN_VERSION_3)
       endif()
