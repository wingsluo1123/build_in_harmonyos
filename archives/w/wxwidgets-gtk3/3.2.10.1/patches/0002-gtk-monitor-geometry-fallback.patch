+// Some GTK backends expose a screen before populating monitor geometry.
+// Use the real screen dimensions for its sole monitor in this case.
+static GdkRectangle GetMonitorGeometry(GdkScreen* screen, int monitor)
+{
+    GdkRectangle rect;
+    gdk_screen_get_monitor_geometry(screen, monitor, &rect);
+    if ((rect.width <= 0 || rect.height <= 0) && monitor == 0 &&
+        gdk_screen_get_n_monitors(screen) == 1)
+    {
+        rect.x = 0;
+        rect.y = 0;
+        rect.width = gdk_screen_get_width(screen);
+        rect.height = gdk_screen_get_height(screen);
+    }
+    return rect;
+}
+
