diff --git a/libxapp/xapp-gtk-window.c b/libxapp/xapp-gtk-window.c
index b8a968c..9275ac5 100644
--- a/libxapp/xapp-gtk-window.c
+++ b/libxapp/xapp-gtk-window.c
@@ -4,11 +4,19 @@
 #include <stdlib.h>
 #include <string.h>
 #include <math.h>
-#include <X11/Xlib.h>
-#include <X11/Xatom.h>
 
 #include <gdk/gdk.h>
+/* gdk.h pulls in gdkconfig.h, which defines the GDK_WINDOWING_* macros for
+ * the windowing systems this GTK build actually contains: a GTK built for
+ * the broadway backend only (as on HarmonyOS PC) installs neither
+ * gdk/gdkx.h nor any X11 backend symbols.  Only take the X11 code paths
+ * below on X11-windowing builds; everywhere else the window-manager hint
+ * protocol is simply unavailable and the entry points degrade to no-ops. */
+#ifdef GDK_WINDOWING_X11
+#include <X11/Xlib.h>
+#include <X11/Xatom.h>
 #include <gdk/gdkx.h>
+#endif
 #include "xapp-gtk-window.h"
 
 #define DEBUG_FLAG XAPP_DEBUG_WINDOW
@@ -74,7 +82,11 @@ is_x11_session (void)
 
     if (g_once_init_enter (&once_init_value))
     {
+#ifdef GDK_WINDOWING_X11
         running_x11 = GDK_IS_X11_DISPLAY(gdk_display_get_default());
+#else
+        running_x11 = FALSE;
+#endif
         DEBUG ("XAppGtkWindow: is_x11_session: %s\n", running_x11 ? "TRUE" : "FALSE");
 
         g_once_init_leave (&once_init_value, 1);
@@ -90,6 +102,7 @@ clear_icon_strings (XAppGtkWindowPrivate *priv)
     g_clear_pointer (&priv->icon_path, g_free);
 }
 
+#ifdef GDK_WINDOWING_X11
 static void
 set_window_hint_utf8 (Window       xid,
                       const gchar *atom_name,
@@ -160,6 +173,40 @@ get_window_xid (GtkWindow *window)
 
     return GDK_WINDOW_XID (gdk_window);
 }
+#else
+/* No X11 windowing backend (e.g. a broadway-only GTK): the window-manager
+ * hint protocol lives in the X11 server, so these become no-ops.  The
+ * public xapp_set_xid_* entry points and the window update paths stay
+ * untouched and simply do nothing, mirroring the is_x11_session() runtime
+ * guard upstream already applies to their non-xid callers. */
+static void
+set_window_hint_utf8 (gulong       xid,
+                      const gchar *atom_name,
+                      const gchar *str)
+{
+    (void) xid;
+    (void) atom_name;
+    (void) str;
+}
+
+static void
+set_window_hint_cardinal (gulong       xid,
+                          const gchar *atom_name,
+                          gulong       cardinal)
+{
+    (void) xid;
+    (void) atom_name;
+    (void) cardinal;
+}
+
+static gulong
+get_window_xid (GtkWindow *window)
+{
+    (void) window;
+
+    return 0;
+}
+#endif
 
 static void
 update_window_icon (GtkWindow            *window,
