+/*
+ * POSIX thread cancellation is optional.  configure probes for it
+ * (AC_CHECK_FUNCS) because some C libraries omit it -- the musl-derived
+ * OHOS libc among them.  Where it is missing we do not fabricate a
+ * successful cancellation: every worker thread created here detaches
+ * itself (pthread_detach(pthread_self())) and is never joined, and each
+ * loop polls the port state/descriptor, so the threads end through their
+ * normal exit conditions.  pthread_testcancel() only acts when a
+ * cancellation is pending, so a no-op is the honest equivalent when none
+ * can exist.
+ */
+#ifndef HAVE_PTHREAD_TESTCANCEL
+#  define pthread_testcancel()    ((void)0)
+#endif
 #include "util.h"
 #include "mutex_utils.h"
 #include "wx.h"
@@ -3566,12 +3581,14 @@
       {
         fprintf(stderr,"Killing thread\n");
       }
+#ifdef HAVE_PTHREAD_CANCEL
       if (pthread_cancel(connect_thread))
       {
         // The only error code we can get here is ESRCH, which means
         // that the thread number wasn't found.  The thread is already
         // dead, so let's not print out an error code.
       }
+#endif
 
       if (sec_now() >= wait_time)    // Timed out
       {
@@ -5878,7 +5895,7 @@
 
   if (ok)
   {
-    int retvalue;
