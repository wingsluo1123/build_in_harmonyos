+
+static void print_voltage(FILE *out, float value)
+{
+	if (!isfinite(value)) fprintf(out, "N/A");
+	else fprintf(out, "%+6.2f", value);
+}
+
+static void print_fan(FILE *out, int value)
+{
+	if (value < 0) fprintf(out, "N/A");
+	else fprintf(out, "%4d", value);
