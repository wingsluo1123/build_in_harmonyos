+static void print_temperature(FILE *out, float value, int integer)
+{
+	if (!isfinite(value))
+		fprintf(out, "N/A");
+	else if (integer)
+		fprintf(out, "%2d", (int)roundf(value));
+	else
+		fprintf(out, "%4.1f", value);
