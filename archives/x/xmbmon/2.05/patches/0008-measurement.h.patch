--- /dev/null
+++ b/measurement.h
@@ -0,0 +1,38 @@
+#ifndef XMBMON_MEASUREMENT_H
+#define XMBMON_MEASUREMENT_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define MBMON_CHANNEL_COUNT 3
+#define MBMON_LABEL_SIZE 64
+
+#if defined(__GNUC__)
+#define MBMON_API __attribute__((visibility("default")))
+#else
+#define MBMON_API
+#endif
+
+/* Names and units belong to the measurement source, never to a guessed chip. */
+struct mbmon_measurements {
+    float temperatures[MBMON_CHANNEL_COUNT];
+    char labels[MBMON_CHANNEL_COUNT][MBMON_LABEL_SIZE];
+    unsigned int valid_temperatures;
+};
+
+MBMON_API int mbmon_read_measurements(struct mbmon_measurements *out);
+MBMON_API const char *mbmon_measurement_backend(void);
+
+/* Diagnostic fan values: source units remain unverified, never labelled RPM. */
+struct mbmon_fans_raw {
+    int values[2];
+    unsigned int valid_fans;
+    long long sampled_unix;
+};
+MBMON_API int mbmon_read_fans_raw(const char *path, struct mbmon_fans_raw *out);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
