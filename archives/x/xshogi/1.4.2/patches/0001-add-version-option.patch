+    /*
+     * Handle -version before the X connection is attempted: XtAppInitialize
+     * opens the display first, so on a host without an X server any option
+     * would abort with "Can't open display" before the version could be
+     * printed.  A single or double dash is accepted, as other X11 programs do.
+     */
+
+    {
+        int n;
+
+        for (n = 1; n < argc; n++)
+        {
+            const char *option = argv[n];
+
+            if (option[0] == '-' && option[1] == '-')
+                option++;
+
+            if (strcmp(option, "-version") == 0)
+            {
+                printf("xshogi version %s based on xboard version %s\n",
+                       PACKAGE_VERSION, XBOARD_VERSION);
+                exit(0);
+            }
+        }
+    }
+
