--- a/src/lib/libumem/SConscript
+++ b/src/lib/libumem/SConscript
@@ -1,7 +1,60 @@
-import os
 Import('env')
 
-Command("Makefile", [], ["cd lib/libumem && ./configure"])
-Command("libumem.a", [Glob('*.c'),'Makefile',Glob('*.h')], ["cd lib/libumem && make && rm -f libumem.a && ln -s .libs/libumem.a"])
-if os.path.isfile("Makefile") and env.GetOption('clean'):
-	Execute(Action(["make -C %s distclean" % (os.path.join(env.Dir("#").abspath, 'lib/libumem'))]))
+# OHOS port: the 2011 autotools build cannot run on HarmonyOS (config.status
+# temp-dir writes fail on HMDFS, and there is no make/gcc in PATH).
+# Build libumem directly with SCons instead (source list from Makefile.am
+# libumem_la_SOURCES; libumem_malloc/umem_test programs are not needed).
+import os
+
+# libumem's init_lib.c includes "config.h"; upstream generates it via
+# autoconf (config.h.in). The autotools configure cannot run on OHOS/HMDFS,
+# so generate it here from the known musl/aarch64 capability set.
+_config_h = """/* config.h - generated for OHOS aarch64 (musl), see config.log */
+#define HAVE_DLFCN_H 1
+#define HAVE_INTTYPES_H 1
+#define HAVE_ISSETUGID 1
+#define HAVE_MALLINFO 1
+#define HAVE_MALLOC_H 1
+#define HAVE_MEMORY_H 1
+#define HAVE_STDINT_H 1
+#define HAVE_STDLIB_H 1
+#define HAVE_STRINGS_H 1
+#define HAVE_STRING_H 1
+#define HAVE_SYS_MMAN_H 1
+#define HAVE_SYS_STAT_H 1
+#define HAVE_SYS_SYSMACROS_H 1
+#define HAVE_SYS_TIME_H 1
+#define HAVE_SYS_TYPES_H 1
+#define HAVE_UNISTD_H 1
+#define PACKAGE "umem"
+#define PACKAGE_BUGREPORT ""
+#define PACKAGE_NAME "umem"
+#define PACKAGE_STRING "umem 1.0.1"
+#define PACKAGE_TARNAME "umem"
+#define PACKAGE_VERSION "1.0.1"
+#define STDC_HEADERS 1
+#define UMEM_PTHREAD_MUTEX_TOO_BIG 1
+#define VERSION "1.0.1"
+"""
+if not os.path.exists('config.h'):
+    with open('config.h', 'w', encoding='utf-8') as _fh:
+        _fh.write(_config_h)
+
+objects = Split('''init_lib.c umem_agent_support.c umem_fail.c umem_fork.c
+umem_update_thread.c vmem_mmap.c vmem_sbrk.c envvar.c getpcstack.c misc.c
+vmem_base.c umem.c vmem.c''')
+
+envu = env.Clone()
+envu.Append(CPPPATH = ['#lib/libumem'])
+
+objects_user = [envu.Object('build-user/' + o[:-2] + '.o', o) for o in objects]
+userlib = envu.StaticLibrary('libumem-user', objects_user)
+
+# NOTE: upstream builds a single user-mode libumem.a (no -D_KERNEL variant);
+# compiling umem.c/init_lib.c with -D_KERNEL conflicts with the user-mode
+# vmem_init() prototypes in vmem_base.h, and nothing in this tree links a
+# kernel libumem. Downstream SConscripts reference #lib/libumem/libumem.a,
+# so publish the user library under that name too.
+envu.Command('libumem.a', userlib, 'cp $SOURCE $TARGET')
+
+Return('userlib')
