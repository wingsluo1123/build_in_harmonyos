{
  "name": "cdo",
  "version": "2.4.0",
  "description": "Climate Data Operators — command-line tools for processing climate and forecast data",
  "homepage": "https://code.mpimet.mpg.de/projects/cdo",
  "license": "GPL-2.0-only",
  "type": "tool",
  "arch": "ohos-aarch64",
  "build_system": "autotools",
  "category": "data",
  "dependencies": {
    "zlib": {
      "version": ">=1.2.11",
      "type": "static"
    },
    "libcurl": {
      "version": ">=7.0",
      "type": "static",
      "optional": true
    },
    "netcdf": {
      "version": ">=4.0",
      "type": "static",
      "optional": true
    },
    "hdf5": {
      "version": ">=1.10",
      "type": "static",
      "optional": true
    }
  },
  "environment": {
    "CONFIG_SHELL": "/data/service/hnp/bin/bash",
    "CC": "clang",
    "CXX": "clang++",
    "AR": "llvm-ar",
    "RANLIB": "llvm-ranlib",
    "CFLAGS": "-fPIC -O2 -target aarch64-linux-ohos",
    "CXXFLAGS": "-fPIC -O2 -target aarch64-linux-ohos",
    "LDFLAGS": "-fuse-ld=/data/service/hnp/bin/ld"
  },
  "configure_options": [
    "--host=aarch64-linux-ohos",
    "--enable-static",
    "--disable-shared",
    "--without-netcdf",
    "--without-hdf5",
    "--without-szlib",
    "--disable-dependency-tracking"
  ],
  "patches": [
    {
      "file": "patches/0001-config.guess.patch",
      "description": "Add HarmonyOS detection to config.guess"
    },
    {
      "file": "patches/0002-config.sub.patch",
      "description": "Add OHOS support to config.sub"
    }
  ],
  "output": {
    "bin": ["cdo"],
    "lib": ["libcdo.a"],
    "include": ["cdo.h"]
  },
  "install_path": "$HOME/usr/local"
}