# DRAFT-002.kv — Go 编译产物未经 ELF 签名无法在 OHOS 执行
# 生成时间: 2026-07-02
# 来源: ytt 0.55.1 编译
# 状态: 草稿 (待审查)

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E301
trigger_tool:           test|runtime
phase:                  testing|runtime
error_signature:        Permission denied|can't execute: Permission denied|inaccessible or not found

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               platform|go|elf-signing|selinux
match_keywords:         Go binary, permission denied, can't execute, ELF signing, binary-sign-tool, selfSign, static ELF, Go build output
title:                  Go 编译产物未经 ELF 签名无法在 OHOS 执行

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             OHOS 要求所有 ELF 二进制文件必须经过签名才能执行。Go 编译器生成的静态 ELF 二进制默认未签名，因此无法在 OHOS 上直接执行。需要使用 binary-sign-tool 进行签名。与动态链接的二进制 (如 Python) 不同，Go 生成的静态 ELF 二进制需要额外的签名步骤。
affected_scope:         所有 Go 语言编译产物的二进制文件，在 OHOS 上执行时
verification_cmd:       binary-sign-tool display-sign -inFile ytt 2>&1 | grep -q "success" && echo "SIGNED" || echo "UNSIGNED"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           shebang-fix
rec_description:        使用 binary-sign-tool 对 Go 编译产物进行自签名 (selfSign=1)，需要创建 module.json 文件
rec_command:            echo '{"module":{"name":"APP","type":"feature","deviceTypes":["default"]}}' > module.json && binary-sign-tool sign -keyAlias "default" -signAlg SHA256withECDSA -inFile ytt -outFile ytt.signed -selfSign 1 -moduleFile module.json && mv ytt.signed ytt && chmod +x ytt
rec_auto_fix:           true
rec_impl:               shebang-fix

# 回退方案
fallback_priority:      2
fallback_approach:       manual-patch
fallback_description:   在 conanfile.py 的 package() 方法中重新签名二进制，因为 copy() 可能丢失签名
fallback_command:       
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       cp.*ytt.*bin|copy.*ytt.*bin
forbid_1_reason:        直接复制未签名的 Go 二进制到 bin/ 目录将导致无法执行
forbid_1_consequence:   二进制在 OHOS 上执行时报 Permission denied (exit 126)

# ═══ Layer 4: 原则引用 ═══
principles:             P-TOOLCHAIN-001

