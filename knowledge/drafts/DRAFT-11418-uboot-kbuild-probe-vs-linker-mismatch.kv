#====================================================================
# DRAFT-11418-uboot-kbuild-probe-vs-linker-mismatch
# — Kbuild 探测函数（ld-option/cc-option）只对「探测时」组件做
#   兼容性测试：u-boot 顶层 Makefile 以 ld-option 对 $(LD)=GNU ld
#   探测 --no-warn-rwx-segments（bfd 2.39+ 警告抑制旗标）通过后进入
#   KBUILD_LDFLAGS；当配方经 LTO_FINAL_LDFLAGS=-fuse-ld=lld 把实际
#   链接器换成 lld（OHOS 上 clang LTO 缺 LLVMgold 的既定路由）后，
#   探测结论失效——lld 无该旗标且硬报 unknown argument。
#   修法：按实际链接器守卫探测（仅 lld 路由时跳过）。
# 触发事件: u-boot 2026.07 适配（真机 LTO u-boot 链接 ld.lld 报错）
# 路径: Path B（知识库扩展）
#====================================================================

id:                     DRAFT-11418-uboot-kbuild-probe-vs-linker-mismatch
trigger_tool:           make|clang|ld.lld|ld-option
phase:                  conan_build
error_signature:        ld.lld: error: unknown argument|linker command failed
severity:               1
category:               build, toolchain, linker, kbuild
match_keywords:         ld-option, cc-option, lld, -fuse-ld, unknown argument, KBUILD_LDFLAGS, 探测, 链接器错配, LLVMgold
title:                  Kbuild ld-option 探测用链接器与实际链接器错配：GNU ld 接受的旗标被 lld 硬拒（unknown argument），按实际链接器守卫探测

topic: >
  Kbuild 的探测函数只对「探测时」的组件做兼容性测试，组件被替换后
  结论即失效。u-boot 顶层 Makefile:1036 以 ld-option 对 $(LD)=GNU
  ld 探测 --no-warn-rwx-segments（bfd 2.39+ 的 RWX LOAD 段警告抑制
  旗标），探测通过后经 KBUILD_LDFLAGS → -Wl, 进入 cmd_u-boot__ 链接
  命令；当配方以 LTO_FINAL_LDFLAGS=-fuse-ld=lld（OHOS 上 clang LTO
  缺 LLVMgold 插件的既定路由）把实际链接器换成 lld 后，该旗标直达
  lld——lld 无此旗标且硬报 unknown argument。探测组件 ≠ 实际组件是
  这类错的共性：换链接器/编译器驱动时，全部 ld-option/cc-option
  探测结果都要按新组件复核。

root_cause:           u-boot Makefile:1036 的 KBUILD_LDFLAGS += $(call
  ld-option,--no-warn-rwx-segments) 用 $(LD)=GNU ld 探测（bfd 接受），
  实际链接经 clang -fuse-ld=lld 由 lld 执行（配方层
  LTO_FINAL_LDFLAGS=-fuse-ld=lld 命令行覆盖位，Makefile 内 := 置空
  后 += -flto 附加到命令行值）。GNU ld 与 lld 旗标集不重叠：该旗标
  是 bfd 2.39+ 专用，lld 无等价项且对未知旗标硬错（非忽略）。
  scripts/Makefile.lib-u-boot:76 的同名探测（KBUILD_EFILDFLAGS）
  不受影响：EFI 链接直接用 $(LD)，不经过 lld，真机该段已构建成功。

affected_scope:         任何「探测组件 ≠ 实际组件」的 Kbuild 系构建（-fuse-ld=lld / LD=ld.lld / 交叉工具链切换等）：ld-option/cc-option/cc-ldoption 的既有探测结论对替换后组件全部待复核；错误签名固定 ld.lld: error: unknown argument '--xxx'。与 u-boot 无关的通用约束，u-boot 2026.07 的 --no-warn-rwx-segments 为首个实例。

durable_solution: >
  patch 0012：仅当 lld 路由生效时跳过该探测——
    ifeq ($(filter -fuse-ld=lld,$(LTO_FINAL_LDFLAGS)),)
    KBUILD_LDFLAGS  += $(call ld-option,--no-warn-rwx-segments)
    endif
  其余环境（上游 gcc、CI clang+GNU ld）保持原样；EFI 同名探测
  不修改（走 $(LD)）。跳过后 OHOS 上失去的仅是 bfd 警告抑制
  （lld 本不产生该警告），无功能差异。
  通用原则：任何「换链接器」的适配（-fuse-ld=lld、LD=ld.lld、
  LDFLAGS 直传）必须全量复核 ld-option/cc-ldoption 类探测结论；
  反之若只想调整探测本身，可用 ld-option 的三参形式
  $(call ld-option,flags,fallback,probe-command) 让探测与实际
  链接器一致。

impact: >
  适用一切 Kbuild 工程（u-boot/内核）在 OHOS 或任何 lld 路由环境
  的适配：bfd 2.39 时代新增的 --no-warn-rwx-segments 只是首个实例，
  ld-option 探过的其他 bfd 专用旗标（如插件类旗标）在 lld 下同样
  会踩。错误签名固定：ld.lld: error: unknown argument '--xxx'。
  与 u-boot 无关的通用平台约束。

recovery: >
  若链接器替换无法避免，可整体性方案：把 ld-option 的探测命令改
  为实际链接器（三参形式传入 clang -fuse-ld=lld 包装），一处修复
  全部探测；但 u-boot 场景只有一处实际踩雷，按实际链接器守卫该
  探测更诚实、最小化。不可直接把旗标从 KBUILD_LDFLAGS 全局摘除
  ——那会改变所有 GNU ld 环境的警告行为。

evidence_chain: >
  u-boot 2026.07 适配（OHOS PC 真机 2026-09-30，上游 denx 发行包 +
  补丁）：
    - 真机实证：0011+配方 lld 路由落地后，LTO u-boot 链接报
      ld.lld: error: unknown argument '--no-warn-rwx-segments'、
      clang-15: error: linker command failed with exit code 1
      （build.log 实证）；
    - 旗标来源定位：顶层 Makefile:1036 KBUILD_LDFLAGS += $(call
      ld-option,--no-warn-rwx-segments)，ld-option 对 $(LD)=GNU ld
      探测；scripts/Makefile.lib-u-boot:76 同名探测走 $(LD) 不受
      影响（EFI 链接实测正常）；
    - 0012 修复后真机全链验证：待回填（重试环下一轮）；
    - 详见 patches/0012-ldflags-no-warn-rwx-guard-for-lld.patch 与
      notes.md 决策表第 16 条。

verification_cmd: >
  make O=<obj> HOSTCC=clang CC=clang NO_PYTHON=1 CONFIG_SHELL=bash \
    LTO_FINAL_LDFLAGS=-fuse-ld=lld sandbox_defconfig
  # 修复前：LTO u-boot 链接 ld.lld unknown argument；修复后：链接通过

limitations: >
  1) 守卫信号绑定本适配的 lld 路由位（LTO_FINAL_LDFLAGS 带
     -fuse-ld=lld）；若未来 OHOS 改走其他 lld 注入路径（如
     LD=ld.lld），守卫需同步扩展；
  2) 仅覆盖 KBUILD_LDFLAGS 一条探测；其他 ld-option 调用点如后续
     再踩，按同款守卫逐一处理。

rec_priority:           1
rec_approach:           kbuild-probe-guard-by-actual-linker
rec_description: >
  OHOS/lld 环境下 Kbuild 探测结论须按实际链接器复核：ld-option 探
  GNU ld 通过而链接走 lld 时旗标被硬拒（unknown argument）。守卫
  探测：仅 lld 路由时跳过，其余环境原样。
rec_command:            grep -rn 'ld-option' Makefile scripts/
rec_auto_fix:           false
rec_impl:               patches/0012-ldflags-no-warn-rwx-guard-for-lld.patch

