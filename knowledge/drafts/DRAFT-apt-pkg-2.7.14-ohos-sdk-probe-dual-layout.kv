#   4. 编写 knowledge/doc/E0XX.md

id:                     DRAFT-apt-pkg-2.7.14-ohos-sdk-probe-dual-layout
trigger_tool:           conan|cmake
phase:                  configuration
error_signature:        Invalid configuration: OHOS native SDK \(libcxx-ohos headers\) not found|
set OHOS_NATIVE_SDK/OHOS_SDK_ROOT or install the SDK

severity:               3
category:               conan|ohos|sdk-detection|cross-compile
match_keywords:         OHOS native SDK, libcxx-ohos headers not found, OHOS_NATIVE_SDK,
  OHOS_SDK_ROOT, _find_ohos_native_sdk, llvm/include/libcxx-ohos, include/libcxx-ohos,
  ohos/native, ohos-sdk.org, sdk probe, flat layout, llvm nested layout, CI worker,
  aarch64-linux-ohos, libc++ runtime, -isystem libcxx-ohos
title:                  OHOS native SDK 探测须兼容「平铺」与「llvm 嵌套」两种 SDK 布局：本地绿 ≠ CI 绿

root_cause: >
  `_find_ohos_native_sdk()` 只按「平铺」布局探测 libc++ 头文件路径
  `<sdk>/include/libcxx-ohos/include/c++/v1`。但 CI worker 上 OHOS SDK 是
  **llvm 嵌套**布局：`<sdk>/ohos/native/llvm/include/libcxx-ohos/include/c++/v1`
  （SDK root 即 `<sdk>/ohos/native`，llvm 工具链与头文件在其 `llvm/` 子目录下）。
  探测函数返回 None → `generate()` 抛 ConanInvalidConfiguration：
  "OHOS native SDK (libcxx-ohos headers) not found"，`conan create` 在配置期失败。
  
  本地开发机的 SDK 是平铺布局（`<sdk>/include/libcxx-ohos/...`，如
  `/storage/Users/currentUser/ohos-sdk`），探测直接命中 → 本地构建全绿，
  而 CI worker（`/data/service/hnp/ohos-sdk.org/*/ohos/native`）报错——
  即「本地绿 ≠ CI 绿」：SDK 路径探测只认一种布局，是跨环境的隐蔽炸弹。

affected_scope: >
  所有用 `_find_ohos_native_sdk()` 约定（或自定义 SDK 探测）把 OHOS libc++ 头文件/
  运行库注入 CXXFLAGS/LDFLAGS 的 conan 配方（libffado、ccrtp、bcc 等同款实现）；
  以及任何需在「本地平铺 SDK」与「CI llvm 嵌套 SDK」两种环境间迁移的 OHOS 构建。

verification_cmd: >
  本地: conan create archives/a/apt-pkg/2.7.14 -pr:h=ci/conan/profiles/ohos-aarch64
  -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing --build=apt-pkg/*
  CI: 同命令在 worker 上执行（SDK 为 llvm 嵌套布局）→ 修复后应全绿。

rec_priority:           1
rec_approach:           sdk-probe-dual-layout
rec_description:        SDK 探测候选路径同时尝试 c 与 c/llvm 两种布局，命中任一即返回。
rec_command: >
  for sdk in (c, os.path.join(c, "llvm")):
      if os.path.isdir(os.path.join(sdk, "include", "libcxx-ohos", "include", "c++", "v1")):
          return sdk
rec_auto_fix:           true

fallback_priority:      2
fallback_approach:      env-override
fallback_description:   显式设置 OHOS_NATIVE_SDK/OHOS_SDK_ROOT 环境变量指向 SDK native root。
fallback_command:       export OHOS_NATIVE_SDK=<sdk>/ohos/native
fallback_auto_fix:      false

principles:             R31

causes:                 []
caused_by:              []
similar_to:             [E120, E132, E265, E286]
conflicts_with:         []
prerequisite_of:        []

