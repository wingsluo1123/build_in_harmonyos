#====================================================================
# DRAFT — conan copy() inside export_sources() preserves the pattern's
#         relative directory structure, so the landing path is
#         <export_sources>/<pattern-dirs>/... and NOT a flat drop
# Draft only: do not promote without reviewer assignment.
# Trigger event: lru-dict/1.5.0 adaptation (W3/G2 "test case missing")
#====================================================================

id:                     DRAFT-conan-export-sources-copy-keeps-pattern-dirs
trigger_tool:           conan|export_sources|conanfile
phase:                  bootstrap, build
error_signature:        HarmonyOS test case missing under .*ohos-tests|export_sources_folder.*missing|conan create.*build\(\) method.*raise ConanException

severity:               2
category:               conan, recipe, tooling
prescan_pattern:        export_sources|export_sources_folder|recipe_folder
prescan_globs:          conanfile.py
match_keywords:         conan, export_sources, export_sources_folder, recipe_folder,
                         copy, pattern, relative path, test_package, build(), ConanException,
                         os.path.join, dst
title:                  conan export_sources() 内的 copy() 会保留 pattern 的相对目录结构，落点不是扁平目录

root_cause:             期望把 test_package/test_ohos_x.py 导出到
                        <export_sources>/ohos-tests/ 下，于是写了
                        copy(self, "test_package/test_ohos_x.py",
                             src=self.recipe_folder,
                             dst=os.path.join(self.export_sources_folder, "ohos-tests"))。
                        实际落点是 <export_sources>/ohos-tests/test_package/test_ohos_x.py
                        —— conan 的 copy() 会把 pattern 里的相对目录层级附加到 dst
                        之后（dst 只作为前缀根，不含 pattern 目录）。build() 里按
                        <export_sources>/ohos-tests/test_*.py 去 glob 自然空集，
                        配方据此抛 ConanException，G2/W3 干净构建直接失败。
                        缓存目录可自证：p/<pkg>/es/ohos-tests/test_package/。

affected_scope:         一切在 export_sources() 中用带目录的 pattern + copy()
                        导出随配方文件、并在 build()/source() 里按「扁平落点」读取
                        的配方（多目录 pattern 的同理）。
verification_cmd:       ① conan create 后列缓存：ls -R ~/.conan2/p/<pkg>/es/（对照
                           es/ 与 s/ 两处落点）；
                        ② 直接 glob 校验：python3 -c "import glob,os;
                           print(sorted(glob.glob(os.path.join('<es>','<dst>','test_*.py'))))"。

rec_priority:           1
rec_approach:           match-glob-path-to-copy-pattern-layout
rec_description:        两条等价修法，任选其一并写清注释：
                        ① 保持 dst=export_sources_folder（不额外加子目录），
                           读取时按 pattern 的完整相对路径 glob：
                           <export_sources>/test_package/test_ohos_*.py；
                        ② 若确实要扁平落点，把 copy 的 src 指到子目录并把
                           pattern 收窄为文件名：
                           copy(self, "test_ohos_x.py",
                                src=os.path.join(self.recipe_folder, "test_package"),
                                dst=os.path.join(self.export_sources_folder, "ohos-tests"))。
                        并在注释里写明「conan copy() 保留 pattern 相对结构」，避免
                        下一位作者重复踩坑。
rec_command:            conan create <recipe> -pr:h=<profile> -pr:b=<profile> ;
                        ls -R "$CONAN_HOME/p/<pkg>/es"
rec_auto_fix:           false
rec_impl:               match-glob-path-to-copy-pattern-layout

fallback_priority:      2
fallback_approach:      copy-whole-subdir-flat
fallback_description:   若不便调整 glob，可 copy 整个子目录内容到目标目录，落点即
                        为 dst/<文件名>（pattern 为 "*" 时不引入额外层级）。
fallback_command:       copy(self, "*", src=<recipe>/<subdir>, dst=<es>/<name>)
fallback_auto_fix:      true
fallback_impl:          copy-whole-subdir-flat

forbid_1_pattern:       把随配方文件写死成内联字符串常量以绕开导出机制
forbid_1_reason:        内联大段测试代码不可维护、无法被独立执行与审阅，且掩盖
                        了导出机制的真实行为。
forbid_1_consequence:   测试资产不可复用（test_package 无法共享同一份断言），
                        后续维护者继续误判 copy() 语义。

principles:             []
causes:                 []
caused_by:              []
conflicts_with:         []
similar_to:             []
prerequisite_of:        []
related_docs:           []
knowledge_domain:       bootstrap
