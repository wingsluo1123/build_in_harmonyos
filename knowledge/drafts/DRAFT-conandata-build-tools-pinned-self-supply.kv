#====================================================================
# Draft knowledge entry — 设备缺失构建工具时应以 conandata build_tools.*
# 钉源自供给（先探测复用、后下载校验），勿依赖预装或人工安装
#====================================================================
# Timestamp: 2026-10-14
# Software: 通用模式（本 run 触发库：纯 Java/Maven 单模块，无上游 wrapper）
# Gate: conan create build()（配方内工具供给链）
# Status: UNMATCHED — needs human/AI review to promote to E-entry

id: draft-conandata-build-tools-pinned-self-supply
title: 设备缺失构建工具时应以 conandata build_tools.* 钉源自供给（先探测复用、后下载校验），勿依赖预装或人工安装
trigger_tool:         conan|mvn|gn|automake|ply
phase:                configuration|build
error_signature:      mvn.*command not found|No usable Maven|Could not execute mvn from|Maven at .* reports version .* expected|gn.*command not found|aclocal.*command not found
severity:             2
category:             toolchain|conan|build-system|self-supply|environment
match_keywords:       build_tools, conandata, pinned, sha256, self-supply, MAVEN_HOME,
                      M2_HOME, JAVA_HOME, bisheng_jdk, repo1.maven.org, version probe,
                      rejected candidates, wrapper missing, tool supply chain
keywords:             build_tools, conandata.yml, url+sha256 pin, probe reuse first,
                      conan downloader, version validation, rejected list, no wrapper,
                      missing build tool, declarative supply

root_cause:           目标执行环境（OHOS 真机/权威 CI worker）不提供 Maven/gn/automake 等
                      构建工具的可用安装（E184：未预装、cmd-pkgs 无包、无 apt/yum/brew），
                      上游 tarball 又不携带 wrapper（无 mvnw/.mvn/wrapper，jline3 的
                      wrapper 路线不可照搬）时，构建在工具探测阶段失败。既有知识止步于
                      "人工手动安装"（E184 rec_impl=manual, rec_auto_fix=false），把人工
                      步骤留给每台 worker 每轮环境，CI 可复现性差。真实机理补充（环境
                      作用域表述）：权威 CI 执行环境的 PATH 不解析 curl（/usr/bin/curl
                      本体存在，8.8.0-DEV；ci-run1.log 预下载段 15 处 FileNotFoundError:
                      'curl'，L85-116）且该环境 python3 无 CA bundle——任何"配方外先手工
                      下载好"或"shell 单通道下载"都依赖执行环境 PATH/CA 状态，不可依赖；
                      conan 内部下载器与这两项环境状态无关。

affected_scope:       任何在 OHOS 真机/CI 上构建、且目标环境缺失其构建工具、上游又不携带
                      wrapper 的项目（Java/Maven、C++/gn、autotools 的 automake/libtool、
                      Python 生成器 ply 等同模式；配方树内 9 处在库先例横跨 Java 与 C/C++
                      双域）。

verification_cmd:     command -v mvn || echo NO_MAVEN; command -v java || echo NO_JAVA  # 平台事实探针，新 shell 可复跑；
                      grep -n "No usable Maven" <任一新run>/logs/ci-run1.log  # 权威失败→钉源下载实证（本 run 实测 L194）；
                      grep -n "Using verified Apache Maven" <同run>/logs/ci-run1.log  # 下载后版本实测校验成功（本 run 实测 L197）；
                      sed -n '/^build_tools:/,/^[a-z_]*:/p' <repo>/archives/j/jline3/3.3.1/conandata.yml  # 模式实例（bisheng_jdk 钉源段）；
                      grep -rl "build_tools:" <repo>/archives --include=conandata.yml | wc -l  # 在库同模式计数（本 run 实测 9）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:         1
rec_approach:         conandata-build-tools-declarative-pin-self-supply
rec_description:      四段式配方内自供给：①conandata.yml build_tools.<tool> 声明式钉源
                      （url+filename+sha256+version 四元组）；②配方内先探测复用（环境变量
                      MAVEN_HOME/M2_HOME/JAVA_HOME → 常见安装位 → PATH，每候选实测版本，
                      拒绝品进 rejected 清单；预置命中免下载、缓存友好）；③全部缺失时用
                      conan 内部下载器按钉源下载（get(url, filename, sha256,
                      strip_root=True, keep_permissions=True)——PATH 与 CA 状态无关）；
                      ④下载后版本实测校验（如 mvn -v 解析 3.8+，不符即抛错），失败信息
                      携带 rejected 候选全量清单定位诊断。
rec_command:          conandata.yml: "build_tools: { maven: { url:
                      https://repo1.maven.org/maven2/org/apache/maven/apache-maven/3.8.6/apache-maven-3.8.6-bin.tar.gz,
                      filename: apache-maven-3.8.6-bin.tar.gz, sha256: c7047a48…b5a9,
                      version: 3.8.6 } }" ; conanfile.py: tool=self.conan_data["build_tools"]["maven"];
                      get(self, url=tool["url"], filename=tool["filename"], sha256=tool["sha256"],
                      destination=os.path.join(self.build_folder, "apache-maven-3.8.6"),
                      strip_root=True, keep_permissions=True); 校验=subprocess.run([mvn, "-v"]) 后
                      正则解析 3.8+，不符 raise ConanException(rejected 清单)
rec_auto_fix:         false
rec_impl:             conan-recipe

# 回退方案
fallback_priority:    2
fallback_approach:    prestage-tarball-for-probe + manual-install (E184) + prebuilt-jar
fallback_description: ①把工具 tarball 预置到 ~/ 等探测位供②②段探测命中（免下载；注意
                      权威 CI 八门禁重跑会清环境，不可作为唯一依赖）；②E184 人工手动安装
                      （域内既有退路，rec_impl=manual）；③无源码构建诉求时直接用官方预
                      构建 jar（E184 fallback_approach）。
fallback_impl:        manual|conan-recipe

# ★ 禁止策略 ★
forbid_1_pattern:     self\.run\(['"].*curl|os\.system\(.*wget|subprocess.*['"]curl['"]
forbid_1_reason:      配方内 shell 单通道外部下载依赖执行环境 PATH/CA 状态：权威 CI 执行
                      环境 PATH 不解析 curl（/usr/bin/curl 存在但 FileNotFoundError，本
                      run ci-run1.log L85-116 实证）、python3 无 CA bundle——单通道必挂
                      且失败点随 worker 环境漂移（DRAFT-12609 forbid_1 同源，本条为其
                      声明式上位替代）。
forbid_1_consequence: FileNotFoundError: 'curl' 或 CERTIFICATE_VERIFY_FAILED，构建在
                      下载阶段失败且不可复现
forbid_2_pattern:     conandata\.yml.*url:.*(mirrors?\.|gh-proxy|ghfast)
forbid_2_reason:      提交镜像 URL 进 conandata 违反官方 URL 纪律（R39）；镜像加速是 CI
                      侧 mirror-fallback 的运行时改写职责，交付面保持官方 URL。
forbid_2_consequence: R39 门禁拦截 / 上游身份漂移
forbid_3_pattern:     get\(self, url=.*\)(?!.*sha256)|url=.*(?<!sha256=.{70})\n.*destination
forbid_3_reason:      无校验和裸下载：sha256 钉校验是钉源自供给的完整性前提，缺校验的
                      下载在镜像/网络异常时引入不可检的供应链风险。
forbid_3_consequence: 损坏/被篡改工具进入构建，失败形态不可诊断

# ═══ Layer 4: 原则引用 ═══
principles:           P-ENV-001（环境语义冲突优先原生机制；conan 内部下载器即原生机制）；
                      P-JNI-001 第 4 点（无 ant/maven 手动构建仅作退路引用，见 E084）

# ═══ 查重与差异化证据（声明检索口径，防复检质疑）═══
dedup_scope:          检索命令 grep -rliE "build_tools"（大小写不敏感，-l 文件级），范围
                      knowledge/graph/ 与 knowledge/drafts/，2026-10-14 于 feat/jheaps-0.14
                      worktree 实测。
dedup_hits_graph:     E476.kv（唯一命中；匹配行为 verification_cmd 中 cmake 选项
                      -DFOONATHAN_MEMORY_BUILD_TOOLS=ON，与构建工具供给无关）。
dedup_hits_drafts:    8 文件全部无关：DRAFT-darts-0.32-hmdfs-getcwd-tmpdir-pwd-fallback.md
                      （HMBS_BUILD_TOOLS 计数器）、DRAFT-expat-2.8.4-cmake-getrandom-
                      default-auto-6371.kv（EXPAT_BUILD_TOOLS cmake 选项）、
                      DRAFT-inspircd-4.7.0-timeout-env-shell-test-command.md（BUILD_TOOLS
                      通用行提及）、DRAFT-libncursesw-6.6-build-path-archiver.kv/.md
                      （OHOS_BUILD_TOOLS=8/8 预检计数器，2 文件）、DRAFT-minia-3.2.6-preset-
                      system-name-false-cross.md（HDF5_BUILD_TOOLS cmake 选项）、
                      DRAFT-uhttpmock-0.11.0-meson-supply-native-rewrite-dual-includedirs.md
                      （HMBS_BUILD_TOOLS 计数器）、E546-draft-B37A.kv（evidence 字段函数名
                      _stage_glib_build_tools）。
dedup_conclusion:     "conandata build_tools.* 声明式钉源自供给模式"在 graph+drafts 零覆盖；
                      命中全部为同名子串的无关 cmake 选项/预检计数器/函数名。
differentiation:      ①与 E184（graph 正式条目）：E184 的 rec_approach=manual-install-ant、
                      rec_impl=manual、rec_auto_fix=false——把工具供给留在人工步骤；本条
                      把同一失败面（error_signature 同族 mvn.*command not found）升级为
                      配方内声明式自动自供给，属对既有知识的范式升级而非重复。②与
                      DRAFT-12609（draft）：该条是命令式坑修复形态（curl 失败→python3
                      urllib 免证书回退 + sh mvn 绕 shebang + asciidoctor.skip，rec_command
                      为双通道命令串），作用于"下载器怎么写"；本条是声明式供给范式
                      （build_tools.* 钉源 + conan 内部下载器 + 探测复用 + 版本校验），
                      作用于"工具从哪来、失败怎么诊断"——conan 内部下载器天然规避
                      DRAFT-12609 的 curl 单通道与 CA bundle 两坑（本 run ci-run1.log
                      L85-116 预下载全挂、L194-197 conan 下载器接管成功即实证），两者
                      相邻不矛盾、互为引证。③与 DRAFT-12611（draft）：完全不同问题类
                      （旧 Maven 构建插件与新 JDK 不兼容），本条是工具供给缺失面；交叉
                      引用见 related。

# ═══ L2 第二实例证据（配方树同模式）═══
l2_recipe_instances:  grep -rl "build_tools:" archives --include=conandata.yml = 恰 9 处：
                      j/jline3/3.3.1（bisheng_jdk）、j/jackson-jr/2.14.0（bisheng_jdk）、
                      j/jheaps/0.14（bisheng_jdk+maven 双工具）、s/servlet-api/4.0.1
                      （bisheng_jdk）、v/vecmath/1.5.2（bisheng_jdk）、q/qtxdg/3.12.0
                      （lxqt_build_tools，同模式异键名）、s/skia/2.88.9（gn）、
                      r/radlib/2.12.0（automake 多镜像）、l/libcamera/0.7.2（ply）——
                      ≥5 类工具、Java+C/C++ 双域，≥3 门槛远超；消费侧同构：jline3
                      conanfile.py 与 jheaps conanfile.py 均以
                      self.conan_data["build_tools"][…] 消费。

# ═══ 本 run 权威实证（佐证，非唯一依据）═══
evidence_this_run:    run_key=jheaps-0.14，logs/ci-run1.log：L85-116 权威 CI 预下载段对
                      三类钉源产物（源码/BiSheng JDK/Maven）均报 FileNotFoundError: 'curl'
                      （环境 PATH 不解析）；L192 补丁应用行；L194 "No usable Maven 3.8+
                      was found; downloading the pinned Apache Maven 3.8.6 binary
                      distribution"（配方探测全 miss → 钉源下载触发）；L197 "Using verified
                      Apache Maven 3.8.6 home …/build-release/apache-maven-3.8.6"（下载后
                      mvn -v 实测校验通过）。行号为 grep -n 实测锚点。

# ═══ 相邻条目第二实例注记（本 run 对既有草稿的补强，不另立条目）═══
related:              DRAFT-12611-jdk17-patch-build-plugin-compat（第二实例注记：jheaps
                      0.14 同题命中——maven-bundle-plugin 4.2.1（bnd 5.2）在 JDK 9+ 抛
                      ConcurrentModificationException，修复线同为插件升 5.1.9 + conandata
                      portability patch（单属性 maven-bundle-plugin.version），机理补齐为
                      bnd 5.2 aQute.bnd.osgi.Jar.putResource 在 TreeMap.computeIfAbsent
                      映射函数内自变更触发 JDK-8176894 检查，并实测同域排除（compiler
                      3.8.1/surefire 3.0.0-M5/jacoco 0.8.5 无需升级）。证据出处如实标注：
                      第一手 CME 堆栈仅存于 jheaps run 的 notes.md 开发期记述（首次上游
                      构建实测命中），权威 CI 日志（ci-run1.log L192）只有补丁应用记录、
                      无 CME 堆栈——补丁先于构建生效，属"开发期构建观察 + 配方补丁"级
                      证据，非 CI 日志可查。该实例注记应随 DRAFT-12611 一并交主编
                      promote，本文件不修改对方草稿。）;
                      E184（手动安装上位替代）；E084（JNI 手动构建仅退路）；
                      DRAFT-12609（命令式下载坑修复，相邻不同形）
similar_to:           E184, E084, DRAFT-12609, DRAFT-12611

