# ═══ Draft knowledge entry — OHOS 上 autoreconf 自举的 perl 双版本 ABI 冲突：
# ═══ conan autoconf 会引入第二支 perl(5.42.2)，与 SDK perl(5.42.0) 的 XS 不兼容；
# ═══ 正解是「不引入第二支 perl」：只声明 automake/libtool/bison，autoconf/m4 交给 SDK ═══
# Timestamp: 2026-10-15
# Software: fdm 2.2（tag 归档无 configure、需 autoreconf 自举的 autotools 包通用）
# Gate: conan create / conan-verify G2 —— build() 的 autoreconf 自举阶段
# Status: UNMATCHED — 待人工审核提升为正式条目

id:                     DRAFT-fdm-2.2-autoreconf-perl-abi-hnp-only
title:                  OHOS autoreconf 自举：conan autoconf 引入的 perl/5.42.2 与 SDK perl/5.42.0 的 XS 不兼容（Perl_my_cxt_init 未定义）——只声明 automake/libtool/bison、autoconf/m4 交给 SDK 才能过
trigger_tool:           autoreconf|aclocal|automake|autoconf|conan
phase:                  configuration
error_signature:        Perl_my_cxt_init.*symbol not found|
                        Can't load .*auto/Cwd/Cwd\.so.*for module Cwd|
                        \.aclocal-real:.*failed with exit status|
                        autoreconf.*error.*aclocal failed
severity:               3
category:               ohos, autotools, conan, perl, build-system
match_keywords:         autoreconf, aclocal, automake, autoconf, perl, 5.42.0, 5.42.2,
                        Perl_my_cxt_init, Cwd.so, PERL5LIB, XS, ABI, tool_requires,
                        build_requirements, .aclocal-real, .automake-real, shebang,
                        tag archive, bootstrap, SDK, hnp
prescan_pattern:        Perl_my_cxt_init|\.aclocal-real|\.automake-real
prescan_globs:          "*.py, *.log, *.sh"

# ═══ Layer 2: 诊断层 ═══
root_cause:             OHOS 上存在两支 perl：SDK 的 /data/service/hnp/bin/perl（5.42.0）与
                        conan 制品仓里 OHOS 构建的 perl/5.42.2。conan 自动聚合的 conanbuild
                        环境把 PERL5LIB 指向 conan perl 的 lib（含 XS 模块 .so）。于是：
                        ① conan automake/1.18 包装脚本 `bin/aclocal`、`bin/automake` 是
                           `#!/bin/sh`，内部 exec 的 `.aclocal-real`/`.automake-real` 的
                           shebang **硬编码** `#!/data/service/hnp/bin/perl`（实测 head -1
                           可见）⇒ 这两个工具永远跑在 SDK perl 5.42.0 上；
                        ② SDK perl 5.42.0 加载 PERL5LIB 里的 5.42.2 XS（Cwd.so）即报
                           `Perl_my_cxt_init`（symbol not found），aclocal 在生成 configure
                           之前就崩；
                        ③ 反向同样不成立：把 PERL5LIB 收窄成只含 automake 纯 Perl 模块目录后，
                           conan autoconf 的 `.autoconf-real`/`.autom4te-real`（shebang 指向
                           conan perl）又找不到自己的核心模块
                           （`Can't locate strict.pm in @INC … //lib/perl5/5.42.2`）。
                        ⇒ 两条链各要一支 perl，同一个自举流程里无法共存。
affected_scope:         所有「源码归档不含生成的 configure、必须 autoreconf 自举」的
                        Autotools 包（GitHub tag archive 是主形态），且在 OHOS 上以 conan
                        create 构建者。凡是 tool_requires 里出现 autoconf（会连带 perl/5.42.2）
                        又同时需要 automake/aclocal 的配方都会命中。CI worker 无系统
                        automake/aclocal/libtoolize（已有 accel-config 4.1.9 的注释实证），
                        因此 automake 必须来自 conan，冲突必然出现。
verification_cmd:       |
  # 1) 复现：conanbuild 里同时有 conan autoconf + automake 时
  . conanbuild.sh && mkdir -p etc && autoreconf -fi
  # 期望看到: Can't load '…/perl/5.42.2/…/auto/Cwd/Cwd.so' for module Cwd:
  #           Error relocating …: Perl_my_cxt_init: symbol not found
  # 2) 取证两支 perl 的版本与 shebang：
  /data/service/hnp/bin/perl -e 'print $^V,"\n"'          # v5.42.0
  conan cache path perl/5.42.2 .../bin/perl -e 'print $^V,"\n"'   # v5.42.2
  head -1 $(dirname $ACLOCAL)/.aclocal-real               # #!/data/service/hnp/bin/perl
  head -1 $(dirname $AUTOCONF)/.autoconf-real             # #! …/.conan2/p/perl…/bin/perl
  # 3) 修复验证：只保留 automake/libtool/bison 的 build_requirements 后
  . conanbuild.sh && env | grep ^PERL5LIB    # 只含 …/share/automake-1.18（纯 Perl）
  mkdir -p etc && autoreconf -fi             # RC=0，生成 configure/aclocal.m4/Makefile.in

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           single-perl-no-autoconf-tool-require
rec_description:        自举阶段全链只用一支 perl（SDK 的 5.42.0）：build_requirements 里
                        **只声明 automake（提供 aclocal+automake）+ libtool（libtoolize）+
                        bison（yacc，parse.y→parse.c 需要）**，**不声明 autoconf 与 m4** ——
                        SDK /data/service/hnp/bin 已自带 autoconf 2.72、autoreconf、m4 与
                        perl 5.42.0。此时 conanbuild 的 PERL5LIB 只来自 automake 包
                        （指向其 share/automake-1.18，纯 Perl、与任何 perl 5.x 兼容），
                        autoreconf/autoconf/autom4te 走 SDK perl，aclocal/automake 走
                        conan 包装（其硬编码 shebang 也指向 SDK perl）⇒ 无 ABI 冲突。
rec_command:            |
  def build_requirements(self):
      # 只声明 aclocal/automake/libtoolize/yacc；autoconf 与 m4 故意不声明（perl ABI）
      self.tool_requires("automake/1.18")
      self.tool_requires("libtool/2.5.4")
      self.tool_requires("bison/3.8.2")
  def build(self):
      self.run('mkdir -p etc && autoreconf -fi', cwd=self.source_folder, env="conanbuild")
rec_auto_fix:           false
rec_impl:               conan-recipe

fallback_priority:      2
fallback_approach:       explicit-interpreter-driver
fallback_description:   若目标机既无 SDK autoconf、又必须声明 conan autoconf，则放弃
                        autoreconf 一体流程，改为逐个驱动工具并各自钉死解释器与 PERL5LIB：
                        aclocal/automake 用 `$PERL <pkg>/bin/.aclocal-real …`（SDK perl +
                        只含 automake 纯 Perl 模块的 PERL5LIB），autoconf/autom4te 用 conan
                        perl + 完整 PERL5LIB。代价：绑定 conan 包装脚本的内部文件名
                        （.aclocal-real/.automake-real），可移植性差，仅作兜底。
fallback_command:       |
  AM_SHARE=$(ls -d "$(dirname "$AUTOMAKE")"/../share/automake-* | sed -n 1p)
  env PERL5LIB="$AM_SHARE" "$ACLOCAL" --force
  env PERL5LIB="$AM_SHARE" "$AUTOMAKE" --add-missing --copy --foreign
  "$AUTOCONF"
fallback_auto_fix:      false
fallback_impl:          explicit-interpreter

# ═══ 禁止策略（与推荐方案同等重要） ═══
forbid_1_pattern:       tool_requires\(\s*"autoconf
forbid_1_reason:        声明 conan autoconf 会连带拉入 OHOS 构建的 perl/5.42.2，其 XS 与
                        SDK perl 5.42.0 不兼容；只要还需要 aclocal/automake，自举必崩。
forbid_1_consequence:   conan create 在 autoreconf 阶段即失败（Perl_my_cxt_init
                        symbol not found），浪费整轮构建；症状还会被误判成"环境坏了"。

forbid_2_pattern:       PATH=.*(automake|autoconf).*(bin).*autoreconf
forbid_2_reason:        把 conan 的工具 bin 前置到 PATH **改变不了解释器版本**——conan
                        automake 的 .aclocal-real/.automake-real 用的是硬编码绝对 shebang
                        （#!/data/service/hnp/bin/perl），不是 `#!/usr/bin/env perl`。
forbid_2_consequence:   照旧崩溃；且会掩盖真正的双 perl 根因，导致反复调参。

# ═══ Layer 4: 原则引用 ═══
principles:             P013

# ═══ 关系图 ═══
causes:                 []
caused_by:              []
similar_to:             [E490, E011]
conflicts_with:         []
prerequisite_of:        []

# ═══ 查重与新增价值（B 判定依据） ═══
dedup_scope:            知识图谱 index.tsv + knowledge/graph/*.kv + knowledge/drafts/*.kv + 经验文档/B草稿库/
dedup_result:           未命中既有条目；最接近的是 knowledge/drafts/DRAFT-20001-conan-autoconf-perl-path-abi-ohos.kv
dedup_note:             DRAFT-20001 给出的解法是「把 build 依赖的 package_folder/bin 前置到 PATH」，
                        本条实测证明该解法**无效**：conan automake 的 .aclocal-real/.automake-real
                        用硬编码绝对 shebang，PATH 顺序改变不了解释器；本条给出的是另一条解法
                        （不引入第二支 perl：不声明 autoconf/m4、让 SDK 提供），并附三次组合
                        对照实验。按「症状同但解法不同 ⇒ 判 create」口径申报。
                        E490（autotools helper 执行位）与 E011（umask 077 临时目录）是同包
                        另外两个适配点，症状与解法均不同，不构成重复。

