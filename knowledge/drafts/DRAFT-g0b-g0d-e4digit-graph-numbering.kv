#====================================================================
# DRAFT — CI G0b/G0d 知识图谱完整性门禁：编号规则仍限 3 位（E###.kv），
#         未随知识库编号增长到 4 位（E####.kv）更新，导致所有基于最新
#         main 的 PR 在 G0 前置门禁硬失败（与包代码无关）
#
# 触发事件: PR #13558 or-tools 9.15 适配，构建 #96604 在 conan-build-test
#           步骤 G0b 失败，日志 "knowledge/graph/ 下有 1000 个非标准命名的
#           .kv 文件（仅允许 E###.kv）" 且列出 E1000.kv..E1004.kv
# 证据: 主编批量归档知识库后，线上 main knowledge/graph/ 有 2001 个 .kv
#       （E001-E1999），其中 E1000-E1999 恰好 1000 个 4 位编号文件被旧规则
#       判为非标准命名；G0d 旧规则统计 999 个 .kv 与 index.tsv 1999 行不匹配
# 参考: DRAFT-10000（同为 build_and_test.sh G0 框架层门禁问题，G0a zsh
#       null-glob 误报）——框架层修复需单独提交改 ci/conan/build_and_test.sh
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E2000
trigger_tool:           ci/conan/build_and_test.sh|buildbot-worker|conan-build-test
phase:                  gate-check
error_signature:        G0b: knowledge/graph/ 下有 [0-9]+ 个非标准命名的 \.kv 文件|G0d: index.tsv 行数\([0-9]+\) vs \.kv 文件数\([0-9]+\) 不匹配

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               infra, ci, knowledge-base, build-system
match_keywords:         G0b, G0d, 非标准命名, E###, E####, index.tsv, knowledge/graph, 知识图谱, 知识库编号, 门禁, G0, G0_BAD_COUNT, 仅允许 E, conan-build-test, 批量归档
title: CI G0 门禁编号规则停留在 3 位 E###.kv，未随知识库编号增长到 4 位 E####.kv，导致所有基于最新 main 的 PR 在 G0 硬失败

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: ci/conan/build_and_test.sh 的 G0b/G0d 检查于 2026-08（提交
            ccecdc506c feat(ci): G0 知识图谱完整性前置门禁）引入，当时知识
            图谱编号为 E001-E###（3 位）。此后主编批量归档知识库（提交
            【知识库归档】20261016-xx），knowledge/graph/ 编号推进到 E1999
            （4 位，1000 条新条目）。但 G0b 白名单正则
            'E[0-9][0-9][0-9]\.kv' 与 G0d 计数 glob 'E[0-9][0-9][0-9].kv'
            仍只认 3 位数字，导致 E1000-E1999 全部被判为非标准命名，
            G0_BAD_COUNT=1000 触发 G0 硬失败并 exit 1，阻塞所有 PR 的 CI
            （与包代码无关）。
affected_scope: 所有基于最新 main 的 PR CI（G0 为全局前置门禁，在任何包
                构建前执行）；自知识库编号超过 3 位起长期存在，波及全部
                参赛者 PR
verification_cmd: ls -1 knowledge/graph/*.kv | grep -vcE '/E[0-9][0-9][0-9]\.kv$|/_template\.kv$|/principles\.kv$'   # 返回 1000（E1000-E1999 全部被判非标准）
                  ls knowledge/graph/ | grep -oE '^E[0-9]+\.kv$' | sort -V | tail -1                                # E1999
                  ls -1 knowledge/graph/E[0-9][0-9][0-9].kv | wc -l; grep -c '^E[0-9]' knowledge/graph/index.tsv    # G0d: 999 vs 1999 不匹配

# ═══ Layer 3: 解决层 (Solution) ═══
rec_priority: 1
rec_approach: 修改 ci/conan/build_and_test.sh 编号匹配，从固定 3 位放宽到 3-4 位
rec_description: G0b 白名单正则 '/E[0-9][0-9][0-9]\.kv$' → '/E[0-9][0-9][0-9][0-9]?\.kv$'（等价 E[0-9]{3,4}）；G0d 计数 glob 'E[0-9][0-9][0-9].kv' → 同时匹配 3/4 位（用 grep -cE '/E[0-9][0-9][0-9][0-9]?\.kv$' 统计）；错误消息"仅允许 E###.kv"同步改为"仅允许 E###.kv / E####.kv"；G0d 的 index.tsv 行数校验在放宽后自动对齐（1999 == 1999）
rec_command: G0_BAD_KV=$(ls -1 "${GRAPH_DIR_G0}"/*.kv(N) 2>/dev/null | grep -vE '/E[0-9][0-9][0-9][0-9]?\.kv$|/_template\.kv$|/principles\.kv$' || true)
              G0_KV_COUNT=$(ls -1 "${GRAPH_DIR_G0}"/E*.kv(N) 2>/dev/null | grep -cE '/E[0-9][0-9][0-9][0-9]?\.kv$' || true)
rec_auto_fix: true
rec_impl:
fallback_priority: 2
fallback_approach: 若主编同步收紧编号规范（如回退到 3 位或统一 4 位补齐），则 PR 等待 main 侧修复后 rebase
fallback_description:
fallback_command:
fallback_auto_fix: false
fallback_impl:
forbid_1_pattern: knowledge/graph/E1[0-9]{3}\.kv
forbid_1_reason: 正式条目编号由主编审核入库，贡献者不得自行在 knowledge/graph/ 添加/删除条目
forbid_1_consequence: 与主编编号冲突、G0d 索引失配、review 驳回
principles:
causes:                 []
caused_by:              []
similar_to:             [E10000]  # DRAFT-10000：G0a zsh null-glob 误报，同为 build_and_test.sh G0 框架层门禁问题
conflicts_with:         []
prerequisite_of:        []
doc_file:               doc/E2000.md
last_updated: 2026-10-17
source_event: PR #13558 or-tools 9.15 构建 #96604 在 conan-build-test 步骤 G0b 失败

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:                yanjiaxin
source_pr:              13558
source_commit:

