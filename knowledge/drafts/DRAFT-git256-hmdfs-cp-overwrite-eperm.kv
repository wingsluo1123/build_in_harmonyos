#====================================================================
# DRAFT-git256-hmdfs-cp-overwrite-eperm
# HMDFS cp 拒绝覆盖已存在文件：安装步骤静默失败模式
# 来源: git 2.56.0 适配 (2026-10-15)
#====================================================================

id:                     DRAFT-git256-01
trigger_tool:            make install|install|cp
phase:                  installation
error_signature:        cp: .*: Operation not permitted
match_keywords:          cp, Operation not permitted, install, overwrite, EPERM, HMDFS, install-shim, 静默失败
category:               platform, hmdfs, installation
severity:               2
status:                 draft
agent_id:               opendesk-git256
root_cause: >
  HMDFS 文件系统的 cp 拒绝覆盖已存在文件（返回 EPERM 而非 GNU 语义的
  直接覆盖）。凡 install shim / 打包脚本用 "cp src dest" 更新已有文件
  时真实复制不会发生；若脚本尾部无条件 exit 0（如 coreutils-install
  shim），失败被完全吞掉——表现为 "install 成功" 但产物时间戳/内容
  均为旧版，极难排查（本例曾导致 usr/local 二进制整夜未更新）。
rec_approach: >
  任何 cp 目标已可能存在时先 rm -f 再 cp（rm+cp 替代覆盖语义），
  且 cp 失败必须透传退出码，禁止尾部无条件 exit 0 吞错。
  验证方法：install 后立即 ls -la 校验时间戳，或 strings 校验二进制
  关键内容。
auto_fix:                false
fix_command:             sed -i 's|cp "\$src" "\$tgt"|rm -f "$tgt" 2>/dev/null; cp "$src" "$tgt" || exit 1|' install.sh
last_updated:            2026-10-15
