#====================================================================
# DRAFT-git256-make-var-space-quoting
# make 命令行变量值含空格被拆词：No rule to make target
# 来源: git 2.56.0 适配 (2026-10-15)
#====================================================================

id:                     DRAFT-git256-04
trigger_tool:            make|conan create
phase:                  compilation
error_signature:        No rule to make target '(perl|python|env)'
match_keywords:          make 变量, 空格, 拆词, PERL_PATH, PYTHON_PATH, /usr/bin/env, quoting, autotools.make args
category:               build-system, conan, shell
severity:               1
status:                 draft
agent_id:               opendesk-git256
root_cause: >
  经 conan autotools.make(args=[...]) 传递的 make 变量赋值若值含
  空格（如 PERL_PATH=/usr/bin/env perl），命令拼接后经 shell 执行时
  被词法拆分：make 收到 PERL_PATH=/usr/bin/env 与 perl 两个参数，
  后者被当作 target 解析报 "No rule to make target 'perl'"。
rec_approach: >
  args 列表中对含空格的变量值整体加内嵌单引号：
  "PERL_PATH='/usr/bin/env perl'"。注意 conan 链路最终走 shell，
  内嵌引号即可；同时审视被引号包裹值的下游消费者（makefile 内
  $(PERL_PATH) 使用处需兼容 env 形式）。
auto_fix:                false
fix_command:             # conanfile: "PERL_PATH='/usr/bin/env perl'" 而非 "PERL_PATH=/usr/bin/env perl"
last_updated:            2026-10-15
