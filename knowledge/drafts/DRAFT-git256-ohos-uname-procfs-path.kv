#====================================================================
# DRAFT-git256-ohos-uname-procfs-path
# OHOS uname 不匹配 config.mak.uname Linux 分支：平台自动探测静默跳过
# 来源: git 2.56.0 适配 (2026-10-15)
#====================================================================

id:                     DRAFT-git256-02
trigger_tool:            make|configure
phase:                  compilation|configuration
error_signature:        RUNTIME_PREFIX.*not working|exec-path.*hardcoded|--exec-path 指向构建机前缀
match_keywords:          uname, HarmonyOS, config.mak.uname, PROCFS_EXECUTABLE_PATH, RUNTIME_PREFIX, exec-path, Linux 分支, uname_S
category:               platform, portability, build-system
severity:               2
status:                 draft
agent_id:               opendesk-git256
root_cause: >
  上游软件（git 等）的 Makefile 常按 uname -s 输出分发平台探测
  （config.mak.uname 的 Linux 分支含 PROCFS_EXECUTABLE_PATH 等）。
  OHOS 的 uname 输出 "HarmonyOS" 不匹配任何已知分支 → Linux 自动
  设置的平台变量全部静默跳过。git RUNTIME_PREFIX 因此静默失效：
  宏编入但 /proc/self/exe 解析宏缺失，exec-path 回退编译期绝对路径，
  二进制不可移植。
rec_approach: >
  移植类软件（需要可重定位/按二进制位置解析资源）在 config.mak
  显式补上被跳过的平台变量：RUNTIME_PREFIX=YesPlease、
  PROCFS_EXECUTABLE_PATH=/proc/self/exe（/proc/self/exe 在 OHOS 可用），
  并将 gitexecdir/localedir/template_dir 覆盖为相对形式（config.mak.autogen
  会把它们拼成绝对）。验证：拷贝安装树到任意路径后 git --exec-path
  应指向新位置。
auto_fix:                false
fix_command:             printf 'RUNTIME_PREFIX=YesPlease\nPROCFS_EXECUTABLE_PATH=/proc/self/exe\ngitexecdir=libexec/git-core\nlocaledir=share/locale\ntemplate_dir=share/git-core/templates\n' >> config.mak
last_updated:            2026-10-15
