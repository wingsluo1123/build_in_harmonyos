#====================================================================
# lang-preflight 的 manifest 扫描对 setup.py 做全树递归匹配：
# 子目录里的纯 ctypes 消费者封装（gtpython/setup.py，运行时 dlopen，
# 不编译扩展）把 C 库任务判成 mixed → env_unsupported。
# D.4-2 绑定覆盖只救编译型绑定（pybind11/boost::python），ctypes 不在其列；
# 处置走 onnx 判例的交付物证据路径，语言以平台检查为准。
#====================================================================

id:                     LANG-CT-006
trigger_tool:           ohc-run.py|lang_detect
phase:                  preflight|W0
error_signature: |
  "expected": "cpp",
  "detected_language": "mixed",
  冲突: manifest=python 但统计 c 占 76% → mixed
  status: env_unsupported

severity:               2
category:               lang-preflight|R47|false-mixed|ctypes|binding-subdir|setup-py|recursive-match|misdetect
match_keywords:         lang-preflight, detected_language, mixed, setup.py, recursive,
                        gtpython, ctypes, CDLL, dlopen, consumer wrapper, D.4-2,
                        onnx misdetect, 交付物证据, env_unsupported, 全树递归

title:                  >-
                        lang-preflight matches setup.py recursively: a subdirectory
                        pure-ctypes consumer wrapper misdetects a C-library task
                        as mixed; use onnx-style deliverable evidence, not D.4-2

prescan_pattern:        'detected_language.*mixed.*setup\\.py|setup\\.py.*detected.*mixed'

root_cause:             >
                            lang_detect._manifest_scan builds `names` from a recursive
                            file walk and checks pyproject.toml/setup.py/setup.cfg
                            against that full set, while Cargo/CMakeLists entries are
                            matched top-level only. Any nested bindings directory with
                            a setup.py therefore promotes the whole tree to a python
                            manifest; with C sources >=70 percent dominant the conflict
                            rule then yields detected_language=mixed. The binding
                            override (protocol appendix D.4-2) only recognizes compiled
                            bindings (pybind11/boost::python), so a pure ctypes wrapper
                            - which never compiles anything and merely dlopens the
                            built shared library at runtime - gets no relief even
                            though it is a consumer of the deliverable, not a build
                            system for it.

affected_scope:         >
                            C/C++ tasks whose upstream tree ships subdirectory python
                            (or similar) consumer wrappers with setup.py, built by a
                            top-level non-python build system. Not applicable to
                            top-level python manifests (true mixed/python repos), nor
                            to compiled bindings (covered by D.4-2), nor to repos
                            whose deliverable really is python.

verification_cmd:       >
                            python3 scripts/ohc-run.py lang-preflight <pkg> <ver> --src <src>
                            find <src> -name setup.py          # subdirectory hit?
                            head <binding>/setup.py            # Extension(...) or pure packages?
                            grep -rn "ctypes.CDLL\\|cdll" <binding> | head
                            # deliverable stats: top-level build system + .c/.cpp share

rec_priority:           1
rec_approach:           deliverable-evidence-via-onnx-precedent
rec_description:        >
                            Do not override the detector and do not force the task.
                            Verify the subdirectory wrapper is a pure ctypes consumer
                            (no Extension compilation), assemble deliverable evidence
                            (top-level build system, C source share, wrapper nature),
                            and file it with the platform per the onnx 1.20.0
                            precedent - the final language call belongs to the platform
                            check. Record the mismatch honestly in notes; do not claim
                            the preflight passed.

rec_command:            >
                            python3 scripts/ohc-run.py lang-preflight <pkg> <ver> --src <src>;
                            find <src> -name setup.py;
                            grep -rn ctypes <src>/<binding-dir> | head -3

rec_auto_fix:           false
rec_impl:               platform-evidence-report

fallback_priority:      2
fallback_approach:      accept-migration
fallback_description:   >
                            If the platform upholds detected=mixed for this tree, accept
                            env_unsupported and let the task migrate; do not keep
                            building a cpp recipe against a cancelled task.
fallback_command:       >
fallback_auto_fix:      false
fallback_impl:          platform-migration

forbid_1_pattern:       lang-preflight.*(mixed|python).*(忽略|override|硬做|force.*cpp)
forbid_1_reason:        >
                            R47 is a frozen protocol; the scanner result may only be
                            contested with deliverable evidence through the platform,
                            never bypassed by continuing the adaptation silently.
forbid_1_consequence:   >
                            The platform cancels or migrates the task by
                            detected_language anyway, invalidating all downstream work.

principles:             P010, P016
causes:                 []
caused_by:              []
similar_to:             [DRAFT-onnx-1.20.0-lang-preflight-pyproject-priority-cpp-deliverable-misdetect]
conflicts_with:         []
prerequisite_of:        >
                            C/C++ adaptation of upstream trees that carry subdirectory
                            pure-python consumer wrappers with setup.py

doc_file:               knowledge/drafts/DRAFT-lang-preflight-recursive-setuppy-ctypes-consumer-misdetect.md
last_updated:           2026-10-04
source_event:           genometools/1.6.2 preflight (mixed via gtpython/setup.py; cpp adaptation green on device r13)
authors:                dsh-agent
source_pr:
source_commit:

metrics_success_count:  1
