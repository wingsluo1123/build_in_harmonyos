#====================================================================
# DRAFT — OHOS SDK clang auto-generates the .codesign section at link
#         time, so hand-signing C-extension .so files is optional (not
#         mandatory as older cffi / lazy-object-proxy notes imply)
# Draft only: do not promote without reviewer assignment.
# Trigger event: lru-dict/1.5.0 adaptation (CPython C extension)
#====================================================================

id:                     DRAFT-lru-dict-ohos-sdk-clang-auto-codesign
trigger_tool:           conan|binary-sign-tool|llvm-objcopy
phase:                  build, package, runtime
error_signature:        Error loading shared library.*\.so.*Permission denied|ImportError.*_lru.*Permission denied

severity:               2
category:               ohos, build, packaging, security, elf, python
prescan_pattern:        codesign|binary-sign-tool
prescan_globs:          conanfile.py, test_package/*.py
match_keywords:         .codesign, codesign, binary-sign-tool, llvm-objcopy, dlopen,
                         Permission denied, CPython C extension, EXT_SUFFIX,
                         aarch64-unknown-linux-ohos, OHOS SDK clang, selfSign,
                         E077, E452, python extension, lru-dict
title:                  OHOS SDK clang 15.0.4 链接期自动生成 .codesign 段——C 扩展无需手工重签（校验兜底即可）

root_cause:             仓内先例（cffi 2.1.1 / lazy-object-proxy 1.12.0）在
                        build() 与 package() 各调一次 binary-sign-tool 自签，并在
                        docstring 里把「OHOS 要求 .so 带 .codesign 段」表述为
                        无条件必需步骤。lru-dict 1.5.0 实测发现：本平台 OHOS SDK
                        clang 15.0.4（Target: aarch64-unknown-linux-ohos，
                        /data/service/hnp/bin/clang）在**链接期即自动生成**
                        .codesign 段（readelf -S 第 36 项 .codesign PROGBITS），
                        产物无需任何手工签名即可被 OHOS 宿主 python3 与 conan
                        python 解释器 import。因此「必须手工重签」并非本平台
                        事实——无条件重签反而会用 selfSign 覆盖掉工具链的可信
                        签名。判据必须实测，不能沿用先例结论。

affected_scope:         在本平台用 OHOS SDK clang 交叉编译的、需要被 OHOS 动态
                        加载器 dlopen 的一切 .so（CPython C 扩展、共享库插件）。
                        反向适用：任何「照抄先例无条件重签」的配方都在做多余
                        且可能有害的操作。
verification_cmd:       ① 编译后 readelf -S <mod>.so | grep codesign（应有输出）；
                        ② 宿主 python3 -c "import <mod>"（应成功）；
                        ③ 负向对照：llvm-objcopy --remove-section .codesign <mod>.so
                           后再 import → 必失败并报 Permission denied
                           （以此证明该段是 dlopen 的必要条件，而非无关产物）。

rec_priority:           1
rec_approach:           verify-codesign-and-only-resign-when-missing
rec_description:        配方里的签名逻辑改为「校验兜底」而非「无条件自签」：
                        构建/打包后先用纯 Python 解析 ELF 段名表实测 .codesign
                        是否存在（不要相信 binary-sign-tool 的 "add codesign
                        section success" 输出与 rc=0——cffi 先例实测其可能不落段）；
                        存在则**不改动**（保留工具链可信签名）；仅当因 copy()/
                        llvm-objcopy 等操作丢失时才用 binary-sign-tool 重签并
                        复验；仍失败则显式抛错，绝不静默交付装不上的模块。
rec_command:            readelf -S <mod>.so | grep -E '\.codesign' ;
                        python3 -c "import <mod>" ;
                        llvm-objcopy --remove-section .codesign <mod>.so &&
                        python3 -c "import <mod>"   # 预期 Permission denied
rec_auto_fix:           false
rec_impl:               verify-codesign-and-only-resign-when-missing

fallback_priority:      2
fallback_approach:      always-resign-with-verification
fallback_description:   若所在平台工具链确实不自动签名（readelf 无该段且 import
                        失败），退回到先例做法：build 期与 package 期各重签一次，
                        并在每步后用段名表解析复验（conan 的 copy() 会使既有
                        签名失效）。
fallback_command:       binary-sign-tool sign -inFile <so> -outFile <so>.signed
                        -selfSign 1 && mv <so>.signed <so>
fallback_auto_fix:      true
fallback_impl:          post-install-script

forbid_1_pattern:       仅依据 binary-sign-tool (rc=0|success) 断言语义已签名|trust.*binary-sign-tool.*exit code
forbid_1_reason:        签名工具会打印成功并返回 0，但产物可能不含 .codesign 段
                        （cffi 先例实测）；只有读 ELF 段名表才是硬证据。
forbid_1_consequence:   交付一个 dlopen 时报 Permission denied 的模块，且错误
                        信息误导排查方向（E212 为同一症状的另一根因）。

principles:             []
causes:                 []
caused_by:              []
conflicts_with:         []
similar_to:             E077, E452, E295
prerequisite_of:        []
related_docs:           []
knowledge_domain:       build
