#====================================================================
# DRAFT-mjs-2.9.0-aarch64-double-int32-conversion-ub — double→int32
#   转换 UB 经 int64_t 中转修复
# 对应人类文档: knowledge/drafts/DRAFT-mjs-2.9.0-aarch64-double-int32-conversion-ub.md
#
# 本条目为 draft（草稿），尚未由主编审核合入。
# 触发事件: PR mjs/2.9.0 适配 HarmonyOS PC（TOK_URSHIFT / mjs_get_int 负数 double
#   转换在 aarch64 上坍缩为 0 / 错读负值）
#====================================================================

id:                     DRAFT-mjs-2.9.0-aarch64-double-int32-conversion-ub
trigger_tool:           clang|cc|conan
phase:                  compilation|runtime-safety
error_signature:        \(0-14\) >>> 2.*expected 1073741820|mjs_get_int.*-14|
                         unsigned right shift.*collapse|(uint32_t) negative double|
                         (unsigned int) get_double|fcvtzu|TOK_URSHIFT

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               portability, aarch64, runtime-safety, compilation, c-language
match_keywords:         double-to-int32, unsigned right shift, URSHIFT, mjs_get_int,
                         negative double, uint32, int64, UB, undefined behavior,
                         fcvtzu, saturated conversion, aarch64, embedded JS engine
title:                  aarch64 上负数 double 直接转 uint32/int32 为 C 标准 UB——
                         经 int64_t 中转保留补码语义修复

# ═══ Layer 2: 诊断层 ═══
root_cause:             C11 6.3.1.4 规定实浮点转整型时若值无法表示行为未定义；负数
                         double 强转 uint32 必越界→UB。x86 上 clang 恰好按位回绕掩盖
                         UB；aarch64 上生成 fcvtzu 饱和转换指令把负数坍缩为 0——
                         同源 UB 在不同架构出现可观测差异。(int)(unsigned int)get_double(v)
                         先转 unsigned int（负值 UB）再由 int 收窄，aarch64 上负值错读
affected_scope:         在 aarch64（HarmonyOS PC）上用 clang 编译、对负数/越界 double
                         直接做 uint32/int32 强制转换的嵌入式 C/C++ 库（JS 引擎、
                         数值解释器、FFI 桥接类），典型如 cesanta/mjs 2.9.0
verification_cmd:       conan create archives/m/mjs/2.9.0 --build=missing
                         -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
                         # 期望: 覆盖前 (0-14) >>> 2 得 0、mjs_get_int(-14) 错读；覆盖后
                         # test_package "mjs consumer test passed" + 上游单测 42/3436 全过

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           int64-trampoline-narrow
rec_description:        负数/越界 double 先转 int64_t（值域内定义良好，IEEE double
                         尾数 52 位总能由 int64 表示），再收窄到 uint32/int—
                         保留补码语义，不再触发负数转无符号 UB
rec_command:            (mjs.c)
                         case TOK_URSHIFT: return (double) ((uint32_t) (int64_t) da
                           >> (uint32_t) (int64_t) db);
                         (mjs_get_int) return (int) (uint32_t) (int64_t) get_double(v);
rec_auto_fix:           false
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      reject-out-of-range-before-narrow
fallback_description:   不中转时，收窄前先检查 |v| ≤ 2^31 且为整数值，越界拒绝或夹紧；
                         语义不完整（非标准补码），仅当中转不可行时采用
fallback_command:       if (!isfinite(v) || v < INT32_MIN || v > INT32_MAX) return 0;
fallback_auto_fix:      false
fallback_impl:          source-patch

# ═══ Layer 4: 反例/边界 ═══
forbid_1_pattern:       \(uint32_t\) [a-z_]+\)? +where value may be negative without int64
forbid_1_reason:        负数 double 直转 uint32 为 C 标准 UB，aarch64 上饱和为 0
forbid_1_consequence:   无符号右移/取整数值运算结果坍缩，跨架构可观测差异
forbid_2_pattern:       llrint|lround.*replacement.*without.*semantics
forbid_2_reason:        舍入函数有舍入/异常语义，与按位截断语义不等价
forbid_2_consequence:   位运算语义被改变，结果与上游不符
causes:                 []
caused_by:              []
similar_to:             [E432]
conflicts_with:         []
prerequisite_of:        []
doc_file:               knowledge/drafts/DRAFT-mjs-2.9.0-aarch64-double-int32-conversion-ub.md
last_updated:           2026-09-29
source_event:           mjs 2.9.0 适配 HarmonyOS PC（aarch64）首轮发现的负数 double 转换 UB
authors:                ohpcd-pc2
source_pr:              archives/m/mjs/2.9.0
source_commit: