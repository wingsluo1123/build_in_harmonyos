#====================================================================
# DRAFT-nbdkit-1.48.0-application-autotools-module-shared-conflict.kv —
#   应用型 autotools 包（含 libtool -module -shared 动态插件）的 Conan
#   配方若在 generate() 里追加 --disable-shared，libtool 会拒绝构建
#   插件模块："cannot build a shared library"（nbdkit 1.48.0 实测）
# 触发事件: nbdkit 1.48.0 适配，conan-verify G2 失败
# 路径: Path B（知识库扩展）
#====================================================================

id:                     DRAFT-nbdkit-1.48.0-application-autotools-module-shared-conflict
trigger_tool:           conan|configure|libtool|make
phase:                  packaging|linking|configuration

error_signature:        libtool.*cannot build a shared library|
                         cannot build a shared library.*Fatal configuration error|
                         -module.*-shared.*error cannot build a shared library|
                         nbdkit-cc-plugin\.la.*Error 1

severity:               2
category:               conan, autotools, libtool, dynamic-module, packaging, ohos

match_keywords:         --disable-shared, --enable-static, -module, -shared,
                        libtool, cannot build a shared library, plugin, filter,
                        .so, module, package_type=application, application,
                        generate(), AutotoolsToolchain, configure_args,
                        系统同名库, 静态链接, R26, E028, E073, cpp_info.bindirs

title:                  >-
  应用型 autotools 包若含 libtool -module -shared 动态插件/过滤器，
  Conan 配方不能在 generate() 中追加 --disable-shared——插件本质是共享模块，
  禁用共享会让 libtool 报 "cannot build a shared library" 拒绝构建

topic: >
  nbdkit 1.48.0 的 conanfile.py 首版沿用模板的 R26 静态化逻辑
  （--enable-static --disable-shared，面向"系统同名库防污染"场景）。
  configure 阶段正常，make 阶段在构建 plugins/cc 的
  nbdkit-cc-plugin.la（-module -avoid-version -shared）时报：
  "libtool: error: cannot build a shared library ... Fatal configuration error"，
  conan-verify G2 失败。移除 --disable-shared（保留 --enable-static 不必要，
  实际直接删掉静态/共享开关）后 conan create 通过，
  plugins/filters 正常产出 .so，test_package 消费者验证 PASSED。

root_cause: >
  autotools 项目的动态插件/过滤器由 libtool 以
  "-module -avoid-version -shared" 构建，本质是共享库。
  --disable-shared 在 libtool 层面关闭共享库构建能力，
  与 -module -shared 直接冲突，libtool 拒绝执行链接。
  系统同名库静态化（R26/E028/E073）针对的是「库产物与系统库同名、
  动态链接会污染 /lib /lib64」的场景；而应用型服务器的插件是
  本包自产自用的共享模块，不属于系统同名库范畴，
  不加区分地套用 --disable-shared 会破坏插件构建。

verification_cmd: |
  cd build-release/plugins/cc && make nbdkit-cc-plugin.la 2>&1
  # 修复前: "libtool: error: cannot build a shared library"
  # 修复后: nbdkit-cc-plugin.so 正常生成
  conan create . -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=... --build=missing

rec_priority:           1
rec_approach:           keep-shared-for-application-modules
rec_description: |
  1) 判断包类型：package_type=application 且构建系统是 autotools/libtool，
     且源码含 -module -shared 的插件/过滤器/扩展模块 → 不得 --disable-shared；
  2) conanfile.py generate() 中移除 --enable-static/--disable-shared 对，
     依赖层面按需 --without-* 禁用缺失可选库即可；
  3) 若确需静态化系统同名库，仅对库型包（插件模块不存在）应用 R26；
  4) package_info: application 型 bindirs 设 ["bin","sbin"]（conan
     Autotools.install 放 bin/，本地 autotools 默认 sbin/，两者都声明）。
rec_command: |
  # 修复示例（nbdkit 1.48.0）: generate() 不再追加静态/共享开关
  tc.configure_args.append("--without-gnutls")  # 可选依赖照常禁用
  ...
  autotools.configure(); autotools.make(args=["-j1"])
  # package_info
  self.cpp_info.bindirs = ["bin", "sbin"]
  self.cpp_info.libs = []

rec_auto_fix:           false
rec_impl:               recipe-edit

forbid_1_pattern:       --disable-shared
forbid_1_reason:        含 -module -shared 插件的应用型 autotools 包禁用共享
                         会导致 libtool "cannot build a shared library"
forbid_2_pattern:       package_type=library
forbid_2_reason:        插件类应用包应为 application，声明为 library 会触发
                         配方级库型假设（如 libs 字段、--disable-shared 模板逻辑）

boundary_novelty:       |
  边界明确：仅库型包（无插件模块）仍可 --disable-shared 静态化；
  含 -module -shared 插件的应用型包必须保留共享。迁移到其他
  autotools 插件类包（服务器 + 插件架构）时可直接复用。