#====================================================================
# DRAFT-netpbm-10.73.42-e037-env-shebang-correction
#   更正 E037 的前提：OHOS **有** /usr/bin/env（→toybox），缺的是 /usr/bin/perl
# 对应人类文档: knowledge/drafts/DRAFT-netpbm-10.73.42-e037-env-shebang-correction.md
#
# 本条目为 draft（草稿），尚未由主编审核合入。定位是**证据补充与结论更正**，
# 供主编在修订 E037 时合并，而非另立新类。
#
# 与既有条目的关系:
#   E037（正式条目）现 root_cause 写「鸿蒙系统没有 /usr/bin/env」，并据此给出
#     「降级为直接 shebang（#!/bin/sh、#!/usr/bin/perl …）」的处理策略。
#   2026-10-15 在 HarmonyOS PC (aarch64) 实测该**前提不成立**：/usr/bin/env 存在，
#     反而 /usr/bin/perl 不存在 —— E037 的降级方向会把脚本改到**不存在的解释器**
#     上，与本条实测结论相反。
#   DRAFT-ohos-perl-script-package-conan-adaptation 已给出「改 #!/usr/bin/env perl
#     且去掉 -w」的正确做法（另有 conan perl @INC 相关的独立坑）；本条不重复其
#     @INC/包装器内容，只补**平台事实与判据**，并纠正 E037。
#====================================================================

id:                     DRAFT-netpbm-10.73.42-e037-env-shebang-correction
trigger_tool:           sh|perl|conan
phase:                  runtime|installation
error_signature:        bad interpreter: No such file or directory|
                         /usr/bin/perl: (No such file or directory|not found)|
                         (env: )?.*: No such file or directory

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               compat, portability, filesystem, shell
match_keywords:         shebang, bad interpreter, /usr/bin/env, /usr/bin/perl,
                         /data/service/hnp/bin, toybox, PATH, env, interpreter,
                         E037 更正, OHOS 平台事实
title:                  OHOS 平台事实核实：/usr/bin/env 存在（→toybox）、/usr/bin/perl 不存在 —— `#!/usr/bin/env <interp>` 才是正确方向（更正 E037 的前提与降级策略）

# ═══ Layer 2: 诊断层 ═══
root_cause:             HarmonyOS PC 的解释器布局与"Linux 惯例"部分一致、部分缺失，
                         不能整体假设"没有 /usr/bin/env"：

                         | 路径 | 实测（HarmonyOS PC aarch64，2026-10-15） |
                         |---|---|
                         | `/usr/bin/env` | **存在**：软链 → `../../bin/toybox` |
                         | `/usr/bin/perl` | **不存在** |
                         | `perl` 实际位置 | `/data/service/hnp/bin/perl`（在 PATH 中） |
                         | `/bin/bash` | **不存在**（只有 `/bin/sh`）；bash 在 `/data/service/hnp/bin/bash` |

                         因此把上游 `#!/usr/bin/perl` 改写成 `#!/usr/bin/env perl`
                         **是可执行的正确方向**（内核 exec 交给 env → 由 PATH 找到
                         /data/service/hnp/bin/perl）；反过来按 E037 的建议"降级为
                         直接 shebang #!/usr/bin/perl"则会命中**不存在**的路径。
                         ❗E037 的前提（"鸿蒙系统没有 /usr/bin/env"）与实测不符，
                         其 rec_approach 的降级方向在 OHOS 上会制造新故障。
affected_scope:         所有在 OHOS 上分发的脚本类产物（Perl/Python/shell 包装器、
                         configure 脚本、libtool 生成脚本）；也影响"是否要把
                         #!/usr/bin/env 改写掉"的通用判断。
verification_cmd:        # ① 平台事实（本机一次性核实）
                         ls -l /usr/bin/env      # → ../../bin/toybox
                         ls -l /usr/bin/perl     # → No such file or directory
                         command -v perl         # → /data/service/hnp/bin/perl
                         # ② 两种 shebang 的行为对照（决定性判据）
                         printf '#!/usr/bin/env perl\nprint "OK-ENV\n";\n' > a.pl
                         printf '#!/usr/bin/perl\nprint "OK-ABS\n";\n' > b.pl
                         chmod +x a.pl b.pl; ./a.pl; ./b.pl
                         # 期望：a.pl 输出 OK-ENV；b.pl 报 No such file or directory

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           portability-shebang-to-env-interp
rec_description:        ① 安装期把写死的 Linux 绝对路径解释器统一改写为
                            `#!/usr/bin/env <interp>`（去掉 `-w` 等额外参数，见
                            DRAFT-ohos-perl-script-package-conan-adaptation 的
                            `env perl -w` 陷阱）。
                         ② 判断"到底要不要改"时，**先在本平台实测**
                            （`ls -l /usr/bin/env`、`command -v <interp>`），不要套用
                            "OHOS 没有 /usr/bin/env" 的旧结论。
                         ③ 若某解释器在 PATH 中确实不存在，则不应改写为 env 形式，
                            而应显式 `tool_requires` 对应工具（如 perl/5.42.2），
                            由 Conan 的 runenv 提供 PATH。
rec_command:            # 安装期批量改写（幂等；只改首行）
                         grep -rl '^#!/usr/bin/perl' <package_folder>/bin \
                           | xargs -r sed -i '1s|^#!/usr/bin/perl|#!/usr/bin/env perl|'
                         # ⚠️ grep -rl 会同时命中 `#!/bin/sh` + `exec perl -x` 脚本的
                         # 第 25 行 perl -x 标记（pnmflip/ppmshadow/pnmquant 等约 10 个），
                         # 属误报但无害——`sed 1s` 只改首行。要精确清单只看首行：
                         #   for f in <package_folder>/bin/*; do head -1 "$f" \
                         #     | grep -q '^#!/usr/bin/perl' && echo "$f"; done
rec_auto_fix:           true
rec_impl:               package-stage-sed

fallback_priority:      2
fallback_approach:      absolute-path-of-real-interpreter
fallback_description:   若目标环境 PATH 不含该解释器且无法用 tool_requires 提供，
                         则写实际存在的绝对路径（如 `/data/service/hnp/bin/perl`）。
                         缺点：与 hnp 目录结构绑定，换机/换版本可能失效，故仅兜底。
fallback_command:       sed -i '1s|^#!/usr/bin/perl|#!/data/service/hnp/bin/perl|' <script>
fallback_auto_fix:      false
fallback_impl:          package-stage-sed

# ★ 禁止策略 ★
forbid_1_pattern:       鸿蒙.*(没有|无|不存在).*/usr/bin/env
forbid_1_reason:         与实测事实相反（/usr/bin/env 存在，软链到 toybox）；
                         据此决策会把脚本改写到不存在的解释器路径上
forbid_1_consequence:    脚本全线报 "bad interpreter: No such file or directory"，
                         且错误信息不含脚本名、定位困难
forbid_2_pattern:       #!/usr/bin/env\s+\S+\s+-w|env perl -w
forbid_2_reason:         内核把 shebang 首个空白后的全部内容当作一个参数 →
                         env 收到 "perl -w" 去找同名程序，必然失败
forbid_2_consequence:    装出的脚本不可执行（详见 DRAFT-ohos-perl-script-package-conan-adaptation）

principles:             P005, P010
causes:                 []
caused_by:              []
similar_to:             [E037]
conflicts_with:         [E037]
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               knowledge/drafts/DRAFT-netpbm-10.73.42-e037-env-shebang-correction.md
last_updated:           2026-10-15
source_event:           netpbm/10.73.42 适配期间核实解释器布局：包内 2 个 Perl 工具
                         （manweb、pbmtox10bm）首行 shebang 写死 `#!/usr/bin/perl`
                         （OHOS 无此路径）；另有约 10 个 Perl 工具走 `#!/bin/sh` +
                         `exec perl -x`，其第 25 行的 `#!/usr/bin/perl` 是 perl -x 的
                         标记行（非解释器行，无需改写）。实测
                         `#!/usr/bin/env perl` 可正常执行（`env` → toybox），
                         故配方安装后统一改写为 env 形式。同时发现正式条目 E037 的
                         root_cause「鸿蒙系统没有 /usr/bin/env」与实测不符，提交更
                         正证据（对方条目修订由主编审核决定）。
authors:                ohpcd <ohpcd@localhost>
