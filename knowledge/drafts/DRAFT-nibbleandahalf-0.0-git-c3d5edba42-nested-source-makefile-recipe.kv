#====================================================================
# DRAFT-nibbleandahalf-0.0-git-c3d5edba42-nested-source-makefile-recipe
#    GitHub commit tarball 仓库根含 IDE 文件、源码在子目录 + 纯 Makefile
#    项目被 conan-init 误判 autotools 模板 → source() 展平 + make 驱动配方
# 来源: nibbleandahalf 0.0-git-c3d5edba42 适配（Path B 知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-nibbleandahalf-0.0-git-c3d5edba42-nested-source-makefile-recipe
trigger_tool:           conan|make|conan-init|init-build
phase:                  source|compilation|configuration
error_signature:        make: \*\*\* No rule to make target\s+'?\w+\.(a|so)'?|
                        下载内容是 HTML|
                        conanfile\.py.*autotools.*configure.*No rule to make target

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               build-system, make, conan-recipe, source-layout, git-tarball
match_keywords:         NibbleAndAHalf, strip_root, 嵌套源码, nested source, 子目录,
                        IDE 工程文件, .sln, .xcodeproj, 仓库根, GitHub commit tarball,
                        archive/<sha>.tar.gz, 0.0-git, no configure, raw Makefile,
                        conan-init, autotools 模板误判, make 驱动配方, cwd=source_folder
title:                  GitHub commit tarball 的仓库根含 IDE 文件而源码在子目录时，conan get(strip_root=True) 只剥一层导致 Makefile 不在 source 根；且纯 Makefile 项目被 conan-init 误判为 autotools 模板 → 需 source() 展平 + make 驱动配方（含 git 版本必须用 /archive/<sha>.tar.gz 下载）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             >
    (1) GitHub commit tarball（NibbleAndAHalf-c3d5edba42.../）仓库根混放 IDE 工程文件
    （.sln/.xcodeproj/.vcxproj）与源码子目录（NibbleAndAHalf/）；conan get(strip_root=True)
    只剥离一层 commit 前缀目录，Makefile 落在 source_folder/NibbleAndAHalf/ 下，
    build() 里 make 找不到 libnaah64.a 目标 -> "No rule to make target"。
    (2) conan-init 依据 init-build 对 URL 的 build_system 猜测（autotools）生成
    AutotoolsToolchain 模板，但上游是纯 Makefile（无 configure 脚本），模板不适用。
    (3) git 版本（0.0-git-<sha>）无 release tag，若 init-build 拿到仓库页 URL 会下载到
    HTML -> "下载内容是 HTML"；必须用官方 commit tarball URL
    https://github.com/<owner>/<repo>/archive/<sha>.tar.gz。
affected_scope:         仓库根含 IDE/非源码文件且实际源码在子目录的库；0.0-git-<sha>
                        commit tarball 版本；纯 Makefile（无 configure）C/C++ 库。
verification_cmd:       cd <worktree> && python3 scripts/ohc-run.py conan-verify nibbleandahalf 0.0-git-c3d5edba42

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           flatten-nested-source-plus-make-recipe
rec_description:        >
    1) source(): get(strip_root=True) 后检测嵌套源码子目录（如 NibbleAndAHalf/），
    将子目录内容 shutil.move 到 source_folder 根（若根尚无 Makefile），使 Makefile 就位。
    2) conanfile.py 改写为 make 驱动：generate() 用 AutotoolsToolchain（提供 conanbuild env，
    满足 R33）；build() 用 `self.run("make -j1 <目标>", cwd=self.source_folder,
    env="conanbuild")`（E392 修复3 复用）；package() 用 copy() 收集 include/lib；
    package_info() 设 cpp_info.libs。
    3) 下载 URL 必须用 /archive/<sha>.tar.gz 官方 commit tarball（R39），
    不能用仓库页 URL；SHA-256 在 conandata.yml 如实填写。
rec_command:            |
  # source() 展平（conanfile.py）
  get(self, **self.conan_data["sources"], strip_root=True)
  nested = os.path.join(self.source_folder, "NibbleAndAHalf")
  if os.path.isdir(nested) and not os.path.isfile(os.path.join(self.source_folder, "Makefile")):
      for item in os.listdir(nested):
          shutil.move(os.path.join(nested, item), self.source_folder)
      os.rmdir(nested)
  # build()
  self.run("make -j1 libnaah64.a", cwd=self.source_folder, env="conanbuild")
  # 下载（init-build --url 或 conandata sources.url）
  https://github.com/superwills/NibbleAndAHalf/archive/c3d5edba42cb3e1fb91638aed79d3d5f9b371ffe.tar.gz
rec_auto_fix:           false
rec_impl:               conanfile-edit

# 回退方案
fallback_priority:      2
fallback_approach:      keep-nested-subdir-cwd
fallback_description:   若不便展平源码树，可在 build() 把 cwd 指向嵌套子目录
                        （os.path.join(self.source_folder, "NibbleAndAHalf")），
                        package() 从该子目录 copy()；对仅打包子目录产物的库同样可行。
fallback_command:       self.run("make -j1 libnaah64.a", cwd=os.path.join(self.source_folder, "NibbleAndAHalf"), env="conanbuild")
fallback_auto_fix:      false
fallback_impl:          conanfile-edit

# ═══ Layer 4: 原则引用 ═══
principles:             P003, P013

