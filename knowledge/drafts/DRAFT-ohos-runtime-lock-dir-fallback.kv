#====================================================================
# DRAFT-ohos-runtime-lock-dir-fallback.kv
# OHOS PC 无 /var/lock、/var/run 且 /tmp 只读：toybox sh 对不存在路径的
# exec fd 重定向失败即致命终止脚本；锁/PID/状态目录路径必须可覆盖并在
# 不可写时回退，写入须非致命。完整叙事与证据见同目录 .md（成对交付）。
#====================================================================

id:                     DRAFT (proposed，最终编号由知识库主编确认)
trigger_tool:           sh|toybox|laptop-mode-tools|conan|ci
phase:                  runtime
error_signature:        can't create /var/lock/.*No such file or directory|
                         sh:\[.*\]: can't create /var/|
                         /var/lock.*No such file or directory|
                         /var/run/.*No such file or directory

severity:               2
category:               runtime, filesystem, shell, ohos, platform-detect
match_keywords:         /var/lock, /var/run, exec, fd, 重定向, file descriptor,
                        lock file, flock, pid file, state dir, toybox sh,
                        mksh, /bin/sh, Read-only file system, /tmp,
                        laptop-mode-tools, 脚本类应用, daemon, 锁目录,
                        lock dir, fallback, writable probe, OHOS

title:                  OHOS PC 运行时锁/PID/状态目录路径不可假设——设备无
                        /var/lock、/var/run 且 /tmp 只读，toybox sh 对不存在
                        路径的 exec fd 重定向失败即终止脚本；此类路径必须
                        环境变量可覆盖并带不可写回退，写入必须非致命

root_cause:             完整因果链（设备实测，2026-09-26）：(1) 平台探测证据——
                        设备 ls -ld /var /var/lock /var/run 全部 "No such file
                        or directory"，/tmp 下 touch 报 "Read-only file system"，
                        即脚本惯用的锁/PID/状态三类目录在 OHOS PC 上全部不可用；
                        (2) 工具实现证据——laptop-mode-tools 1.74 顶部无防御地
                        执行 `exec 8>$LMT_REQ_LOCK`（LMT_REQ_LOCK=/var/lock/
                        lmt-req.lock 硬编码），`exec 9>$LMT_INVOC_LOCK` 同理，
                        状态文件硬编码 /var/run/laptop-mode-tools/state；
                        (3) 解释器语义证据——toybox sh（/bin/sh）把 exec fd
                        重定向失败当作致命错误立即终止脚本（探针仅输出 before
                        即退出 rc=1，"after" 永不打印），hnp bash 则容忍 exec
                        重定向失败继续执行——同一脚本换解释器症状完全不同，
                        构成间歇性；(4) 失败面——脚本在任何业务诊断输出之前
                        即死，错误信息只有一行 "can't create /var/lock/..."，
                        极易误判为脚本自身缺陷或权限问题而非平台目录缺失。

affected_scope:         在 OHOS PC 上运行、使用 /var/lock、/var/run、/tmp 作为
                        锁/PID/状态/套接字目录的脚本类应用与守护进程：conan
                        打包的 CLI 工具（package_type=application）的
                        build()/test_package 直跑冒烟、CI 直跑脚本、
                        init 脚本/事件触发入口；C/C++ 程序对同族路径的
                        open()/mkdir() 属相邻失败面（见 keyd 案例），但
                        "解释器 exec 重定向致命终止"仅波及 shell 解释路径

verification_cmd:       设备任意新 shell 可复现（探针为只读语义，重定向目标
                        在不存在的目录下不会创建文件）——
                        复现: ssh <ohos-host> "sh -c 'echo before; exec 9>/var/lock/x; echo after'"
                        → 输出仅 "before"，stderr "sh: can't create
                        /var/lock/x: No such file or directory"，rc=1
                        （"after" 永不打印，证明 exec 重定向失败即终止）
                        解释器差异: 同一探针用 /data/service/hnp/bin/bash
                        执行 → "after" 照常打印（bash 容忍 exec 重定向失败）
                        平台探测: ssh <ohos-host> "ls -ld /var /var/lock /var/run; touch /tmp/.probe"
                        → 前三者 "No such file or directory"，touch 报
                        "Read-only file system"

rec_priority:           1
rec_approach:           override-able-paths-plus-writable-fallback
rec_description:        三层防御，全部最小侵入：(1) 路径可覆盖——锁/PID/状态
                        目录统一收敛为环境变量（如 LMT_LOCK_DIR、LMT_RUN_DIR，
                        默认保持上游值），部署侧可指向可写位置；(2) 不可写
                        回退——使用前做可写探针（( : > "$DIR/.probe" )
                        2>/dev/null），失败则按序回退 /tmp/<app>-locks →
                        $HOME/.<app>-locks，仍不可用则以"无锁降级"运行并打
                        VERBOSE 日志（单实例 CLI 工具可接受无锁）；(3) 写入
                        非致命——mkdir/touch/写状态文件均 2>/dev/null 且不
                        使脚本退出。实例：archives/l/laptop-mode-tools/1.74
                        patches/0002（conan create + 权威 CI 全门禁 PASS）
rec_command:            patch 模式（laptop-mode-tools 0002 为范本）:
                        LMT_LOCK_DIR="${LMT_LOCK_DIR:-/var/lock}"
                        if ! ( : > "$LMT_LOCK_DIR/.probe" ) 2>/dev/null; then
                          for fb in /tmp/app-locks "$HOME/.app-locks"; do ...
                        LMT_REQ_LOCK="$LMT_LOCK_DIR/lmt-req.lock"
                        # 状态写入: echo ... > "$LMT_RUN_DIR/state" 2>/dev/null
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      interpreter-swap-not-a-fix
fallback_description:   换用 hnp bash 解释脚本可绕过 exec 重定向致命终止
                        （bash 容忍失败继续运行）。诚实权衡：掩盖而非修复——
                        bash 的容忍是实现细节而非 POSIX 承诺，且锁依然没有
                        建立成功，并发语义静默丢失；仅作过渡手段并需在 PR
                        中标注解释器依赖。
fallback_command:       /data/service/hnp/bin/bash <script> <args>
fallback_auto_fix:      false
fallback_impl:          wrapper-only

forbid_1_pattern:       exec\s+\d+>\s*["']?/(var/(lock|run)|tmp)/
forbid_1_reason:        在未做可写探针/回退的脚本里保留对 /var/lock、/var/run、
                        /tmp 的硬编码 exec fd 重定向：toybox sh 下该行即脚本
                        终止点，且发生在任何业务输出之前。
forbid_1_consequence:   本机/部分上下文（bash）通过、CI 或 /bin/sh 下必现
                        "脚本无输出直接 rc=1"的间歇性失败，最难归因。
forbid_2_pattern:       (mkdir|touch|open)\(?\s*["']?/(var/(lock|run))/
forbid_2_reason:        假设"mkdir -p 能建出 /var/lock"：设备根文件系统对
                        用户不可写，mkdir -p /var/lock 报错，目录不会出现；
                        必须走可覆盖路径 + 回退。
forbid_2_consequence:   启动日志刷 mkdir/touch 错误或功能静默失效（状态文件
                        永远写不进去），锁/单实例语义名存实亡。

principles:             P014
causes:                 []
caused_by:              []
