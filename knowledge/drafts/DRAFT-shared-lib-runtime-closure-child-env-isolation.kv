#====================================================================
# DRAFT-shared-lib-runtime-closure-child-env-isolation
# 可执行依赖的运行时闭包只能注入子进程环境，
# 禁止套到测试进程自身
#====================================================================

# Layer 0: Error Surface
id:                     DRAFT-shared-lib-runtime-closure-child-env-isolation
trigger_tool:           "shell|conan"
phase:                  "build|testing"
error_signature: |
  Error relocating .*libpython3\.12.*\.so.*symbol not found
  libintl_gettext: symbol not found
  Error loading shared library libgcrypt\.so
  exec: "tshark": executable file not found in \$PATH
  exit status 127

# Layer 1: Recognition
severity:               3
category:               "runtime, environment, shared-library"
match_keywords: |
  LD_LIBRARY_PATH, 闭包, runtime closure, 子进程 env, 毒化解释器,
  libintl_gettext, symbol not found, conanrun, buildenv, 共享库型应用,
  command 依赖, PATH, package_folder, child env
title:                  共享库型命令依赖：运行时闭包只注入子进程，测试进程自身绝不套整个 runenv

# Layer 2: Diagnosis
root_cause: |
  当一个可执行包 A 在运行期 exec 另一个共享库型可执行依赖 B（如
  termshark exec tshark）时，B 需要它**整条依赖闭包**的 lib
  目录都在 LD_LIBRARY_PATH 上（tshark 自身 + glib / libgcrypt /
  libgpg-error / libxml2 / zstd / brotli / libpcap 等）。
  这里有两个方向相反的错误：
  (1) 注入不足：只加 B 自己的 lib/，B 会因缺传递依赖的 .so 而
  启动失败（Error loading shared library libgcrypt.so.20）。
  A 还有个隐蔽前提——依赖的 bindirs 只进**消费者的 runenv**，
  不进 A 的 build 进程，所以 A 的上游测试里若 exec B，
  必须显式把 B 的 bin/lib 补进该子进程环境。
  (2) 注入过度：把整个 conanrun 的 LD_LIBRARY_PATH 套到
  **测试进程自身**会毒化无关进程。实测该路径列表里的外部
  libintl 会让 libpython3.12.so.1.0 报
  libintl_gettext symbol not found，消费者测试以 exit 127 崩，
  而真实被测功能根本没跑起来。
  副带问题——Python 侧只依赖合并后的 runenv PYTHONPATH 是脆弱的：
  某依赖用 runenv_info.define_path（替换语义）可覆盖兄弟包的
  prepend_path；应以各包导出的 *_PACKAGE_ROOT 显式重建 sys.path。
affected_scope: |
  所有"exexec 另一个可执行"的可执行包（termshark 调 tshark、
  snakeviz 调 python、wireshark 调 dumpcap 等），以及任何共享库型
  命令依赖的消费者测试。
verification_cmd: |
  组装"B 的 bin + 全闭包 lib"的子进程 env 后跑 B --version；
  负向确认测试进程自身 LD_LIBRARY_PATH 未被污染（解释器可正常 import）。

# Layer 3: Solution Space
rec_priority:           1
rec_approach:           export-plain-vars-build-child-env-in-test
rec_description:        配方把依赖的 bin/lib 以**普通环境变量**导出（如
                        TERMSHARK_TSHARK_BIN / TERMSHARK_LIB_DIRS，遍历全部依赖的
                        package_folder/lib 组成完整闭包），消费者测试在脚本内为
                        termshark/tshark **子进程**构造 env；测试进程自身的
                        LD_LIBRARY_PATH 保持原样。test() 调用时只传自己生成的 env
                        脚本，**不传 "conanrun"**（除非已确认其中无外部 lib 路径）。
                        A 的上游测试若需 exec B，同样显式注入 B 的 bin + 完整 lib 闭包。
rec_command:            遍历 self.dependencies[*].package_folder/lib 组成 LD_LIBRARY_PATH，
                        仅在 subprocess.run(..., env=child_env) 使用
rec_auto_fix:           false
rec_impl:               recipe-plus-test

fallback_priority:      2
fallback_approach:      pinned-strict-closure-download
fallback_description:  若依赖的 runenv 顺序可预期，可用 conan install --deployer=full_deploy
                        把闭包部署到单一目录后只加该目录——仍是子进程作用域。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       conanrun.*self\.run\(|env=\["termshark_test_env",\s*"conanrun"\]
forbid_1_reason:        conanrun 的 LD_LIBRARY_PATH 含外部 lib，会毒化测试进程自身
                        （libpython 报 libintl_gettext symbol not found，exit 127）。
forbid_1_consequence:    消费者测试崩在启动阶段，真实功能一行未跑，且报错误导。
forbid_2_pattern:       只加 tshark 自身 lib|package_folder/lib 单目录注入
forbid_2_reason:        共享库型应用需要整条依赖闭包，仅自身 lib/ 会
                        Error loading shared library libgcrypt.so.20。
forbid_2_consequence:    依赖可执行起不来，上游测试与消费者测试双双失败。

# Layer 4: Principles
principles:             P005

# Relations
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# Metadata
doc_file:               doc/DRAFT-shared-lib-runtime-closure-child-env-isolation.md
last_updated:           2026-10-13
source_event:           termshark 2.4.0 适配：tshark 为共享库型 application 包（bindirs/libdirs），
                        termshark exec tshark。踩过注入不足（libgcrypt.so.20 缺失）与注入过度
                        （conanrun 毒化 libpython → exit 127）两个方向；最终用普通变量导出
                        bin/lib 并在测试内为子进程构造 env，消费者测试 6 项全 PASS。

