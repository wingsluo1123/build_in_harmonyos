#====================================================================
# DRAFT-silent-assertion-artifact-pollution-negative-control
# 视觉/二进制产物断言必须做负对照：artifact 里的无关内容
# （窗口装饰/水印/固定 UI 元素）会让断言永不失改
#====================================================================

# Layer 0: Error Surface
id:                     DRAFT-silent-assertion-artifact-pollution-negative-control
trigger_tool:           "test|consumer-test"
phase:                  "testing"
error_signature: |
  永不失改|软断言|no dominant-red pixels
  assertion.*never fail|static UI element.*satisfied

# Layer 1: Recognition
severity:               3
category:               "testing, deception-detection, assurance"
match_keywords: |
  负对照, negative control, 软断言, 永不失改, silent assertion,
  窗口装饰, #ED655A, ANSI 颜色, PNG filter, scanline, RGBA,
  --no-decoration, artifact pollution, R34, L1e, 反向验证
title:                  产物断言必须做负对照：无关内容（窗口装饰/固定 UI）会让断言永不失改

# Layer 2: Diagnosis
root_cause: |
  对「产物」（截图/渲染图/二进制）做内容断言时，artifact 里往往含有
  与被测能力无关的固有内容。若判定条件只写「出现某特征」，
  该固有内容就能让断言永不失改，测试看似通过实则零信息量。
  实测案例（termshot 0.6.1 消费者测试）：断言「PNG 中存在
  dominant-red 像素」以证明 ANSI 颜色被渲染；但 termshot 默认绘制
  窗口装饰按钮，其中红色为 #ED655A (237,101,90)，代入判定式
  r>=120 且 r-g>=60 且 r-b>=60 必然成立 → 即使被测命令输出
  完全没有颜色，断言仍 PASS。即「颜色渲染功能坏了」与「功能正常」
  产生相同测试结果。
  另有算法层陷阱会掩盖问题：PNG 每行首字节是 filter type，
  gg/image.RGBA 输出为 4 通道，按 3 字节步长在未解 filter 的
  IDAT 流上采样什么都采不中——此时断言恒失败；反向若判定写得太松
  （如 red>0 且 artifact 含固有红色），则恒通过。
  两种都是「与真实能力脱钩」的断言。
affected_scope: |
  所有对图像/渲染产物做内容断言的消费者测试；以及任何断言只检查
  「存在性」而未排除 artifact 固有内容的场景（日志含固定 banner、
  二进制含固定字符串、输出含固定表头等）。
verification_cmd: |
  构造负对照：让被测能力不生效（去掉颜色转义 / 移除目标功能），
  确认断言会失败；再构造正对照确认能通过。两者都成立才是真断言。

# Layer 3: Solution Space
rec_priority:           1
rec_approach:           disable-confounding-ui-plus-negative-control
rec_description: |
  先消除 artifact 中的混淆因素再断言，并用负对照证明断言有区分力。
  termshot 案例：渲染时传 --no-decoration（上游 internal/cmd/root.go:116
  支持该 flag）排除窗口按钮，使红色像素只可能来自命令的 ANSI 输出；
  同时按 PNG 真实格式（chunk 遍历 + 多段 IDAT 合并 + 每行 filter byte
  + width*channels 步长 + 4 类 filter 全解）统计像素。负对照实证：
  无颜色命令 → 0 红色像素（断言失败），ESC[31m 命令 → 1154
  红色像素（断言通过）。把负对照数值写进 MANIFEST/notes 作为证据。
rec_command:            对比实验：被测能力开/关两组，断言结果必须不同
rec_auto_fix:           false
rec_impl:               test-design

fallback_priority:      2
fallback_approach:      region-or-threshold-isolation
fallback_description: |
  若无法关闭混淆 UI，可把判定限定在内容区（跳过标题栏/按钮带），
  或把阈值提高到明显高于混淆因素贡献量（如 red > 1500），
  并在注释中给出混淆因素的像素量级估算。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       "red > 0|存在.*即 PASS|软断言.*never fail"
forbid_1_reason:        「出现某特征即通过」未排除 artifact 固有内容（窗口装饰/固定 UI），固有内容即可满足判定式，导致永不失改；只 print 不 fail 的软断言同样永不失败。
forbid_1_consequence:    R34 软断言，功能回归完全测不出，构成零信息量测试。
forbid_2_pattern:       "按 3 字节步长|未解 filter|raw\\[i:i\\+96\\]|直接扫 IDAT"
forbid_2_reason:        PNG 每行首字节为 filter type 且常见 4 通道 RGBA，3 字节步长采样必然错位、恒不命中（或恒误判）。
forbid_2_consequence:    断言恒失败（无法交付）或采样逻辑形同虚设。

# Layer 4: Principles
principles:             P005

# Relations
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# Metadata
doc_file:               doc/DRAFT-silent-assertion-artifact-pollution-negative-control.md
last_updated:           2026-10-13
source_event: |
  termshot 0.6.1 消费者测试：ANSI 红色断言先因 PNG filter/通道
  步长错误恒失败，修复算法后又发现窗口装饰红 #ED655A 使断言
  永不失改（软断言）。加 --no-decoration 并用负对照实证
  （无颜色 0 像素 / ESC[31m 1154 像素）后才成为真断言。

