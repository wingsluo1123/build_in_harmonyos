#====================================================================
# DRAFT-slrn-1.0.3-build-time-target-tool-run-guard
# 构建期目标端校验工具（chkslang 类）交叉编译守卫
#
# 本条目为 draft，不预占正式 E 编号，禁止直接 promote。
# 触发事件: slrn 1.0.3 HarmonyOS PC 适配（PR #14088）
#====================================================================

id:                     DRAFT-slrn-1.0.3-build-time-target-tool-run-guard
trigger_tool:           make|configure|conan
phase:                  compilation
error_signature:        cannot execute binary file|\*\*\* \[.+\] Error 126
severity:               2
category:               cross-compile, build-system, make, autotools, toolchain
match_keywords:         cannot execute binary file, Error 126, chkslang, build-time tool, sanity check, run guard, cross compile, ENOEXEC
title:                  Build-time target-arch check tools (chkslang-style) must be run-guarded under cross compilation
root_cause:             老式 autotools Makefile 在同一规则里先用目标 CC 编译链接出一个
                        构建期工具（如 jedsoft 系的 chkslang，校验 S-Lang 头文件与
                        运行库版本一致），随后在同一 target 的 recipe 里立刻 exec 它。
                        交叉编译时该产物是目标架构 ELF，构建机 execve 返回 ENOEXEC
                        （cannot execute binary file，make Error 126），构建中断。
                        关键区分：此类工具是"纯校验"（无产出物被后续编译依赖），
                        与必须运行的代码生成器（E359 场景）不同。
affected_scope:         所有在 Makefile 中"编译并立即运行"目标端校验工具的老式
                        autotools 包；jedsoft 系（slrn/most/jed 等）共用该 Makefile
                        模式；任何 macOS/Linux 交叉构建 OHOS 的场景。
verification_cmd:       交叉 profile 下 conan create 成功（构建机无目标架构执行能力），
                        且 OHOS CI 原生构建日志中该校验工具仍真实运行并输出版本校验结果。

rec_priority:           1
rec_approach:           cross-run-guard-with-dependency-pinned-floor
rec_description:        给 Makefile 中"构建并立即运行"的规则加 SKIP 守卫变量：交叉构建时
                        跳过运行并打印明确原因；校验的版本底线改由 conan requires 的
                        精确版本锁定兜底；原生构建（OHOS CI）照常执行校验，行为不弱化。
rec_command:            补丁: if [ "$(SKIP_CHKXXX)" = "1" ]; then echo "skip: cross compiling (floor pinned by conan dep)"; else $(TOOL) ...; fi
                        配方: cross 时 make 传 SKIP_CHKXXX=1（区分真实原生构建与
                        OHOS-settings 本地模拟构建：conf user.build:flex_bison_native）
rec_auto_fix:           false
rec_impl:               apply-conandata-patch

fallback_priority:      2
fallback_approach:      host-compiler-rebuild
fallback_description:   若该工具有产出物被后续编译依赖（代码生成器），则不许跳过——
                        改用 E359 的 HOSTCC/CC_FOR_BUILD 宿主编译器映射重建该工具。
fallback_command:       make HOSTCC="$CC_FOR_BUILD" ...
fallback_auto_fix:      false
fallback_impl:          conan-recipe-build

forbid_1_pattern:       直接删除校验目标|把校验目标改为.*true
forbid_1_reason:        无条件删除运行校验会同时削弱原生构建的版本一致性检查。
forbid_1_consequence:   原生 CI 上库版本错配不再被拦截，问题推迟到运行时崩溃。
forbid_2_pattern:       用目标 CC 编译构建期工具并假设构建机可执行
forbid_2_reason:        交叉编译中构建机无法执行目标架构 ELF。
forbid_2_consequence:   execve ENOEXEC，make Error 126，构建中断（本条目场景本身）。

principles:             P004, P006
causes:                 []
caused_by:              []
similar_to:             E359, E543, E087
conflicts_with:         []
prerequisite_of:        []

prescan_pattern:        ^\t(\./|\$\([A-Za-z_]*DIR\)/)[A-Za-z0-9_.-]+\s
prescan_globs:          Makefile.in, Makefile.am, Makefile, *.mk

doc_file:               drafts/DRAFT-slrn-1.0.3-build-time-target-tool-run-guard.md
last_updated:           2026-10-02
source_event:           slrn 1.0.3 HarmonyOS PC adaptation, PR #14088

authors:                songzhenyan
source_pr:              14088
source_commit:          af3a690cca

metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     1.0
