#====================================================================
# DRAFT-jc-prdiff-baseline-junk.kv
# 主题: W3/finish JC 门禁 full 模式误拦其他库基线 junk 文件 → 生成本包 pr.diff 走 prdiff 模式
# 来源: tiff 4.6.0 首轮本地适配 W3 门禁（finish step5 阻塞）
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     DRAFT-jc-prdiff-baseline-junk
trigger_tool:           git|bash|ci
phase:                  CI/PR-validation
error_signature:        JC_RESULT=fail|
                         Junk Files: [0-9]+|
                         JC1: .*运行时状态文件被跟踪|
                         JC5: .*archives 下未登记的隐藏文件|
                         \[fail\] JC: junk files detected — blocking build

# ═══ Layer 1: 识别层 ═══
severity:               3
category:               CI, PR-validation, junk_check, prdiff, baseline
match_keywords:         JC, junk_check, pr.diff, prdiff, .build-closed, .staging-verified,
                         origin/main baseline, full mode, git ls-files, W3, baseline isolation

# ═══ Layer 2: 诊断层 ═══
title:                  W3/finish JC 门禁 full 模式误拦其他库基线 junk 文件（分支基于 origin/main 重建时）
root_cause:             junk_check.sh 检测模式优先级: 有 pr.diff 走 prdiff（只审 PR 文件清单）；
                         无 pr.diff 且 git diff origin/main...HEAD 为空（分支 HEAD==origin/main 的 R01
                         新库分支尚未提交）时回退 full 模式，用 git ls-files 整仓扫描，
                         把 origin/main 已跟踪的其他库空状态文件（.build-closed/.staging-verified）
                         当作 junk 计入，导致新库首轮 W3 被误判阻塞。
affected_scope:         所有从 origin/main 重建分支、PR 只含本包路径的 R01 新库适配；
                         仓库中"提交前已存在"的其他库基线空状态文件被误计入时
verification_cmd:       git diff origin/main --name-only -- <本包路径>
                         # 确认基线路径不在本包 diff；再 grep -c '其他库路径' pr.diff 应得 0

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           generate-package-prdiff
rec_description:        生成本包 pr.diff 并让 junk_check 走 prdiff 模式（真实 CI checkout-pr 同款）:
                         先确认本地分支基于 origin/main（rev-parse origin/main 成功），
                         再 `git add -N <本包路径>`（intent-to-add 使新文件进入 diff），
                         然后 `git diff origin/main -- <本包路径> > pr.diff`，
                         junk_check 自动检测 pr.diff 存在 → prdiff 模式只审 PR 文件清单。
                         命中的其他库基线文件不做修改/提交，按 ./SKILL.md 记录 blob SHA
                         隔离复验（复跑受影响门禁）后保持原样。
isolation_command:      JUNK_PR_DIFF=$PWD/pr.diff bash ci/scripts/junk_check.sh $PWD
rerun_command:          python3 scripts/ohc-run.py finish <软件> <版本> built
rerun_exit_code:        0
restore_command:        rm -f pr.diff（提交后清理，不纳入 commit；基线文件零修改）
post_sha256:            <基线文件保持 origin/main blob 原值，如 e69de29...>