# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E15137
trigger_tool: conan|cmake|ctest
phase: testing
error_signature: multiprocessing/synchronize.py|_multiprocessing.SemLock|OSError: \[Errno 28\] No space left on device

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: conan, posix, portability
match_keywords: Conan download, ThreadPool, SemLock, ENOSPC, core.download:parallel=0, global.conf, serial download
title: Conan binary download ThreadPool requires SemLock even with a single worker

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Conan binary downloads use multiprocessing.pool.ThreadPool for every nonzero core.download:parallel value; that pool allocates a multiprocessing SimpleQueue with SemLock before any binary download, so unavailable semaphore resources can fail even a one-package download.
affected_scope: Conan 2 binary downloads on targets where the selected pool implementation cannot allocate POSIX semaphore resources; not file extraction or storage-capacity failures.
verification_cmd: conan create <recipe> -pr:h=<native-ohos> -pr:b=<native-ohos>; inspect the full upstream and installed consumer terminals

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: task-private-core-download-parallel-zero
rec_description: First distinguish SemLock initialization ENOSPC from file extraction/disk/inode ENOSPC; use supported core.download:parallel=0 in the task-private Conan home global.conf, preserving the exact published binary RREV/PID/PREV and tests.
rec_command: See the paired Markdown for the exact evidence-backed implementation and verification sequence.
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
