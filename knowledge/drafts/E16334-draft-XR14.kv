#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E16334.kv，填写各字段
# 对应的人类文档: doc/E16334.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E16334
trigger_tool: libtool|clang|llvm-readelf|conan
phase: linking|package|testing
error_signature: (RPATH|RUNPATH).*build.*linker-view|installed=.yes.*libdir=

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: autotools, linking, packaging, runtime, conan
match_keywords: libtool, installed=yes, libdir, private linker view, RUNPATH, RPATH, shared ELF, pkg-config, relocation, signed provider
title: Installed Libtool metadata can leak build-private RUNPATH after successful relocation tests

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: A rewritten installed Libtool archive still tells Libtool to hardcode its libdir into dependent shared objects. Redirecting libdir to a build-private copy fixes stale links but can leak that temporary directory into the installed ELF, even when package consumers and migration tests run successfully while the producer cache still exists.
affected_scope: Libtool producers linking published shared dependencies through a build-private view; applicable only where upstream LIBADD accepts ordinary -L/-l libraries and does not require public Libtool metadata.
verification_cmd: Clean native shared/static conan create; make check and original source inventory; three CMake/PkgConfig consumers; one native signed relocated-provider test; readelf -d must show no producer RPATH/RUNPATH.

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: la-free-shared-library-view-and-installed-ELF-check
rec_description: Copy the actual required .so/.a libraries into the build-private search directory without installed .la files, preserve -L/-l linking, inspect the final installed ELF dynamic section before signing/alias validation and run real consumers from a relocated package.
rec_command: llvm-readelf -d <installed-provider.so>; conan create <recipe> -pr:h=<native-host> -pr:b=<native-build> --build=<package>/*
rec_auto_fix: false
rec_impl: conan-recipe

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach: preserve-required-libtool-metadata-and-repair-upstream-link-interface
fallback_description: If public Libtool metadata is required, inspect the source-bound link interface and installed dependency closure before changing it; a private .la rewrite alone is insufficient.
fallback_command:
fallback_auto_fix:      false
fallback_impl: source-and-recipe

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: sed .*libdir.*\.conan|rm .*\.la.*\.conan
forbid_1_reason: Mutating shared dependency caches breaks package revision identity and affects unrelated builds.
forbid_1_consequence: Reproducibility depends on cache mutation and task order.
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: P010, P012, P014

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to: E236, E522
conflicts_with:         []
prerequisite_of:        []

