#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E2005.kv，填写各字段
# 对应的人类文档: doc/E2005.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E2005
trigger_tool: conan|build_and_test.sh|buildbot-worker
phase: gate-check
error_signature: stub_test_method|test\(\) method has no self\.run\(\) call.*likely a stub|L0d:.*self\.run

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: ci, build, conan, testing
match_keywords: stub_test_method, L0d, self.run, test_package, meson.test, conan create, test(), 门禁拦截, 假测试
title: test_package/conanfile.py 的 test() 未调用 self.run()（仅 meson.test()）导致 CI L0d 门禁 stub_test_method 拦截

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: CI L0d 门禁（build_and_test.sh grep self\.run）要求 test_package/conanfile.py 的 test() 方法必须实际调用 self.run() 运行测试程序；仅调用 meson.test()/cmake.test() 构建系统测试助手会被判为 stub（空壳测试），L0 直接拦截、不进入编译，失败码 stub_test_method
affected_scope: 所有用 meson/cmake 构建、test_package 通过构建系统测试助手驱动测试的 Conan 配方（OHOS PC 制品仓 PR CI）
verification_cmd: grep -q "self\.run" test_package/conanfile.py  # 必须命中；完整验证: CI_PACKAGES="archives/w/wf-utils/0.4.0" zsh ci/conan/build_and_test.sh

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: 在 test() 方法中用 self.run() 直接运行 meson/cmake 构建出的测试程序: test_exe = os.path.join(self.build_folder, "test_xxx"); if can_run(self): self.run(test_exe, env="conanrun")
rec_description: 参考已合入 jsonrpc-glib/gnome-autoar 的 meson test_package 写法：test() 内用 can_run(self) 判断 + self.run(测试程序, env="conanrun") 实际执行，取代仅 meson.test() 的空壳调用
rec_command:            可选: 具体命令模板(${VAR}变量引用)
rec_auto_fix: true
rec_impl: test-package-self-run

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E2005.md
last_updated: 2026-10-18
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:

