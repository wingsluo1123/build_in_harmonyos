#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E2026101615425
trigger_tool: conan|test_package|evidence-auditor
phase: testing|verification
error_signature: Removing previously existing.*test_package.*build folder|AUDIT_FAIL_FIRST_HARMONY_RAW_RECORD_NOT_PRESERVED

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 1
category: conan, testing, build-system
match_keywords: Conan create, test_package, build folder cleanup, first-create raw evidence, stdout, stderr, phase checkpoint, SHA256
title: 重复Conan create前封存瞬时原始测试记录，防止test_package清理丢证

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Repeated Conan create refreshes the same test_package build directory before the next test; collecting only at transaction end loses earlier raw records even when both commands exit zero.
affected_scope: Conan packages whose staged acceptance requires original result/stdout/stderr from multiple creates using one test_package build root.
verification_cmd: Verify first-create raw file manifest before next create, then independently decode and hash-check first/last phase records and actual command argv/rc; keep all original test denominators.

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: checkpoint-raw-test-evidence-before-next-create
rec_description: Conan重复create会先删除既有test_package构建目录；应在每次create完成且下一次调用前，以独立不覆盖的相位清单保存原始stdout/stderr/result字节、相对路径、长度和SHA256，再按run/config/phase重验。该方法补足E403仅讲交付清理、E474仅讲消费者与观察回执分离的边界，可用于需要逐阶段复核的Conan包，不将末次汇总冒充前次原始证据。
rec_command: after create1: capture owned raw paths, bytes, length, sha256 to exclusive phase manifest outside test build; run unchanged create2; audit both phases
rec_auto_fix: false
rec_impl: same-run phase manifest with strict base64 bytes, relative-path and length/SHA256 checks; no synthetic PASS generation

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach: preserve-evidence-incomplete-predecessor
fallback_description: If first raw evidence is already gone, retain incomplete result and release; only a fully rebound successor can establish new complete proof.
fallback_command: record AUDIT_FAIL_FIRST_HARMONY_RAW_RECORD_NOT_PRESERVED; do not replay launched run
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: collect only final test_package build folder|copy final PASS to first phase
forbid_1_reason: The next Conan create can remove earlier raw records; terminal summaries cannot reconstruct source streams.
forbid_1_consequence: False complete repeated-create proof and unreproducible Harmony acceptance.
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

