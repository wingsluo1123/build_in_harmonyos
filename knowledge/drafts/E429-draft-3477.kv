#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E600.kv，填写各字段
# 对应的人类文档: doc/E600.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: clang|test|runtime
phase: testing|runtime
error_signature: Signal 11 \(core dumped\)|Segmentation fault.*(libtk|stub)|Error loading shared library.*libtk|undefined reference to .Tk_InitStubs

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: testing, runtime, conan, api
match_keywords: stub 表, tclStubsPtr, USE_TCL_STUBS, USE_TK_STUBS, Tk_Init, Tk_InitStubs, Tcl_InitStubs, libtkstub, Signal 11, core dumped, 消费者测试, display-independent, wish8.6
title: stub 机制库（Tk 系）消费者测试必须先绑定宿主 stub 表：未绑定即调 API 直接 SIGSEGV

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 库以 USE_TCL_STUBS 编译，库内所有 Tcl 调用经 tclStubsPtr 间接表；该表仅由宿主初始化入口（Tk_Init→Tcl_InitStubs）绑定。消费者只链接 libtk 就调 Tk 公共 API 时表为 NULL → 空指针解引用 SIGSEGV，崩溃点落在 API 内部，极易被误判为链接冲突或库损坏。无显示环境下 Tk_Init 必然失败，但它在检查 display 之前已完成绑定，「容忍其失败再调 API」是可用路径。
affected_scope: Tk 家族及一切经宿主 stub 表导出 API 的库（Tk 8.6/9、Tcl 扩展 expect/itcl/tdbc、Tk 扩展）在 OHOS 的消费者测试
verification_cmd: clang --target=aarch64-linux-ohos -I<pkg>/include test.c -ltk8.6 -ltcl8.6 后运行；未绑定表时 rc=139，先 Tk_Init(容忍失败) 后 rc=0

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: host-init-before-api-call
rec_description: 消费者先调宿主初始化入口（Tk_Init）并接受其环境性失败（无显示 rc=1），完成内部 stub 表绑定后再调库公共 API 断言返回值；并把失败原因钉在 display 上，避免与库加载/签名问题混淆。
rec_command:            可选: 具体命令模板(${VAR}变量引用)
rec_auto_fix: false
rec_impl: conan-test-package

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: dlopen-dlsym-symbol-contract
fallback_description: 无宿主二进制可绑表时退化：dlopen 包内 .so + dlsym 校验动态符号表真实导出符号 + 运行包内 CLI 探针，断言失败原因仅缺显示。
fallback_command:
fallback_auto_fix: false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: dlsym\([^)]*"Tk_InitStubs"
forbid_1_reason: Tk_InitStubs 由静态 stub 库（libtkstub8.6.a）提供，不在 .so 动态符号表，dlsym 恒 NULL
forbid_1_consequence: 消费者测试以假失败收场，掩盖真实适配问题
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: P013,P014

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to: E530
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
forbid_2_pattern: printf\(.*\\n"\);$
forbid_2_reason: 输出走管道时 stdout 默认块缓冲，崩溃前最后几行被吞掉
forbid_2_consequence: 崩溃点被误判到更早的位置，浪费排查轮次
doc_file: doc/E429.md
last_updated: 2026-10-16
source_event: tk 8.6.16 HarmonyOS PC 适配（依赖项任务，消费者测试无显示环境）

