#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: javac|conan|create
phase: building
error_signature: unmappable character \(0x..\) for encoding UTF-8|警告: unmappable character|编码错误

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: java, encoding, build
match_keywords: javac, -encoding, ISO-8859-1, Latin-1, unmappable character, 0xA4, 老源码, 默认平台编码
title: **老 Java 源码常是 Latin-1（ISO-8859-1）编码**：用 `javac -encoding UTF-8` 编译会报 `unmappable character (0xNN) for encoding UTF-8` → 必须按 `-encoding ISO-8859-1` 编译（上游 `build.xml` 往往不指定 encoding，即依赖 javac 的**默认平台编码**，在 UTF-8 环境下就会踩到）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 2000s 前后的 Java 源码常在注释/字面量里含 Latin-1 单字节字符（如 0xA4 = "¤"、0xA7 = "§"）。 上游构建脚本未声明 `encoding` 时，javac 用平台默认编码读源码——在 UTF-8 默认的现代环境里， 这些字节无法映射 → 编译失败（或（警告形式）静默替换成 U+FFFD，造成字面量悄悄变样）。
affected_scope: 所有编译 2000s 前后 Java 源码的适配；以及任何"上游未在构建脚本里声明 encoding"的 Java 项目
verification_cmd: ①`file <src>` 或 `grep -P '[\x80-\xff]' <src> | head`（找非 ASCII 字节）②`python3 -c "b=open('<src>','rb').read(); print([hex(x) for x in b if x>127][:8])"` ③用两种 encoding 各试一次编译，看哪种通过

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: compile-with-iso-8859-1-when-upstream-omits-encoding
rec_description: ①遇到 `unmappable character (0xNN) for encoding UTF-8` 时**不要**去改上游源码或加 `-nowarn` 了事；②先取字节级证据（`python3` 列出 >127 的字节），确认是老编码；③把编译命令改为 `javac -encoding ISO-8859-1 …`（与 javac 在上游默认环境下行为一致），并在配方注释/notes 里写明原因；④若同一工程里新旧文件编码混杂，可按目录分别编译或逐个试探；⑤消费者校验仍要端到端真跑（编码错误在被 `-nowarn` 掩盖时可能变成"字面量悄悄变样"，只有真跑能发现）。
rec_command: python3 -c "b=open('src/x.java','rb').read(); print(sorted({hex(x) for x in b if x>127}))" ; javac -encoding ISO-8859-1 -d classes $(find src -name '*.java')
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: patch-the-few-offending-files-to-utf8
fallback_description: 若必须统一成 UTF-8（例如要与仓库其它规范一致），可只对含非 ASCII 字节的少数文件做一次转码（latin-1 → utf-8）并作为 portability 补丁提交；但补丁须逐个文件核对、且不能改变字面量的语义。
fallback_command:
fallback_auto_fix: false
fallback_impl: manual forbid_1_pattern:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

