#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: conan
phase: configuration
error_signature: HTTP Error 418: I'm a teapot.*alpinelinux.*APKBUILD|解压失败: not a gzip file.*APKBUILD|conan.*download.*gitlab.alpinelinux.org.*(418|403)

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: packaging|source-fetch|shell
match_keywords: APKBUILD, aports, tpaste, not a gzip file, 418, teapot, gitlab.alpinelinux.org, raw, single-file, printf, package()
title: 以 Alpine APKBUILD 为唯一上游（无 tarball）的脚本包：init-build 报 'not a gzip file'，源文件改取同 commit 的 GitHub 官方镜像 raw，并在配方内按 package() 模板生成脚本

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 部分 Alpine 包（如 tpaste/dpaste/ix）没有上游发布包，脚本由 aports 的 APKBUILD 在 package() 里用 printf 现场生成：①init-build 只会下载并解压 tar，对单文件源报 '解压失败: not a gzip file'；②gitlab.alpinelinux.org 前置反爬(go-away)对 Conan 的 User-Agent 返回 HTTP 418（curl/urllib 的 UA 可 200），CI 里 conan download 会失败。
affected_scope: 所有以 Alpine aports APKBUILD 为唯一源、脚本由 package() 的 printf/heredoc 现场生成的包（tpaste/dpaste/ix 等）。与 E347(同域 418，rec=预置 conan 下载缓存) 和 E335(tarball 场景改用 distfiles) 在『418』部分重叠；本条新增点是『无 tarball、APKBUILD 本身就是源』这一形态：distfiles 无对应文件，且 init-build 无法处理单文件源。
verification_cmd: python3 -c "import urllib.request as u;print(u.urlopen(u.Request('https://gitlab.alpinelinux.org/alpine/aports/-/raw/3f28b79bb6e626953e3786be38349719ebd1789d/main/tpaste/APKBUILD',headers={'User-Agent':'Conan/2.29.1'})).status)"  # 期望 HTTP Error 418；改用 raw.githubusercontent.com/alpinelinux/aports/<同 commit>/... 得 200 且 sha256 相同

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: 固定 aports commit，conandata 下载 GitHub 官方镜像 alpinelinux/aports 的同 commit raw APKBUILD 并校验 sha256；init-archive 代替 init-build 建骨架；配方 build() 解析 APKBUILD 的 pkgver/url，按 package() 的 printf 模板生成脚本并 sh -n 语法检查
rec_description: 不要自行手写脚本内容后声称来自上游：脚本模板须与校验过 sha256 的 APKBUILD 的 package() 逐字对照，pkgver 取自 APKBUILD 并与 conan version 比对，不一致时报错；test_package 用确定性的假 curl 做消费者用例，逐字节比对生成的脚本与 APKBUILD printf 输出。
rec_command: conandata.yml: url=https://raw.githubusercontent.com/alpinelinux/aports/<commit>/main/<pkg>/APKBUILD + sha256
rec_auto_fix: false
rec_impl:

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach: 按 E347 预置 conan sources download cache（curl 取 gitlab 官方 raw，按 sha256 入缓存）
fallback_description: 仅在 GitHub 镜像缺失目标 commit 时使用；CI worker 上无法预置缓存，故不作首选
fallback_command: 见 E347
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: printf .*#!/bin/sh|cat > .*<<.*#!/bin/sh|手写脚本内容
forbid_1_reason: 脚本内容不得凭记忆手写后声称来自上游，必须由 sha256 校验过的 APKBUILD 派生
forbid_1_consequence: 无法溯源，评审会判定源码来源不可信；上游改动后配方静默漂移
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             [E335, E347, E271]
conflicts_with:         []
prerequisite_of:        []

