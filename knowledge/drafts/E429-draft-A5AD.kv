#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: conan, node, mocha
phase: build, testing
error_signature: WebAssembly is not defined|typeof WebAssembly.*undefined|spawn mocha ENOENT|Only a single instance is supported

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: P1
category: node-runtime, ohos, testing
match_keywords: WebAssembly is not defined, jitless, --jitless, node runtime, mocha exit code, SNFE single instance, uBlock Origin, ubo-core, JS library wasm
title: OHOS Node.js: WebAssembly-依赖的纯 JS 库禁用 --jitless；npm test.js 不传播 mocha 退出码

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: OHOS 上 node 执行 JS 可能触发 V8 断言崩溃（E400），习惯性用 NODE_OPTIONS=--jitless 规避；但 --jitless 令 V8 关闭可执行内存，typeof WebAssembly 变为 undefined（实测 plain=object / jitless=undefined）。若被测 JS 库依赖 WebAssembly 制品（如 uBlock Origin 的 hntrie/biditrie/publicsuffixlist/lz4 wasm 引擎），--jitless 会让上游 wasm 用例直接 ReferenceError 失败。另：上游 platform/npm/test.js 用 promisify(spawn)('mocha',...) 却不检查子进程退出码，mocha 失败时 test.js 仍 exit 0。
affected_scope: Node.js 运行时上、依赖 WebAssembly 制品的纯 JS 库/CLI（如 uBlock Origin @gorhill/ubo-core 的 hntrie/biditrie/publicsuffixlist/lz4 wasm 引擎）；在 OHOS/HarmonyOS aarch64 上以 conan 配方构建并跑上游 mocha 测试的场景。
verification_cmd: node -e 'process.stdout.write(typeof WebAssembly)'   # plain=object / --jitless=undefined；另 node --jitless -e 'typeof WebAssembly' 复现 undefined

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: 对依赖 WebAssembly 的 JS 库：不要注入 NODE_OPTIONS=--jitless；以 plain node + (typeof WebAssembly==='object') 作可用性探针，构建期 fail-fast。运行上游测试时直接调用 mocha（node_modules/.bin/mocha --experimental-vm-modules）取真实退出码，勿依赖 test.js 的退出码。ubO SNFE 为单实例，serialize/deserialize 必须作用于同一实例。
rec_description:        一句话描述这个推荐方案
rec_command:            可选: 具体命令模板(${VAR}变量引用)
rec_auto_fix:           true|false                  # 引擎能否自动执行
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

