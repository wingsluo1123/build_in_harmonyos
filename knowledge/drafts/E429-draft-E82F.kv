#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: conan|create|test_package|sh
phase: testing
error_signature: usb-list 真实失败（exit=1）|set -e|\[ -d .*\] 返回非 0|空设备树|宿主缺前置条件

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: testing, shell, environment
match_keywords: set -e, 前置条件, /sys/bus/usb/devices, usb-list, report-hw, 具名环境信号, 消费者校验, exit=1, 空目录, 探测后 SKIP
title: upstream 脚本常带 `set -e`，当**宿主缺少它的前置条件**（如沙箱里 `/sys/bus/usb/devices` 为空）时脚本会**按设计**返回非 0 —— 消费者校验不能据此判"打包缺陷"，应当在运行前**显式探测该前置条件**，探到缺失才记具名环境 SKIP（有设备时仍严格校验）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: installation-report 的 `usb-list` 遍历 `/sys/bus/usb/devices/usb*`：在没有任何 USB 设备的 容器/沙箱里该 glob 不匹配，脚本内部 `[ -d '…usb*' ]` 为假 → `return` 非 0 → 受文件头 `set -e` 影响整脚本以 **1** 退出（实测：直接执行 exit=1；`sh -x` 追踪可见失败点就是那次 `[ -d … ]`）。 脚本本身没错（upstream 走 Debian 安装器/真实机器的路径下总有设备），错的是把"宿主缺前置条件" 当成"产物有问题"。另一方面，若把这类非 0 一律 SKIP，又会掩盖真实缺陷（与 PR #14983 的 aireview P2 同类问题）。
affected_scope: 所有 best-effort 真跑 upstream 脚本/二进制的消费者校验；尤其是脚本依赖宿主资源（sysfs、/proc、设备、可选外部工具）而自身带 `set -e` 的情形
verification_cmd: ① `ls -A /sys/bus/usb/devices | wc -l`（前置条件是否具备）② 直接执行脚本看退出码：`<pkg>/bin/usb-list; echo $?` ③ `sh -x <script>` 看失败点是否落在"前置条件判断"上

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: probe-the-precondition-then-classify-with-named-evidence
rec_description: ①跑之前**显式探测前置条件**（目录/条目数/设备/可选工具是否存在），探测结果就是"具名证据"；②前置条件缺失 → 记 **SKIP 并打印探测到的具体依据**（如"`/sys/bus/usb/devices` 条目数 0"），不要空口 SKIP；③前置条件具备却仍失败 → 按"具名信号才 SKIP、其余判缺陷"的口径严格判 FAIL（超时/无执行权限/权限拒绝可 SKIP）；④在所测脚本带 `set -e` 时，特别注意"最后一个判断为假"也会让整脚本非 0，这是最常见的伪失败来源。
rec_command: n=$(ls -A /sys/bus/usb/devices 2>/dev/null | wc -l); [ "$n" -eq 0 ] && echo "SKIP: 宿主无 USB 设备（条目 0）" || ./usb-list; echo $?
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: run-under-sh-and-treat-documented-nonzero-as-named
fallback_description: 若某脚本的前置条件难以探测，可退而用 `sh <script>` 运行并把"upstream 文档/注释中声明过的资源缺失"列为具名信号；但这比显式探测弱，须在 notes 里注明判据来源，且不得演变成"任何非 0 都 SKIP"。
fallback_command:
fallback_auto_fix: false
fallback_impl: manual forbid_1_pattern:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

