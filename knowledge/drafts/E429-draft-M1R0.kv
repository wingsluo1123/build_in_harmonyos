#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool:           configure|cmake|meson|make|gcc|clang|ld|python|pip|install|test|runtime
phase:                  configuration|compilation|linking|installation|testing|runtime
error_signature: config.guess 报 unable to guess system type，即使已按 E007 插入 HarmonyOS 分支

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: autotools,platform
match_keywords:         unable to guess system type, config.guess, GUESS, HarmonyOS, config.sub
title:                  老版 config.guess 无 GUESS 出口机制——E007 补丁插入的 HarmonyOS 分支不生效

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 2012 年代版本的 config.guess 主 case 各分支直接 echo+exit，没有新版才有的 GUESS 变量出口机制；patch-autotools-ohos.pl 插入的分支只给 GUESS 赋值不输出，脚本继续走到文件末尾报 unable to guess system type（同代 config.sub 也缺 android-linux 锚点，三处 ohos 支持不会自动命中）
affected_scope: 使用 2012 年前后 autotools 预生成 config.guess 的项目（尤其发布 tarball、无 autoreconf 的适配路径），凡靠 patch-autotools-ohos.pl / E007 插入 HarmonyOS 分支者；典型如 miredo 1.2.6（admin/config.guess）
verification_cmd: cd <源码根> && sh admin/config.guess（期望输出 aarch64-unknown-linux-ohos；若报 unable to guess system type 即命中本模式；对照 grep -n "GUESS" admin/config.guess 无输出即为无出口机制的版本）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach: 插入分支须自带 echo "${MACHINE}-unknown-linux-ohos" ; exit ;;（见 archives/a/abook/0.6.1/patches/0001-config.guess.patch 与 miredo 0004 补丁）；config.sub 手工补 maybe_os 列表 linux-ohos*、内核-OS 列表、-linux-ohos*) os=-linux-ohos 三处（见 archives/a/acpitool/0.5.1/patches/0002-config.sub.patch）；改完用 sh admin/config.guess 与 sh admin/config.sub aarch64-unknown-linux-ohos 自测
rec_description:        在老版 config.guess 的对应分支里直接 echo 三元组并 exit（不能只给 GUESS 变量赋值），config.sub 同步补 ohos 三处锚点，改完用 sh 自测两脚本能输出/接受 aarch64-unknown-linux-ohos
rec_command:            config.guess 插入 `*:HarmonyOS:*:*) echo "${MACHINE}-unknown-linux-ohos" ; exit ;;`（放在原有 case 分支内、文件末尾报错之前）；config.sub 补 maybe_os 列表 linux-ohos*、内核-OS 列表 linux-ohos、`-linux-ohos*) os=-linux-ohos ;;`
rec_auto_fix:           false
rec_impl:               manual-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
