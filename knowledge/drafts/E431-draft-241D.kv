#====================================================================
# E431 — 鸿蒙 XPM 代码签名：未签名的打包 ELF 无法 exec/dlopen
# 场景: ws 11.4.6 (IXWebSocket) 适配 — bin/ws "Operation not permitted"
#====================================================================

id:                     E431
trigger_tool:           conan|runtime
phase:                  installation|testing|runtime
error_signature:       Operation not permitted|Permission denied.*bin/|dlopen failed:.*\.so|inaccessible or not found.*bin/

# ═══ Layer 1: 识别层 ═══
severity:               3
category:               ohos, platform, selinux, build-system, conan
match_keywords:         XPM, codesign, binary-sign-tool, llvm-objcopy, .codesign, Operation not permitted, dlopen, exec, test_package
title:                  鸿蒙 PC XPM 要求 exec/dlopen 的 ELF 都带代码签名，package() 必须对 bin/ 与 lib/*.so 调 binary-sign-tool 签名

# ═══ Layer 2: 诊断层 ═══
root_cause:             鸿蒙 PC 内核 XPM 策略要求可执行文件与动态库具备有效代码签名；conan package() 直接 cmake.install() 出来的 ELF 没有 .codesign 节，test_package 里 self.run(包内 bin/ws) 报 sh: Operation not permitted（退出码 126），dlopen 共享库同理。
affected_scope:         所有打包二进制（bin/ 下 CLI）或 shared 选项产物（lib/*.so）的配方；test_package 里执行包内程序的场景。
verification_cmd:      /data/service/hnp/bin/llvm-objdump -h <pkg>/bin/<tool> | grep codesign

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           sign-in-package-method
rec_description:        在 package() 里对 lib/**/*.so* 与 bin/ 下的 ELF 逐个执行 llvm-objcopy --remove-section .codesign（幂等清理）后 binary-sign-tool sign -selfSign 1 重签名（工具仅存在于 OHOS 设备，须加 settings.os == "OHOS" 守卫）。
rec_command:            self.run('{oc} --remove-section .codesign "{f}" 2>/dev/null || true'.format(oc="/data/service/hnp/bin/llvm-objcopy", f=f)); self.run('{sg} sign -inFile "{f}" -outFile "{f}" -selfSign 1'.format(sg="/data/service/hnp/bin/binary-sign-tool", f=f))
rec_auto_fix:           false

fallback_priority:      2
fallback_approach:      consumer-side-sign
fallback_description:   消费者安装后再签名（不进包，导致包不可复用，不推荐）。
fallback_auto_fix:      false

forbid_1_pattern:        git add -f.*\.so|git add -f.*bin/
forbid_1_reason:         已签名的二进制属于制品而非源码归档，禁止进 git（会被 junk_check JC2 拦截）。
forbid_1_consequence:    PR 被 JC 门禁拒绝。

# ═══ Layer 4: 原则引用 ═══
principles:

# ═══ 关系图 ═══
causes:                 []
caused_by:              []
similar_to:             [E220]
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E431.md
last_updated:           2026-10-13
source_event:           ws 11.4.6 (IXWebSocket) 适配：test_package self.run(bin/ws --version) 报 "/system/bin/sh: .../bin/ws: Operation not permitted" (rc=126)；照 fmt/spdlog 配方的 _sign_binaries 模式补 package() 签名后 ws --version 正常输出 ixwebsocket/11.4.6

