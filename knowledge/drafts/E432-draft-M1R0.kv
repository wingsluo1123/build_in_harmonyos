#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E432.kv，填写各字段
# 对应的人类文档: doc/E432.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E432
trigger_tool:           configure|cmake|meson|make|gcc|clang|ld|python|pip|install|test|runtime
phase:                  configuration|compilation|linking|installation|testing|runtime
error_signature: refresh-patch --auto 生成的新增文件补丁在 conan create 中报 source/target file does not exist（补丁头为 --- a/...）；改用 export_sources 后 clean-verify 的干净构建又报 configure 失败

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: conan,patch,filesystem
match_keywords:         source/target file does not exist, patch_file, /dev/null, refresh-patch, export_sources, GENERATED, configure
title:                  新增文件补丁与 GENERATED 文件（configure）改写的正确处置

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 两点：(1) 补丁工具对新增文件固定写 --- a/<path> 头部，Conan 的 patch 工具要求新增文件源侧为 /dev/null，且工具每次重跑都会覆盖 AI 的判定行；(2) 预生成 configure/config.guess 属 GENERATED 会被补丁工具排除，E114 对它们的改写无法进 patches/
affected_scope: 用 conan 补丁机制（refresh-patch --auto / conandata patches）适配的项目：需要新增源文件、或需要改写 autotools 预生成文件（configure/config.guess/config.sub）时必然遇到；miredo 1.2.6 适配中两类都踩到
verification_cmd: conan create 报 `source/target file does not exist`（或补丁应用失败）；对照 `grep -n "^--- " patches/*.patch`——新增文件若显示 `--- a/<path>` 而非 `/dev/null` 即命中；`grep -n "GENERATED" reports/*.log` 可看补丁工具对 configure 的排除判定

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach: inline-new-code-into-existing-files（优先把新增代码内联进既有文件，让全部补丁都是修改型；必须新增文件时走 export_sources 导出并配 source() 拷贝，同 abiword-plugin-* 的 compat/；GENERATED 文件 configure 的 E114 改写放配方 build() 内，不要指望 patches/）
rec_description:        优先把新增代码内联进既有文件，使全部补丁都是修改型（clean-verify 只需 tarball+补丁即可配置）；必须新增文件时走 export_sources 导出并在 source() 拷贝；GENERATED 文件（configure/config.guess/sub）的改写放配方 build() 内
rec_command:            patches/ 只放修改型补丁；新增文件在 conanfile.py 的 export_sources() 里导出、source() 里 copy；configure 的 umask 077 改写放 build()（如 `_drop_umask_077(self, os.path.join(self.source_folder, "configure"))`）
rec_auto_fix:           false
rec_impl:               manual-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E432.md
last_updated: 2026-10-14
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:

draft: true
contributor_id: M1R0
