#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E433.kv，填写各字段
# 对应的人类文档: doc/E433.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E433
trigger_tool:           configure|make|conan|sh
phase:                  configuration
error_signature:        fork: (retry: )?Resource temporarily unavailable|
                         can't fork - try again|
                         (conanautotoolstoolchain\.sh|conanautotoolsdeps\.sh|configure)\[\d+\]: can't fork - try again|
                         checking for (sys/stat|stdlib|string|memory|strings|inttypes|stdint|unistd|dlfcn)\.h\.\.\. no|
                         checking whether byte ordering is bigendian\.\.\. yes|
                         configure: error: Required tdestroy\(\) or Judy dynamic arrays

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力提升）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               ci,autotools-config,environment,detection,diagnostics
match_keywords:         fork, Resource temporarily unavailable, EAGAIN, configure, AC_CHECK_HEADERS, AC_CHECK_LIB, tdestroy, Judy, CI worker, intermittent, flaky, 进程数上限, uid, rebuild, Autotools
title:                  受限 CI worker 上 autotools 探针因 fork EAGAIN 静默回落为 no，伪装成「缺依赖 / 平台不兼容」

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             >
  CI worker 的进程数/内存资源被同机其他 job 挤占（OHOS 上多个 CI job 共用 uid 100），
  使 shell 的 fork() 返回 EAGAIN（日志 "fork: retry: Resource temporarily unavailable"，
  bash 重试若干次后报 "fork: Resource temporarily unavailable"）。autoconf 生成的 configure
  把每个探针都实现为「fork 一个子 shell 去编译/运行测试程序」，且**无法区分「子进程 fork
  失败」与「特性确实不存在」**——两者都让探针结果为 no。于是 AC_CHECK_HEADERS 对标准头
  （stdlib.h/string.h/unistd.h/dlfcn.h…）报 no、AC_CHECK_SIZEOF/字节序判成大端，
  最终把项目真正必需的探测项（如 Judy.h/-lJudy、tdestroy()）也判成缺失，
  报出看起来像「缺依赖」的硬错误（miredo 1.2.6 即报
  "configure: error: Required tdestroy() or Judy dynamic arrays."）。
  失败点 100% 落在 fork 上而非编译/链接，且同一 commit 在不同 worker 上结果相反。
affected_scope:         所有在共享/受限 worker 上执行的 autotools（含 configure 自带探针的项目）适配任务，
                        以及与 configure 同源的一切「探针静默回落」场景（cmake 的 try_compile、
                        meson 的 compiler checks 在 fork 压力下同理）。
                        与 DRAFT-11327（autoreconf 自举链 can't fork）互为同源现象，
                        本条目覆盖「不跑自举、直接 ./configure」也能命中」的形态。
verification_cmd:       >
  判环境（首要）：同一 SHA 在 PR 上重触发 /rebuild，对比不同 worker 的结果——
  本例 miredo 1.2.6 SHA e39b052a：CI-021 构建 #91926 全绿 vs CI-035 构建 #93375
  configure fork EAGAIN；同时 grep 日志确认并行存在不可能成立的探针结果：
  grep -c "fork: .*Resource temporarily unavailable" <ci.log>
  grep -nE "checking for (stdlib|string|unistd|dlfcn)\.h\.\.\. no|byte ordering is bigendian\.\.\. yes" <ci.log>
  判修复：换到空闲 worker 后同一流水线 L0/L1 + 上游 make check + test_package 全过。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           diagnose-environment-not-recipe
rec_description:        先判环境、别改配方：拿日志里的 fork EAGAIN 特征 + 标准头探测为 no/字节序判反
                        这类「不可能成立」的探针结果证伪配方缺陷；再用同一 SHA 在不同 worker 重跑做
                        对照（同 SHA 一绿一红 = 环境）。确认为环境后在 PR 重触发 /rebuild 落到空闲 worker，
                        并把失败日志与对照写进 notes.md。配方侧只做降低 fork 压力的最小加固
                        （官方发行包自带预生成 configure，避免 autoreconf 自举链；autotools.make(args=["-j1"])）。
rec_command:            python3 scripts/ohc-run.py submit <name> <ver> --resume   # 内置评论触发 /rebuild 并轮询
rec_auto_fix:           false
rec_impl:               ci-retry|knowledge-draft

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      serialize-and-retry
fallback_description:   若换 worker 仍间歇失败：把 configure 期间的并发压到最低（配方内不做并行探针、
                        make 用 -j1）、必要时对**仅匹配 EAGAIN 特征**的失败做退避重试（其他错误首次即失败
                        并原样输出日志，禁止把真错误掩盖成 infra）；仍不收敛则按 R41/R42 停损上报。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       把环境失败当配方缺陷：删改正常构建逻辑（删探针/硬编码"依赖已存在"的 config.h/去掉必要的 configure 参数）
forbid_1_reason:        根因在 worker 资源竞争，探针回落是症状不是病因；改配方会把环境问题固化成错误产物。
forbid_1_consequence:   产物与上游语义不符且不可复现，真实缺失项被永久掩盖，评审拒绝。
# forbid_2_pattern:    "把失败改成通过 / 跳过测试（伪造 .ci-result.json、删上游测试）以绕过间歇失败"
# forbid_2_reason:     R9/R42：伪造状态属欺骗行为。
# forbid_2_consequence: 评审 request changes，取消计分资格。

