#====================================================================
# E545-draft-44F3.kv — 内核追踪特性（eBPF/kprobe/perf_event/tracefs）在 OHOS 缺失
# 草稿状态：待主编审核 promote 为正式条目（R17/R31）
# 载体库：ply-probe 2.4.0（上游 iovisor/ply），知识库扩展任务产出
#====================================================================

id:                     E545
trigger_tool:           clang|gcc|ld|make|runtime
phase:                  configuration|compilation|runtime
error_signature:        Bad system call|SIGSYS|Function not implemented.*bpf|perf_event_open.*(Operation not permitted|EACCES|Function not implemented)|linux/bpf\.h.*No such file|/sys/kernel/debug/tracing.*No such file|cannot find -lbpf|libbpf
severity:               3
category:               kernel, syscall, portability, limitation, detection
match_keywords:         bpf, eBPF, kprobe, perf_event_open, tracefs, debugfs, kallsyms, libbpf, BPF_MAP_CREATE, SIGSYS, kernel tracing
title:                  Gate packages that need Linux kernel tracing (eBPF/kprobe/perf_event) — OHOS 无追踪接口

root_cause:             OHOS 内核未提供 Linux 追踪接口：bpf() 被平台以 SIGSYS（aarch64 信号 31）直接终止进程而非返回 ENOSYS；perf_event_open 返回 EACCES；
                        /proc/kallsyms 地址被 kptr_restrict 抹零（无 CAP_SYSLOG）；
                        /sys/kernel/debug/tracing 与 /sys/kernel/tracing 虽存在，但无 BPF/perf 后端支撑，仅目录表象。
                        结论：追踪类软件可编译通过，运行期不可用；且探测这类系统调用本身会杀掉进程（探针必须 fork 隔离）。
affected_scope:         依赖 eBPF/kprobe/perf_event/tracefs 的追踪与观测软件（ply、bpftrace、bcc、libbpf 系、性能剖析与系统观测工具）
verification_cmd:       python3 -c "import ctypes,os;pid=os.fork();print('bpf() -> KILLED BY SIGNAL',os.waitpid(pid,0)[1]&0x7f) if pid else (ctypes.CDLL(None,use_errno=True).syscall(280,0,0,0,0,0),os._exit(0))"   # 预期: bpf() -> KILLED BY SIGNAL 31（aarch64 __NR_bpf=280；fork 隔离必需）

rec_priority:           1
rec_approach:           feature-gate-kernel-tracing
rec_description:        构建期保留产物（ply vendored <linux/bpf.h>，可编译通过）；运行期明确标注平台不支持——
                        配方与 notes.md 记录限制，test_package 只验证非追踪路径（--version 等），并附复现脚本与实测日志证据
rec_command:            ply --version   # 仅验证产物完整性；任何 kprobe/eBPF 脚本都会在 bpf() 处被 SIGSYS 终止
rec_auto_fix:          false
rec_impl:               recipe-notes-and-feature-gate

fallback_priority:      2
fallback_approach:      declared-unsupported
fallback_description:   确需内核追踪能力时，改用 Linux 主机/容器运行该库；不在 OHOS 侧打桩伪造成功
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       stub.*bpf|fake.*BPF|silently return 0
forbid_1_reason:        用空壳 stub 让 bpf()/perf_event_open 假装成功会静默失效，违反 R8（禁止空壳 stub，须有实质逻辑）
forbid_1_consequence:   用户在 OHOS 上获得错误的"追踪可用"信号，问题被推迟到运行时才暴露

principles:             P008, P015, P013

causes:                 []
caused_by:              []
similar_to:             E334, E051
conflicts_with:         []
prerequisite_of:        []

prescan_pattern:        syscall\(__NR_bpf|BPF_MAP_CREATE|perf_event_open\(|/sys/kernel/debug/tracing|/sys/kernel/tracing|tracefs|kprobe|bpf_prog_load|libbpf
prescan_globs:          *.c, *.h, *.cc, *.cpp, *.sh, configure*, Makefile*, *.am, *.ac
doc_file:               doc/E545.md
last_updated:           2026-10-02
source_event:           ply-probe 2.4.0 适配（知识库扩展任务）

authors:                bbzl <bbzl@noreply.gitcode.com>
source_pr:
source_commit:

metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:

draft: true
