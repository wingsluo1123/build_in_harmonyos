#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E545.kv，填写各字段
# 对应的人类文档: doc/E545.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E545
trigger_tool: bash
phase: runtime
error_signature: Failed to create temporary directory '/tmp/|tar: .*/tmp.*(Read-only|Cannot open)|mkdir: cannot create directory '/tmp/.*Read-only

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: platform|shell|tmpdir
match_keywords: Failed to create temporary directory, rfcdiff, workdir, /tmp, TMPDIR, read-only, --keep, cd /tmp, shell script
title: bash 脚本把 /tmp 写死不止一处：只改 workdir 赋值会漏掉 --keep 分支的 cd /tmp 与 tar 打包

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 鸿蒙 /tmp 只读（E002）。rfcdiff 这类 bash 工具除了 workdir=/tmp/$name-$$ 外，保留现场分支还写死 cd /tmp; tar czf $name-$$.tgz，只把 workdir 改成 ${TMPDIR:-/tmp}/… 时，--keep 仍会 cd 到只读的 /tmp 并打包失败（目录名相对 cwd 解析）。
affected_scope: 单文件 shell 工具包（rfcdiff、lynis、clitest 一类）：凡含多处 /tmp 字面量、且不同分支各自拼路径的脚本
verification_cmd: grep -n '/tmp' <script>；用 TMPDIR=<可写目录> 跑 --keep 之类的保留现场选项，断言产出落在 $TMPDIR；再设 TMPDIR=<不存在目录> 断言脚本报错而非静默回退 /tmp

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: patch-all-tmp-literals
rec_description: 先 grep 出脚本里全部 /tmp 字面量逐处归类：工作目录赋值改为 ${TMPDIR:-/tmp}/…；依赖该目录的后续 cd/tar/mv 改为相对工作目录父目录 cd "${workdir%/*}"，不要再出现独立的 /tmp。保留 $TMPDIR 显式设置时的原有语义（不可用即报错）。
rec_command: sed -i 's#workdir="/tmp/#workdir="${TMPDIR:-/tmp}/#; s#^\(\s*\)cd /tmp$#\1cd "${workdir%/*}"#' <script>
rec_auto_fix: false
rec_impl:               manual-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:       wrapper-env
fallback_description:   无法改脚本时，调用方统一设置 TMPDIR 并避免使用 --keep 一类依赖 /tmp 字面量的分支
fallback_command:       TMPDIR=$HOME/tmp <tool> <args>
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       cd /tmp\s*$|"/tmp/\$\{?[a-z]+\}?-\$\$"
forbid_1_reason:        只改 workdir 赋值而保留其他 /tmp 字面量（cd /tmp、/tmp/xxx-$$）会让部分分支仍落在只读 /tmp
forbid_1_consequence:   主路径测试通过，--keep 等次要分支在鸿蒙上才失败；或 tar 找不到相对目录
forbid_2_pattern:       ln -sf .* /tmp|mount .* /tmp
forbid_2_reason:        不得用软链/挂载改造构建机的 /tmp 来绕过只读
forbid_2_consequence:   污染构建机共享环境，且在 CI 与用户设备上不可复现
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             P001

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to: E002, E482
conflicts_with:         []
prerequisite_of:        []

