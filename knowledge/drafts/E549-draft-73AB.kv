#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E549.kv，填写各字段
# 对应的人类文档: doc/E549.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E549
trigger_tool:           conan|python
phase:                  compilation
error_signature: Not found.*harmonybrew.*bottle|404.*bottle.tar.gz|NotFoundException.*bottles

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category: rust-build
match_keywords:         harmonybrew, bottle, 404, NotFoundException, openssl, conandata, cargo_runtime, formula.jws.json, rust-toolchain
title: Harmonybrew bottle URL 轮换（E509 延伸：运行期 bottle 404）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Harmonybrew bottle 仓持续轮换下架旧版 bottle：配方 conandata 中静态照抄先例的 bottle URL（如 openssl@3 3.6.4 / 2.3.3_1 / 3.6.4_1 / 2.3.3_2 不带 .1 后缀）会在数周后整体 404，导致 cargo 运行期共享库（E509）注入步骤在构建首步即失败
affected_scope: 任何使用 Harmonybrew bottle 提供 cargo/构建工具运行期共享库的 Rust/工具链配方（E509 路径全部下游）
verification_cmd: curl -sS -o /dev/null -w "%{http_code}" https://harmonybrew.atomgit.com/bottles/<name>.tar.gz   # 404 即命中

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: fetch-current-bottle-from-formula-api
rec_description:        从 harmonybrew.atomgit.com/api/formula.jws.json 按 formula name 查当前 stable bottle 的 url+sha256，本地下载核验后写入 conandata.yml cargo_runtime 段，不静态照抄先例配方。
rec_command:            curl -sS https://harmonybrew.atomgit.com/api/formula.jws.json -o formula.jws.json
rec_auto_fix:           false
rec_impl:               manual-recipe-edit

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       sha256:\s*["']?\*|-\s*sha256:
forbid_1_reason:        为绕过 bottle 404 而删除/通配 sha256
forbid_1_consequence:    供应链完整性丢失，任意内容可注入构建机
forbid_2_pattern:       openssl%403-3\.6\.4|zlib-ng-compat-2\.3\.3_1\.arm64_ohos\.bottle\.tar\.gz
forbid_2_reason:        已实测下架（404）的旧版 bottle URL，静态照抄自先例配方
forbid_2_consequence:    构建首步 NotFoundException，任务必失败
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
solution: 不从先例配方静态照抄 bottle URL；构建报 bottle 404 时，从官方 formula API（https://harmonybrew.atomgit.com/api/formula.jws.json，payload 为纯 JSON 数组）按 formula name 查当前 stable bottle 的 url+sha256，本地下载核验 sha256 后写入 conandata（wpmeta 0.2.0 实测：openssl%403-3.6.5_1.arm64_ohos.bottle.1.tar.gz / zlib-ng-compat-2.3.3_2.arm64_ohos.bottle.1.tar.gz）
evidence: https://harmonybrew.atomgit.com/api/formula.jws.json + wpmeta 0.2.0 适配实测（2026-10-13，weggli 10-01 使用的 3.6.4 已 404）
doc_file:               doc/E549.md
last_updated: 2026-10-13
source_event:           wpmeta 0.2.0 适配 conan create 失败（cargo_runtime bottle 404，2026-10-13）

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:                ohc-agent <ohc-agent@local>
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:

