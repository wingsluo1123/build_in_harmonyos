# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E549.kv，填写各字段
# 对应的人类文档: doc/E549.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E549
trigger_tool:           clang|test|runtime
phase:                  testing|runtime
error_signature: result of comparison of constant -1 with expression of type .char. is always true|getopt_long.*timed out

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category: abi, c-language, testing
match_keywords: getopt_long, unsigned plain char, AArch64, -1 sentinel, CLI timeout, tautological comparison
title:                  Early-exit help can conceal a getopt sentinel busy loop across multiple CLI subcommands

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: getopt_long returns an int with -1 as its end sentinel; narrowing into unsigned plain char on AArch64 converts that sentinel to 255 before comparison, trapping functional commands in their option parsing loop.
affected_scope:         Multi-command C/C++ tools with char-narrowed getopt/getopt_long results; help/version exits from a switch branch before reaching the -1 sentinel while ordinary data commands loop without a default rejection branch.
verification_cmd:       Inventory all parser variables and prove each retains int; run bounded valid-data commands that exhaust options, require artifacts and exact content/multiplicity roundtrips, then run the installed binary through the same data path and test invalid-command rejection. Bind upstream coverage to the exact source inventory and real entry/oracle, not test-substring path counts; production Tester classes and stream-header name coincidences are not test cases, while missing framework registration alone is not proof that no tests exist.

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           parser-family-int-sentinel-and-data-liveness
rec_description:        When help works but ordinary commands time out before output, correlate tautological -1 comparison warnings with parser code before blaming an algorithm. Replace char receivers with int across the matching parser family, retain strict timeouts, and verify actual data products and inverse transformations rather than accepting help/version as functional coverage.
rec_command:            for (int c; (c = getopt_long(argc, argv, shortopts, longopts, NULL)) != -1;)
rec_auto_fix:           false
rec_impl:               source-patch-and-functional-verification

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       replace.*(roundtrip|functional).*help|increase.*timeout.*without.*diagnosis
forbid_1_reason:        Help/version can exit before the broken end-of-options comparison; replacing data checks with these probes or raising the timeout hides the liveness defect.
forbid_1_consequence:   A package can be reported usable while every ordinary data command spins forever.
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             [E419]
conflicts_with:         []
prerequisite_of:        []

