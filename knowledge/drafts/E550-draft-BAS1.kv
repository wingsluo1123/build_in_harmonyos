# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E550.kv，填写各字段
# 对应的人类文档: doc/E550.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E550
trigger_tool:           cmake|conan|readelf
phase:                  configuration|linking|runtime
error_signature: Error loading shared library|Library rpath.*\[/../lib\]

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               cmake, conan, linking, runtime
match_keywords:         CMakeToolchain, cache_variables, tc.variables, ORIGIN, shell expansion, SONAME, RPATH, DT_RPATH, loader token
title: Preserve loader tokens across Conan CMake cache arguments and link-time RPATH

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: A literal loader ORIGIN token placed in a double-quoted CMake cache argument is expanded by the shell before CMake reads it; a valid SONAME cannot repair the resulting wrong runtime search path.
affected_scope:         Conan CMakeToolchain recipes passing loader tokens through a shell-based CMake configure command; most visible when a shared CLI loads an adjacent own library absent from dependency-only conanrun paths. Not a general assertion that all generators or loaders reject ORIGIN.
verification_cmd:       Compare generated CMake configure argv, toolchain file, CMakeCache.txt and llvm-readelf -d on the actual ELF; require literal $ORIGIN in DT_RPATH/RUNPATH, basename SONAME, all upstream tests and installed consumers. A correct SONAME alone is insufficient. Run the installed CLI through a real data transformation, serialization and inverse transformation in a private UTF-8 path with spaces; verify exact semantic output, bind the installed binary, and count one workflow separately from its internal assertions and API checks.

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           loader-token-toolchain-not-shell-cache
rec_description:        Keep loader tokens in tc.variables so they are written literally inside conan_toolchain.cmake rather than a shell-expanded -D argument. Restore missing ELF platform link rules if independently absent. For signed OHOS ELF use the same final relative RPATH at build/install time, then verify the actual dynamic section and real installed consumers; do not patch signed output or infer unsupported loader behavior from a token already missing before load.
rec_command:            tc.variables["CMAKE_INSTALL_RPATH"] = "$ORIGIN;$ORIGIN/../lib"; tc.variables["CMAKE_BUILD_WITH_INSTALL_RPATH"] = True
rec_auto_fix:           false
rec_impl:               recipe-toolchain-and-elf-readback

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       conclude.*ORIGIN.*unsupported.*without.*readelf|CMAKE_INSTALL_RPATH.*cache_variables
forbid_1_reason:        The shell can remove the token before linking. Diagnose where the bytes changed instead of blaming the target loader or replacing a shared library with static delivery merely to hide the failure.
forbid_1_consequence:   Wrong compatibility conclusions and non-relocatable or unvalidated shipped libraries.
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

