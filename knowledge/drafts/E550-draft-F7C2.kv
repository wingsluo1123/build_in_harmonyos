#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E550.kv，填写各字段
# 对应的人类文档: doc/E550.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E550
trigger_tool: cmake|conan
phase: configuration|linking
error_signature: NEEDED.*libz\.so|libz\.so\.1.*in.*lib|ZLIBConfig\.cmake.*not.*found

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: conan, cmake, linking, packaging
match_keywords: CMakeDeps, find_package, FindZLIB, libz.so.1, zlib-ng, ZLIB_LIBRARIES, R26, NEEDED, conan create, generate(), 系统同名库, harmonybrew
title: Conan 配方 generate() 漏掉 CMakeDeps：find_package 回退 Find 模块，静默链上宿主同名共享库（R26 违规 + 非封闭构建）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 配方 generate() 只调 CMakeToolchain(self).generate() 没有 CMakeDeps(self).generate()，build 目录里不会生成 <Pkg>Config.cmake；上游 CMakeLists 又用 find_package(ZLIB) + 旧式 ${ZLIB_LIBRARIES} 变量，于是 find_package 落到 CMake 内置 FindZLIB 模块模式，命中构建机 PATH/搜索路径里的同名库（本机实测：~/.harmonybrew/lib 的 zlib-ng 共享库），产出的 .so 出现 NEEDED libz.so.1：既违反 R26（系统同名库必须静态），又让包依赖 CI worker 上不存在的宿主路径。
affected_scope: 所有上游用 find_package(<Pkg>) 的 CMake 项目；依赖包同名于构建机已装的库（zlib/sqlite3/libpng/openssl…）时最易静默命中
verification_cmd: readelf -d <pkg>/lib/*.so | grep NEEDED   # 期望只出现 libc++_shared.so/libc.so；且 strings/llvm-nm 里能找到 zlib 符号（已静态内嵌）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: conan-recipe
rec_description: 配方 generate() 里显式生成 CMakeDeps（deps = CMakeDeps(self); deps.generate()），让 Conan 的 <Pkg>Config.cmake 进入 CMAKE_PREFIX_PATH；或退一步在 CMakeToolchain 上 tc.cache_variables["CMAKE_FIND_PACKAGE_PREFER_CONFIG"]=True 强制优先 config 模式
rec_command: python3 -c "import conan.tools.cmake as m; print(m.CMakeDeps)"  # generate() 内: CMakeDeps(self).generate()
rec_auto_fix: false
rec_impl: conan-recipe

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: len\(.*LIBRARIES\).*==.*0|silently.*system.*lib
forbid_1_reason: 依赖声明了却不参与链接 = 假依赖；用宿主库顶替会在 CI/他机变成运行时缺库或行为漂移
forbid_1_consequence: CI 干净环境 test_package 报 libz.so.1 not found，或链接到不同 zlib 实现（zlib-ng vs zlib）导致压缩数据不兼容
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: P014

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

