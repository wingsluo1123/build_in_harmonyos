#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E551.kv，填写各字段
# 对应的人类文档: doc/E551.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E551
trigger_tool: conan
phase: 依赖链接/运行时
error_signature: Error loading shared library libdeflate\.so\.0|Error relocating .*libdeflate_|Target .* links to .* but the target was not found|env argument to ConanFile\.run\(\) should be a list

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: medium
category: conan-dependency-link
match_keywords: libdeflate|BUILD_SHARED_LIB|shared=False 无效|VirtualRunEnv|conanrun|DT_NEEDED|PATH 未包含 bin
title:

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 部分上游集成配方在 build() 中把 CMake 开关硬编码（libdeflate/1.25 的配方固定 -DLIBDEFLATE_BUILD_SHARED_LIB=ON -DLIBDEFLATE_BUILD_STATIC_LIB=OFF），因此 default_options = {"libdeflate/*:shared": False} 或 requires(..., options={"shared": False}) 都不会改变产物：conan 会按 shared=False 计算新的 package_id 并从源码重建，但重建出的包里仍然只有 .so。当消费者是静态链接 htslib 的 CLI 时，产物 DT_NEEDED 必然包含该 .so，直接执行报 Error loading shared library。另注：Conan 2 的 ConanFile.run(env=...) 只接受环境脚本名或 "NAME=VALUE" 列表，传 dict 会断言失败。
affected_scope: 依赖被硬编码为共享库的集成配方（libdeflate 等）的可执行文件包与库包；任何想在 build() 内运行上游测试或直接执行产物的配方，以及 CI L2 直接执行 bin/ 而不注入 LD_LIBRARY_PATH 的场景。
verification_cmd: readelf -d <pkg>/bin/<exe> | grep NEEDED；再以 conanrun 环境执行: bash <exe> --version（应成功）；对比无 LD_LIBRARY_PATH 时的 Error loading shared library

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: P0
rec_approach: 用 VirtualRunEnv + env=conanrun 提供运行期库路径，不擅改已发布依赖
rec_description: 在配方 generate() 中调用 VirtualRunEnv(self).generate()，build() 内运行上游测试用 self.run(..., env="conanrun")；test_package 同样用 env="conanrun"。不要为了消掉 .so 依赖去改已发布依赖的配方（违反 PR 原子性），也不要在 build() 里手拼 LD_LIBRARY_PATH 字典（Conan 2 不接受 dict）。
rec_command: generate(): VirtualRunEnv(self).generate(); build(): self.run("bash tests/test.sh static", cwd=run_dir, env="conanrun")
rec_auto_fix: no
rec_impl: 实例 megadepth 1.2.0（feat/megadepth-1.2.0）：htslib/1.24-r0 为纯静态 libhts.a 且 --with-libdeflate，其传递依赖 libdeflate/1.25 配方硬编码 BUILD_SHARED_LIB=ON，导致产物 DT_NEEDED 含 libdeflate.so.0；设 shared=False 只会触发一次从源码重建（package_id 21b17f8b…）而产物仍为 .so。最终以 generate() 中 VirtualRunEnv + build()/test_package 的 env="conanrun" 解决，上游 18 次调用 30 条断言 100% 通过。

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

