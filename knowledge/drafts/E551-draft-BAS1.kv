# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E551
trigger_tool:           conan|ctest|qt
phase:                  testing|runtime
error_signature: QWidget: Cannot create a QWidget without QApplication|Could not open icon resource file|This plugin does not support propagateSizeHints

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               testing, environment, packaging, runtime
match_keywords:         QTEST_GUILESS_MAIN, QCoreApplication, QApplication, QWidget, modal dialog, QStandardPaths, XDG_DATA_DIRS, RCC, headless, isolated Conan prefix
title: Missing library-owned Qt resources can masquerade as a headless test harness failure

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: A library looks up installed RCC data through QStandardPaths but the isolated Conan prefix is absent from XDG_DATA_DIRS. Its missing-resource error path opens a modal widget even when the tested API is non-GUI, making QCoreApplication tests abort and QApplication tests hang.
affected_scope:         Qt/KDE libraries with non-GUI APIs whose initialization locates library-owned resources through QStandardPaths and reports failures with modal widgets. Applies to isolated prefixes and headless tests, not a claim that genuinely widget-driven tests can use QCoreApplication.
verification_cmd:       Trace the resource lookup and error path, verify the installed RCC exists, prepend the current package share directory to XDG_DATA_DIRS while preserving prior entries, restore original test main and assertions, then require the full upstream suite and installed API consumer to exit normally.

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           resource-path-before-headless-harness-change
rec_description:        Do not infer a GUI requirement from an error dialog in otherwise non-GUI initialization. Verify the exact installed resource and its QStandardPaths search root, expose the relocatable package share directory via runenv_info, and use the same data path for upstream tests before package_info is available. Keep the original GUILESS test harness, strict bounded execution and all assertions; verify consumers with their generated runtime environment.
rec_command:            self.runenv_info.prepend_path("XDG_DATA_DIRS", os.path.join(self.package_folder, "share"))
rec_auto_fix:           false
rec_impl:               package-runtime-data-path-and-unchanged-upstream-tests

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       suppress.*resource.*dialog|replace.*GUILESS.*without.*root.cause|skip.*timed.out.*Qt.*test
forbid_1_reason:        Switching to QApplication only permits the missing-resource dialog to open and block forever; suppressing it or skipping tests hides an unusable installed resource layout.
forbid_1_consequence:   False GUI dependency diagnosis, headless timeouts and packages that cannot initialize normally for consumers.
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

