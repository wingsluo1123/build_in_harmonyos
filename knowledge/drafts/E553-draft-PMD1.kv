#====================================================================
# E553-draft-PMD1.kv — clang/GCC>=10 默认 -fno-common，
#                      老 C 的重复暂定定义变成 duplicate symbol
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E553
trigger_tool:           ld|clang|gcc
phase:                  linking
error_signature:        duplicate symbol: .*|multiple definition of .*|ld\.lld: error: duplicate symbol|ld: .* multiple definition of `.*'

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               linking, compiler, clang, portability, warnings
match_keywords:         duplicate symbol, multiple definition, fno-common, -fcommon,
                        tentative definition, 暂定定义, common symbol,
                        ld.lld, GCC 10 默认, 重复符号
title:                  clang/GCC>=10 默认 -fno-common：老 C 跨文件重复暂定定义变成 duplicate symbol

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             clang 11 / GCC 10 起默认 -fno-common，老 C 中跨编译单元重复的文件作用域暂定定义不再合并，链接期报 duplicate symbol / multiple definition。
                        在 GCC<10（以及老 clang 的默认）下，文件作用域的
                        `int x;`（无初始化）是**暂定定义**，被放进 COMMON 段，
                        多个编译单元各自写 `int x;` 会被合并成同一个符号。
                        GCC 10 / clang 11 起改为默认 `-fno-common`，同样的代码会生成
                        多个强定义 → 链接期 `duplicate symbol: x`。
                        这类代码常见于 2011 年前的 C 项目（把变量"定义"写在全局头/多处）。
affected_scope:         2010 年前后、依赖 GCC<10 暂定定义语义的 C/C++ 项目；
                        任何用较新 clang（OHOS clang 15）或 GCC>=10 构建的场景。
verification_cmd:       1) 链接报 `duplicate symbol: <name>` / `multiple definition of`;
                        2) grep -rn '^[A-Za-z_].* <name>;' <src> 看到多处无初始化的文件作用域定义;
                        3) 加 -fcommon 后链接通过，即可确诊

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           compile-with-fcommon
rec_description:        用 `-fcommon` 恢复旧语义（仓库既有惯例，11+ 个配方采用）。
                        对纯 C 老项目最省事，不改源码、不引入行为变化。
                        经 CPPFLAGS 传入即可覆盖 make 内建编译规则。
rec_command:            make -j1 CPPFLAGS="-fcommon"
rec_auto_fix:           true
rec_impl:               conan-recipe-build-flags

fallback_priority:      2
fallback_approach:      make-definitions-extern
fallback_description:   更"正统"的修复：保留一处定义，其余处改成 `extern` 声明
                        （或全项目改为单一定义 + 头文件 extern）。改动面大，仅在
                        -fcommon 引发其他问题时使用。
fallback_command:       # 在 .h 中改 `extern int x;`，仅在某个 .c 中保留 `int x;`
fallback_auto_fix:      false
fallback_impl:          conan-patch

# ★ 禁止策略 ★
forbid_1_pattern:       static\s+.*\s+lcd_bck_info|注释掉重复定义
forbid_1_reason:        直接删/注释掉"重复"的定义会改变符号可见性（static 化后其他
                        编译单元看不到该变量），破坏功能。
forbid_1_consequence:   链接虽通过但运行时行为错误（变量各自独立，跨模块不同步）。
forbid_2_pattern:       -Wl,--allow-multiple-definition
forbid_2_reason:        让链接器随意选一个定义，语义不确定，掩盖真实的代码缺陷。
forbid_2_consequence:   运行时数据不一致，难以排查。

# ═══ Layer 4: 原则引用 ═══
principles:             P012

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

