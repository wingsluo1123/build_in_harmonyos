#====================================================================
# E554-draft-PMD1.kv — 纯 C 链接行引用了含 C++ 目标文件的静态库，
#                      需要显式 -lc++（operator new / std::__n1 未定义）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E554
trigger_tool:           ld|clang
phase:                  linking
error_signature:        undefined symbol: operator new\[\]|undefined symbol: operator new|undefined reference to `operator new|__cxa_pure_virtual|std::__.*basic_string.*append|undefined symbol: _ZdlPv

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               linking, c++, static-library, toolchain, compilation
match_keywords:         operator new, __cxa_pure_virtual, std::__n1, libaudiofile.a,
                        undefined symbol C++, 纯 C 链接 C++ 库, -lc++, libc++_shared,
                        静态库含 C++, ld.lld
title:                  纯 C 项目链接含 C++ 目标文件的静态库时缺 libc++，报 operator new 未定义

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             某个 Conan 依赖以**静态库**形式提供，但库内包含 C++ 目标文件
                        （如 audiofile 0.3.6 的 libaudiofile.a 含 C++ 实现）。
                        纯 C 项目用 C 编译器驱动链接时不会自动带上 C++ 运行时，
                        于是链接报 `undefined symbol: operator new[]`、
                        `__cxa_pure_virtual`、`std::__n1::basic_string<...>::append`
                        等 C++ 运行时符号——错误信息里出现 C++ 名字修饰
                        （_ZdlPv / std::__n1）即是特征。
affected_scope:         用 C 编译器（clang/gcc）驱动链接、但依赖链里有 C++ 静态库的项目；
                        在 libc++（OHOS/clang）与 libstdc++（GNU）平台上所需库名不同。
verification_cmd:       1) 链接报 undefined symbol: operator new[] / __cxa_pure_virtual / std::__n1::...;
                        2) `nm -C <dep>.a | grep -c ' T *std::'` 确认该静态库含 C++ 目标文件;
                        3) 加 -lc++ 后链接通过即可确诊

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           link-cxx-runtime-explicitly
rec_description:        在链接行显式加入 C++ 运行时：OHOS/clang+libc++ 用 `-lc++`
                        （解析为 libc++_shared.so），GNU/libstdc++ 用 `-lstdc++`。
                        对 Makefile 项目可通过 LDFLAGS 传入（make 内建链接规则会带上）。
rec_command:            make -j1 LDFLAGS="-lc++"        # OHOS / clang + libc++
rec_auto_fix:           true
rec_impl:               conan-recipe-build-flags

fallback_priority:      2
fallback_approach:      use-cxx-driver-for-link
fallback_description:   若项目链接步骤与编译步骤共用同一变量，可考虑单独用 C++ 驱动
                        （clang++）执行链接步骤；但用 clang++ 编译 .c 文件会按 C++ 语义
                        处理源码，需把编译与链接分开，改动较大。
fallback_command:       <objs> 链接阶段改用 clang++ 驱动
fallback_auto_fix:      false
fallback_impl:          conan-recipe-helper

# ★ 禁止策略 ★
forbid_1_pattern:       -Wl,--unresolved-symbols=ignore-all|--allow-shlib-undefined
forbid_1_reason:        忽略未定义符号把问题推到运行时，程序 dlopen/启动即崩。
forbid_1_consequence:   编译链接"成功"但产物不可用，测试假通过。
forbid_2_pattern:       -static-libstdc\+\+|拷贝 libc\+\+\.so 到 bin/
forbid_2_reason:        静态链接 C++ 运行时与 OHOS 上 libc++_shared.so 的存在方式冲突；
                        手动拷贝 .so 违反 R26/R49（污染系统库路径、破坏依赖管理）。
forbid_2_consequence:   运行时加载错误或污染系统库目录。

# ═══ Layer 4: 原则引用 ═══
principles:             P012

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

