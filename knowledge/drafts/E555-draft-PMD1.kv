#====================================================================
# E555-draft-PMD1.kv — PkgConfigDeps 按 Conan 包名生成 .pc，
#                      与上游 Makefile 的 pkg-config 查询名不一致
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E555
trigger_tool:           make|configure|pk
phase:                  configuration|compilation|linking
error_signature:        Package .* was not found in the pkg-config search path|No package '.*' found|pkg-config:.*not found|shell: pkg-config .* --cflags.*\(empty\)

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               pkg-config, conan, build-system, dependency, make
match_keywords:         pkg-config, PkgConfigDeps, dbus-1.pc, dbus.pc, libpci.pc,
                        pciutils.pc, 找不到 package, pkg-config not found,
                        名字不一致, .pc 别名, 回退到错误分支
title:                  PkgConfigDeps 生成的 .pc 名与上游 Makefile 查询名不一致，触发错误的回退分支

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             Conan 的 PkgConfigDeps 按**Conan 引用名**生成 .pc 文件
                        （dbus/1.14.10 → dbus.pc，pciutils/3.13.0 → pciutils.pc），
                        而上游 Makefile 习惯查询发行版包名（`pkg-config dbus-1`、
                        `pkg-config libpci`）。名字对不上 → pkg-config 返回空/失败，
                        轻则缺 -I/-L 头文件路径，重则让 Makefile 的
                        `$(shell pkg-config libpci && echo true || echo false)`
                        探测**误判为 false**，走进完全错误的回退分支
                        （如引用 /usr/lib/libpci.a 并额外 -lz）。
affected_scope:         用 pkg-config 探测依赖的 Makefile/autotools 项目，
                        且通过 Conan 提供依赖（PkgConfigDeps）的场景。
verification_cmd:       1) PKG_CONFIG_PATH=<gen> pkg-config dbus-1 --cflags 返回空或报 not found;
                        2) ls <gen>/*.pc 看到的是 dbus.pc / pciutils.pc 而非 dbus-1.pc / libpci.pc;
                        3) grep -n 'pkg-config' Makefile* 列出实际查询名

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           generate-pc-aliases-in-conanfile
rec_description:        在 conanfile 的 generate() 里，把 PkgConfigDeps 产出的
                        <conan-name>.pc 复制为上游期望的别名（dbus-1.pc / libpci.pc），
                        并显式把 PKG_CONFIG_PATH 指向 generators 目录。不改上游、
                        不碰系统路径，纯配方侧适配。
rec_command:            gen = self.generators_folder ; shutil.copyfile(os.path.join(gen,"dbus.pc"), os.path.join(gen,"dbus-1.pc")) ;
                        self.run(f'PKG_CONFIG_PATH="{gen}" make -j1 ...')
rec_auto_fix:           true
rec_impl:               conan-recipe-helper

fallback_priority:      2
fallback_approach:      build-with-explicit-flags
fallback_description:   不用 pkg-config，改为在配方里显式拼出 -I/-L/-l 传给 make
                        （CFLAGS/LDLIBS 直接给全量值）。直观但要手工维护依赖列表，
                        漏一个依赖就编不过。
fallback_command:       make -j1 CFLAGS="-I<dep>/include ..." LDLIBS="-L<dep>/lib -ldbus-1 ..."
fallback_auto_fix:      false
fallback_impl:          conan-recipe-build-flags

# ★ 禁止策略 ★
forbid_1_pattern:       ln -s .*/usr/lib/pkgconfig|cp .*\.pc\s+/usr/lib/pkgconfig
forbid_1_reason:        往系统 pkgconfig 目录写文件，污染共享文件系统（同类 E524），
                        CI 干净 worker 上不存在。
forbid_1_consequence:   本地通过、CI 失败；且可能干扰同机其他包的依赖解析。
forbid_2_pattern:       安装 dbus-glib|apt .*install .*dbus-1-dev
forbid_2_reason:        试图用发行版的 -dev 包补齐 .pc，OHOS/CI 环境没有包管理器，
                        且引入与 Conan 依赖链无关的系统库。
forbid_2_consequence:   依赖来源混乱，产物不可复现。

# ═══ Layer 4: 原则引用 ═══
principles:             P012

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

