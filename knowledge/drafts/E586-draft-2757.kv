#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E586.kv，填写各字段
# 对应的人类文档: doc/E586.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E586
trigger_tool: conan|patch
phase: source
error_signature: Failed to apply patch.*000N.*\.patch|source/target file does not exist: --- b'a/|patchset.apply -> False

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: conan, patch, packaging
match_keywords: new file, /dev/null, patch_ng, apply_conandata_patches, export_conandata_patches, strip, unified diff, patch -p1, file creation, no such file
title: New-file patches must carry a /dev/null source header: patch_ng only treats a hunk as file creation when the --- line contains dev/null, while GNU patch -p1 happily accepts --- a/<new-path> and gives a false green

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Conan applies recipe patches through patch_ng, whose PatchSet.apply() branches on "dev/null" in item.source to create a file (patch_ng.py:1059-1063, save(target, new_file)). A patch written as --- a/<new-path> / +++ b/<new-path> / @@ -0,0 +1,N @@ takes the ordinary branch instead, findfiles() cannot locate the source side, and the build dies with "source/target file does not exist". GNU patch -p1 accepts the very same file because a -0,0 hunk header implies creation, so verifying with patch -p1 only reports success and the failure surfaces later inside conan create.
affected_scope: Any recipe that adds files through patches/ (shims, compatibility headers, extra upstream test drivers, generated data); on this platform every Python package that needs a test-driver shim. Verified instance: kitchen 1.2.6 patches 0003 and 0004.
verification_cmd: diff -u --label /dev/null --label b/<path> /dev/null <file> > patches/000N.patch  # then: python3 -c "import patch_ng;print(patch_ng.fromfile('patches/000N.patch').apply(strip=0, root='<tree>'))"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: generate-new-file-patches-with-devnull-header-and-verify-with-patch-ng
rec_description: Generate file-creation patches with the /dev/null source label (diff -u --label /dev/null --label b/<repo-rel-path> /dev/null <file>) and verify them with the same parser Conan uses: patch_ng.fromfile(path).apply(strip=0, root=<extracted-tree>). Conan calls apply() with strip=0 and patch_ng already strips the a//b/ prefixes, so passing strip=1 silently writes to a path with the first component removed and can still return True.
rec_command: python3 -c "import patch_ng; p=patch_ng.fromfile('patches/0003-x.patch'); print(p.apply(strip=0, root='/tmp/tree', fuzz=False))"
rec_auto_fix: false
rec_impl:               patch-newfile-devnull-header   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: verify new-file patches with patch -p1 only|commit a patch whose --- side is a/<new-path>|skip patch verification because conan create will tell us later
forbid_1_reason: patch -p1 tolerates the invalid header, so the defect reaches CI as a build failure that looks like a broken recipe rather than a malformed patch.
forbid_1_consequence: CI L1 fails with "Failed to apply patch" after a full source download, wasting a CI cycle, and the same malformed patch keeps being copied into sibling recipes.
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: verify-with-the-real-parser, minimal-patch, reproducible-artifact

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

