#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E588.kv，填写各字段
# 对应的人类文档: doc/E588.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E588
trigger_tool: conan create / conan test
phase: testing
error_signature: ModuleNotFoundError: No module named (click|urwid|tomlkit|soupsieve)|bin/toot: rc=1|Traceback (most recent call last)|Error 1 while executing|conan create failed at test_package

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: python, testing, conan
match_keywords: PYTHONPATH, conanrun, VirtualRunEnv, test_package, ModuleNotFoundError, site-packages, python -S, 本地绿 CI 红, 消费者测试, 子进程环境
title: 纯 Python 包消费者测试覆盖 PYTHONPATH，本地全绿而 CI 全红

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 纯 Python 包的 test_package 常把包根塞进子进程环境，写法多为 env[PYTHONPATH] = pkg。这是覆盖而非追加，会把 conanrun（VirtualRunEnv 生成的 conanrunenv-release-*.sh）注入的全部依赖路径整条丢掉。开发机上宿主解释器的 site-packages 往往已有 click/urwid/requests，子进程照样 import 成功，本地 conan create 全绿；CI worker 是干净环境，解释器里没有这些三方包，同一段代码立刻 ModuleNotFoundError，表现为 bin/<tool> 子进程 rc=1、test_package 失败。判别方法：用 python -S（不加载 site-packages）重跑被测二进制，依赖只来自 conanrun 的 PYTHONPATH 时应仍为 rc=0；若覆盖了 PYTHONPATH 则必然 ModuleNotFoundError。注意 conanrun 确实导出了完整依赖路径（实测 17 条，click 在内），不要采信 conanrun 的 PYTHONPATH 只影响子进程、脚本自身不继承 之类判断，据此覆盖环境变量正是缺陷本身。
affected_scope: 所有用 conan test_package 验证的纯 Python 包（package_type 为 application 或 python-require）；凡是测试代码自行拼装子进程环境变量、或只在宿主 site-packages 存在时才通过的本地验证，都会踩中。
verification_cmd: PYTHONPATH=<pkg_folder> python3 -S bin/<tool> --version; echo rc=$? ; . conanrun.sh && PYTHONPATH=<pkg_folder>:$PYTHONPATH python3 -S bin/<tool> --version; echo rc=$?

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: prepend-not-overwrite-and-isolated-runtime-assert
rec_description: 测试代码构造子进程环境时，把包根 prepend 到继承来的 PYTHONPATH 之前（保留全部依赖条目），不要整体赋值覆盖；同时在 test_package 里增加一条隔离断言，用 sys.executable 加 -S 重跑被测二进制并要求 rc=0，把本地与 CI 的判别条件固化进测试，避免宿主 site-packages 掩盖缺陷、也避免依赖环境差异导致的假绿。
rec_command: PYTHONPATH=<pkg> python3 -S bin/<tool> --version
rec_auto_fix: false
rec_impl: prepend-pythonpath-and-isolated-runtime-assert

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: install-deps-into-testenv
fallback_description: 退而求其次，可在 CI 侧的测试调用前显式 source conanrun 脚本并保留其 PYTHONPATH，只在最外层追加包根。缺点是仍依赖调用方自觉，无法阻止测试代码内部再次覆盖，因此不如在测试内固化隔离断言。
fallback_command:
fallback_auto_fix: false
fallback_impl: source-conanrun-keep-pythonpath

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: env\[.PYTHONPATH.\]\s*=\s*pkg|environ\[.PYTHONPATH.\]\s*=\s*[^+$]
forbid_1_reason: 整体赋值会丢弃 conanrun 注入的依赖路径，本地因宿主 site-packages 侥幸通过，CI 必挂。
forbid_1_consequence: 本地全绿 CI 全红，白烧一轮 CI 额度，且失败日志指向 bin/<tool> Traceback，容易被误判为依赖包未构建。
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: P003, P006

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to: E587
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
forbid_2_pattern: --ignore=tests/.*\.py|--deselect
forbid_2_reason: 靠 --ignore 裁掉上游测试文件会静默降低测试覆盖，使声明数量与实际执行数量不一致。
forbid_2_consequence: 测试数量少报或虚报，违反上游测试全量执行的要求，审查与验收不可信。
doc_file:               doc/E588.md
last_updated: 2026-10-12
source_event: toot 0.52.1 首轮平台 CI（build #84757）：test_package 14 条中 G4a/G4b/H5 因 bin/toot 子进程 rc=1 失败；定位为 test_toot.py 覆盖 PYTHONPATH，改为 prepend 后并新增隔离断言 H6，本地 14/14 全绿。

