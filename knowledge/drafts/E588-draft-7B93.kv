# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E588.kv，填写各字段
# 对应的人类文档: doc/E588.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E588
trigger_tool: zsh|bash|ci
phase: testing
error_signature: can't create temp file for here document: read-only file system|L0i: conanfile.py AST 解析失败.*read-only file system

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: ci, shell, environment
match_keywords: TMPPREFIX, TMPDIR, here document, read-only file system, zsh, build_and_test.sh, L0i, AST parse failure, W3 local CI
title: W3 runs the CI script under zsh, whose here-document temp files honour TMPPREFIX (not TMPDIR): with /tmp read-only the failure is misreported as an L0i conanfile.py AST parse error

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: zsh creates here-document temp files under TMPPREFIX (default /tmp/zsh) and never looks at TMPDIR, so pointing TMPDIR at a writable directory does not help. build_and_test.sh opens the here-doc on the same line that captures the python AST extraction output, and its error handler attributes the failure to L0i, printing the misleading hint about a UTF-8 BOM or a syntax error in conanfile.py.
affected_scope: Every W3 local CI simulation on platforms where /tmp is read-only (HMDFS/HarmonyOS PC workers), independent of the package being adapted.
verification_cmd: TMPPREFIX=$HOME/tmp/zsh TMPDIR=$HOME/tmp zsh ci/conan/build_and_test.sh <name>/<version>

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: point-tmpprefix-at-a-writable-directory
rec_description: Run the CI script with TMPPREFIX set to a writable prefix (zsh uses TMPPREFIX plus a random suffix for here-document temp files). TMPDIR alone is not sufficient on zsh. Confirm with a one-liner first: TMPPREFIX=$HOME/tmp/zsh zsh -c 'x=$(cat <<EOF\nhi\nEOF\n); echo $x'.
rec_command: TMPPREFIX=$HOME/tmp/zsh zsh -c 'x=$(cat <<EOF
hi
EOF
); echo $x'
rec_auto_fix: false
rec_impl:               env-zsh-tmpprefix           # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: edit ci/conan/build_and_test.sh to avoid here-documents|conclude the recipe has a syntax error from the L0i hint|set TMPDIR only and retry blindly
forbid_1_reason: ci/ is framework-owned and must not be modified from a recipe PR (W2), and the L0i hint names a cause that does not exist in the recipe; retrying with TMPDIR alone can never succeed because zsh ignores it.
forbid_1_consequence: Misdiagnosis sends the adapter into groundless conanfile.py rewrites and burns budget on a pure environment artifact.
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: environment-first-diagnosis, do-not-modify-framework, real-evidence-over-assumption

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

