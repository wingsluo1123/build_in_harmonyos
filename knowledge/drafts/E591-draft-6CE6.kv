# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E591
trigger_tool: python|test|socket|network
phase: testing
error_signature: "Resolving IPv6 host: localhost failed|Name does not resolve|\[Errno -2\]|getaddrinfo.*AF_INET6.*localhost"

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: platform-quirk, resolver, ipv6, test-harness
match_keywords: localhost, ipv6, ::1, AF_INET6, getaddrinfo, gaierror, /etc/hosts, ip6-localhost, AI_NUMERICHOST, sitecustomize, PYTHONPATH
title: OHOS /etc/hosts has no '::1 localhost' alias: restore dual-stack loopback at the resolver layer

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: The OHOS runtime /etc/hosts maps only '127.0.0.1 localhost' and '::1 ip6-localhost ip6-loopback'; there is no '::1 localhost' alias, so socket.getaddrinfo('localhost', p, AF_INET6) raises gaierror even though the literal '::1' resolves, binds and connects normally. Upstream pwncat's own GitHub CI works around this by rewriting /etc/hosts (sudo tee with '::1 localhost ip6-localhost ip6-loopback'); /etc is a symlink to a read-only backing file on OHOS and there is no sudo/unshare, so that workaround cannot be reproduced.
affected_scope: Any port whose test suite or runtime resolves the name 'localhost' for AF_INET6 (dual-stack clients, -6 mutations, IPv6-only listeners). Also affects code that maps IPv4 to '::ffff:' only after a successful name lookup.
verification_cmd: python3 -c "import socket; print(socket.getaddrinfo('localhost',4444,socket.AF_INET6,socket.SOCK_STREAM))"  # gaierror without the shim, ('::1',4444,0,0) with it

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: resolver-layer-ipv6-localhost-alias-shim
rec_description: Do not modify the package source. Inject a sitecustomize.py via PYTHONPATH (test scaffolding only) that wraps socket.getaddrinfo: on gaierror with host in {localhost, localhost.localdomain}, retry with the alias the hosts file already provides (ip6-localhost -> ::1) and then with the literal ::1, and re-raise otherwise. Critically, skip the fallback when flags & AI_NUMERICHOST so --no-dns semantics are preserved (a numeric-only lookup must still fail for a hostname).
rec_command: PYTHONPATH=<shim-dir> python3 -m py_compile <shim-dir>/sitecustomize.py && PYTHONPATH=<shim-dir> python3 -c "import socket;print(socket.getaddrinfo('localhost',4444,socket.AF_INET6)[0][4])"
rec_auto_fix:           true|false                  # 引擎能否自动执行
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
