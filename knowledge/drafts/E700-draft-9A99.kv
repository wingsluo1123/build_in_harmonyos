#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E700.kv，填写各字段
# 对应的人类文档: doc/E700.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E700
trigger_tool: configure|config.status|make
phase: configuration|build
error_signature: can't create .*/confXXXXXX/subs1.awk.*Permission denied|could not setup config files machinery|mktemp -d .*Permission denied

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: platform,hmdfs,autotools,permissions
match_keywords: HMDFS, config.status, confXXXXXX, mktemp, umask 077, chmod no-op, group bits, autoreconf
title: HMDFS 上 config.status 的 (umask 077 && mktemp -d ./confXXXXXX) 临时目录不可写：改写生成 configure 的 umask，autoreconf 无法解决

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: HMDFS 目录访问权按组位判定（构建 uid 20020082 不是文件属主 20001006），而 config.status 用 (umask 077 && mktemp -d ./confXXXXXX) 建的目录实际为 drwx--S---(2700)、组位无 rwx，紧随其后的 cat > $tmp/subs1.awk 报 EACCES，configure 以 'could not setup config files machinery' 终止。chmod 在 HMDFS 上是 no-op（实测 chmod 770 后 ls 仍 2700、写入继续失败），umask 是唯一杠杆。
affected_scope: HarmonyOS PC 上以 autotools 构建的所有包（autoconf 的 config.status 模板固定写 umask 077，与源码树无关）
verification_cmd: grep -c 'umask 077' configure 应为 2；或 mktemp -d ./confXXXXXX 后写文件

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: rewrite-generated-configure-umask
rec_description: 在 build() 内把生成后的 configure 里两处 umask 077 改写为 umask 022，并对替换次数做契约断言（≠2 即报错）。该两行来自 autoconf config.status 模板、不在源码树内，无法做成源码补丁（同 archives/l/libcaca/0.99.beta20.1 处理）。
rec_command: python3 - <<'PY'  # 断言 count('umask 077')==2 后替换为 umask 022
rec_auto_fix: false
rec_impl: conan-recipe

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: mktemp-wrapper-redirect-tmpdir
fallback_description: 在 PATH 前置一个 mktemp wrapper，把 ./confXXXXXX 重定向到 $TMPDIR（E175 的 fallback 2），或在 022 umask 下重建目录。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: autoreconf -fvi.*即可修复
forbid_1_reason: 实测无效：autoreconf/bootstrap 只会重新生成 configure，config.status 模板里的 umask 077 原样保留。本条目即对 E175 rec_priority=1（autoreconf-regenerate）的实测修正。
forbid_1_consequence: 照抄 E175 首选方案会在原地反复打转，configure 仍以 'could not setup config files machinery' 失败。
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

