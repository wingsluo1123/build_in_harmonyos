#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E701.kv，填写各字段
# 对应的人类文档: doc/E701.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E701
trigger_tool: conan|autotools|make check
phase: build|testing
error_signature: grep: \.\./src/.*No such file or directory|error: could not load font .*|make check.*FAIL.*check-.*|上游测试.*VPATH.*失败

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: conan,autotools,layout,testing
match_keywords: basic_layout, folders.build, VPATH, srcdir, builddir, in-tree, make check, upstream tests, check-source, check-fonts, layout
title: 上游测试按源码树相对路径取值时，conan basic_layout 的 VPATH 构建会让 make check 假失败：改 folders.build='.' 做源码内构建

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: conan 的 basic_layout 默认把构建目录放在 build-release/ 子目录（srcdir != builddir），而相当多的 autotools 上游测试脚本用源码树相对路径取值（如 grep ../src/main.c、-d ../fonts、make -C ../fonts echo-fonts）。VPATH 构建下这些相对路径落在构建目录里、源码文件不在那儿，测试便以 'No such file or directory' / 'could not load font' 失败——不是平台缺陷，是构建布局错配。
affected_scope: 任何带源码树相对路径测试脚本的 autotools 包（toilet 的 test/check-source+check-fonts 实测 2/2 假失败）；与 E434（copystamp 必须 VPATH）方向相反，两者需按项目实际选择布局
verification_cmd: 在默认 basic_layout 下 make check 应见 ../src/../fonts 路径类失败；改为 folders.build='.' 后同一 make check 原样 2/2 PASS

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: in-tree-build-via-folders-build-dot
rec_description: layout() 中 basic_layout(self, src_folder='.') 且 self.folders.build='.'，使 source_folder == build_folder（conan 默认 no_copy_source=False，源码已复制进 build_folder），上游测试脚本零改动即可通过（同 archives/a/adjtimex/1.29 先例）。
rec_command: def layout(self): basic_layout(self, src_folder='.'); self.folders.build='.'
rec_auto_fix: false
rec_impl: conan-recipe

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: patch-tests-to-be-vpath-aware
fallback_description: 改用 $(srcdir)/$(top_srcdir) 改写测试脚本使其 VPATH-aware，但会修改上游测试文件、需在 PR 中逐条申报修改理由，优先选 rec_priority=1。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: 删除失败用例|跳过 make check|改断言为 true
forbid_1_reason: 假失败应通过构建布局或路径修正解决，删除/跳过上游测试属 R34/R51 欺骗类。
forbid_1_consequence: 评审按欺骗类一票否决（CI L1e 破坏性反向验证亦会兜底）。
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

