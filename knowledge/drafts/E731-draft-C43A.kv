#====================================================================
# E731-draft-C43A — HNP cmake 二进制依赖 SDK aarch64-linux-ohos/libc++_shared.so
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E731
trigger_tool:           cmake|conan|conan-verify|cmake --install
phase:                  configuration|compilation|installation|testing
error_signature:        Error loading shared library libc\+\+_shared\.so|Error relocating /data/service/hnp/bin/cmake.*symbol not found

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               ohos, toolchain, conan, cmake, environment
match_keywords:         libc++_shared.so, LD_LIBRARY_PATH, HNP cmake,
                        /data/service/hnp/bin/cmake, Error loading shared library,
                        aarch64-linux-ohos, SDK lib, save_script, conan create,
                        Error relocating
title:                  HNP cmake 二进制在 conan create 中依赖 SDK aarch64-linux-ohos/libc++_shared.so，须在 conanfile generate() 注入 SDK lib 路径并 save_script 覆盖 build/package/test 全阶段

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             OHOS 上 conan create 调用的 /data/service/hnp/bin/cmake（HNP 打包的
                        CMake 4.1.2）动态链接 SDK 的 libc++_shared.so，该库位于
                        llvm/lib/aarch64-linux-ohos 子目录；conan profile 的 buildenv 只把
                        llvm/lib 顶层加入 LD_LIBRARY_PATH（且顶层无 libc++_shared.so），
                        cmake 进程启动即失败：Error loading shared library libc++_shared.so。
                        build/package/test 各阶段重新拉起 cmake，均会命中同一问题。
affected_scope:         所有使用 HNP cmake 工具链在 OHOS 上跑 conan create 的 CMake 系配方
                        （含 KDE Frameworks 组件及其 test_package）。
verification_cmd:       conan create archives/e/ecm/6.28.0 -pr:h=ci/conan/profiles/ohos-aarch64
                        --build=missing --user=ohpcd --channel=stable
                        （修复前必现 Error loading shared library libc++_shared.so；
                        修复后 G2 通过）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           sdk-lib-path-prepend
rec_description:        conanfile.py 的 generate() 中用 Environment 将 SDK llvm/lib 顶层及
                        aarch64-linux-ohos 子目录 prepend 到 LD_LIBRARY_PATH，并
                        save_script("sdk_runtime_env") 持久化，使 build/package/test 全阶段
                        （含 test_package 的 configure/build/test()）拉起 cmake 时都能加载
                        libc++_shared.so；test_package/conanfile.py 同样注入。
rec_command:            def _sdk_runtime_env(self):
                            env = Environment()
                            sdk_base = os.environ.get("OHOS_SDK_HOME", "/data/service/hnp/ohos-sdk.org")
                            sdk_libs = sorted(glob.glob(os.path.join(sdk_base, "*", "ohos", "native", "llvm", "lib")))
                            for lib_dir in sdk_libs:
                                env.prepend_path("LD_LIBRARY_PATH", lib_dir)
                                sub = os.path.join(lib_dir, "aarch64-linux-ohos")
                                if os.path.isdir(sub):
                                    env.prepend_path("LD_LIBRARY_PATH", sub)
                            return env
                        # generate(): self._sdk_runtime_env().vars(self).save_script("sdk_runtime_env")
rec_auto_fix:           false
rec_impl:               manual-recipe-env

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      shell-ld-library-path-probe
fallback_description:   本地手工验证：export LD_LIBRARY_PATH=llvm/lib/aarch64-linux-ohos:llvm/lib
                        后直接运行 /data/service/hnp/bin/cmake --version 可启动；
                        仅用于确认根因，CI 仍须配方内 save_script 注入。
fallback_command:       export SDK_LLVM_LIB=/data/service/hnp/ohos-sdk.org/*/ohos/native/llvm/lib
                        LD_LIBRARY_PATH="$SDK_LLVM_LIB/aarch64-linux-ohos:$SDK_LLVM_LIB" \
                        /data/service/hnp/bin/cmake --version
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
forbid_1_pattern:       prepend.*/usr/local|prepend.*SYS_PREFIX|LD_LIBRARY_PATH.*usr/local
forbid_1_reason:        R49/E524：禁止注入共享系统前缀，避免 CI worker 与本地文件系统互相污染。
forbid_1_consequence:   污染共享 /usr/local 后影响其他任务，CI 环境不可复现。

# ═══ Layer 4: 原则引用 ═══
principles:             P001, P009

