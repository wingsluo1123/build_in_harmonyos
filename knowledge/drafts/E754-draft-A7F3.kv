# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E754
trigger_tool:           configure
phase:                  configuration
error_signature:        can't create /tmp/[^ ]*: Read-only file system|/tmp/[^ ]*: Read-only file system|Read-only file system.*\/tmp

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               portability, ohos, build-system, compat
match_keywords:         /tmp, TMPDIR, Read-only file system, 硬编码, 构建脚本, custom build, build.sh, config.state, probe
title:                  上游自研构建脚本硬编码 /tmp 字面量：设置 TMPDIR 无效，须补丁改为 ${TMPDIR:-/tmp}

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             软件自带的构建/配置脚本把临时文件路径写成 /tmp 字面量（不是通过 TMPDIR 解析），而 OHOS 的 /tmp 是只读挂载（E002），脚本内每一次编译探针写入都失败，特征探测随即判为"库不存在"，configure 提前 exit 1。因为路径是字面量，仅在外部 export TMPDIR 完全无效——脚本内联赋值会覆盖环境变量。
affected_scope:         自带非 autotools/cmake 构建脚本（build.sh / Makeinfo / 自研 configure 菜单）的项目；脚本内 TEMPFILE、mktemp、trap 清场路径写成 /tmp 的包。UQM 0.8.0 build/unix/config_functions 即典型：TEMPFILE="/tmp/build.$$.tmp"。
verification_cmd:       grep -nE 'TMPFILE|TEMPFILE|/tmp/' build/ */build.sh 2>/dev/null | head; echo "TMPDIR=$TMPDIR"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           patch-build-file
rec_description:        对构建脚本打可移植性补丁，把 /tmp 字面量改成 ${TMPDIR:-/tmp}；同时在配方里把 TMPDIR 指到 build_folder 下的可写目录
rec_command:            sed -i 's|TEMPFILE="/tmp/|TEMPFILE="${TMPDIR:-/tmp}/|' build/unix/config_functions  # 用 refresh-patch --auto 固化为 patches/NNNN-*.patch
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      set-env-var
fallback_description:   仅当脚本真的通过 ${TMPDIR} 解析临时目录时，export TMPDIR=<可写目录> 即可（无需补丁）；对硬编码脚本无效
fallback_command:       TMPDIR=$PWD/tmp ./configure ...
fallback_auto_fix:      false
fallback_impl:          set-env-var

forbid_1_pattern:       ^\s*TMPDIR=\S+\s*$|/tmp\s+2>/dev/null
forbid_1_reason:        只设置环境变量、不改字面量就宣称已修复——脚本内联赋值优先于环境变量，失败必然复现
forbid_1_consequence:   configure 探针静默误判（"libpng not found" 之类），根因被误判为缺依赖，白跑一轮依赖排查

principles:             P001

causes:                 []
caused_by:              []
similar_to:             [E002, E052]
conflicts_with:         []
prerequisite_of:        []

