#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E800.kv，填写各字段
# 对应的人类文档: doc/E800.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E800
trigger_tool: cmake|conan
phase: configuration
error_signature: VERSION ".*-NOTFOUND.*" format invalid|HEAD-HASH-NOTFOUND|include could not find requested file

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: cmake, conan, toolchain, configuration, variable-timing
match_keywords: CMAKE_TOOLCHAIN_FILE, project(), ADS_VERSION, tc.variables, cache_variables, cli_args, HEAD-HASH-NOTFOUND, git describe, CMAKE_MODULE_PATH, include(Versioning), Qt Advanced Docking System
title: CMake 到第一个 project() 才加载 CMAKE_TOOLCHAIN_FILE：上游在 project() 之前读取的变量（如 ADS_VERSION）用 tc.variables 传不进去，必须走 cmake.configure(cli_args)

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: CMake 在第一个 project() 命令处才包含 CMAKE_TOOLCHAIN_FILE。Conan 的 CMakeToolchain 把所有 tc.variables 写进 conan_toolchain.cmake，因此这些变量在 project() 之前的 CMakeLists.txt 语句里不可见。QtADS 4.5.0 顶层 CMakeLists.txt 在 project() 之前用 if(NOT ADS_VERSION) 决定版本来源：变量为空时走 git describe，release tarball 无 .git 得到 HEAD-HASH-NOTFOUND，随后 project(... VERSION HEAD-HASH-NOTFOUND.HEAD-HASH-NOTFOUND.HEAD-HASH-NOTFOUND) 直接 FATAL。同理上游只在 if(NOT ADS_VERSION) 分支里 set(CMAKE_MODULE_PATH <src>/cmake/modules)，而 src/CMakeLists.txt 无条件 include(Versioning)，外部传 ADS_VERSION 时会连带丢失模块路径。
affected_scope: 所有在 project() 之前读取版本/路径/选项类变量的 CMake 上游项目（典型：自 tarball 构建、用 git describe 兜底版本、或在 project() 前 set(CMAKE_MODULE_PATH) 的项目）；任何用 tc.variables 传“project() 之前就要用”的变量都会静默失效。
verification_cmd: conan create <pkg> -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 2>&1 | grep -E 'NOTFOUND|include could not find requested file'

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: cli-args-for-pre-project-variables
rec_description: 把必须在 project() 之前生效的变量改用 cmake.configure(cli_args=['-DVAR=value']) 传递（命令行 -D 在配置开始前即成为 cache 项）；同时用 tc.variables 补上上游在分支里才设置的 CMAKE_MODULE_PATH 等路径。判据：该变量是否出现在第一个 project() 之前的 CMakeLists 语句里 —— 是则 cli_args，否则 tc.variables 即可。
rec_command: cmake.configure(cli_args=[f"-DADS_VERSION={self.version}"]); tc.variables["CMAKE_MODULE_PATH"] = os.path.join(self.source_folder, "cmake", "modules")
rec_auto_fix:           true|false                  # 引擎能否自动执行
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description: 改上游 CMakeLists.txt，把版本/模块路径的读取移到 project() 之后；但需改上游结构，优先用 cli_args。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: 只改 tc.variables 而不改 cli_args|跳过 conan create 验证
forbid_1_reason: tc.variables 写入的 cache 项在 project() 之前不可见，只改 tc.variables 会持续失败；跳过验证则无法发现。
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: P012

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

