#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E802.kv，填写各字段
# 对应的人类文档: doc/E802.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E802
trigger_tool: clang|cmake|conan
phase: compilation
error_signature: fatal error: '.*\.h' file not found|undefined reference.*lib.*\.so|--no-allow-shlib-undefined

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: conan, transitive-deps, public-headers, cpp_info-traits
match_keywords: transitive_headers, transitive_libs, cpp_info, public header, xcb/xcb.h, libxcb, ads_globals.h, find_dependency, consumer compile
title: 库的公共头 include 传递依赖的头文件时，requires() 必须声明 transitive_headers/transitive_libs，否则消费者编译缺头、链接缺库

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Conan 2 默认不把传递依赖的头文件与库传播给下游（transitive_headers/transitive_libs 默认 False），CMakeDeps 生成的消费配置里该依赖的 include 目录为空。若本库的 PUBLIC 头文件（如 QtADS 的 ads_globals.h 在 Q_OS_UNIX 下 include <xcb/xcb.h>）引用了该传递依赖的头，消费者编译即 file not found；若公共头对应的符号由该依赖提供，则链接期还会缺库。注意 Q_OS_UNIX 在 OHOS 的 Qt 移植里是定义的，所以“OHOS 无 X11”并不免除该编译期依赖。
affected_scope: 所有公共头 include 了间接依赖头文件的库配方（Qt 库、X11 相关库尤其常见）。QtADS 4.5.0 实证：libxcb 未声明 transitive_headers 时 test_package 报 'xcb/xcb.h' file not found。
verification_cmd: conan create <pkg> -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 2>&1 | grep -E "file not found|undefined reference"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: declare-transitive-traits-for-public-header-deps
rec_description: 对照本库 PUBLIC 头文件的 include 清单，把其中出现的依赖在 requirements() 里声明为 self.requires("dep/ver", transitive_headers=True, transitive_libs=True)。判据：该头文件是否安装在 include/<本包>/ 且被下游 include —— 是则其 include 的第三方头必须可传播。
rec_command: self.requires("libxcb/1.17.0.1", transitive_headers=True, transitive_libs=True)
rec_auto_fix:           true|false                  # 引擎能否自动执行
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description: 若该依赖确实不应暴露，则改公共头不 include 它（例如把平台私有头移入 .cpp），但那属上游结构调整，优先用 traits 声明。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: 在 test_package 里手工 -I 依赖 include 目录绕过
forbid_1_reason: 绕过只让自测通过，真实下游仍失败，属伪造验证。
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: P012

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

