#====================================================================
# E999-draft-A127 — libindi 2.x Property API 迁移（indi-eqmod 适配）
# 来源: indi-eqmod 1.0-20230126190232 → libindi 2.2.2.1 OHOS 适配
# 对应文档: E999-draft-A127.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══

error_signature: |
  no member named 'nsp'/'sp'/'name'/'s' in 'INDI::PropertySwitch'/'INDI::PropertyNumber'
  'operator&' is a protected member of 'INDI::PropertyBasic<_INumber>'
  no member named 'initGuiderProperties' in 'INDI::GuiderInterface'
  constructor for 'X' must explicitly initialize the base class 'INDI::GuiderInterface' which does not have a default constructor
  use of undeclared identifier 'processGuiderProperties'
  use of undeclared identifier 'timestamp'

match_keywords: |
  libindi, INDI, PropertyView, PropertySwitch, PropertyNumber, operator->, operator&, initGuiderProperties,
  initProperties, processNumber, processGuiderProperties, timestamp, indi_timestamp, GuiderInterface,
  std::any, C++14, C++17, INDI_PROPERTY_BACKWARD_COMPATIBILE

# ═══ Layer 1: 根因 (Root Cause) ═══

root_cause: |
  上游驱动源码（2023 年前后快照）使用 libindi 1.x/2.0 早期 Property API，而 libindi 2.2.x 已将
  Property 从旧式底层结构（INumberVectorProperty* 等）切换为 new Property API（PropertyBasic<T>
  包装类）：operator& 变为 protected、底层成员需经 operator-> 访问、部分方法改名
  （initGuiderProperties→initProperties、processGuiderProperties→processNumber、timestamp→indi_timestamp）。
  同时 libindi 2.2.x 头文件（defaultdevice.h）使用 std::any 需要 C++17，而旧项目 CMakeCommon.cmake
  强制 C++14。此外 FindINDI.cmake 版本检测正则无法匹配新版 indiversion.h 的带引号 INDI_VERSION。

# ═══ Layer 2: 方案 (Approach) ═══

rec_approach: |
  1) generate() 强制 CMAKE_SYSTEM_NAME=Linux + CMAKE_SYSTEM_PROCESSOR=aarch64 + CMAKE_CXX_STANDARD=17
     （规避 CMakeCommon.cmake 的 C++14）+ CMAKE_POLICY_VERSION_MINIMUM=3.5（cmake_minimum_required 3.0 与 CMake>=4 冲突）
  2) patch FindINDI.cmake: 版本正则兼容引号 .*INDI_VERSION \"?([0-9]+)\.([0-9]+)\.([0-9]+)\"?
  3) 源码 API 迁移（保留 INDI_PROPERTY_BACKWARD_COMPATIBILE 下的 operator-> 兼容路径）：
     - SlewRateSP.nsp/sp[i] → SlewRateSP->nsp/sp[i]
     - IUFindNumber(&XNP,...) → IUFindNumber(XNP.operator->(),...)（operator& 已 protected）
     - defineProperty(&GuideNSNP) → defineProperty(GuideNSNP)（新重载接受 INDI::Property&）
     - X.name/.s → X->name/X->s
     - initGuiderProperties(dev,grp) → initProperties(grp)；processGuiderProperties → processNumber(getDeviceName(),...)
     - EQMod() 构造器加 : INDI::GuiderInterface(this)（新版构造需 DefaultDevice*）
     - timestamp() → indi_timestamp()
  4) 依赖连锁错误先修上层头文件错误（std::any→C++17）再修编译错误，避免误判

trigger_tools: cmake, clang, clang++, conan_test
phase: compile
severity: 2
category: api, compile, cmake

