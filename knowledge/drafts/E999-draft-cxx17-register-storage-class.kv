#====================================================================
# E999 draft - C++17 removed the 'register' storage class specifier
# Proposed document: drafts/E999-draft-cxx17-register-storage-class.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#====================================================================

id:                     E999
trigger_tool:           clang|gcc|cmake|make
phase:                  compilation
error_signature:        ISO C\+\+17 does not allow 'register' storage class specifier|error:.*'register' storage class specifier|warning:.*'register' storage class specifier.*\[-Wregister\]

severity:               3
category:               toolchain|cxx17|legacy-source
match_keywords:         register, storage class specifier, C++17, cppstd, -Wregister, legacy C++, pre-C++11 source
title:                  Strip the removed 'register' storage class specifier before compiling legacy C++ at C++17

root_cause:             The OHOS profile pins compiler.cppstd=17, so the Conan CMakeToolchain passes -std=c++17 to every C++ translation unit. C++17 removed 'register' as a storage class specifier; clang and gcc promote the diagnostic to a hard error, so any pre-C++11 style source that still writes 'register double x;' aborts the build.
affected_scope:         Legacy C/C++ projects (sources written before C++11) built on OHOS with the default cppstd=17 profile. The failure only appears when the offending translation unit is actually compiled, so it surfaces late in large builds and looks unrelated to the platform work.
verification_cmd:       grep -rn --include=*.cpp --include=*.hpp -E '^[[:space:]]*register[[:space:]]+' src/ ; echo 'int main(){register int i=0;return i;}' | clang++ -x c++ -std=c++17 - -o /dev/null

rec_priority:           1
rec_approach:           drop-register-specifier
rec_description:        Delete the 'register' keyword from the offending declaration - it is a no-op optimisation hint with no observable effect - and keep the project at C++17.
rec_command:            sed -i -E 's/^([[:space:]]*)register[[:space:]]+/\1/' src/algo/stats/impl/StatisticsPlastn.cpp
rec_auto_fix:           false
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      pin-cxx-standard-14
fallback_description:   When the one-line source change cannot be carried, set CMAKE_CXX_STANDARD=14 from the recipe's generate() so the compiler stops running that project in C++17 mode.
fallback_command:       tc.cache_variables["CMAKE_CXX_STANDARD"] = "14"   # then re-run conan create
fallback_auto_fix:      false
fallback_impl:          recipe-cmake-variable

forbid_1_pattern:       .*#define[[:space:]]+register.*|.*-Wno-register.*|.*-Wno-error=register.*
forbid_1_reason:        Masking the keyword with a macro or silencing the diagnostic hides a real language-level removal instead of fixing the single line that triggers it.
forbid_1_consequence:   The next C++17 removal in the same code base (std::auto_ptr, std::unary_function, dynamic exception specification throw(T)) stays undetected and breaks the build later.

principles:             P005,P007,P013

causes:                 []
caused_by:              []
similar_to:             E293
conflicts_with:         []
prerequisite_of:        []

doc_file:               drafts/E999-draft-cxx17-register-storage-class.md
last_updated:           2026-10-15
source_event:           plast 2.3.2 (2017 vintage source) static analysis under the OHOS cppstd=17 profile

authors:
source_pr:
source_commit:

metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:      2026-10-15

draft:                  true
