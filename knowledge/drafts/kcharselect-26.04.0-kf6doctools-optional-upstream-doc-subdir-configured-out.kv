#====================================================================
# Draft: kcharselect 26.04.0 -- KDE 应用的 KF6DocTools 是**可选**上游依赖：
#        不提供时 doc/ 手册子目录与 kdoctools_install(po) 静默配置掉，
#        只留一条 CMake Warning（不是构建失败）
#====================================================================

id:                     DRAFT-KCHARSELECT-26040-KF6DOCTOOLS-OPTIONAL-DOC-SUBDIR-CONFIGURED-OUT
trigger_tool:           cmake
phase:                  configuration
error_signature:        Could not find a package configuration file provided by "KF6DocTools"|
                        Could NOT find KF6DocTools|
                        KF6DocTools \(required version >= .*\), Tools to generate documentation

severity:               1
category:               cmake, dependency, build-system, ohos

match_keywords:         KF6DocTools, kdoctools, kdoctools_install, kdoctools_create_handbook,
                        add_subdirectory(doc), find_package optional, OPTIONAL packages have not been found,
                        KDE Gear, ECM, KF_IGNORE_PLATFORM_CHECK, docbook, kcharselect

title:                  KDE/ECM 工程里 find_package(KF6DocTools) 多为**可选**：OHOS 上不提供 kdoctools 时不要当失败——doc/ 手册子目录与 kdoctools_install(po) 会自动配置掉，只剩一条 CMake Warning

root_cause:             上游 KDE 应用的 CMakeLists.txt 惯例是
                          find_package(KF6DocTools ${KF_MIN_VERSION})      # 注意：没有 REQUIRED
                          set_package_properties(KF6DocTools PROPERTIES ... TYPE OPTIONAL)
                        并把它包在 `if (KF6DocTools_FOUND) add_subdirectory(doc); kdoctools_install(po) endif()`
                        里。因此 KF6DocTools 缺失时 CMake 只打印一条 Warning
                        ("Could not find a package configuration file provided by KF6DocTools")
                        并继续配置，doc/ 手册目标与 kdoctools_install(po) 整段被跳过；
                        FeatureSummary 末尾如实列在 "OPTIONAL packages have not been found"。
                        容易误判点有二：(1) 见到 "Could not find a package configuration file"
                        就以为必须补依赖；(2) 误以为 doc/ 必须构建。
                        真实约束是：doc/ 手册链在 OHOS 上还需要 DocBook XML 4.5 DTD
                        （kdoctools 的 kdedbx45.dtd 以绝对 file:/// URI 引 DTD，平台不提供），
                        即使补上 kdoctools/6.19.0 也要额外裁剪该链（poXml 先例 DRAFT-poxml-...）。

affected_scope:         所有 ECM/KDE（KDE Gear、KF6）工程在 OHOS 上的配方：
                        上游把 KF6DocTools / Qt6LinguistTools 等文档/翻译工具声明为可选依赖时，
                        配方可以不声明对应 conan 依赖，让 doc 子目录自然配置掉；
                        不要把 "OPTIONAL packages have not been found" 当作必须消除的门禁失败。

verification_cmd:       conan create archives/k/kcharselect/26.04.0 \
                          -pr:h=ci/conan/profiles/ohos-aarch64 \
                          -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing 2>&1 | \
                          grep -E "OPTIONAL packages have not been found|KF6DocTools|Built target kcharselect" -A2
                        # 期望: 出现 KF6DocTools 未找到的 Warning + OPTIONAL 列表，
                        #       同时 [100%] Built target kcharselect（构建成功）

rec_priority:           1
rec_approach:           rely-on-upstream-optional-semantics
rec_description:        配方里**不声明** kdoctools 依赖，依赖上游 `if (KF6DocTools_FOUND)` 可选语义让
                        doc/ 与 kdoctools_install(po) 自动配置掉；同时在配方 docstring / notes.md /
                        manifest.yaml 里如实记录 "KF6DocTools (OPTIONAL packages have not been found)"
                        作为证据，避免审核误判为依赖缺失。仅当确实需要手册时才引入
                        tool_requires kdoctools 并同时裁剪 DocBook DTD 链。
rec_command:            # 无（默认即可）; 如需显式关闭文档链可加
                        tc.variables["BUILD_DOCS"] = "OFF"   # 仅当上游提供该开关
rec_auto_fix:           false

# ═══ 知识协作 (Authorship & Provenance) ═══
source_pr:
source_commit:
contributor_id:         DRAFT
verified_on:            OHOS 6.0 aarch64 (HarmonyOS PC, native build, clang 15, conan 2.29.1)
verified_by:            kcharselect/26.04.0 conan create + conan verify (G0-G4/L2/L4/L5 PASS)
