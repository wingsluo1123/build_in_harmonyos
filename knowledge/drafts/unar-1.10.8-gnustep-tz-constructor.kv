#====================================================================
# Draft: unar 1.10.8 — gnustep-base 1.31.1 在库加载期（constructor，
#        早于 main）读取 TZ 并固化时区状态；OHOS 无 TZ 环境变量、
#        无 /etc/localtime、无 /usr/lib/zoneinfo → 固化失败状态 →
#        日期/日历 API 抛 NSInvalidArgumentException、嵌套档案行为异常
#====================================================================

id:                     DRAFT-UNAR-1108-GNUSTEP-TZ-CONSTRUCTOR
trigger_tool:           conan|clang|make
phase:                  runtime
error_signature:        GSPlaceholderString-initWithString: given nil string|
                         NSInvalidArgumentException.*[Cc]alendar|
                         dateWithCalendarFormat|
                         lsar.*\(null\)

severity:               2
category:               platform, ohos, runtime, libc, musl
match_keywords:         gnustep-base, NSCalendar, NSCalendarDate, NSTimeZone, TZ,
                         /etc/localtime, zoneinfo, constructor, DT_NEEDED,
                         NSInvalidArgumentException, NSDateFormatter, 时区
title:                  gnustep-base 1.31.1 在库加载期（constructor，早于 main）读取 TZ 并固化时区状态：OHOS 无 TZ 环境变量、无 /etc/localtime、无 /usr/lib/zoneinfo → 固化失败状态 → 日期/日历 API 抛 NSInvalidArgumentException、嵌套档案行为异常；main() 内 setenv 太迟，解法 = libtzguard.so 以首个 DT_NEEDED 链接，constructor 先行设 TZ=UTC

root_cause:             GNUstep Base 的时区状态在 .so 的 constructor 中加载并缓存（早于 main()）。
                        OHOS（musl）上 getenv("TZ")==NULL 且 access("/etc/localtime",F_OK)!=0
                        且 /usr/lib/zoneinfo 不存在 → 库在加载期固化"无时区"失败状态 → 之后
                        NSDateFormatter/NSCalendar 日期解析全部返回 nil / 抛
                        NSInvalidArgumentException（"GSPlaceholderString-initWithString: given nil
                        string"）。main() 内 setenv("TZ","UTC") 太迟——状态已固化。

affected_scope:         所有在 OHOS 上动态链接 gnustep-base 且使用日期/日历/时区 API 的包。
                        unar/lsar 实测症状：lsar -l 日期列 (null)、XADArchive.m:1114
                        dateWithCalendarFormat 返回 nil、tar.gz 嵌套档案识别/解压行为异常
                        （日期解析失败进入错误分支）。

verification_cmd:       # 复现: 不设 TZ 直接运行链接 gnustep-base 的二进制 → 日期列 (null) /
                        #        NSInvalidArgumentException
                        # 修复验证: readelf -d bin/unar | grep NEEDED 确认 libtzguard.so 在首位
                        #        （DT_NEEDED 顺序 = 链接顺序），再跑 lsar -l 日期列正常

rec_priority:           1
rec_approach:           tzguard-constructor-earliest-needed
rec_description:        编一个极小的 libtzguard.so（单个 constructor：当 !getenv("TZ") 且
                        access("/etc/localtime",F_OK)!=0 且 access("/usr/lib/zoneinfo",F_OK)!=0
                        时才 setenv("TZ","UTC",0)），作为目标二进制的首个 DT_NEEDED 链接
                        （DT_NEEDED 加载顺序 = 链接顺序）→ 其 constructor 先于 gnustep-base
                        执行，时区状态固化前环境变量已就位。条件精确：桌面有 /etc/localtime
                        不触发，零副作用。main() 内 setenv 可保留作第二道防线（无害）。
                        禁用 wrapper 脚本方案：ELF 签名流水线要求纯 ELF，commands.json
                        （hicmd）元数据直接指向二进制。
                        参考实现: archives/u/unar/1.10.8/conanfile.py（tzguard 内嵌构建）。
rec_command:            clang -shared -fPIC -o libtzguard.so tzguard.c && LIBS="-ltzguard ... -lgnustep-base ..."（-ltzguard 置于 -lgnustep-base 之前）
rec_auto_fix:           false

# ═══ 知识协作 (Authorship & Provenance) ═══
source_pr:              PENDING
source_commit:          PENDING
