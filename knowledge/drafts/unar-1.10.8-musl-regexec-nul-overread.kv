#====================================================================
# Draft: unar 1.10.8 — musl regex.h 无 REG_STARTEND（GNU 扩展），
#        且 regexec 要求 NUL 终止字符串：直接传 NSData bytes（未
#        NUL 终止）在 musl 上堆越界读，$ 锚点/字符串末尾判定异常，
#        tar.gz 子档案识别静默失败（glibc 下因堆布局碰巧可用）
#====================================================================

id:                     DRAFT-UNAR-1108-MUSL-REGEXEC-NUL-OVERREAD
trigger_tool:           conan|clang|make
phase:                  compilation|runtime
error_signature:        REG_STARTEND|
                         error: implicit declaration of function 'regexec'.*REG_STARTEND|
                         Tar in Gzip|
                         No such file or directory.*UniversalDetector|
                         unrecognized sub-archive

severity:               2
category:               libc, musl, compat, posix
match_keywords:         musl, regex.h, REG_STARTEND, regexec, NSData, bytes,
                         NUL termination, 堆越界, $ anchor, tar.gz, 嵌套档案,
                         XADRegex, NSRegularExpression
title:                  musl regex.h 无 REG_STARTEND（GNU 扩展）且 regexec 要求 NUL 终止字符串：直接传 NSData bytes（无 NUL 终止）在 musl 上 strlen 堆越界，$ 锚点/末尾判定异常 → tar.gz 子档案识别静默失败（glibc + 典型堆布局碰巧可用，迁移 OHOS 才暴露）

root_cause:             ① REG_STARTEND 是 GNU 扩展（glibc 定义为 0，配合 regexec 的
                        startp/endp 取 re_endpos[1]）；musl regex.h 无此宏 → 编译期
                        implicit 使用报错。② musl regexec 实现要求目标字符串 NUL 终止
                        （内部 strlen 等）；XADMaster 的 XADRegex.m（NSRegularExpression
                        桥接）把 NSData.bytes（无 NUL 终止）直接传给 regexec → musl 下
                        堆越界读，有效串长由分配后首个 0x00 字节决定（不可预测）→ `$`
                        锚点/字符串末尾位置错 → tar.gz 子档案头识别正则失败 → lsar 不再
                        报 "Tar in Gzip"、unar 嵌套解压异常。glibc + 典型堆布局在 bytes
                        后恰有零字节，碰巧工作——迁移 OHOS 才暴露的潜伏 bug。

affected_scope:         任何在 OHOS/musl 上把 NSData.bytes（或其他未 NUL 终止 buffer）
                        直接传给 POSIX regexec 的 GNUstep/Objective-C 代码，尤其正则含
                        `$` 锚点或依赖字符串末尾判定者。XADMaster XADRegex.m 已修
                        （补丁 0002-xadregex-musl-compat.patch：#define REG_STARTEND 0 +
                        regexec 前把 bytes 拷贝到 NUL 终止的 malloc buffer，用完 free）。

verification_cmd:       # 功能验证: lsar test.tar.gz 输出应含 "Tar in Gzip"；
                        #           unar -f -o out test.tar.gz 嵌套内容正确解压
                        # 静态排查: grep -rn 'regexec' --include='*.m' 后核对参数是否 NUL 终止

rec_priority:           1
rec_approach:           nul-terminated-copy-for-musl-regexec
rec_description:        两步：① 兼容宏 `#define REG_STARTEND 0`（musl 无此宏，取值 0 与
                        glibc 语义一致）；② regexec 前把 NSData bytes 拷贝到 NUL 终止的
                        malloc buffer，用后 free。不要依赖"堆里碰巧有零字节"（平台相关）。
                        判据：代码使用 NSData.bytes + regexec 且正则含 $ 锚点/依赖末尾
                        判定 → 基本需要本修复。llvm-nm/堆布局实证：修复前 musl 上
                        strlen 越过 NSData 分配边界读到非零字节。
rec_command:            # patch 形态（XADRegex.m）:
                        # char *nulbuf = malloc(len + 1);
                        # memcpy(nulbuf, data.bytes, len); nulbuf[len] = 0;
                        # regexec(&re, nulbuf, nmatch, pmatch, eflag);
                        # free(nulbuf);
rec_auto_fix:           false

# ═══ 知识协作 (Authorship & Provenance) ═══
source_pr:              PENDING
source_commit:          PENDING
