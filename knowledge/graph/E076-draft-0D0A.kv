id:                     E076
title: autotools umask 077 导致临时目录权限问题
trigger_tool:           configure
phase:                  configuration
error_signature:        config\.status.*can't create.*subs1\.awk.*Permission denied|could not setup config files machinery

severity:               2
category:               filesystem|autotools|hmdfs
match_keywords:         umask, mktemp, Permission denied, config.status, subs1.awk, HMDFS

root_cause:             在 HMDFS 文件系统上，configure 脚本使用 umask 077 创建临时目录导致权限过严。
                        umask 077 创建的临时目录权限为 drwx--S---，当前用户无法在其中创建文件。
                        这是 HMDFS 对 umask 的特殊处理导致的。

affected_scope:         所有使用 autotools 构建系统的 C/C++ 项目

verification_cmd:       cd <src_dir> && tmp=$(umask 077 && mktemp -d "./confXXXXXX") && ls -ld "$tmp" && touch "$tmp/test.file" && rm -rf "$tmp"

rec_priority:           1
rec_approach:           patch-autotools-umask
rec_description:        修改 configure 脚本，将 umask 077 改为 umask 022：
                        在 configure 中找到两处：
                        1. tmp=\`(umask 077 && mktemp -d "./confXXXXXX")\`
                        2. (umask 077 && mkdir "$tmp")
                        将 umask 077 改为 umask 022
                        
rec_command:            |
  # 方法1：直接修改 configure 脚本
  sed -i 's/umask 077/umask 022/g' configure
  
  # 方法2：创建补丁
  diff -u configure.orig configure > 0005-configure-umask.patch

rec_auto_fix:           true
rec_impl:               patch-configure-umask

principles:             P-AUTOTOOLS-001

causes:                 []
caused_by:              [E002, E046]
similar_to:             [E007]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E076.md
last_updated:           2026-05-27
source_event:           archives/l/libevent/2.1.12
