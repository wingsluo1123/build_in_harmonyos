#====================================================================
# E590 草稿 — 本仓 ncurses/6.6 在 uid 0 下忽略 TERMINFO/TERMINFO_DIRS/
# ~/.terminfo：x86 root runner 上 terminfo 类程序的 test_package 找不到
# 终端描述（tgetent=-1），用户命名空间 + root 自有的条目副本解决
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E1043
trigger_tool:           test
phase:                  testing
error_signature:        newfstatat(AT_FDCWD,"//share/terminfo"|newfstatat(AT_FDCWD, "//share/terminfo"|stat("//share/terminfo"|access("//share/terminfo"

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               runtime, testing, environment, permissions
match_keywords:         TERMINFO, TERMINFO_DIRS, .terminfo, root, uid 0, _nc_env_access, //share/terminfo, tgetent, setupterm, unshare, user namespace, map-user, qemu-aarch64, test_package, 640, line mode
title:                  本仓 ncurses/6.6 在 uid 0 下忽略 TERMINFO/TERMINFO_DIRS/~/.terminfo，只查编译期默认的 //share/terminfo：x86 root runner 上 terminfo 类 CLI 的 test_package 找不到终端描述（tgetent=-1，vi 克隆退化为行模式或读 EOF 空转）；测试脚本在 uid 0 时经 unshare --user --map-user 以非特权 uid 运行，并使用 root 自有的 terminfo 条目副本

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             ncurses 出于安全考虑在特权进程中不读取终端数据库相关环境变量（_nc_env_access() 对 uid 0 返回假），本仓 ncurses/6.6 的该行为实测成立：同一个静态链接 libncursesw 的探针，TERMINFO 指向包内 share/terminfo 时以 root 运行 tgetent=-1，以 nobody 运行 tgetent=1（li=24 co=80）；qemu-aarch64 -strace 显示 root 下只 stat 了编译期默认的 //share/terminfo（包以 --prefix=/ 构建）。
  设备 CI 以普通用户运行，不受影响；本地 x86 runner 的 conan create 以 root 运行，test_package 因此拿不到任何终端描述。
  改用 unshare --user --map-user=65534 在用户命名空间内以非特权 uid 运行时还有第二个坑：命名空间内对「属主未映射」的文件没有 CAP_DAC_OVERRIDE，而 ncurses 包内 terminfo 文件属主是 CI 构建用户、权限 640，映射 uid 读不到，必须先由 root 复制一份（属主变为映射到的 uid 0）。
affected_scope:         在本地 x86_64 root runner 上跑 W3/conan-verify 的、运行期依赖 terminfo（tgetent/setupterm）的 CLI/TUI 包的 test_package；设备 CI 与非 root 本机不受影响
verification_cmd:       TERM=vt100 TERMINFO=<ncurses>/share/terminfo ./probe; setpriv --reuid=65534 --regid=65534 --clear-groups env TERM=vt100 TERMINFO=<可读副本> ./probe   # 前者 tgetent=-1、后者 tgetent=1 即命中本条

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           userns-unprivileged-uid-with-owned-terminfo-copy
rec_description:        test.sh 在 id -u 为 0 时：先 cp 所需 terminfo 条目到工作目录（root 自有），再以 unshare --user --map-user=65534 --map-group=65534 前缀运行被测程序，TERMINFO 指向该副本；非 root（设备 CI）不走此分支。工作目录与被测文件仍可读写（映射 uid 对应外部 uid 0）
rec_command:            if [ "$(id -u)" = 0 ]; then mkdir -p "$WORK/terminfo/v"; cp "$TI/v/vt100" "$WORK/terminfo/v/"; TI="$WORK/terminfo"; as_user=(unshare --user --map-user=65534 --map-group=65534); fi; ${as_user[@]+"${as_user[@]}"} env TERM=vt100 TERMINFO="$TI" ./prog
rec_auto_fix:           false
rec_impl:               archives/l/levee/4.0/test_package/test.sh

fallback_priority:      2
fallback_approach:      setpriv-with-world-writable-workdir
fallback_description:   无用户命名空间时用 setpriv --reuid/--regid 降权，但需把工作目录与 terminfo 副本改为该 uid 可读写（chmod/chown），且降权进程读不到 root 属主 0755 目录外的私有文件
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       mkdir -p /share/terminfo|ln -s .* /share/terminfo|cp .* /usr/share/terminfo
forbid_1_reason:        往构建机根目录放 terminfo 数据库（迎合编译期默认路径）会污染共享构建机，且掩盖设备侧真实的查找路径
forbid_1_consequence:   本地侥幸通过、换机失败，属环境污染
forbid_2_pattern:       TERM=dumb
forbid_2_reason:        改用无能力的终端类型只会让程序走无光标寻址分支（vi 克隆进入行模式、COLS=0 时无法输入命令），测不到真实的终端层
forbid_2_consequence:   测试形同空壳或卡死

# ═══ Layer 4: 原则引用 ═══
principles:

# ═══ 关系图 (Relations) ═══
# ═══ 元数据 ═══
doc_file:               knowledge/drafts/E590-draft-BC71.md
last_updated:           2026-09-27
source_event:           levee 4.0 OHOS 适配（2026-09-27）：本地 root runner 上 levee 以 TERMINFO 指向 ncurses/6.6 包目录仍 tgetent=-1、读到 EOF 后空转超时；探针对比 root/nobody、-strace 定位；test.sh 加用户命名空间分支与 root 自有条目副本后 conan create 内 test_package 9/9
authors:                lkjing2021345 <1908499668@qq.com>
source_pr:
source_commit:

# ═══ 质量度量 ═══
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     1.0
metrics_last_used:      2026-09-27

