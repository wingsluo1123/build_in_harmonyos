#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E549.kv，填写各字段
# 对应的人类文档: doc/E549.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E1168
trigger_tool: lang-preflight
phase: 语言预检/适配立项
error_signature: detected_language=mixed|build_system=none

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               detection, build-system
match_keywords: CMakeLists.txt.ci|lang-preflight|构建系统探测落空|非规范构建文件名|ln -fs CMakeLists.txt
title:

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 上游 CMake 工程不使用规范名 CMakeLists.txt，而是提供 CMakeLists.txt.<variant>（.ci/.static/.statlib/.windows），构建脚本用 ln -fs CMakeLists.txt.ci CMakeLists.txt 取别名。语言预检判定优先级为 manifest > 构建系统 > 源码统计，而构建系统探测只认规范名；探测落空后回退源码统计，若仓库同时含较多辅助脚本（bash/perl 构建与测试脚本）且 C/C++ 源码文件数很少（megadepth 顶层仅 megadepth.cpp + 若干头文件），主体占比不足 70% 便误判 mixed，进而触发错误的 env_unsupported 终态。
affected_scope: 把构建文件命名为 CMakeLists.txt.<variant> 并以 ln -fs 取规范名的上游工程；单翻译单元或源码文件数极少的 C/C++ CLI 项目风险最高。
verification_cmd: 在源码目录执行 ln -fs CMakeLists.txt.ci CMakeLists.txt 后重跑 python3 scripts/ohc-run.py lang-preflight <pkg> <ver> --src <src>，观察 build_system 由 none 变为 cmake、detected_language 由 mixed 变为 cpp

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: P0
rec_approach: 按上游自身构建脚本的布局准备语言预检输入
rec_description: 语言预检前先按上游构建脚本的方式补齐规范名构建文件（如 ln -fs CMakeLists.txt.ci CMakeLists.txt），使构建系统探测命中；不要因为探测器回退到源码统计得到 mixed 就立即写 env_unsupported。
rec_command: ln -fs CMakeLists.txt.ci CMakeLists.txt && python3 scripts/ohc-run.py lang-preflight <pkg> <ver> --src <src>
rec_auto_fix:          false
rec_impl: 实例 megadepth 1.2.0（feat/megadepth-1.2.0）：首次预检 build_system=none、源码统计 bash:25/cpp:2/c:1/perl:1 主体占比 50% → mixed；按上游 build_megadepth.sh 第一步 ln -fs CMakeLists.txt.ci CMakeLists.txt 复现后 build_system=cmake、manifest=CMakeLists.txt project(megadepth) → detected=cpp，exit 0。

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
# ═══ 元数据 ═══
doc_file: doc/E549.md
last_updated: 2026-10-13
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:
authors:               411A
