#====================================================================
# E546-draft-7DD4 — Imake/xmkmf 构建系统在 OHOS 上的适配模式
# 对应的人类文档: E546-draft-7DD4.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E1200
trigger_tool:           configure|make
phase:                  configuration|compilation
error_signature:        xmkmf: inaccessible or not found|xmkmf: not found|imake: No such file|No rule to make target 'Xaw3dP.h'|Imakefile.*No such file|imake -I.*failed

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               platform, portability, build-system, x11
prescan_pattern:        \bxmkmf\b|imake -I|\.imake\.conf|Imakefile
prescan_globs:          '*.c, *.h, *.sh, Imakefile*, *.cfg, configure'
match_keywords:         xmkmf, imake, Imakefile, X11, Xaw, Xaw3d, X11R6, config, cf
title: Imake/xmkmf 构建系统在 OHOS 不可用（无 imake 工具链）——老式 X11 软件需改为配方内手工 Makefile/直接编译

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             Imake 体系（xmkmf/imake + *.cf 规则）依赖 X11 开发树（/usr/lib/X11/config）与 imake 预处理器，OHOS 工具链不携带；上游 configure 内部调 xmkmf 生成 Makefile 时立即失败
affected_scope:         老式 X11 软件（xpaint、xfig、xpdf、myman 等 1990s-2000s Imakefile 项目）；特征是源码树有 Imakefile 而无 configure.ac/Makefile.am
verification_cmd:       ls Imakefile 2>/dev/null && ! which xmkmf && echo "E546: Imake project, xmkmf unavailable"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           manual-makefile-extraction
rec_description:        不碰 imake：通读 Imakefile 提取编译单元（SRCS/OBJS/DEFINES/INCLUDES/LIBS），在配方内用 Conan 工具链变量写手工 Makefile 或直接 self.run() 编译；Vendored 子目录（如 xaw3dxft）若含 yacc/lex 生成步骤，用 tool_requires bison/flex 或本机 flex/bison 补齐生成物
rec_command:            grep -E "^(SRCS|OBJS|DEFINES|SYS_LIBRARIES|X.*_LIB)" Imakefile   # 提取编译单元
rec_auto_fix:           false
rec_impl:               manual

# 回退方案
fallback_priority:      2
fallback_approach:      vendored-widget-static-build
fallback_description:   内嵌 widget 库（xaw3dxft/libXaw3dxft.a）随主程序一并编译为静态库再链接，避免外部 Xaw3d/Xaw 依赖（制品仓无 libxaw3d）
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 ★
forbid_1_pattern:       apt.*install.*imake|yum.*install.*xmkmf|apt.*xorg-dev
forbid_1_reason:        CI worker 是 OHOS 环境，无 apt/yum，试图装 imake 必然失败
forbid_1_consequence:   浪费编译轮次；正确路径是绕开 Imake 体系直接组织编译
forbid_2_pattern:       xmkmf\s+-a|imake\s+-I
forbid_2_reason:        配方内任何调用 xmkmf/imake 的命令在 CI 必挂（工具不存在）
forbid_2_consequence:   configuration 阶段 Hard Fail

# ═══ Layer 4: 原则引用 ═══
principles:             P003
