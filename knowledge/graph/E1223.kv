#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E545.kv，填写各字段
# 对应的人类文档: doc/E545.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E1223
trigger_tool: make
phase: compilation
error_signature: unsupported argument 'k8' to option '-march='|skipping incompatible .*-lpopt|cannot find -lpopt|g\+\+ -D.*-c -o .*\.o

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               portability, build-system, toolchain
match_keywords: Makefile, g++, hardcoded compiler, literal g++, CXX ignored, CPPFLAGS +=, -march=k8, unsupported argument 'k8', x86 host compiler, wrong format, skipping incompatible, patman, raw Makefile, aarch64, OHOS
title: 手写 Makefile 在规则命令里写死字面量 g++ 且用 CPPFLAGS += 追加 -march=k8：环境变量 CXX 无效，误用宿主 g++ 产出 x86 目标文件导致链接 libpopt.a 'skipping incompatible'；-march=k8 在 OHOS clang 直接报错

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: patman 1.2.2 的 Makefile 把 g++ 作为字面量写在链接与编译规则的命令行里（不是 CXX 变量），因此 Conan AutotoolsToolchain 注入的 CXX（以及 make CXX=... 命令行覆盖）完全不起作用；构建机上若恰有宿主 g++，会静默产出 x86 目标文件，随后链接交叉编译的 libpopt.a 报 skipping incompatible / cannot find -lpopt（构建机没有 g++ 时则直接 g++: not found）。同一 Makefile 以 'CPPFLAGS += -O3 ... -march=k8' 追加（会与环境变量合并，只能用命令行 CPPFLAGS= 整体覆盖或改文件），而 OHOS clang 实测报 unsupported argument 'k8' to option '-march='。
affected_scope: 没有 configure、规则命令写死 g++/gcc 字面量并带 x86 专有 -march 的手写 Makefile 项目（生物信息/科学计算小工具常见）；影响 aarch64 OHOS 交叉构建与 x86 runner 上的 W3 本地构建。
verification_cmd: grep -nE '^[[:space:]]+(g\+\+|gcc|cc) |-march=' Makefile; make -n CXX=/data/service/hnp/bin/clang++ | head -3  # 仍显示 g++ 即为字面量

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: makefile-literal-compiler-to-cxx-var-drop-march
rec_description: 补丁把规则里的 g++ 改成 $(CXX)、删除 -march=k8（以及按需修版本串），由 Conan Toolchain 经环境变量提供 CXX/CPPFLAGS/LDFLAGS；配方里用 self.run('make <target>', cwd=self.source_folder) 并绕开上游 install -s。
rec_command: sed -i -e 's/^\tg++ /\t$(CXX) /' -e 's/ -march=k8//' Makefile  # 然后 refresh-patch --auto
rec_auto_fix: false
rec_impl: patch-makefile

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: -march=k8|-march=native|CXX=g\+\+|ln -s .*g\+\+
forbid_1_reason: 用 -march 保留 x86 架构参数、或把 clang++ 软链成 g++ 都会把宿主/错误架构带进交叉构建，掩盖编译器选择问题。
forbid_1_consequence: x86 目标文件与 aarch64 libpopt.a 混链失败，或在 OHOS clang 上直接编译失败。
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

