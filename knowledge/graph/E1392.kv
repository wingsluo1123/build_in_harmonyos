#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E1392
trigger_tool: conan|create|package|sed|install
phase: packaging
error_signature: @VERSION@|@BUSYBOX_PACKAGES@|占位符残留|模板化脚本|override_dh_install|sed -e 's,@X@,

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category: packaging, debian, template
match_keywords: mkinitramfs, 占位符, @VERSION@, @BUSYBOX_PACKAGES@, override_dh_install, sed 替换, 模板化脚本, DESTDIR, 产物断言
title: Debian 包（尤其是 native 脚本包）里常有**带 `@VAR@` 占位符的模板脚本**（本例 `mkinitramfs` 的 `@VERSION@`/`@BUSYBOX_PACKAGES@`）：Debian 的 `override_dh_install` 是用 sed 替换后才安装的，若不照做（直接原样 `cp` 进产物）会把占位符带进包；**修法 = 照抄 Debian 的替换 + 在消费者校验里断言"占位符已消失且含版本号"**

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 这类工程的源码里保留的是"模板"，值在打包期由 dh 的目标注入（版本号来自 changelog/pkg-info， 依赖包名来自 rules 里的变量）。不跑 dh 的适配（OHOS 无 dh/debhelper）如果只是把文件 cp 进产物， 就漏掉了这一步——产物里的脚本会带着 `@VERSION@` 去执行，行为不可预期（且极难从"能装能跑"看出来）。
affected_scope: 所有"不跑 dh、按 .install 映射直接安装"的 Debian 包适配；以及任何以 `@VAR@`/`%%VAR%%` 形式做打包期替换的工程
verification_cmd: `grep -rn '@[A-Z_]*@' <package_folder>`（应为空）；或对具体脚本 `grep -q '@VERSION@' <pkg>/sbin/mkinitramfs`（应无命中）且 `grep -q '<版本号>' <pkg>/sbin/mkinitramfs`（应有命中）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: replicate-the-distro-substitution-and-assert-it
rec_description: ①在源码里 `grep -rn '@[A-Za-z_]*@'` 找出模板化文件（本例 `mkinitramfs`）；②去 Debian 打包侧看替换规则（`debian/rules` 的 `override_dh_install`，本例是 `sed -e 's,@BUSYBOX_PACKAGES@,…,' -e 's,@VERSION@,<pkg-info version>,'`）；③在 `package()` 里读模板 → 替换 → 写产物（保留可执行位），并对"关键占位符"加断言（若模板里找不到占位符就报错，避免上游改版后静默失效）；④在 test_package 里**断言无残留 + 含正确版本号**——这一步最能防回归；⑤把替换规则与来源（哪个 debian/rules 目标）写进 notes/PR。
rec_command: grep -rn '@[A-Za-z_]*@' <src> ; sed -e 's,@VERSION@,<version>,g' -e 's,@BUSYBOX_PACKAGES@,<pkgs>,g' mkinitramfs > <pkg>/sbin/mkinitramfs ; grep -q '@' <pkg>/sbin/mkinitramfs && echo LEFTOVER
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: run-the-distro-helper-if-available
fallback_description: 若环境里确实有 dh（或能装 debhelper），可直接调用对应 dh_* 目标完成替换；但在无 dh 的适配环境里这条不可用，应以"照抄替换规则 + 断言"为主。
fallback_command:
fallback_auto_fix: false
fallback_impl: manual forbid_1_pattern:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
# ═══ 元数据 ═══
doc_file:               doc/E429.md
last_updated: 2026-10-08
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:
authors:               CB0D
