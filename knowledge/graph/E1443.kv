#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E1443
trigger_tool: python|pip
phase: runtime|installation
error_signature: No module named|ModuleNotFoundError|unpublished dependency|Recipe not found

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               portability, python, dependency, packaging
match_keywords: python-require, requires, unpublished, guard patch, pip --target, runenv_info PYTHONPATH, R36
title: Python 应用配方的未发布依赖三级处置（requires / 守护补丁 / pip 钉版本打入包）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Python 应用的上游依赖分三类：已发布/未发布但可降级/未发布且必需（含传递依赖）。未发布依赖声明进 requires 会被 R36 的 L0i/PF4 闸拦截；直接联网 pip install 又不可复现。
affected_scope: 纯 Python python-require 配方，尤其 CLI 应用
verification_cmd: bash ci/scripts/preflight_check.sh <pkg>/<ver> --deps "<dep>/<ver> ..."

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           dependency-tiered-dispatch
rec_description: 已发布→requires；未发布但可降级→守护补丁（try/except ImportError + 受控报错）；未发布且必需/传递依赖→pip 钉版本 --target 打入本包 site-packages。
rec_command:            pip install --no-compile --target=<stage> <pkg>==<ver>
rec_auto_fix:           false
rec_impl:               source-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      adapt-and-publish-missing-dep-first
fallback_description:   R36 拓扑序：先适配并发布缺失依赖（独立的依赖 PR），再让本包声明 requires；适用于依赖重要度高、值得独立发布的场景。
fallback_command:       bash ci/scripts/preflight_check.sh <dep>/<ver>
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: pip install .*--break-system-packages
forbid_1_reason: 直接装进构建机系统环境，包内容不完整、不可复现，消费者在干净环境 import 会失败
forbid_1_consequence: 发布包缺依赖，下游 import 报 ModuleNotFoundError；构建结果依赖构建机残留
forbid_2_pattern: requires\(["'][^"']*(yt-dlp|jsonpatch)[^"']*["']\)
forbid_2_reason: 声明未发布到制品仓的依赖会被 R36 的 L0i/PF4 闸拦截
forbid_2_consequence: CI 直接失败（unpublished_deps / dependency gate）

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
# ═══ 元数据 ═══
doc_file:               doc/E429.md
last_updated: 2026-10-13
source_event: tubeup 2026.5.8 适配

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:
authors:               5961
