# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E1538
trigger_tool: runtime
phase: testing
error_signature: SIGSYS|close_range.*NO|undefined reference to.*close_range

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               platform, detection, syscall
match_keywords: negative libc feature probe, inline raw syscall, SIGSYS, close_range, complete portable fallback, descriptor lifetime, CLOEXEC, SCM_RIGHTS, ancillary message batch, aggregate descriptor limit, private temporary directory, TMPDIR, actual UID ownership, child watch, pidfd, waitpid, owned child reaping, XDG_RUNTIME_DIR, intrusive build root, exact source path
title: 负向 libc 探测与源码内联 raw syscall 的执行边界

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: libc符号检测返回NO并未覆盖项目随后用__NR宏和inline syscall重新定义HAVE能力的路径；目标进程域真实SIGSYS，必须保留完整原portable close-all/CLOEXEC语义，不把未trace的上游信号归因为具体策略。
affected_scope: POSIX原生程序在libc探测后自建Linux raw syscall fastpath；不证明所有内核/进程域不支持，也不提供NSS或跨UID权限。
verification_cmd: 对照实际configure输出和源宏重定义，用一个真实自有fd的签名控制/同raw调用比较RC，再fresh执行原close/CLOEXEC语义组并核对完整receipt链。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: retain-original-complete-portable-fallback-on-observed-target
rec_description: 同一构建能力选项守卫libc和raw fastpath，原完整fd枚举、close和CLOEXEC回退不改；负向能力探测与实际执行验收分层。close_range默认auto，实际SIGSYS域由配方显式disabled；不伪造HAVE_CLOSE_RANGE探测结果。
rec_command: 查精确源inline syscall路径；保存真实签名own-fd控制；用同一构建能力guard绑定两个fastpath后立即fresh原语义目标验证，不复跑未漂移旧探针制造进度。
rec_auto_fix: false
rec_impl: one-meson-feature-for-libc-and-raw-close-range-fastpaths; DBUS_DISABLE_CLOSE_RANGE仅由真实close_range disabled配置生成。子进程原测试临时根须由实际UID验证无symlink、可写与归属；未显式配置时允许选择真实owned默认目录，显式错误不得回退。fresh官方20261011-r006实际Conan create RC0，49原组44clean/1partial/3ERROR/1wholeSKIP，consumer4/Harmony1；账户缺口和完整分母保留，不是全上游或提审PASS。

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: return 0.*close|disable all descriptor cleanup|fake passwd|ignore SIGSYS|replay launch
forbid_1_reason: 不能把清理成功假定、弱化描述符安全或伪造身份当适配。
forbid_1_consequence: 可能泄漏敏感描述符或接受未真实验证的认证/权限路径。
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

