#====================================================================
# E14723-draft-8735 — Debian-native 源码包抽取单个 C 工具：无 configure + po4a 门禁
#   + 上游内置版本号与包版本不一致
# 对应人类文档: knowledge/drafts/E14723-draft-8735.md
# 触发事件: run-parts 5.23.2（源自 salsa.debian.org debian/5.23.2 tag 归档）适配 HarmonyOS PC
#====================================================================

id:                     E1561
trigger_tool:           configure|make|conan
phase:                  configuration|compilation|testing
error_signature:        po4a-translate not installed, failing to rebuild changed man page translation|
                         run-parts: failed to write to temporary file|
                         run-parts: failed to copy content of stdin|
                         configure: error: cannot find|
                         No rule to make target .configure.|
                         autoreconf: not found

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               portability, build-system, autotools, conan, testing
match_keywords:         O_TMPFILE, mkstemp, --stdin, failed to write to temporary file, debianutils, run-parts, po4a-translate, po4a, TRANSLATE_DOCS, DEBIANUTILS_VERSION,
                         PACKAGE_VERSION, acinclude.m4, 无 configure, Debian native, 单文件 C, config.h 宏,
                         HAVE_GETOPT_H, autopkgtest
title:                  Debian-native 源码包无 configure 且 po4a 子目录缺 po4a-translate 即 exit 1：单文件 C 工具绕过 autotools 直接编译，且 --version 回显上游内置版本而非包版本
prescan_pattern:        po4a-translate not installed|SUBDIRS\s*=\s*po4a
prescan_globs:          Makefile.am, Makefile.in, configure.ac

# ═══ Layer 2: 诊断层 ═══
root_cause:             Debian 自家维护（native）的源码包（debianutils 等）只发布 configure.ac/Makefile.am，
                         不含生成的 configure；顶层 Makefile.am 强制 SUBDIRS = po4a，而 po4a/<lang>/Makefile.am
                         在构建机无 po4a-translate 时把 TRANSLATE 设为 "echo ...; exit 1"，make 直接失败；
                         走 autoreconf 路线还要求构建机具备 autoconf/automake。另外 acinclude.m4 的
                         DEBIANUTILS_VERSION 在 5.23.2 tarball 中仍为 5.23.1，编译出的 --version 输出 5.23.1，
                         与 conan 包版本 5.23.2 不一致
affected_scope:         run-parts --stdin 在 O_TMPFILE 不可用的文件系统上直接失败（上游不检查 open 返回值，补丁回退 mkstemp+unlink）；Debian 维护的 debianutils 系列单文件 C 工具（run-parts、tempfile、ischroot）及同类
                         "tarball 无 configure + 文档翻译子目录强依赖外部工具" 的包；以包版本做 --version
                         断言的 smoke/test_package 会误判失败
verification_cmd:       grep -n "TRANSLATE = " po4a/de/Makefile.am; grep -n "DEBIANUTILS_VERSION" acinclude.m4;
                         qemu-aarch64 ./run-parts --version | head -1   # 期望输出 version 5.23.1

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           direct-compile-single-c-file
rec_description:        配方不跑 autoreconf/configure：只取目标 C 文件直接编译，手工提供 config.h 宏
                         （PACKAGE_VERSION 取 acinclude.m4 内置值、HAVE_GETOPT_H、HAVE_PATHS_H、
                         _FILE_OFFSET_BITS=64）；编译器取自 profile 的 tools.build:compiler_executables 字典；
                         不打 po4a 补丁；test_package 不以包版本断言 --version
rec_command:            clang -O2 -fPIE -DPACKAGE_VERSION='"5.23.1"' -DHAVE_GETOPT_H -DHAVE_PATHS_H -D_FILE_OFFSET_BITS=64 run-parts.c -o run-parts -static-pie
rec_auto_fix:           false
rec_impl:               conan-recipe-custom-build

# 附：真机 CI 上 run-parts --stdin 的 open(O_TMPFILE) 失败，见 md「补充」一节，补丁 0001-run-parts.c.patch
fallback_priority:      2
fallback_approach:      disable-po4a-subdir-autoreconf
fallback_description:   需要完整安装 Makefile 规则时：Makefile.am 去掉 po4a 子目录后 autoreconf -fvi（构建机需
                         autoconf/automake；会引入源码补丁）
fallback_command:       sed -i 's/^SUBDIRS = po4a/SUBDIRS =/' Makefile.am && autoreconf -fvi
fallback_auto_fix:      false
fallback_impl:          source-patch

# ★ 禁止策略 ★
forbid_1_pattern:       po4a-translate.*(touch|stub|ln -s)|TRANSLATE.*true
forbid_1_reason:        伪造 po4a-translate 会静默产出空的/错误的翻译 man 页，且骗过 make 规则
forbid_1_consequence:   产物里混入无效文档；知识与真实平台能力脱钩
forbid_2_pattern:       assert.*5\.23\.2.*--version|version.*==.*self\.version
forbid_2_reason:        上游内置版本号与包版本不同，按包版本断言 --version 必然失败
forbid_2_consequence:   test_package 误红；为过测试去改源码里的版本串会破坏与上游一致性

principles:             P004
doc_file:               knowledge/drafts/E14723-draft-8735.md
last_updated:           2026-10-07
source_event:           run-parts 5.23.2 适配（archives/r/run-parts/5.23.2）

authors:                nyaco3 <aqjCItYW1QmEJQuF.gcw_XDpqZ8sO@noreply.gitcode.com>
source_pr:
source_commit:

metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.9
metrics_last_used:

