#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E588.kv，填写各字段
# 对应的人类文档: doc/E588.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E1632
trigger_tool: clang|cmake|make
phase: compilation
error_signature: assigning to 'xmlErrorPtr' from 'const xmlError \*' discards qualifiers|cannot initialize a variable of type 'xmlErrorPtr' with an rvalue of type 'const xmlError \*'

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               compat, portability, cpp, libxml2
match_keywords: xmlGetLastError, const xmlError, xmlErrorPtr, discards qualifiers, libxml2 2.15, xml.cc
title: libxml2 2.15.x 的 xmlGetLastError() 返回 const xmlError*，老代码用非 const xmlErrorPtr 接收报 discards qualifiers

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: libxml2 2.15 将 xmlGetLastError() 的返回值改为 const xmlError*（只读错误信息），老 C++ 代码（如 scram 0.16.2 src/xml.cc:31、src/xml.h:161）用非 const xmlErrorPtr 接收或赋值，Clang 报 discards qualifiers；xmlErrorPtr 是 _xmlError* 的非 const typedef
affected_scope: 所有在 libxml2 ≥2.15 上编译、直接使用 xmlGetLastError() 返回值的 C/C++ 项目
verification_cmd: sed -i 's/xmlErrorPtr xml_error = xmlGetLastError();/const xmlError *xml_error = xmlGetLastError();/' src/xml.cc && cmake --build build -j1 && ./scram_tests

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: const-qualifier-align
rec_description: 把接收 xmlGetLastError() 返回值的变量/参数类型改为 const xmlError*（或 const xmlErrorPtr），与 libxml2 2.15 API 一致；仅错误对象只读，不改变使用方式
rec_command:            可选: 具体命令模板(${VAR}变量引用)
rec_auto_fix: true
rec_impl: apply-conandata-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
# ═══ 元数据 ═══
doc_file: knowledge/drafts/E588-draft-8F24.md
last_updated: 2026-10-07
source_event:           # 触发此条目创建的编译事件(如有)

