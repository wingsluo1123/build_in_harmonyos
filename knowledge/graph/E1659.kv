#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E1659
trigger_tool: runtime|test|ld
phase: runtime
error_signature: R_AARCH64_IRELATIVE|IRELATIVE|DEATH_CPU_USE_IFUNC|ifunc|relocation.*unsupported

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category:               platform, compat, ohos, musl, runtime
match_keywords: IRELATIVE, ifunc, DEATH_CPU_USE_IFUNC, R_AARCH64_IRELATIVE, readelf -r, musl, 启动崩溃, relocation, nCine, indirect function
title: OHOS musl 不支持 IRELATIVE 重定位：代码用 ifunc（GNU indirect function）做运行期分发时，链接产物含 R_AARCH64_IRELATIVE，动态加载器不处理 -> 二进制编译链接全过但一启动就崩

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: ifunc（__attribute__((ifunc))）让符号解析推迟到加载期，由加载器执行 resolver 并把结果写回，链接器为此产出 R_AARCH64_IRELATIVE 重定位。OHOS 的 musl 动态加载器（ld-musl-aarch64.so）不实现 IRELATIVE 处理路径，于是相关符号保持未解析：轻则 Error relocating ...: symbol not found，重则进程在 libc 初始化阶段直接异常终止。现象具有极强误导性——编译、链接、甚至 readelf -d 看依赖都正常，只有真正运行（或 test_package 冒烟）才暴露。nCine 引擎默认 DEATH_CPU_USE_IFUNC=ON（cmake/ncine_helpers.cmake），用于 memcpy 等热点的 CPU 特性分发，即为此坑。
affected_scope: 任何在 OHOS/aarch64 上启用 ifunc 的包：nCine 系（jazz2-native / 其他 nCine 游戏）、显式写 __attribute__((ifunc)) 的库、以及把 glibc 的 ifunc 优化路径搬过来的移植代码
verification_cmd: readelf -r <bin> | grep -c IRELATIVE   # 修复前 >0，修复后应为 0；随后 <bin> --version 应能正常退出

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: disable-ifunc
rec_description: 在构建配置里关闭 ifunc 分发（nCine 用 -DDEATH_CPU_USE_IFUNC=OFF；自研代码则改为编译期静态选择或运行时条件分支）
rec_command: cmake -DDEATH_CPU_USE_IFUNC=OFF ...
rec_auto_fix: false
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach:
fallback_description: 无法关开关时：打补丁把 ifunc 声明改成普通函数（保留一份实现），或改用 -fno-... 等价手段；不要试图用 LD_PRELOAD/包装脚本绕过，加载期就已失败
fallback_command: 
fallback_auto_fix: false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
# ═══ 元数据 ═══
doc_file:               doc/E429.md
last_updated: 2026-10-07
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
