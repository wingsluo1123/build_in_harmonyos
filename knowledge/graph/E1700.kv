#====================================================================
# E14724 — 纯 Python 依赖 site-packages 布局不统一，探测不能只认一种
# 来源: tinyprog 1.0.23 适配（package_info 需逐个探测依赖 site 目录）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E1700
trigger_tool: conan
phase: packaging
error_signature: Package '.*' not found in the pkg-config search path|ModuleNotFoundError: No module named|expected str, bytes or os.PathLike object, not NoneType|PYTHONPATH.*(missing|empty)|site-packages.*not (found|exist)

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               detection, python, packaging
match_keywords: site-packages, PYTHONPATH, runenv_info, package_info, dependencies, package_folder, lib/python, pythonX.Y, append_path, 纯 Python 依赖
title: 纯 Python 依赖的 site-packages 布局三种并存，package_info 探测须逐一尝试

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: 本仓库纯 Python 配方由不同来源生成，payload 目录布局不统一——lib/pythonX.Y/site-packages（packaging 风格）、lib/python/site-packages（pyserial/six 实测）、以及 flat 在包根——package_info() 里若只硬编码一种路径，其余依赖的 PYTHONPATH 静默为空，消费者 import 失败
affected_scope: 所有在 package_info()/runenv_info 中为纯 Python 依赖拼 PYTHONPATH 的配方；跨依赖组合时（本包同时依赖 packaging 风格与 un-versioned 风格）必踩
verification_cmd: ls <dep_package_folder>/lib/*/site-packages <dep_package_folder>/lib/python/site-packages 2>/dev/null; conan test <test_package> <ref> -r=ohpcd

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority: 1
rec_approach: probe-all-python-dep-site-layouts
rec_description: 写一个 _dep_site() 探测器，按 lib/pythonX.Y/site-packages → lib/python/site-packages → 包根 顺序返回首个存在的目录；对每个依赖逐个调用，不要假设统一布局
rec_command: for c in (f"lib/{py_tag}/site-packages", "lib/python/site-packages"): if isdir(join(folder,c)): return c
rec_auto_fix: false
rec_impl:

fallback_priority: 2
fallback_approach: declare-dep-sites-in-runenv-and-buildenv-both
fallback_description: 探测到后必须同时写 runenv_info 与 buildenv_info：部分依赖只发布 runenv（six/1.17.0 实测无 buildenv），构建期消费者会看不到
fallback_command: self.runenv_info.append_path("PYTHONPATH", site); self.buildenv_info.append_path("PYTHONPATH", site)
fallback_auto_fix: false
fallback_impl:

forbid_1_pattern: join\(folder, *["']lib/python/site-packages["']\)\s*(\)|,)
forbid_1_reason: 硬编码单一 site-packages 布局，遇到另一种布局的依赖时静默返回空路径
forbid_1_consequence: 消费者 PYTHONPATH 缺该依赖，运行期 ModuleNotFoundError；无任何构建期报错，诊断成本高
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
principles:             P007
