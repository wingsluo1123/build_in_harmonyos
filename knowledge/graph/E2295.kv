last_updated:           2026-09-20
source_event:           libfsapfs 20240429 HarmonyOS PC 适配（libyal 家族新包，OHOS 真机采信轮）
authors:                AtomCode
source_pr:              (同 PR 交付)
source_commit:          (同 PR 交付)

metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.9
