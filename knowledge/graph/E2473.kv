error_signature: "smoke: .* missing (line|numbered|diagnostic)|grep -q.*out.txt.*fail|cli assertion passed standalone but failed in conan test|rc=0 on missing file|stdin: /dev/null"
root_cause: "conan 2 的 test() 阶段以 env=\"conanrun\" 执行消费者脚本时，进程的 stdin 被接到 /dev/null（VirtualRunEnv 无 tty）。这使 CLI 分页器/交互工具的可观测行为与手工运行不一致：①显示层特性（less -N 行号、 -M 提示符等）只存在于 tty 渲染路径，管道输出里根本不出现；②读取 stdin 的工具（less 在参数文件打开失败后回落读 stdin）读到 EOF 后'正常'退出，错误场景 rc 反而为 0。把手工终端里的行为预期直接写成断言，必然假阴性。"
rec_approach: "CLI 工具消费者测试的断言只选两类管道可观测证据：①stdout 重定向后的文件内容（-F 等整页直通路径的输出）；②stderr 诊断文本（grep 错误关键词）。交互/显示层特性要么不进消费者测试、要么用上游自带的脚本化仿真套件（如 less 自带的 lesstest：pty + 模拟终端）承载。"
fallback_approach: "若必须验证交互行为：改用上游仿真设施（less 的 lesstest、htop 的 scripts）或 pty 库包装；不要试图在 conanrun 下伪造 tty。"
fallback_command: "grep -rn 'smoke' archives/*/*/latest/test_package/ | head; conan profile 查 VirtualRunEnv 生成的 conanrun.sh 确认 stdin 接线"
prescan_pattern: "self.run.*smoke\\.sh|test\\(self\\).*conanrun|--version"
prescan_globs: ["**/test_package/conanfile.py", "**/test_package/smoke.sh"]
rec_command: "less -F missing.txt < /dev/null > /dev/null 2>err.txt || true; grep -qi 'no such' err.txt  # 断言 stderr 诊断而非 rc"
match_keywords: ["conanrun", "stdin", "/dev/null", "consumer test", "smoke", "断言", "CLI", "--version", "rc=0", "less", "-N", "显示层", "VirtualRunEnv", "test_package"]
severity:               1
category: conan, testing, cli
