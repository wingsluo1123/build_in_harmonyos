# ═══ Draft knowledge entry — 自带数据资源的 CLI 工具：硬编码资源路径补丁 + runenv 导出打包闭环 ═══
# Software: starfetch 0.0.4
# Gate: packaging|test_package|L1e
# Status: DRAFT — same-stem .md/.kv pair

id:                     E2895
severity:               2
category:               portability, conan, packaging
trigger_tool: conan|make
phase: package

error_signature: resources not found after install|cannot open .*template|help message empty|ifstream.*\.json failed|Error: the .* you asked for isn't recognized

match_keywords: /usr/local/share, resource dir, data files, runenv, define_path, install target, ln -s, hardcoded path, CLI tool, package_type application

root_cause: |
  上游 CLI 工具把数据资源目录硬编码为 FHS 绝对路径（如 /usr/local/share/<name>/），
  makefile install 目标同样 rm/mkdir/cp/ln -s 直写 /usr/local——两处假设在 Conan
  包前缀隔离 + OHOS（/usr/local 不可写）下全部失效：安装后二进制找不到随包资源，
  功能整体静默失效（帮助文本为空、资源渲染失败）。

rec_approach: env-override-patch-plus-manual-package-plus-runenv-export
rec_description: |
  四步闭环：①最小补丁把静态路径初始化改为 getenv 覆盖、未设置保持上游默认
  （补丁登记 conandata.yml，build() 首行 apply_conandata_patches——G1 门禁要求）；
  ②不碰 install 目标，build() 用 profile 编译器（conf 取，勿 ${CXX}）直编，
  package() 手动拷 bin + share/<name>/ 资源；③package_info 用
  runenv_info.define_path 导出资源变量并 prepend PATH；④test_package 经 conanrun
  消费（which 找二进制 + 环境变量找资源），断言含资源存在性/帮助/渲染/错误路径，
  L1e 破坏产物即失败。上游无测试套件时 MANIFEST 如实记 0，验证全落 test_package
  断言且三处计数一致。
rec_command: |
  # 判别
  grep -nE '/usr/(local/)?(share|lib|etc)' src/* ; grep -nE 'ln -s|INSTALL_DIR' makefile
  # 补丁核心（C++17）
  #   static string path = [] { const char *e = getenv("<NAME>_RES_DIR");
  #     string p = e ? string(e) : string("/usr/local/share/<name>");
  #     while (!p.empty() && p.back()=='/') p.pop_back(); return p + "/"; }();
  # package_info
  #   self.runenv_info.define_path("<NAME>_RES_DIR",
  #       os.path.join(self.package_folder, "share", "<name>"))
  #   self.runenv_info.prepend_path("PATH", os.path.join(self.package_folder, "bin"))
rec_auto_fix: false

affected_scope: |
  所有源码硬编码 /usr/local(/share) 资源路径、install 目标硬编码 /usr/local、
  且资源属于包自身的编译型 CLI 工具（package_type=application）。

verification_cmd: |
  # 未设环境变量 → 资源读取失败面（帮助文本为空）
  env -u <NAME>_RES_DIR <pkg>/bin/<name> -h | wc -c        # 期望 0 或缺资源告警
  # conanrun 环境 → 正常渲染
  conan create <pkgdir> -pr:h=... -pr:b=... --build=missing
  cd <pkgdir>/test_package && conan test . <name>/<version> -pr:h=...   # 断言全过

authors:
  - codex
source_pr:
source_commit:
rec_impl:               manual
rec_priority:               1
last_updated:               2026-10-19
authors:               
doc_file:               doc/E2895.md
