#====================================================================
# DRAFT-libmeshb-8.02-dotted-versioned-target-name
#   CMake 库目标名内嵌主版本号且带点号（Meshb.7 → Meshb.8）
#   —— cpp_info.libs 必须显式跟随；版本升级联动头文件改名
# 来源: PR feat/libmeshb-8.02 适配 HarmonyOS PC（7.80 → 8.02 升级验证）
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E2936
trigger_tool:           cmake|conan|ld
phase:                  packaging|linking
error_signature:        add_library\(Meshb\.[0-9]+|
                         libMeshb\.[0-9]+\.a|
                         cannot find -lMeshb\.|
                         cpp_info\.libs.*Meshb\.|
                         libmeshb[0-9]+_helpers\.h|
                         libmeshb[0-9]+\.h

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               cmake, linking, conan, packaging, target-name
                        version-embedded, ohos, header-rename
match_keywords:         目标名带点号, Meshb.7, Meshb.8, libMeshb.8.a,
                        cpp_info.libs, -lMeshb, 点号, dotted target,
                        版本升级目标名变化, 头文件改名, libmeshb7.h,
                        libmeshb8.h, 主版本号, 版本内嵌目标名
title:                  CMake 库目标名内嵌主版本号并带点号（Meshb.7/Meshb.8）：
                        conan 配方 cpp_info.libs 必须显式跟随目标名（-lMeshb.8），
                        版本升级时目标名与公开头文件名联动变化（libmeshb7.h →
                        libmeshb8.h），打包 copy 与 libs 需同步
prescan_pattern:        add_library\([A-Za-z_]+\.[0-9]+|
                         lib[A-Za-z]+_[0-9]+\.h|
                         cpp_info\.libs\s*=\s*\[
prescan_globs:          CMakeLists.txt, sources/CMakeLists.txt, conanfile.py

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             上游 add_library(Meshb.8 ...) 把主版本号直接编进目标名
                        （产物 libMeshb.8.a）。Conan 配方生成器按包名猜 libs
                        名（libmeshb）会猜错，链接器无法解析 -lMeshb.8，导致
                        下游 target_link_libraries 失败。同时公开头文件
                        libmeshb8.h/libmeshb8.ins/libmeshb8_helpers.h 也内嵌
                        主版本号，版本升级（7.80 → 8.02）时目标名与头文件
                        全部联动改名，package() 的 copy 源与 cpp_info.libs
                        必须逐项同步，否则打包缺头或缺库。
                        7.80 已遇到同构问题（Meshb.7），8.02 升级复验确认
                        该模式随版本迁移而非固定。

rec_approach:           1) 在 conanfile.py 显式 cpp_info.libs = ["Meshb.8"]（跟随
                        目标名，含点号原样保留，链接器可解析 -lMeshb.8）；
                        2) package() 按上游实际头文件名 copy（libmeshb8.h、
                        libmeshb8.ins、libmeshb8_helpers.h 到 include/），
                        不调用 cmake.install() 避免示例二进制进入包；
                        3) 版本升级时先 diff 上游 sources/CMakeLists.txt 的
                        add_library 目标名与公开头文件名，联动更新 libs 与 copy；
                        4) test_package 消费者以 find_package(libmeshb) 真实编译
                        链接运行验证（CMakeDeps 导出 target 为 libmeshb::libmeshb，
                        与带点号库文件名不冲突）。

verification_cmd:
                        conan create 成功；test_package 消费者 test_libmeshb_consumer
                        9/9 checks passed、test_libmeshb_ohos 22/22 checks passed；
                        7.80（Meshb.7）同构验证为先例。

# ═══ Layer 3: 关联层 (Relations) ═══
# ═══ Layer 4: 边界层 (Boundary) ═══
rec_auto_fix:               false
rec_impl:               manual
rec_priority:               1
last_updated:               2026-10-19
authors:               unknown
doc_file:               doc/E2936.md
affected_scope:         CMake 库目标名内嵌主版本号并带点号（Meshb.7/Meshb.8）：
verification_cmd:       # 以 source_pr CI 门禁为准（PR n/a）
rec_description:        1) 在 conanfile
