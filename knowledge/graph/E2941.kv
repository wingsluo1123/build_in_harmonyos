#====================================================================
# DRAFT-include-form-driven-include-dir-mount
#   消费者 include 形态驱动的依赖 include 目录挂载层级归一：
#   命名空间前缀 include（"ns/header.h"）要求 include dir 指向命名空间
#   目录父级（或重排 vendor 布局/镜像公共头进命名空间目录），直接错层
#   挂载即 fatal error: file not found（头实际存在）
# 来源: feat(kodi-game-libretro): 21.0.10 适配 HarmonyOS PC
#       （libretro-common @ 50c15a88 / rcheevos v9.2.0 vendor pin；
#        同型实证 feat/kodi-inputstream-rtmp-21.1.2 librtmp registry 包）
# 路径: Path B（知识库扩展，primary；Curator 判定 B1 + Auditor CONFIRMED 路径 A+B）
# 状态: 草稿（待审核 promote；最终编号 Exxx 由知识库主编确认）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E2941
trigger_tool:           clang|gcc|cmake|conan
phase:                  compilation
error_signature:        fatal error: ['"]?[a-z0-9_-]+/[A-Za-z0-9_.-]+\.h['"]? file not found|
                        'libretro-common/libretro\.h' file not found|
                        'rcheevos/rcheevos\.h' file not found|
                        'librtmp/rtmp\.h' file not found

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               build-system, cmake, conan, include-resolution, vendored-dependency
match_keywords:         include 形态, include form, 命名空间目录, namespaced include,
                        namespace prefix, includedirs, include_directories,
                        PATH_SUFFIXES, find_path, 挂载层级, mount, mount hierarchy,
                        父目录注入, 子树重排, 平铺头镜像, vendor, vendored, tarball,
                        fatal error, file not found, libretro-common, rcheevos,
                        librtmp, RTMP_INCLUDE_PARENT, kodi
title:                  消费者源码以命名空间目录前缀 include 依赖头时，依赖 include 目录必须挂载到命名空间目录父级（或重排 vendor 布局/镜像公共头进命名空间目录），错层直接挂载即 fatal error: file not found
prescan_pattern:        \#include\s+["<][a-z0-9_-]+/[A-Za-z0-9_.-]+\.h[">]
prescan_globs:          src/**/*.h, src/**/*.c, src/**/*.cpp, conanfile.py,
                        CMakeLists.txt, **/CMakeLists.txt

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             因果链（工具实现证据 → 触发命令 → 失败点 → 归类）：
                        ① 工具实现——编译器引号 include 按"每个 include dir +
                        头相对路径"拼接解析；#include "ns/header.h" 要求某个
                        include dir 下存在 ns/header.h，即 include dir 必须指向
                        命名空间目录的父级；
                        ② 触发命令——任何把依赖 includedirs 原样注入消费者编译的
                        构建（target_include_directories / include_directories /
                        conan cpp_info 传递）；
                        ③ 失败点——依赖实际布局不满足父级要求（registry 包
                        includedirs 指进命名空间目录内部 / vendor 头平铺在
                        include 根 / include 子树无命名空间层）→ 相对路径拼不中
                        → fatal error: 'ns/header.h' file not found → 构建阻塞；
                        头文件实际存在，错在挂载层级而非缺文件；
                        ④ 归类——build-system（编译 include 解析面），阻塞面 =
                        构建失败（自包含探针实证，非边缘观察）。
                        三种已实证变体：
                        变体 A 父目录注入——registry 包 includedirs 指进命名空间
                        目录内部时取其父目录注入（inputstream-rtmp 21.1.2
                        RTMP_INCLUDE_PARENT 先例）；
                        变体 B tarball include 子树重排——解包后重排为
                        <部署目录>/<命名空间名>/（本 run：libretro-common →
                        libretro-common-include/libretro-common）；
                        变体 C 平铺公共头镜像——镜像为 <部署目录>/<命名空间名>/*.h
                        （本 run：rcheevos → rcheevos-include/rcheevos/，等价
                        上游 depends 的 include/<project> 安装布局）。
                        诚实边界：两个工程实例均为设计期预防（无真实构建失败
                        日志），阻塞面由探针独立证实。
affected_scope:         任何消费者源码以命名空间前缀 include 依赖头
                        （#include "ns/header.h"）、且依赖包（registry conan 包
                        includedirs 或 vendor tarball 布局）与该形态不一致的
                        项目；加载型插件与含命名空间头布局依赖的库（kodi 家族
                        已 3 实例）高发；registry 包与 vendor tarball 两条供给
                        路径均适用。非 OHOS 专有：机理是编译器 include 解析
                        语义，任何交叉/本地构建面同构。反例：消费者为平铺形态
                        且依赖头在 include 根 → 直接挂载即可；头确缺失属依赖
                        闭包断裂，另案处理。
verification_cmd:       自包含真机探针（任何有 tar/clang 的 shell 可独立复跑，
                        不依赖本 run 日志路径；完整转录见同 run
                        reports/curator/probe-include-form/run-probe.sh 与
                        probe-transcript.txt）：
                        # ① 取两份与消费形态错配的依赖源码
                        curl -fL -o lc.tar.gz https://github.com/libretro/libretro-common/archive/50c15a88eb741cbe675743a282d8cc4c89421e3f.tar.gz
                        curl -fL -o rc.tar.gz https://github.com/RetroAchievements/rcheevos/archive/refs/tags/v9.2.0.tar.gz
                        # ② 消费者 TU（命名空间前缀 include）
                        printf '#include "libretro-common/libretro.h"\nint main(void){return 0;}\n' > consumer_lc.c
                        printf '#include "rcheevos/rcheevos.h"\nint main(void){return 0;}\n' > consumer_rc.c
                        # ③ naive 挂载（错层）→ 期望 exit 1：
                        clang -I<lc-include内部> consumer_lc.c -o /dev/null
                        #   fatal error: 'libretro-common/libretro.h' file not found
                        clang -I<rc-include根> consumer_rc.c -o /dev/null
                        #   fatal error: 'rcheevos/rcheevos.h' file not found
                        # ④ 按形态归一（父级挂载/重排加命名空间层/平铺头镜像进
                        #    命名空间目录）→ 期望 exit 0
                        # 实测记录：naive 两例 exit 1（naive-error.log /
                        # rc_naive-error.log），归一两例 exit 0（normalized.bin /
                        # rc_norm.bin）

# ═══ Layer 3: 方案层 (Solution Space) ═══
rec_priority:           1
rec_approach:           consumer-include-form-driven-mount-normalization
rec_description:        按依赖供给形态三选一，判据统一为"include dir 必须使
                        <命名空间>/<header>.h 相对路径可解析"：
                        ① 变体 A 父目录注入——registry 包 includedirs 指进命名
                        空间目录内部时，消费者侧取其父目录注入；
                        ② 变体 B tarball include 子树重排——vendor 解包后把
                        include/ 子树重排为 <部署目录>/<命名空间名>/；
                        ③ 变体 C 平铺公共头镜像——头平铺在 include 根时镜像为
                        <部署目录>/<命名空间名>/*.h。
                        配方层桥接，上游源码零修改。
rec_command:            zsh reports/curator/probe-include-form/run-probe.sh
rec_auto_fix:           false
rec_impl:               conan-recipe-bridge

fallback_priority:      2
fallback_approach:      modify-consumer-include-form
fallback_description:   修改消费者源码 include 形态（去掉命名空间前缀）以适配
                        依赖布局。权衡：污染上游 diff、随上游演进漂移、
                        可读性下降，仅作退路，不予自动化。
fallback_command:       sed -i 's|#include "ns/header.h"|#include "header.h"|' <consumer-sources>   # 逐处人工改
fallback_auto_fix:      false
fallback_impl:          consumer-source-edit

# 禁止策略
forbid_1_pattern:       cp.*\.h.*<dep>.*/include/[^/]*\.h|散拷.*include根|copy.*headers.*include root
forbid_1_reason:        禁止把命名空间头文件散拷至 include 根——破坏命名空间、
                        跨库头名碰撞风险，且掩盖依赖布局错配根因（P012 同向：
                        不污染公共路径）。
forbid_1_consequence:   局部编译能过，其他消费同头库的项目被 include 根残留
                        影响或撞名，问题被推迟到链接/运行期。
forbid_2_pattern:       -I.*<dep>.*/ns/子目录.*-I.*<dep>.*/ns/子目录|逐子目录.*-I|C_INCLUDE_PATH
forbid_2_reason:        禁止逐子目录堆叠 -I / 用 C_INCLUDE_PATH 类环境变量兜底
                        错层——脆弱且掩埋"挂载层级"根因（P-ENV-001 同向：构建
                        系统原生机制优先，环境变量兜底禁用）。
forbid_2_consequence:   依赖每次加子目录就要追堆 -I，上游布局一变即碎；
                        环境变量兜底还会污染同机构建的其他项目。

# ═══ Layer 4: 原则引用 ═══
principles:               
