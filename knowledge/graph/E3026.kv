#====================================================================
# 知识草稿（.kv）—— g_libintl_* 跨库 gettext 符号绑定死锁
# 提交到 knowledge/drafts/ 时文件名与 id: 一致：
#   DRAFT-gtk-libintl-gettext-deadlock.kv（配套同名 .md）
# 证据来源：md汇总/留痕工作/gtk/验收执行手册-V1V2V3与真编-20260920.md、
#           md汇总/留痕工作/gtk/evidence-20261001/（含 SHA256SUMS.txt）
# 定位（2026-10-01 评审口径）：新增价值在【根因机制 + 最小复现件 + 边界修正】；
#   修复手段①（消费侧 -lintl）已由 DRAFT-autoreconf-bootstrap-intltool-prefix-and-gtk-lintl
#   第④坑记录，本条不再作为“新方案”主张。
#====================================================================

# ── 错误面（Layer 0）──────────────────────────────────────────────────
id:                     E3026
trigger_tool:           ld
phase:                  runtime
error_signature:        ld\.lld: error: undefined reference due to --no-allow-shlib-undefined: g_libintl_bindtextdomain|ld\.lld: error: undefined reference due to --no-allow-shlib-undefined: g_libintl_bind_textdomain_codeset|g_libintl_gettext.*libgtk-3\.so

# ── 识别层（Layer 1）──────────────────────────────────────────────────
severity:               3
category:               ohos, linking, runtime
match_keywords:         g_libintl,gettext,futex,deadlock,libintl,proxy-libintl,-fvisibility=hidden,visibility,跨库绑定,g_once
title:                  第三方库（gtk/3.24.38 自建 gettext shim）以默认可见性重复导出 g_libintl_*，劫持 libglib 的跨库符号绑定并重入 g_once → 首次译文查找永久 futex 死锁（同时掩盖下游漏链 libintl）

# ── 诊断层（Layer 2）──────────────────────────────────────────────────
root_cause:             libglib-2.0.so 的 g_libintl_* 是未定义符号（由 glib 包 vendored proxy-libintl 的共享 libintl.so.8 提供）；gtk/3.24.38 配方额外自建 gettext shim 并以默认可见性导出同名符号进 libgtk-3.so，动态链接器按装载顺序（libgtk-3.so → libglib-2.0.so → libintl.so.8）把 libglib 的未定义引用绑到 libgtk 的重复定义；该 shim 回调 glib_gettext/g_dgettext 时，glib 的 gettext 一次性初始化（_g_dgettext_should_translate 的 g_once）仍在进行且仅一个线程 → g_cond_wait 永久等待（musl futex、timeout=NULL）。同一 shim 还掩盖了 libgsf-1.so 漏链 libintl（.dynsym 含 U g_libintl_* 但未进 DT_NEEDED）的链接期缺陷
affected_scope:         ① 所有在 OHOS 上加载 libgtk-3（3.24.38 系）并在首次 gettext 译文查找处死锁的 GTK3 应用/插件宿主机；② 任何 .dynsym 含 U g_libintl_* 且未进 DT_NEEDED 的库（实证实例 libgsf-1.so：libgsf/1.14.58）；③ 可推广为“同进程内某库以默认可见性重复导出他人未定义符号 → 跨库绑定劫持 → 重入一次性初始化”这一类别
verification_cmd:       llvm-nm -D --defined-only <libgtk-3.so> | grep -c g_libintl_   # 期望 0（脏包 7）；llvm-nm -D --defined-only <glib>/lib/libintl.so | grep -c g_libintl_   # 期望 9；探针：只链 libgtk-3 + 一次 g_dgettext，20s 超时

# ── 方案层（Layer 3）──────────────────────────────────────────────────
rec_priority:           1
rec_approach:           link-shared-libintl
rec_description:        首选工程解：让引用 g_libintl_* 的库/可执行文件链接共享 libintl.so（绝对路径 + -Wl,--no-as-needed 保证进 DT_NEEDED），不要自行再定义这些符号。注：该手段同类做法已由 DRAFT-autoreconf-bootstrap-intltool-prefix-and-gtk-lintl 第④坑（“glib 的 g_libintl_* 要单独补 -lintl”）记录，本条不主张为新方案，仅作为工程首选
rec_command:            -Wl,--no-as-needed <glib 包>/lib/libintl.so
rec_auto_fix:           false
rec_impl:               compile-flag

fallback_priority:      2
fallback_approach:      hidden-visibility-shim
fallback_description:   源头修法：消除非法外泄（二选一）——① 升级到不含该 shim 的 gtk/3.24.43（其 _augment_glib_pkg_config 给 glib-2.0.pc 补 -lintl）；② 若必须保留 3.24.38，给 shim 编译加 -fvisibility=hidden，使其不进入动态符号表。⚠️ 与 DRAFT-ohos-hidden-symbol-visibility-exports-zero 方向相反（该条目讲“上游强制 hidden 导致导出 0、消费者链接失败”，本条讲“默认可见导致非法外泄”），勿混用；⚠️ -Wl,--exclude-libs 不适用（只作用于静态库成员，shim 是普通 .o）
fallback_command:       -fvisibility=hidden
fallback_auto_fix:      false
fallback_impl:          compile-flag

# 预防措施（可与上两项并存；本条为建议形态，尚未在配方中实现）
# ── 禁止做法 ──────────────────────────────────────────────────────────
forbid_1_pattern:       再次自行定义并默认可见导出 g_libintl_|链接静态 libintl\.a
forbid_1_reason:        前者重演跨库绑定死锁（E107 的“建中间共享库导出 g_libintl_”在本场景即属此类）；后者引入第二套 glib/GObject 类型系统（R60 已证实）
forbid_1_consequence:   运行时永久 futex 挂起 / quark、类型 ID 跨副本失效

