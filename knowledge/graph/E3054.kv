error_signature: "symbol not found|No such file or directory.*run/.*\\.so"
root_cause: "OHOS clang/lld 交叉工具链使 CMake 的 CMAKE_SHARED_LIBRARY_SONAME_*_FLAG 探测为空，内部共享库无 SONAME，可执行文件 DT_NEEDED 记录构建树绝对路径（run/libwiretap.so）而非 SONAME；同时上游按 CMAKE_SYSTEM_NAME（Linux/SunOS/FreeBSD 等）门控 $ORIGIN install RPATH 的项目在 OHOS 全部不匹配，可执行文件最终无 RPATH → 安装后包运行时无法解析自身库（'symbol not found'）。"
rec_approach: "配方强制注入 CMAKE_SHARED_LIBRARY_SONAME_C_FLAG / CMAKE_SHARED_LIBRARY_SONAME_CXX_FLAG = '-Wl,-soname,'（尾逗号必须：CMake 以无分隔符方式拼接 flag 与 soname，缺逗号 lld 拒收融合 token）+ ENABLE_RPATH_ORIGIN=ON（或等效 $ORIGIN RPATH），使包自包含可重定位。"
match_keywords: ["SONAME", "CMAKE_SHARED_LIBRARY_SONAME", "RPATH", "$ORIGIN", "DT_NEEDED", "symbol not found", "OHOS", "CMake"]
prescan_pattern: "CMAKE_SYSTEM_NAME"
severity:               2
category: platform
