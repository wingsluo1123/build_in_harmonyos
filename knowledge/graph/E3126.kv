#====================================================================
# DRAFT knowledge entry - make 4.4.1 整文件替换式 config.guess/config.sub 补丁的配方内覆盖
# Source package: make/4.4.1（上游 GNU make 4.4.1，autotools，纯 C）
#====================================================================

id:                     E3126
trigger_tool: configure|config.guess|config.sub|git apply
phase: conan-recipe, configuration
error_signature: apply_conandata_patches|patch does not apply|Invalid configuration|unable to guess system type
severity:               3
category:               autotools, conan, patches
match_keywords: 整文件补丁, whole-file patch, config.guess, config.sub, HarmonyOS triplet, apply_conandata_patches, unified diff, patch 目录, 覆盖替换, make 4.4.1

title: patches/ 里"0001-*.patch"实为 config.guess/config.sub 完整替换文件时,不能用 conandata 补丁管线——在 build() 中复制覆盖并补执行位

root_cause: >
  仓库中部分 autotools 库的 patches/ 目录以 .patch 后缀存放 config.guess/config.sub
  的整份替换脚本(非 unified diff)。apply_conandata_patches()/git apply 无法应用;
  逆向转 diff 又引入维护负担。此类包应绕过 conandata 补丁管线,在配方内做文件级覆盖。

affected_scope: 所有"config.guess/config.sub 整文件替换"型 autotools 库的 Conan 化
  (make/4.4.1、其他沿用 patch-autotools-ohos.pl 产物直接入库的包)。

verification_cmd: >
  # 配方可加载性(本机 Windows,Conan 2.29.1):
  conan graph info archives/m/make/4.4.1 -s "os=Linux" -s "arch=armv8" \
    -s "compiler=gcc" -s "compiler.version=12" -s "compiler.libcxx=libstdc++11" -s "build_type=Release"
  # → error=null;py_compile 配方与 test_package 通过;SHA256 与 GNU 发布一致

rec_priority: 2
rec_approach: recipe-export-and-copyfile-overlay
rec_description: >
  1) 不建 conandata.yml,URL/SHA256 内联配方(顺带规避 CI BUILD_DIR 预下载缺陷);
  2) exports = "patches/*" 导出整文件;
  3) build() 起始用 copyfile 覆盖 <source>/build-aux/config.guess|config.sub 并 chmod +x,
  之后 configure 正常识别 aarch64-unknown-linux-ohos(r9 设备已验证同一替换文件有效)。
rec_command: >
  dst = os.path.join(self.source_folder, "build-aux/config.guess")
  shutil.copyfile(os.path.join(self.recipe_folder, "patches", name), dst)
  os.chmod(dst, os.stat(dst).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
rec_auto_fix: false
rec_impl: conan-recipe-build
authors: codex
source_pr: pending
source_commit: feat/make-4.4.1-codex (W5 r9)
last_updated:               2026-10-19
doc_file:               doc/E3126.md
