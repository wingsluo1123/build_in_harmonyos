#====================================================================
# E999 — OHOS loader 校验 .codesign 摘要：meson install 改写 .dynstr(RUNPATH) 使 lld 摘要失配 → dlopen Permission denied
# 来源: libfprint 1.94.10 适配（meson 共享库配方）
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具
# phase:         出错阶段
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E3270
trigger_tool:           meson|install|ld|dlopen|runtime|test
phase:                  installation|runtime|testing
error_signature:        dlopen.*Permission denied.*codesign.*meson install.*Error loading shared library.*symbol not found

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表，逗号分隔，最多 5 个）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category:               platform, ohos, portability, build-system, codesign
match_keywords:         Permission denied, Error loading shared library, symbol not found, codesign, dynstr, RUNPATH, meson install, binary-sign-tool, pristine .so, restore
title:                  OHOS loader 校验 .codesign 摘要：meson install 改写 .dynstr(RUNPATH) 使 lld 生成的摘要失配 → dlopen Permission denied；须从 build 树恢复 pristine .so

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             OHOS loader 在 dlopen 时校验 .codesign digest（由 lld -Wl,--code-sign 生成）是否与当前文件内容一致。(1) OHOS 适配版 'meson install' 会把已安装副本 .dynstr 中的绝对构建路径（RUNPATH 字符串如 /storage/.../.conan2/.../p/lib）改写成 'X'，使摘要失配；(2) 配方在链接后再用 binary-sign-tool -selfSign 重签同样破坏摘要。结果 loader 拒绝加载（'Permission denied' / 级联 'Error relocating ... symbol not found'）。build 树里链接时刻的原始 .so（pristine lld 签名）可正常加载。
affected_scope:         所有 OHOS 交叉编译且用 meson install 的共享库配方；凡 install 后对 .so 做字节改写（RUNPATH 重写）或重签（binary-sign-tool -selfSign）的包，test_package 消费者 dlopen 均会失败。
verification_cmd:       对比 build 树原始 .so 与包内 .so 的字节（cmp 应有差异且集中在 .dynstr/RUNPATH）；或 conan create 后直接运行 test_package 观察 dlopen Permission denied / symbol not found。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先)
rec_priority:           1
rec_approach:           restore-pristine-so-after-install
rec_description:        package() 中 Meson(self).install() 之后，从 meson build 树找回同名原始 .so（walk self.build_folder 匹配 basename），用 shutil.copy2 覆盖包内被改写/重签的副本，恢复 lld 生成的 .codesign 摘要；不要用 binary-sign-tool 重签（CI 在 release 阶段用 ci/artifacts/sign.sh 统一签名）。
rec_command:            def _restore_pristine_shared_libraries(self):\n    for root,_,files in os.walk(self.build_folder):\n        for f in files:\n            if f.endswith('.so') and not os.path.islink(...):\n                src=os.path.join(root,f); dst=os.path.join(self.package_folder,'lib',f)\n                if os.path.exists(dst): shutil.copy2(src,dst)
rec_auto_fix:           false
rec_impl:               restore-pristine-so

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      replace-cached-package-so
fallback_description:   对已受影响的缓存依赖包（非本配方），从 conan build 树复制干净 .so 替换包目录与 d/conan_package.tgz 中的对应文件，再重跑 test_package。
fallback_command:       find ~/.conan2/p -path '*/d/*' -name 'lib*.so*' ; shutil.copy2(build_tree_so, pkg_dir/lib) && 重打包
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       binary-sign-tool.*-selfSign|--remove-section.*\.codesign
forbid_1_reason:        链接后重签/删 .codesign 段会替换 lld 生成的摘要，OHOS loader 校验必失败。
forbid_1_consequence:   dlopen Permission denied / symbol not found，test_package 无法加载库，构建失败难定位。
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

