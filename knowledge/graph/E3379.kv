# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E3379
trigger_tool: python
phase: runtime
error_signature: self.mrt.micro_ts = self.val_num(4)

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category: network
match_keywords: mrtparse, micro_ts, val_num, chk_buf
title: 扩展 MRT 时间前缀必须在真实载荷层消费一次

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: mrtparse 1.6 BGP4MP_ET uses Reader.val_num(4) while Reader.buf is None; feeding the unsliced prefix to Bgp4Mp also misaligns AS/IP/BGP decoding.
affected_scope: mrtparse 1.6 Type17 BGP4MP_ET with four-byte big-endian microsecond prefix and shared Bgp4Mp decoder; not all NoneType errors.
# module_root is the original H1-002 functional-result module_path with /mrtparse/__init__.py removed.
# results-json below is a separate prospective output; original 5/5 and 12 samples are reused, not replayed for this text fix.
verification_cmd: python3 -B /data/storage/el2/base/files/gcw-mrtparse8998-h1-001-20261013/continuations/h1-002-20261013/framework/archives/m/mrtparse/1.6/test_package/functional.py /data/storage/el2/base/files/gcw-mrtparse8998-h1-001-20261013/continuations/h1-002-20261013/conan-home/p/b/mrtpa639b2721e14ce/p/lib/python /data/storage/el2/base/files/gcw-mrtparse8998-h1-001-20261013/continuations/h1-002-20261013/tmp/functional-knowledge-derived003-20261016.json

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: consume-et-prefix-at-payload-owner
rec_description: Validate payload length >=4, decode micro_ts with struct.unpack(>I,data[:4]), and pass only data[4:] to Bgp4Mp; retain raw Mrt.buf and Type16 behavior.
rec_command: apply_conandata_patches(self)
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: replace-None-with-empty-buffer, pass-unsliced-microsecond-prefix
forbid_1_reason: A default empty buffer or unsliced child input hides the true buffer ownership problem and corrupts record alignment.
forbid_1_consequence: Valid extended records fail or decode incorrect downstream fields.
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

