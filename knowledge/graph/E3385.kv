# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E3385
trigger_tool:           configure|cmake|meson|make|gcc|clang|ld|python|pip|install|test|runtime
phase:                  configuration|compilation|linking|installation|testing|runtime
error_signature: file cannot create directory: /usr/lib/sysusers\.d|cmake --install.*cannot create directory.*/usr/lib|CMake Error.*file INSTALL cannot make directory

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               platform, ohos, cmake, conan, install
match_keywords: SYSUSERS_DIR, CMAKE_INSTALL_PREFIX, DESTDIR, cmake --install, Conan, file cannot create directory, absolute path, CACHE PATH, sysusers.d, rdma-core
title: cmake 上游 CACHE PATH 默认绝对系统目录：Conan 前缀打包时 cmake --install 报 file cannot create directory

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 上游 CMakeLists 用 set(SYSUSERS_DIR "" CACHE PATH ...) 之类的空默认值，随后回退到一个绝对系统路径（rdma-core 64.0 是 /usr/lib/sysusers.d），并用 install(FILES ... DESTINATION ${SYSUSERS_DIR}) 安装。Conan 打包时 cmake --install 以包目录为前缀，但绝对路径绕过了前缀重定位，安装器试图在真实根文件系统下创建 /usr/lib/sysusers.d 而失败（沙箱/无权限），整个 package() 阶段终止。
affected_scope: 任何在 CMakeLists 中把安装目标默认成绝对系统目录（sysusers.d / systemd units / /etc 下文件等）并用 CMake 安装的库；在 Conan/cmake_layout 前缀打包场景下必失败。rdma-core 64.0 实测。
verification_cmd: 在配方 generate() 中把该变量覆盖为相对路径后 conan create 应通过；检查产物树：ls <package>/lib/sysusers.d 存在 rdma-sysusers.conf，且没有向宿主根文件系统写入。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: override-absolute-cache-path-to-relative
rec_description: 在配方 generate() 里用 CMakeToolchain 覆盖该 CACHE PATH 为相对前缀的路径（tc.variables["SYSUSERS_DIR"]="lib/sysusers.d"），使 install(DESTINATION) 落在 Conan 包前缀内；不要用 DESTDIR（已废弃）或改写绝对路径。
rec_command: tc.variables["SYSUSERS_DIR"] = "lib/sysusers.d"
rec_auto_fix:           false
rec_impl: conan-recipe

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      cmake-install-prefix-patch
fallback_description:   若该变量不可从配方覆盖（未声明为 CACHE 变量或已被项目内部硬编码），用一个最小上游补丁把 install(DESTINATION) 或变量默认值改成相对路径 ${CMAKE_INSTALL_PREFIX}/lib/sysusers.d；避免在构建期对宿主根文件系统写入。
fallback_command:       set(SYSUSERS_DIR "lib/sysusers.d" CACHE PATH "...")
fallback_auto_fix:      false
fallback_impl:          package-patch

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
