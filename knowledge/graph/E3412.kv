# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E3412
trigger_tool: conan|Environment|perl
phase: configure|build|test
error_signature: Can.t locate Test/Harness.pm|define.*prepend_path.*space-joined

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               1
category:               build-system, conan, environment
match_keywords: Conan Environment, define_path, define, prepend_path, setdefault, _EnvValue, path=False, first definition, PERL5LIB
title: Conan路径变量首次define后prepend_path保留标量分隔类型

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Environment.define creates a scalar _EnvValue with space separator; later prepend_path uses setdefault and retains the first value type and separator.
affected_scope: Conan 2 environments that define a search-path variable as scalar before adding path entries.
verification_cmd: Evaluate actual Conan EnvVars with OHOS settings and identical published Perl; scalar-first import rc2, path-first rc0; full original tests and native consumer/Harmony.

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: define-path-semantics-at-first-private-variable-definition
rec_description: Conan Environment先用define建立变量时会保存path=False和默认空格分隔；后续prepend_path通过setdefault沿用已有_EnvValue，不会自动将其改为路径列表。即使最初值已用os.pathsep拼接，追加后仍可能成为带空格的单一搜索目录。对实例私有且明确重建的路径变量，首次用define_path，再prepend_path；传递依赖导出继续采用路径追加，避免覆盖依赖图。
rec_command: env.define_path("PERL5LIB", core_arch_value); env.prepend_path("PERL5LIB", source_lib)
rec_auto_fix: false
rec_impl: Use define_path at the first creation of explicitly private reconstructed paths; retain dependency-export prepend_path semantics.

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
