#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E688.kv，填写各字段
# 对应的人类文档: doc/E688.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E3422
trigger_tool: qmake|conan|make|runtime
phase: configuration|building|runtime
error_signature: No such file or directory.*lrelease|Error loading shared library libc\+\+_shared\.so|Error relocating.*_ZTISt12length_error|libc\+\+_shared\.so.*symbol not found|_ZdlPv.*not found

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               build-system, qmake, toolchain, conan, runtime
match_keywords: qmake6, QMAKE_LRELEASE, lrelease, qttools, LinguistTools, qtbase, libc++_shared, LD_LIBRARY_PATH, OHOS SDK, aarch64-linux-ohos, host tool, moc, generated Makefile
title: Qt6 qmake 工程 OHOS 构建：QMAKE_LRELEASE 显式指向 qttools 的 lrelease + host 工具运行期注入 SDK libc++_shared.so

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: qtbase 包不含 LinguistTools 工具（lrelease 由 qttools 提供），qmake 生成 Makefile 时默认取 $[$QT_INSTALL_BINS]/lrelease 不存在；qtbase/qttools 的 host 工具（qmake6/lrelease/moc）是 OHOS 本机 ELF，DT_NEEDED 含 libc++_shared.so，仅 OHOS SDK llvm/lib/aarch64-linux-ohos/ 提供
affected_scope: 所有 Qt6 qmake 工程（含翻译）在 OHOS 上经 qtbase+qttools conan 包构建的场景，以及所有运行 qtbase/qttools host 工具（qmake6/moc/lrelease）的 OHOS conan 构建
verification_cmd: QT_QPA_PLATFORM=offscreen ./qabc --version && echo OK; conan create ... -pr:h=ohos-aarch64

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: explicit-lrelease-and-sdk-libcxx-injection
rec_description: qmake 命令行传 QMAKE_LRELEASE=<qttools>/bin/lrelease 覆盖默认路径；generate()/build()/test() 中用 Environment 把 SDK libc++ 目录与 qtbase/qttools lib 注入 LD_LIBRARY_PATH（fingerterm 同款）
rec_command: qmake -config release QMAKE_LRELEASE=$QTT/bin/lrelease; env LD_LIBRARY_PATH=...make -j1
rec_auto_fix: false
rec_impl: conan-recipe

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
# ═══ 元数据 ═══
doc_file: doc/E688.md
last_updated: 2026-10-15
source_event: qabc 1.16 conan-verify G2 失败（qmake6 运行期缺 libc++_shared.so）

