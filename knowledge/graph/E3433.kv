#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E544.kv，填写各字段
# 对应的人类文档: doc/E544.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E3433
trigger_tool: clang|make|conan
phase: compilation
error_signature: posix_spawn failed: Resource temporarily unavailable|clang-15: error: unable to execute command|linker command failed with exit code 1|can't fork - try again|spawn-resource exhaustion

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               ohos, build-system, process-limit, worker
match_keywords: posix_spawn, Resource temporarily unavailable, EAGAIN, process slot, RLIMIT_NPROC, link step, link.sh, command substitution, clang -cc1, procs=668
title: OHOS CI worker 进程槽位临界：并发进程需求决定成败（链接步多一层 shell 即 EAGAIN）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 构建机进程槽位长期贴近上限（procs≈668 稳定、load≈21），真正的判据是「该步同时需要几个进程」：普通编译 3 个（shell→clang→clang -cc1，实测 clang 每文件都会 spawn 一个 -cc1，非进程内汇编）能过；link lua 4 个（shell→命令替换子 shell→clang→链接器）能过；tup 最终链接 5 个（多出上游 link.sh 这一层 shell）必失败——即该机只剩约 4 个空闲槽。故失败位置确定、重试（20s×10、三次尝试共 30 次）全部无效：不是负载抖动。
affected_scope:         所有在进程槽位贴近上限的 OHOS worker 上、某一步并发进程数高于普通编译步的构建脚本与配方：上游自带 build.sh/bootstrap 脚本、把链接交给辅助脚本完成的项目、用命令替换捕获长命令输出的 shell 代码。典型症状是「编译全过、到链接（或运行刚生成的工具）时确定性 EAGAIN」。
verification_cmd: CI_PACKAGES="archives/t/tup/0.8" zsh ci/conan/build_and_test.sh

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: reduce-concurrent-processes-at-fragile-step
rec_description: 把脆弱步的并发进程数压到与已通过的编译步同级：①不要用 out=$(...) 捕获输出（命令替换会让子 shell 在整个 spawn 期间常驻，恰好多占一槽），改为重定向到文件 + 内建 read/case 判特征；②不要在链路里插入额外 shell（就地展开上游辅助脚本，如 tup 的 link.sh）；③重试窗口按构建预算给足（15 次、退避 20→60s），每次重试前用 /bin/sh -c : 探针记录「能否创建进程」以区分整机槽位耗尽与本步需求过高。
rec_command:            可选: 具体命令模板(${VAR}变量引用)
rec_auto_fix: false
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
# ═══ 元数据 ═══
doc_file:               knowledge/drafts/E544-draft-50EF.md
last_updated: 2026-10-16
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
