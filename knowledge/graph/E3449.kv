#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E3449
trigger_tool: conan|create|source|sha256
phase: building
error_signature: sha256 hash failed for|Provided hash: .*Computed hash: .*（两串视觉相同）|hash 长度不是 64

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category: conan, recipe-metadata, tooling
match_keywords: sha256, conandata.yml, get(), Provided hash, Computed hash, 不可见字符, 零宽字符, len(hash), hex64, 外观相同, 校验失败
title: `conandata.yml` 里的 `sha256` 值若混入**不可见字符**（零宽字符/非常规空白），Conan 会报 `sha256 hash failed` 并把 `Provided hash` 与 `Computed hash` 打印成**视觉完全相同**的两串——此时不要怀疑下载源，先量哈希串的**长度与字符集**（正确应为 64 个 `[0-9a-f]`）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 手工把哈希值敲进 YAML 时可能带进零宽/不可见字符（复制自带格式的终端输出、或输入法/编辑器插入的隐藏字符）。 Conan 的校验是按字节比较的，于是： * 报错说 `Provided hash` 与 `Computed hash` 不一致， * 但两串在终端里看起来一模一样（不可见字符不显示宽度），极易误判成"下载源变了/缓存脏了"而白折腾。 实测：某次 conandata 的哈希串长度为 **67**（多 3 个字符）且不是 `[0-9a-f]{64}`；本地文件的实际 sha256 与 预期值一致——问题只在字面量本身。
affected_scope: 所有手写/粘贴哈希（sha256/md5）到配方元数据的场景（conandata.yml 的 sources、patches 的哈希、任何 pin 常量的散列）
verification_cmd: `python3 -c "import re;h=re.search(r'sha256:\s*\"([^\"]+)\"',open('conandata.yml',encoding='utf-8').read()).group(1);print(len(h), bool(re.fullmatch(r'[0-9a-f]{64}', h)))"`（长度必须是 64、且全为十六进制）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: measure-hash-length-and-charset-then-write-the-computed-value-back
rec_description: ①遇到 `sha256 hash failed` 且两串"看起来相同"时，**先量长度与字符集**，不要先怀疑网络/缓存；②确认真实文件的哈希（`hashlib.sha256(open(file,'rb').read()).hexdigest()` 或 `sha256sum`）；③把 conandata 里那个值替换成**由文件实算得到**的字符串（避免再次手敲带入不可见字符），替换后立即回校（长度 64 + 十六进制 + 等于实算值）；④顺手记录该现象，避免下次再被"看起来一样"误导。
rec_command: sha256sum <tarball> # 与 conandata 的值逐 char 比对；或 python 量 len() 与 fullmatch
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: regenerate-the-metadata-block-from-the-file
fallback_description: 若不便就地替换（编辑器/工具仍会插入隐藏字符），改为用脚本按"文件实算值"重新生成该段 YAML（只改这一个值、其余字节不动），生成后回校长度与字符集。
fallback_command:
fallback_auto_fix: false
fallback_impl: manual forbid_1_pattern:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
# ═══ 元数据 ═══
doc_file:               doc/E429.md
last_updated: 2026-10-08
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:
authors:               11A7
