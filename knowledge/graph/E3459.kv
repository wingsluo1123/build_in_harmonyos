#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E593.kv，填写各字段
# 对应的人类文档: doc/E699.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E3459
trigger_tool: clang|make|ld
phase: linking
error_signature: Error loading shared library libc\+\+_shared\.so|ld.lld: error: undefined symbol: operator new|undefined symbol: __cxa_begin_catch|undefined symbol: __gxx_personality_v0|symbol not found: _ZNSt9exceptionD2Ev|Error relocating .*__cxa_pure_virtual

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category: portability, toolchain, linking
match_keywords: libc++_shared.so, static-libstdc++, libc++.a, libc++abi.a, libunwind.a, -print-file-name, DT_NEEDED, operator new, __cxa_begin_catch, C 程序链 C++ 库, taglib, tag_c, 运行时自包含, rc=127
title: OHOS 上让 C 程序的 C++ 运行时自包含：clang -static-libstdc++ 在 -stdlib=libc++ 下是 no-op，须显式链接 clang -print-file-name 解析出的 libc++ 静态归档

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 用 C 驱动 clang 链接一个内含 C++ 静态库（如 taglib 的 libtag_c.a/libtag.a）的产物时，默认把 libc++_shared.so 写进 DT_NEEDED；该库放在 SDK 的 llvm/lib/aarch64-linux-ohos 下，不在 OHOS 加载器默认搜索路径，运行期报 'Error loading shared library libc++_shared.so' 并逐条打印 undefined 符号，或用静态运行时时链接期报 operator new/__cxa_* 未定义。-static-libstdc++ 是 GCC 兼容开关，在 -stdlib=libc++ 下不产生静态链接效果（本任务实测：加该开关链接仍报 32 条 undefined symbol: operator new(unsigned long)/__cxa_begin_catch/vtable for __cxxabiv1::__class_type_info）。
affected_scope: OHOS/HarmonyOS 上用 clang（C 驱动）或手写 Makefile 链接、且间接依赖 C++ 运行时的 C/C++ 程序；Conan 依赖里带静态 C++ 库（taglib、libxml2 等）的场景尤其常见
verification_cmd: clang -print-file-name=libc++.a && clang -print-file-name=libc++abi.a && clang -print-file-name=libunwind.a   # 三个静态归档绝对路径；llvm-readelf -d ./<bin> | grep NEEDED   # 期望只剩 libc.so；./<bin> -h   # 不再报 libc++_shared.so 加载失败

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: 显式把 clang -print-file-name 解析出的 libc++.a/libc++abi.a/libunwind.a 三个静态归档追加到链接行末尾，不要依赖 -static-libstdc++
rec_description: 在配方里用编译器自省取路径（避免硬编码 SDK 布局）：三个静态归档加入 LDFLAGS；链接后 readelf -d 校验 NEEDED 仅 libc.so
rec_command: 参考 archives/v/vitunes/2.3/conanfile.py 的 _cxx_runtime_archives()（vitunes 2.3 实测）
rec_auto_fix: false
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
