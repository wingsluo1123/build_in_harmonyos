#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E592.kv，填写各字段
# 对应的人类文档: doc/E697.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E3460
trigger_tool: clang|make|test
phase: runtime
error_signature: usage: -e .*\[-.*\].*file|option requires an argument|invalid option -- |usage: .*\[-[a-zA-Z:]+\]

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category:               portability, abi, c-language, cli
match_keywords: getopt, optarg, optind, optreset, plain char, unsigned char, char signedness, __CHAR_UNSIGNED__, CHAR_MIN, aarch64, -1 sentinel, usage error, 子命令, 参数解析, e-command, getc, EOF
title: plain char 承接 getopt(3) 返回值：aarch64 上 char 默认无符号，-1 哨兵永不成立，带选项的子命令退化为 usage 报错

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: getopt(3) 返回 int 并用 -1 表示结束，POSIX 要求接收变量为 int；plain char 的符号性由实现定义。OHOS/HarmonyOS aarch64 的 clang 15 下 plain char 无符号（clang -dM -E 含 __CHAR_UNSIGNED__，CHAR_MIN==0）：返回值 -1 存入 char 变为 255，'while ((ch = getopt(...)) != -1)' 恒真；下一次迭代 getopt 仍返回 -1，控制流落入 switch 的 default 分支，直接打印 usage 并退出（若 default 不退出则为死循环）。x86 上 plain char 有符号，同一份源码表现正常，因此该缺陷在移植到 aarch64 时才暴露。
affected_scope: 所有把 getopt(3) 返回值存进 char 的 C 程序（跨架构行为不同）；同类哨兵问题还包括 getc/fgetc/EOF、以及任何用 -1/EOF 作哨兵并存入 plain char 的读取循环
verification_cmd: clang -dM -E - </dev/null | grep -c CHAR_UNSIGNED   # 1=plain char 无符号（本机 aarch64-unknown-linux-ohos clang 15 实测）；grep -nE '^[[:space:]]*char[[:space:]]+[a-zA-Z_]+;' <file>.c 找接收变量并与 getopt 调用点核对；对照运行：未修复时 '-e <subcmd> -s <file>' 打印 usage（探针实测 inner getopt 返回 255 后中断），把变量改为 int 后同一命令正常得到 flag='s'(115)、nfiles=1

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: 把接收 getopt(3) 返回值的变量声明为 int（不要用 -fsigned-char 掩盖符号性差异）
rec_description: 逐处修改 getopt 使用点：char ch -> int ch；若有 optind=0/optreset 的重入逻辑保持原样即可（musl 支持 optind=0 重置，问题不在重置而在哨兵比较）
rec_command: 参考 archives/v/vitunes/2.3/patches/0001-e_commands.c.patch（vitunes 2.3 实测：ecmd_check/ecmd_flush/ecmd_tag 三处）
rec_auto_fix: false
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
# ═══ 元数据 ═══
doc_file: doc/E697.md
last_updated: 2026-10-17
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
