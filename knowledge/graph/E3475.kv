#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E3475
trigger_tool: python|test
phase: testing
error_signature: assert locker_1\.has_lock\(\)|Timed out waiting for (Acquired|Released|Send newline to stdin to acquire)

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               posix, threading, python, testing
match_keywords: process test, startup race, ready, Acquired, Released, fixed sleep, causal ordering, delay injection, assertion AST
title: 多进程锁测试：阶段屏障与受控延迟反证，保留原判定语义

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 父进程用固定休眠推断子进程已就绪或持锁，在负载下会先启动竞争者或先执行断言；启动成功不等于锁已取得，释放命令发送不等于释放完成。
affected_scope: 具有真实子进程、可观测状态及竞争资源的测试辅助协议；已验证 locket/1.0.0 一例，其他库需独立验证。
verification_cmd: sh regression-device.sh (prepare two isolated sources and test tools as documented); python3 -m pytest -v tests

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: ordered-process-phase-barriers-with-delay-falsification
rec_description: 先等 READY，再命令首进程 acquire 并等待 Acquired，才启动竞争者；正向持锁和释放判定等待实际事件。辅助响应有上限且不改产品 timeout。对照延迟实验、全量回归和原测试名/Assert AST 证明语义保留。
rec_command: python3 -m pytest -v tests; conan create . --profile:all <device-profile> --build=never
rec_auto_fix: false
rec_impl: manual-test-helper-protocol

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: retain-failure-until-observable-phase-exists
fallback_description: 若无法观测真实阶段则保留失败并完善辅助协议，不以长 sleep、重试或 skip 声称修复。
fallback_command:
fallback_auto_fix: false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: pytest\.mark\.(skip|xfail)|sleep\([1-9][0-9]*\)
forbid_1_reason: 禁止仅靠跳过或增加固定等待掩盖启动竞态；此模式需人工结合上下文判定。
forbid_1_consequence: 未建立首持锁者到竞争者的因果关系，或未执行原用例。
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
# ═══ 元数据 ═══
doc_file: knowledge/drafts/E429-draft-LK13.md
last_updated: 2026-10-13
source_event: locket 1.0.0 HarmonyOS PC 真机提交前回归 15/16 与 400ms 受控启动延迟对照

