#====================================================================
# E551-draft-PMD1.kv — x86 I/O 端口原语 (outb/inb/iopl) 在 aarch64 上不存在，
#                      且 <sys/io.h> 存在但为空
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E3479
trigger_tool:           clang|gcc|ld
phase:                  compilation
error_signature:        call to undeclared function 'outb'|call to undeclared function 'inb'|call to undeclared function 'iopl'|implicit declaration of function 'out[bw]'|undefined reference to 'outb'|undefined reference to 'iopl'|sys/io\.h:.*empty

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               platform, portability, headers, compilation, architecture
match_keywords:         outb, inb, outw, outl, iopl, ioperm, sys/io.h, x86 I/O port,
                        I/O 端口, 端口读写, aarch64 不支持, 架构守卫, SMI, 背光驱动
title:                  x86 I/O 端口访问驱动在 aarch64 上无法编译：<sys/io.h> 存在但无 outb/inb/iopl

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             x86 专有 I/O 端口原语（outb/inb/iopl/ioperm）在 aarch64 上既无声明也无指令，OHOS sysroot 的 <sys/io.h> 是空文件，于是 `#include <sys/io.h>` 成功但编译报 undeclared function。
                        代码用这些原语（声明来自 <sys/io.h>）直接驱动硬件。
                        aarch64 的 OHOS sysroot **有** <sys/io.h>，但它是空文件——
                        没有这些声明，也没有对应指令（x86 的 in/out 指令在 aarch64 上不存在）。
                        因此 `#include <sys/io.h>` 会成功但编译随即报
                        "call to undeclared function 'outb'"。
affected_scope:         直接读写 I/O 端口的低级驱动（背光/风扇/看门狗/EC 访问等），
                        尤其 x86 笔记本厂商驱动；任何被移植到非 x86 架构的场景。
verification_cmd:       1) grep -rn 'sys/io\.h' <src> 定位引用点;
                        2) cat <sysroot>/usr/include/sys/io.h 确认为空;
                        3) grep -rn '\boutb\b\|\binb\b\|\biopl\b' <src> 列出使用点;
                        4) 非 x86 编译报 undeclared function 'outb'

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           arch-guard-with-substantive-unsupported-path
rec_description:        用**架构能力**宏（__i386__ / __x86_64__）而不是 __OHOS__ 包一层守卫：
                        非 x86 时把端口读写调用编译掉，并让驱动的探测函数如实返回"不支持"
                        （记日志 + 返回 -1），由上层回退到别的后端。守卫分支必须含实质逻辑，
                        不能是空壳 stub（R40）。
rec_command:            #if !defined(__i386__) && !defined(__x86_64__) / # define XXX_NO_PORT_IO 1 / #endif ;
                        在 xxx_probe() 内: #ifdef XXX_NO_PORT_IO -> logmsg(LOG_ERR, "... requires x86 I/O port access, unavailable on this architecture"); return -1; #else -> 原探测逻辑 #endif
rec_auto_fix:           false
rec_impl:               conan-patch

fallback_priority:      2
fallback_approach:      exclude-driver-from-build
fallback_description:   若该驱动在目标平台上完全无意义，可从构建中剔除对应源文件；
                        但必须同时处理符号引用（上层调用点也要条件编译），否则链接报未定义符号。
fallback_command:       # 在 Makefile 的 SOURCES 里条件排除，并在调用点加同样的守卫
fallback_auto_fix:      false
fallback_impl:          conan-recipe-helper

# ★ 禁止策略 ★
forbid_1_pattern:       return 0;\s*/\*\s*(stub|not supported|TODO)
forbid_1_reason:        让 probe() 直接返回"成功"而不做任何事，会让上层以为硬件可用，
                        后续读写得到无意义数据——空壳 stub 被 R40 明确禁止。
forbid_1_consequence:   运行时行为静默错误，且掩盖了平台真实能力，测试无法发现。
forbid_2_pattern:       __asm__\s*\(\s*"out[bwl]
forbid_2_reason:        手写内联汇编模拟 x86 in/out 指令在 aarch64 上无法编码，编译期即失败。
forbid_2_consequence:   引入新的编译错误，问题未解决。

# ═══ Layer 4: 原则引用 ═══
principles:             P012
