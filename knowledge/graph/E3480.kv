#====================================================================
# E550-draft-PMD1.kv — 遗留 Makefile 用 /usr/include 探测 syscall 头文件，
#                      在 OHOS sysroot 下误判缺失 → aarch64 编到 #error 分支
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E3480
trigger_tool:           make|clang|gcc
phase:                  compilation
error_signature:        #error "inotify not supported on this architecture!"|#error Unsupported architecture|error: .*inotify-syscalls\.h|error: .*timerfd-syscalls\.h|__NR_inotify_init.*undeclared

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               detection, portability, syscall, headers, make
match_keywords:         inotify-syscalls.h, timerfd-syscalls.h, NO_SYS_INOTIFY_H,
                        NO_SYS_TIMERFD_H, test -e /usr/include, sys/inotify.h,
                        sys/timerfd.h, 架构不支持, Makefile 头文件探测, sysroot
title:                  遗留 Makefile 探测 /usr/include 而非 sysroot，OHOS 下误判 syscall 头文件缺失

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             老式 Makefile 用构建机绝对路径 `/usr/include` 探测头文件是否存在，在 sysroot 化的 OHOS 上误判缺失，从而编到 aarch64 不支持的 syscall shim 分支。
                        常见写法：`INOTIFY_CFLAGS = $(shell test -e
                        /usr/include/sys/inotify.h || echo -DNO_SYS_INOTIFY_H)`。
                        OHOS 的工具链头文件在 sysroot（如
                        <sdk>/native/sysroot/usr/include）里，`/usr/include` 下并不存在，
                        于是 make 误判为"平台没有该头文件"，加上 -DNO_SYS_*，
                        源码随即 include 上游自带的 syscall 编号 shim
                        （inotify-syscalls.h / timerfd-syscalls.h）——这些 shim 只写了
                        x86/ppc/ia64/s390/alpha/sparc/arm/sh/hppa/mips 分支，
                        aarch64 直接落到 #else → #error 编译失败。affected_scope:         用 Makefile 且通过 `test -e /usr/include/...` / `[ -f /usr/include/... ]`
                        探测头文件的 C/C++ 项目；在交叉编译或头文件位于 sysroot 的平台
                        （OHOS、sysroot 化发行版）上必然误判。
verification_cmd:       1) grep -n 'test -e /usr/include' Makefile* 定位探测点;
                        2) `test -e /usr/include/sys/inotify.h; echo $?` 在本机应为非 0;
                        3) 确认 sysroot 里存在：`ls <sysroot>/usr/include/sys/{inotify,timerfd}.h`;
                        4) 编译日志出现 `#error "inotify not supported on this architecture!"`

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           override-make-variable-from-recipe
rec_description:        不改 Makefile：在构建命令里**用命令行变量覆盖**探测结果。
                        GNU make 命令行赋值优先级高于 makefile 内部赋值，因此
                        `make INOTIFY_CFLAGS= TIMERFD_CFLAGS=` 会清空那两个变量，
                        使源码头文件走真实 sysroot 的 <sys/inotify.h>/<sys/timerfd.h>，
                        完全无需 patch。
rec_command:            make -j1 -C <dir> INOTIFY_CFLAGS= TIMERFD_CFLAGS=
rec_auto_fix:           false
rec_impl:               conan-recipe-build-flags

fallback_priority:      2
fallback_approach:      patch-makefile-detection
fallback_description:   若探测结果被写进多个变量或参与条件分支，直接 patch Makefile：
                        把 `test -e /usr/include/...` 改成 pkg-config/编译器自带的
                        `$(CC) -E` 探测，或改为无条件使用系统头文件。
fallback_command:       INOTIFY_CFLAGS = $(shell $(CC) -E - </dev/null -include sys/inotify.h >/dev/null 2>&1 || echo -DNO_SYS_INOTIFY_H)
fallback_auto_fix:      false
fallback_impl:          conan-patch

# ★ 禁止策略 ★
forbid_1_pattern:       mkdir -p /usr/include/sys && (cp|ln).*inotify\.h
forbid_1_reason:        往构建机的 /usr/include 里塞头文件，污染共享文件系统（E524 同类问题），
                        在 CI 干净 worker 上不存在 → 本地绿、CI 红。
forbid_1_consequence:   本地编译通过、CI 必然失败；且可能影响同机其他包的编译。
forbid_2_pattern:       -DNO_SYS_INOTIFY_H|-DNO_SYS_TIMERFD_H
forbid_2_reason:        显式定义 NO_SYS_* 会强制走 aarch64 不支持的 syscall 编号 shim，
                        是错误方向而非修复。
forbid_2_consequence:   编译必在 syscall shim 的 #error 处失败。

# ═══ Layer 4: 原则引用 ═══
principles:             P012
# ═══ 关系图 (Relations) ═══
