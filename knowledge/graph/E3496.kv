#====================================================================
# E549-draft — raw makefile 多目录仓库 + release tarball 适配模式：
#   (1) Makefile 内嵌 git 探针（GIT_VERSION=$(shell git describe)）
#       在 release tarball（无 .git）中报错/产出空版本宏
#   (2) init-build F068 嵌套源码提升对 C 多目录仓库的边界扩展
#       （software/examples/libinfnoise 被提升为源码根，兄弟目录
#        software/、tests/ 全部丢失）
# 来源: infnoise 0.3.3 适配 (2026-10-14)
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E3496
trigger_tool:           make|git|ohc-run.py
phase:                  source|compilation|extract
error_signature:        fatal: not a git repository|GIT_VERSION=|GIT_COMMIT=|git describe|嵌套源码检测: 找到源码在 software/examples|\.work 目录只有 [0-9]+ 个文件|Only in .*\.orig.*libinfnoise

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               portability, build-system, packaging
match_keywords:         raw makefile, git probe, git describe, GIT_VERSION, release tarball, no .git, nested source, promote, multi-directory repo, software/, tests/, strip_root, codeload, Makefile.linux, F068, infnoise, 多目录仓库
title: raw makefile 多目录仓库适配: Makefile git 探针固定 + init-build F068 嵌套提升边界

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >
  两个独立问题叠加在多目录仓库 + raw makefile 软件上:
  (1) Makefile 内嵌 $(shell git describe --tags) / git rev-parse 探针用于生成
      GIT_VERSION/GIT_COMMIT/GIT_DATE 宏——官方 release tarball 不包含 .git 目录，
      探针在 make 解析期报 "fatal: not a git repository"，且 GIT_VERSION 等宏为空字符串，
      -DGIT_VERSION=\"\" 破坏版本输出/诊断信息（--version 显示空版本）。
  (2) init-build 的 _promote_nested_source 按 C/C++ 构建标记（configure/CMakeLists.txt/
      Makefile/meson.build）递归识别"源码子目录"；多目录仓库（顶层同时含 software/、
      tests/、kicad/、eagle/、images/ 等硬件设计与文档目录）中 software/examples/libinfnoise
      含 Makefile，被误提升为源码根，导致 work 目录只剩该子目录 7 个文件，
      software/ 主体（daemon.c/infnoise.c/libinfnoise.c/tests 209 文件）全部丢失。
affected_scope: >
  所有用 raw POSIX Makefile（非 autotools/cmake/meson 生成）构建、且源码树顶层为
  多目录结构（主代码在子目录、顶层含其他非构建目录）的软件；典型如硬件驱动/工具类
  仓库（infnoise、及其他含 examples/ 子项目 + 主代码子目录的仓库）。Makefile 内嵌
  git 探针的仓库在 release tarball 适配时普遍受影响。
verification_cmd: >
  cd $REPO_DIR && grep -n "GIT_VERSION.*git" software/Makefile.linux &&
  python3 scripts/ohc-run.py conan-verify infnoise 0.3.3 2>&1 | grep -E "G2.*PASS|Error"
  # 探针修复后 make 输出不再有 "fatal: not a git repository"，GIT_VERSION 固定为 0.3.3
rec_priority:           1
rec_approach:           git-probe-pin-plus-tarball-full-rebuild
rec_description: >
  两步修复：(1) 用补丁把 Makefile 内嵌 git 探针替换为固定版本字符串
  （GIT_VERSION ?= 0.3.3 等，支持环境覆盖），消除 release tarball 无 .git 报错；
  (2) F068 嵌套提升截断后，从官方 tarball 全量解压重建 .orig/.work 完整结构
  （339 文件），再重新应用补丁——不得依赖 init-build 的目录推断。
rec_command: >
  # 1) 补丁 Makefile.linux: GIT_VERSION := $(shell git ...) 改为 GIT_VERSION ?= 0.3.3
  # 2) FULL=$(tar -xzf 官方tarball); rm -rf .orig .work; cp -a $FULL .orig; cp -a $FULL .work
  # 3) cd .work && patch -p1 -s < archives/.../patches/0001-*.patch
  # 4) 重建后 diff -rq .orig .work 应仅剩 Makefile.linux 差异
rec_auto_fix:           false
rec_impl:               manual

# 回退方案
fallback_priority:      2
fallback_approach:      git-clone-full
fallback_description:   探针问题可用完整 git clone（含 .git）替代 tarball 规避，但 CI/R36 要求官方 tarball 来源，故仅作本地探索手段。
fallback_command:       git clone --depth=1 https://github.com/leetronics/infnoise
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 ★
forbid_1_pattern:       平台宏兜底（#ifdef __OHOS__ 之类）|sed -i.*Makefile.linux.*git
forbid_1_reason:        根因是 release tarball 无 .git 与目录结构推断，与平台无关；R8 禁止补丁平台宏；直接 sed 修改 Makefile 绕过补丁管线会丢失审计。
forbid_1_consequence:   CI W3/JC 拦截补丁非补丁管线生成，或平台宏误伤其他平台构建。
forbid_2_pattern:       在 work 残留目录上直接 refresh-patch --auto 再提交
forbid_2_reason:        F068 截断后 work 只剩 7 文件，若直接跑 refresh-patch 会生成 13 个误补丁（把后来手工拉取的 submodule 内容也打进去），且 conandata 声明的 0001 补丁路径与实际文件失配（E515 BadZipFile/patch missing）。
forbid_2_consequence:   conan-verify G2 失败、W3 JC 拦截、补丁失配连锁错误。

# ═══ Layer 4: 原则引用 ═══
principles:             P001, P011
