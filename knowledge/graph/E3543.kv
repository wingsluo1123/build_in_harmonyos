#====================================================================
# DRAFT-autotools-pkgincludedir-absolute-header-relocation
# Custom Autotools header installation must not bake absolute pkgincludedir into includes
#
# This entry is a draft and does not reserve a formal E-number or claim promotion.
#====================================================================

id:                     E3543
trigger_tool:           conan|autoconf|automake|make|clang
phase:                  install|package|compilation
error_signature:        '#include.*"/.*(include|headers)/.*\.hpp|header.*absolute.*pkgincludedir|package.*relocat.*include.*fail'
severity:               2
category:               headers, autotools, conan, packaging, relocatability
match_keywords:         pkgincludedir, install-data-local, installed headers, absolute include path, Conan package relocation, Autotools, same-directory include
title:                  Keep custom Autotools installed-header includes relative to avoid baking pkgincludedir into packages
root_cause:             A hand-written install-data-local rule rewrites every quoted include to include $(pkgincludedir). Since configure resolves the install prefix to an absolute Conan package folder, installed headers retain that build-time package path. A consumer can compile while the package remains at that exact location, but package relocation leaves internal header includes pointing at the old prefix. DESTDIR staging does not rewrite the configured prefix embedded in header text.
affected_scope:         Autotools projects with custom header install rules that sed-rewrite same-directory includes using pkgincludedir or another absolute configured include directory, especially binary package caches and deployment workflows that relocate package folders.
verification_cmd:       Inspect the installed public headers for include directives beginning with an absolute path; move or copy the package to a different prefix and compile a minimal consumer that includes the umbrella header.

rec_priority:           1
rec_approach:           keep-installed-header-includes-relative
rec_description:        Preserve co-located header include basenames during installation. Rewrite only the generated config.h reference to a package-specific config header, expose the installed include root through package metadata, and add a fail-closed scan for absolute include directives.
rec_command:            sed -e 's%#include "config.h"%#include "libthreadar_config.h"%g' source.hpp > package/include/pkg/source.hpp; scan installed .h/.hpp files for absolute #include paths; compile a consumer after relocating the package prefix
rec_auto_fix:           false
rec_impl:               source-patch|conan-recipe-package-check

fallback_priority:      2
fallback_approach:      rewrite-at-package-time
fallback_description:   If upstream build files cannot be patched, rewrite only same-directory absolute include prefixes in staged package headers to relative basenames and verify no configured prefix remains.
fallback_command:       Rewrite a narrowly matched $(pkgincludedir) include prefix in staged headers, then scan and compile after relocation.
fallback_auto_fix:      false
fallback_impl:          conan-package-step

forbid_1_pattern:       hardcode.*absolute.*pkgincludedir.*(header|include)
forbid_1_reason:        The installed header stores the configured package-folder prefix as source text.
forbid_1_consequence:   Consumers fail to compile after the Conan package directory is moved or reinstalled at another path.
forbid_2_pattern:       strip.*all.*include.*path|remove.*all.*quoted.*include
forbid_2_reason:        Public headers still depend on same-directory sibling headers and the generated configuration header.
forbid_2_consequence:   Umbrella-header consumers fail with missing sibling/configuration headers.

principles:             P016
doc_file:               drafts/DRAFT-autotools-pkgincludedir-absolute-header-relocation.md
last_updated:           2026-10-18
source_event:           libthreadar 1.6.1 HarmonyOS PC dependency adaptation, task #14347
authors:                iKalous_OscarP
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.65
metrics_last_used:      2026-10-17

