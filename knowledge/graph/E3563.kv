#====================================================================
# DRAFT-gnu-efi-4.0.4-raw-makefile-installroot-prefix-and-version-drift
#   手写 Makefile 的「双前缀 install」+ 生成物不随 install 重生成 + in-tree VERSION 漂移
# 来源: gnu-efi 4.0.4 适配（2026-10-16, 主理-5 链路）
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E3563
trigger_tool:           make|conan
phase:                  installation|packaging
error_signature:        "(package_folder)/usr/local/lib|/usr/local/include/.*自 INSTALLROOT|pkg-config.*--modversion.*版本不符|Version: [0-9.]+.*≠.*tag 版本"

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               build-system, make, pkg-config, packaging, versioning
match_keywords:         INSTALLROOT, DESTDIR, PREFIX, /usr/local, make install, 双前缀,
                        gnu-efi.pc, pkg-config, 陈旧元数据, stale, VERSION 变量,
                        in-tree 版本漂移, tag 与 VERSION 不一致, package_folder/usr/local
title:                  手写 Makefile 用 INSTALLROOT+PREFIX 双层前缀（DESTDIR 只是回退）且
                        .pc 在 make 阶段生成 ⇒ 打包必须 INSTALLROOT=<pkgdir> PREFIX=/ 同传，
                        并单独核对生成的 .pc 前缀与 VERSION
prescan_pattern:        INSTALLROOT|DESTDIR.*PREFIX|@VERSION@|\.pc\.in
prescan_globs:          Makefile,Make.defaults,*Makefile*,*.pc.in

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >
  gnu-efi 的手写 Makefile 把安装根拆成两层：`INSTALLROOT`（未定义时回退到 `DESTDIR`）
  只提供**外层根**，而 `LIBDIR := $(EXEC_PREFIX)/lib`、`INCLUDEDIR := $(PREFIX)/include`
  仍挂死在**内层**硬编码 `PREFIX := /usr/local` 上，安装规则写的是
  `$(INSTALL) -m 644 libefi.a $(INSTALLROOT)$(LIBDIR)`。因此只按 Conan 惯例传
  `DESTDIR=<package_folder>`（或只传 `INSTALLROOT=<package_folder>`）时，产物会落到
  `<package_folder>/usr/local/{lib,include,lib/pkgconfig}` —— 与 Conan 期望的
  `<package_folder>/{lib,include}` 差一层，`cpp_info` 路径全错、下游找不到头/库。
  同类第二处：`gnu-efi.pc` 由 `make`（而非 `install`）的 `gnu-efi.pc:` 规则生成，
  `install` 目标**不依赖**它；先 `make` 后 `make install PREFIX=…` 时 `make` 不会
  重跑该规则，装出的是**上一轮前缀**的 .pc（陈旧 pkg-config 元数据，实测 prefix/libdir
  仍为 /usr/local）。第三处：`Makefile: VERSION = 4.0.3` 与发布 tag `4.0.4` 漂移，
  `@VERSION@` 被塞进 .pc 的 `Version:` ⇒ 装出来的 pkg-config 报错版本。
affected_scope:         手写 Makefile / 非 autotools 项目；安装规则用 INSTALLROOT 或
                        DESTDIR 但 LIBDIR/INCLUDEDIR 挂在硬编码 PREFIX 上的包；
                        以及把版本号写进 in-tree 变量而非由 tag/构建系统注入的包。
verification_cmd:       ( set -eu; PKG=gnu-efi; VER=4.0.4; T1="$(mktemp -d)"; T2="$(mktemp -d)";
                        cd "$(mktemp -d)"; make -s -j4 ARCH=aarch64 CC=clang HOSTCC=clang AS=clang
                        LD=ld.lld AR=llvm-ar RANLIB=llvm-ranlib OBJCOPY=objcopy INSTALL=ginstall;
                        make -s ARCH=aarch64 CC=clang HOSTCC=clang AS=clang LD=ld.lld AR=llvm-ar
                        RANLIB=llvm-ranlib OBJCOPY=objcopy INSTALL=ginstall install DESTDIR="$T1"
                        >/dev/null 2>&1 || true; find "$T1" -maxdepth 3 -type d | sed "s|$T1||";
                        make -s ARCH=aarch64 CC=clang HOSTCC=clang AS=clang LD=ld.lld AR=llvm-ar
                        RANLIB=llvm-ranlib OBJCOPY=objcopy INSTALL=ginstall install
                        INSTALLROOT="$T2" PREFIX=/ >/dev/null 2>&1; find "$T2" -maxdepth 2 -type d
                        | sed "s|$T2||"; grep -E '^(prefix|libdir|includedir|Version)' "$T2"/lib/pkgconfig/gnu-efi.pc )

# ═══ Layer 3: 修复层 (Remediation) ═══
rec_approach:           makefile-installroot-plus-empty-prefix-then-relocate-pc
rec_description:        Conan 配方 package() 同传「外层根=package_folder」与「内层空前缀」：
                        `make install INSTALLROOT="<package_folder>" PREFIX=/` ⇒ 产物直接落在
                        <package_folder>/{lib,include,lib/pkgconfig}。再把装出来的 .pc 改写成
                        可重定位形式（`prefix=${pcfiledir}/../..`），不要留在包里写死构建期
                        绝对路径；安装布局核对用 `find <pkg> -maxdepth 2 -type d`。
rec_command:            make install INSTALLROOT="$(pwd)/pkg" PREFIX=/ ARCH=aarch64 CC=clang HOSTCC=clang AS=clang LD=ld.lld AR=llvm-ar RANLIB=llvm-ranlib OBJCOPY=objcopy INSTALL=ginstall
fallback_approach:      destdir-then-move-usr-local
fallback_description:   若上游 install 规则不可改（例如还把 INSTALLROOT 当相对路径拼），退化为
                        仍传 DESTDIR=<pkgdir>，再在 package() 里把 <pkgdir>/usr/local/{lib,include}
                        整体搬到 <pkgdir>/ 根下；搬迁后务必复跑包内测试（pkg-config/链接）确认
                        没有残留的 /usr/local 绝对引用。
fallback_command:       cp -a "$PKG/usr/local/." "$PKG/" && rm -rf "$PKG/usr/local"
# ═══ Layer 4: 证据层 (Evidence) ═══
  - "手写 Makefile 且安装规则形如 $(INSTALLROOT)$(LIBDIR) 的项目"
  - "LIBDIR/INCLUDEDIR 由硬编码 PREFIX 派生（PREFIX := /usr/local）的项目"
  - "把 @VERSION@ 等元数据在 make 阶段生成、install 阶段不再重生成的项目"
rec_auto_fix:               false
rec_impl:               manual
rec_priority:               1
last_updated:               2026-10-19
authors:               unknown
doc_file:               doc/E3563.md
