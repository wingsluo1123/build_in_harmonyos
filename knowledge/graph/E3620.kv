#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E3620
trigger_tool:           configure|cmake|meson|make|gcc|clang|ld|python|pip|install|test|runtime
phase:                  configuration|compilation|linking|installation|testing|runtime
error_signature: cpp_info.libs = ["<包名>"]|No rule to make target.*<包名>|cannot find -l<包名>

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               packaging, recipe
match_keywords:         cpp_info.libs, cmake_target_name, cmake_file_name, conan-init, package name, lib name, newuoa, target not found, cannot find -l
title: conan-init 按包名生成 cpp_info.libs 与库名不一致时的配方修正

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: conan-init 模板按包名({name})推断 cpp_info.libs 与默认 CMake target 名；当仓库/包名与上游 CMake 项目目标名不一致（如 newuoa-cpp 包的产物是 libnewuoa.a / newuoa::newuoa）时生成错误库名，导致下游链接失败
affected_scope: 包名与 CMake 目标名不一致的 CMake 库（repo 名带 -cpp/-c 等后缀）
verification_cmd: conan create 后检查 lib 文件名与 CMakeDeps 生成 target；消费者 test_package 链接实际 target 并运行

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: 按实际 CMake 产物修正 package_info：cpp_info.libs=[实际库名]，cmake_target_name=实际 target，cmake_file_name 保持包名（find_package 名称）
rec_description:        以 newuoa-cpp 0.1.2 实证：conan-init 生成 cpp_info.libs=["newuoa-cpp"] 但实际产物是 libnewuoa.a、CMake 目标 newuoa::newuoa；修正为 libs=["newuoa"] + set_property("cmake_file_name","newuoa-cpp") + set_property("cmake_target_name","newuoa::newuoa")
rec_command:            self.cpp_info.libs = ["<实际库名>"]; self.cpp_info.set_property("cmake_file_name", "<包名>"); self.cpp_info.set_property("cmake_target_name", "<包名>::<实际target>")
rec_auto_fix:           false
rec_impl:

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
# ═══ 元数据 ═══
doc_file:               doc/E429.md
last_updated: 2026-09-29
source_event:           newuoa-cpp 0.1.2 R01 适配 (conan-init 后 cpp_info.libs 误写为 newuoa-cpp，conan create 之前人工修正)

# ═══ 知识协作 (Authorship & Provenance) ═══
