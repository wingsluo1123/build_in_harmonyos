# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E3623
trigger_tool: runtime|test
phase: runtime|testing
error_signature: panel_destroyed.*inputStop|inputStop.*panel_destroyed|Old session cleanup incomplete

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category: ohos, portability, testing, lifecycle
match_keywords: HarmonyOS, OpenHarmony, InputMethodExtensionAbility, inputStop, panel_destroyed, TextInput focus
title: HarmonyOS 6.1 IME inputStop callback omitted during TextInput handoff

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: On the tested HarmonyOS 6.1 device, moving focus to another real TextInput destroyed the old IME panel without emitting inputStop; stopEditing or stopInputSession return values alone did not prove session closure. The device emitted repeated same-run focus lifecycle markers, but a runner that de-duplicates identical JSON records can discard the second valid interaction unless markers carry an increasing sequence or interaction identifier.
affected_scope: HarmonyOS Stage-model IME lifecycle acceptance and session restart tests on HarmonyOS 6.1
verification_cmd: Run the signed device harness; correlate old session token, TextInput focus callback and panel_destroyed before requiring a distinct new input_start/create/show token and reset Shift UI.

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: verify-client-handoff-and-old-panel-destruction
rec_description: Use a second real TextInput to trigger client handoff; require successful focus evidence, old-token panel_destroyed, and a distinct replacement input_start with panel create/show and rendered reset UI. HarmonyOS 6.1 may report replacement input_start before old-panel destruction, so require old destroy before replacement panel create/show rather than before input_start. For terminal cleanup, arm the trace before input and request focus to the second TextInput programmatically. Give repeated markers a monotonic sequence or interaction identifier. If inputStop is emitted, additionally require it precede panel destruction.
rec_command: python run_harmonyos_device_test.py
rec_auto_fix: false
rec_impl: none

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: stopEditing\(\).*inputStop|stopInputSession\(\).*inputStop
forbid_1_reason: An API return value does not establish that the platform emitted an inputStop callback or destroyed the old panel.
forbid_1_consequence: Lifecycle tests can pass while the old session or panel remains active, or can fail on a valid HarmonyOS client handoff that omits inputStop.
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

