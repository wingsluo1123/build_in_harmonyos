# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E3656
trigger_tool: clang
phase: compilation
error_signature: SVE support not enabled|src_port_pg_popcount_aarch64

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category:               compat, detection, portability, build-system
match_keywords: SVE support not enabled,USE_SVE_POPCNT_WITH_RUNTIME_CHECK,POPCNT_AARCH64,__ARM_NEON,pg_popcount_aarch64,libpg_query
title: Extracted vendor CPU feature config selects an incomplete SVE/NEON branch on baseline AArch64

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: The release bundles generated target feature configuration and AST-extracted vendor sources; compiler NEON detection selects a unit with inherited SVE configuration and omitted unused helper bodies.
affected_scope: Extracted PostgreSQL-derived parser libraries and release bundles carrying preconfigured CPU feature branches, when a complete portable fallback is present.
verification_cmd: Inspect pg_config.h and pg_bitutils.h; compile baseline AArch64; compare native upstream tests before and after selecting the portable implementation.

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: verify-extracted-feature-closure-before-selecting-portable-fallback
rec_description: Trace architecture macros, generated capability claims and retained function bodies together; use the existing portable implementation without increasing the target ISA.
rec_command: Append -U__ARM_NEON to the private build CFLAGS only after verifying the complete portable implementation.
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach: regenerate-complete-vendor-source-and-capability-detection
fallback_description: If the portable implementation is incomplete or performance requirements forbid fallback, regenerate the upstream vendor source/configuration for the target and validate its complete optimized branch.
fallback_command:
fallback_auto_fix:      false
fallback_impl: manual

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: -march=.*sve
forbid_1_reason: Raising the target ISA before verifying retained optimized function bodies does not repair an extracted-source closure.
forbid_1_consequence: Build errors may turn into undefined functions or unsupported target instructions.
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

