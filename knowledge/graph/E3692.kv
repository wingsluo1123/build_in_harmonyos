#====================================================================
# E2296-draft-7D29.kv — KF6 6.18 闭包 registry 二进制漂移（Missing packages: kiconthemes）
# 由 lskat 26.04.0 适配过程产生（conan graph info 阶段实测）
# 对应人类文档: knowledge/drafts/E2296-draft-7D29.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E3692
trigger_tool:           conan
phase:                  configuration
error_signature:        Missing packages: kiconthemes | WARN: There are some error\(s\) in the graph

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               compat, build-system, cmake, conan, dependency
match_keywords:         Missing packages, kiconthemes, karchive, conan graph info, package_id, KF6 6.18, libkdegames
title:                  KF6 6.18 闭包 registry 二进制漂移导致 conan graph 报 Missing packages: kiconthemes

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             registry 上同名同版本包的**二进制**被后续重建为依赖另一条 karchive 版本线（kiconthemes/6.18.0 → karchive/6.19.0），而 KF6 6.18 闭包其余成员（knewstuff/6.18.0、kxmlgui/6.18.0）仍按 karchive/6.18.Z 解析；配方按 libkdegames 闭包 pin karchive/6.18.0 后，kiconthemes/6.18.0 计算出的 package_id 在制品仓不存在 → graph 报 Missing packages（注意：不是版本冲突，recipe 与 binary 都存在，只是 package_id 对不上）
affected_scope:         所有引用 libkdegames/26.04.0(.1) + KF6 6.18 线且需要 kiconthemes 的 KDEGames6 应用（lskat、kbreakout、kfourinline、kgoldrunner、knavalbattle、kjumpingcube 在当前 registry 状态下均复现）；同类模式适用于任何「同一版本包被重建、依赖线变更」的 registry 漂移
verification_cmd:       conan graph info <recipe> -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 --format=text | grep -A2 'Missing packages'

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           pin-karchive-618Z-built-kiconthemes-revision
rec_description:        选与 karchive 6.18.Z 同源构建的修订 kiconthemes/6.18.0.1 并 override=True，
                        使 kxmlgui/knewstuff 的 6.18.Z 区间解析统一落到该修订，graph 复原为 0 missing
rec_command:            self.requires("kiconthemes/6.18.0.1", override=True)
rec_auto_fix:           false
rec_impl:               conanfile.requirements() 显式 pin + override；定版前先用
                        conan list "kiconthemes/6.18.0.1:*" -r=ohpcd 核对二进制的 requires 是否含 karchive/6.18.Z

fallback_priority:      2
fallback_approach:      bump-whole-kf6-line
fallback_description:   若 6.18.Z 线无可用修订，则整体升级 KF6 到 6.26 线，并同步重建/重新发布 libkdegames
                        二进制（属 R36 依赖链重建，需按 A→B→C 拓扑序发布后才可继续）
fallback_command:       conan list "kiconthemes/*:*" -r=ohpcd   # 逐修订核对 requires
fallback_auto_fix:      false
fallback_impl:          仅在 6.18 线确实无解时使用；会改动下游全部 package_id

# ★ 禁止策略 ★
forbid_1_pattern:       \-\-build=missing
forbid_1_reason:        R36：依赖必须先发布；用源码重建依赖既掩盖 registry 漂移，又拉长 CI 时间
forbid_1_consequence:   CI 超时/失败，且 create-pr 的 PF4 依赖闸与 L0i 会拦截
forbid_2_pattern:       Missing packages.*ignore
forbid_2_reason:        把 graph 缺包当警告忽略会在 conan create 阶段以更晦涩的链接/配置错误复发
forbid_2_consequence:   浪费整轮 CI，且错误定位成本翻倍

# ═══ Layer 4: 原则引用 ═══
principles:

# ═══ 关系图 (Relations) ═══
# ═══ 元数据 ═══
doc_file:               knowledge/drafts/E2296-draft-7D29.md
last_updated:           2026-10-18
source_event:           lskat 26.04.0 conan graph info: WARN .. Missing packages: kiconthemes（62 节点图，
                        其余依赖齐备）；conan list "kiconthemes/6.18.0:*" 显示该二进制 requires
                        karchive/6.19.0，而 knewstuff/6.18.0 要求 karchive/6.18.Z；改 pin
                        kiconthemes/6.18.0.1 后 0 missing，conan create 成功

