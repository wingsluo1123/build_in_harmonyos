#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E9945.kv，填写各字段
# 对应的人类文档: doc/E9945.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E858
trigger_tool:           conan|cmake|clang
phase:                  configuration|compilation|linking
error_signature:        package_type 'application' is defined|fatal error: 'jellyfish/atomic_gcc.hpp' file not found|CMakeDeps.*empty

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               headers, cmake, linking, conan, packaging
match_keywords:         package_type, application, dependency traits, headers=True, libs=True, CMakeDeps, empty imported target
title:                  已发布混合 CLI/库依赖的下游显式 traits 修复边界

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             上游包真实安装公开头和库且 cpp_info 正确，但 package_type=application 的默认 dependency traits 屏蔽了 headers/libs；CMakeDeps 的目标存在却无所需 include/link 数据。已经发布的上游不能被下游擅自重写或重新上传。
affected_scope:         Conan 2 下游消费已发布、同时含 CLI 和公开开发库、但仍按 application 建模的依赖；安装物和 ABI 必须已真实确认。
verification_cmd:       对比修复前后 CMakeDeps target 数据和 compile/link 命令；不硬编码 -I/-L/-l，仅链接 imported target，原生 conan create 执行全量上游及安装消费者。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           explicit-downstream-header-library-traits
rec_description:        先确认发布包真实含公开头/库且 cpp_info 完整；仅在下游的 requires 明确 headers=True, libs=True，使 CMakeDeps 消费这些已有安装物，保留 CLI 能力和上游不可变版本。不将此修复推广到 CLI-only 包或 cpp_info 缺失的包。
rec_command:            self.requires("dependency/version", headers=True, libs=True)
rec_auto_fix:           false
rec_impl:               manual-conan-recipe

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       target_link_libraries.*-[lL]|link_directories|绝对缓存.*include
forbid_1_reason:        硬编码路径掩盖依赖传播缺陷并把包缓存位置烤死。
forbid_1_consequence:   同一机器假通过，换 worker 或缓存路径失败。
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
# ═══ 元数据 ═══
doc_file:               doc/E9945.md
last_updated: 2026-10-11
source_event:           quorum 1.1.2 W3 r2 missing header -> r3 full production build -> r6 upstream 4/4 consumer 8/8 W3_PASS; log SHA256 82322c35f10b6e1ca8cfbe14b970f88becec925443d99ec6977a3379875ef4cb

# ═══ 知识协作 (Authorship & Provenance) ═══
