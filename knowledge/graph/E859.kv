# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 子串(|分隔), 按实际消费入口匹配日志文本
id:                     E859
trigger_tool: python
phase: testing
error_signature: test_good_port_ranges_unordered_set - assert []|assert [] == [(1003, 1036)]

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category:               compat, portability
match_keywords: test_good_port_ranges_unordered_set - assert []
title: 无序集合进入连续整数分组导致合法区间被长度过滤误丢

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: port-for1.0.0的good_port_ranges将set无排序转list；to_ranges按enumerate的value-index分组，连续整数必须已按数值递增。set迭代折返会把同一合法连续区间拆成短段，再被min_range_len加双border的过滤丢弃。
affected_scope: port-for1.0.0及使用index-value分组后按长度筛选的无序整数集合；集合本身无序并非错误，分组器的有序前置条件被违反。已在OHOS6/armv8/Python3.12.9实测原缺陷和修后套件/消费者；补准确官方输入后正式W3通过，裸CLI smoke失败后skip与整体finish归档失败另记。
verification_cmd: python -m pytest tests/test_cases.py::test_good_port_ranges_unordered_set -ra

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: sort-before-adjacency-grouping
rec_description: 在good_port_ranges调用to_ranges前以sorted(ports)替代list(ports)。保留范围包含/border/最小长度/长区间排序及socket探测策略；追加1条回归，不删改原断言。
rec_command: patch -p1 < patches/0001-sort-port-set-before-range-grouping.patch
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

