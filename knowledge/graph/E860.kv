#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E9121.kv，填写各字段
# 对应的人类文档: doc/E9121.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E860
trigger_tool: configure && make（程序启动时 init_buffers/open_sbuf）
phase: runtime
error_signature: /tmp/ed.XXXXXXXXXX: Read-only file system

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category: environment
match_keywords: /tmp, TMPDIR, EROFS, Read-only file system, mkstemp, scratch file, init_buffers, open_sbuf, erofs, 只读
title: HarmonyOS PC /tmp 为只读挂载：硬编码 /tmp 的 scratch 文件目录使程序完全不可用

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: HarmonyOS PC 的 /tmp 是 erofs 只读挂载（/proc/mounts: /dev/block/dm-0 /tmp erofs ro），且 /var/tmp、/dev/shm、/data/local/tmp 同样不可写。上游 oed 的 buf.c 把 scratch 文件模板编译期写死为 /tmp/ed.XXXXXXXXXX，而 init_buffers() 在启动时无条件调用 open_sbuf()，mkstemp() 必然失败，故 ed 在解析任何用户命令之前就以非零码退出，工具完全不可用。
affected_scope: 所有把临时/scratch 目录硬编码为 /tmp 的 C/C++ 程序在 HarmonyOS PC 上运行时
verification_cmd: printf ',p\nq\n' | ed -s file; echo $?   # 修复前报 Read-only file system 且 rc=2

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: 补丁：scratch 目录改为候选链回退
rec_description: 把编译期常量拆成目录+模板名，缓冲放大到 PATH_MAX，open_sbuf() 依次尝试 $TMPDIR → 编译期内置目录 → $HOME，第一个 mkstemp() 成功的即采用；不含平台宏，/tmp 可写平台行为不变。
rec_command:            export TMPDIR="$HOME/tmp" && ed -s file（或在配方里把候选链打进去）
rec_auto_fix: false
rec_impl: 见 archives/o/oed/7.4/patches/0001-buf.c.patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

