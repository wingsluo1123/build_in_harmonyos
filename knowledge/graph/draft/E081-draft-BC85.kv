#====================================================================
# E081.kv — lld 链接器找不到 libxml2.so.16
#====================================================================

id:                     E081
title:                  lld 链接器找不到 libxml2.so.16，编译器无法创建可执行文件
trigger_tool:           configure|clang|cmake
phase:                  configuration
error_signature:        Error loading shared library libxml2.so.16.*lld|
                         C compiler cannot create executables.*clang|
                         unable to execute command.*lld.*signal

severity:               2
category:               toolchain|linker|environment
match_keywords:         lld, libxml2, LD_LIBRARY_PATH, SDK, llvm, linker, C compiler cannot create executables

root_cause:             鸿蒙 SDK 的 lld 链接器位于 llvm/bin/lld，其 RUNPATH 设置为 $ORIGIN/../lib，
                         依赖 libxml2.so.16。虽然 SDK 的 llvm/lib 目录中有 libxml2.so.16，
                         但由于环境变量未正确设置，lld 在运行时找不到该库，导致链接失败。
                         错误表现为 configure 检测"C compiler cannot create executables"。

affected_scope:         所有使用 clang 编译器的软件编译，特别是 autotools 和 cmake 项目
verification_cmd:       echo '#include <stdio.h>' > $TMPDIR/test.c &&
                         echo 'int main() { return 0; }' >> $TMPDIR/test.c &&
                         clang $TMPDIR/test.c -o $TMPDIR/test &&
                         file $TMPDIR/test

rec_priority:           1
rec_approach:           set-env-var
rec_description:        在编译前将 SDK 的 llvm/lib 目录添加到 LD_LIBRARY_PATH：
                         export LD_LIBRARY_PATH=/data/service/hnp/ohos-sdk.org/ohos-sdk_26.0.0.18/ohos/native/llvm/lib:$LD_LIBRARY_PATH
                         然后重新运行 configure 或 cmake。
rec_command:            export LD_LIBRARY_PATH=/data/service/hnp/ohos-sdk.org/ohos-sdk_26.0.0.18/ohos/native/llvm/lib:/storage/Users/currentUser/usr/local/lib:$LD_LIBRARY_PATH
rec_auto_fix:           true
rec_impl:               set-env-var

fallback_priority:      2
fallback_approach:      use-gnu-ld
fallback_description:   如果仍有问题，尝试使用 GNU ld 链接器替代 lld：
                         clang -B/data/service/hnp/bin/ ...
fallback_command:       clang -B/data/service/hnp/bin/ ...
fallback_auto_fix:      false

forbid_1_pattern:       在未设置 LD_LIBRARY_PATH 的情况下直接运行 clang
forbid_1_reason:        lld 链接器依赖 libxml2.so.16，找不到库会导致链接失败
forbid_1_consequence:   configure 检测失败，无法创建可执行文件
principles:             P-TOOLCHAIN-001

causes:                 []
caused_by:              []
similar_to:             [E053]
conflicts_with:         []

doc_file:               doc/E081.md
last_updated:           2026-05-29
source_event:           archives/e/expat/2.6.0/manifest.yaml