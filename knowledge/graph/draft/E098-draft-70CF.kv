#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E098.kv，填写各字段
# 对应的人类文档: doc/E098.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E098
trigger_tool:           meson|ninja
phase:                  compilation
error_signature:        /bin/sh: rm: inaccessible or not found|
                         FAILED.*code=127.*Linking static target.*\.a

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category:               toolchain|ninja|hmdfs
match_keywords:         ninja, static library, rm inaccessible, /bin/sh, toybox
title:                  ninja 链接静态库时 toybox sh 的 rm 命令不可用

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             ninja 使用 `/bin/sh` 执行静态库链接命令，
                        命令行包含 `rm -f xxx.a && llvm-ar csrDT xxx.a ...`。
                        toybox sh 在 HMDFS 环境下执行 rm 命令失败
                        (permission denied/inaccessible)，导致静态库无法创建。
affected_scope:         使用 meson 构建系统且需要链接静态库的软件。
                        已知: libvirt。
verification_cmd:       grep "Linking static target.*\.a" builddir/build.ninja;
                        ls -la /bin/sh /usr/bin/rm 2>&1

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           workaround-manual           # 见 DESIGN §5 impl 列表
rec_description:        手动创建静态库文件，绕过 ninja 的 rm 命令。
                        在 builddir 中直接运行 llvm-ar csrDT 命令，
                        然后继续 ninja 编译。
rec_command:            cd builddir && llvm-ar csrDT <target>.a <objects>/*.o && ninja -j1
rec_auto_fix:           false
rec_impl:               workaround-manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      build-system-mod
fallback_description:   修改 meson 的静态库链接器配置，
                        使用不包含 rm 的 ar 命令。
                        可能需要创建 meson native file 或 wrapper script。
fallback_command:       meson setup builddir --native-file=/path/to/native.ini
fallback_auto_fix:      false
fallback_impl:          build-system-mod

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       ln -s.*toybox.*rm|alias rm
forbid_1_reason:        不要创建 rm 软链接或 alias 来绕过，
                        这会污染构建环境且可能影响其他软件。
forbid_1_consequence:   构建环境污染，可能导致其他软件的构建命令混乱。

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             R8,R11

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             [E002,E046]
conflicts_with:         []
prerequisite_of:        []

