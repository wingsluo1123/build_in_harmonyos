# Layer 0: 错误面
id:                     E100
title:                   HMDFS config.status umask 077 导致临时文件创建失败
trigger_tool:           config.status / configure
phase:                  configuration
error_signature:        can't create \./conf.*subs1\.awk.*Permission denied|sort: stat failed: \-: Permission denied|cat: standard output: Permission denied

# Layer 1: 识别层
severity:               3
category:               platform-hmdfs
match_keywords:         umask 077, config.status, subs1.awk, Permission denied, HMDFS, mktemp, GNU cat stdout, GNU sort stdin, temporary directory

# Layer 2: 诊断层
root_cause:             HMDFS 文件系统上，`mktemp -d` 使用 `umask 077` 创建的目录权限为 0700，
                        shell 子脚本（config.status）无法在其中创建文件（Permission denied）。
                        同时 GNU cat 和 GNU sort 无法处理 stdin→stdout 管道操作（HMDFS 限制），
                        toybox 版本（/bin/cat, toybox sort）可正常工作。
affected_scope:          所有使用 Autotools 构建系统的 C/C++ 项目在 HMDFS 上编译
verification_cmd:       test_script=$(mktemp /tmp/test_hmdfs.sh); echo 'echo test >$(mktemp -d ./confXXXXXX)/file' > $test_script; sh $test_script 2>&1 | grep Permission

# Layer 3: 方案层 ★
rec_priority:           1
rec_approach:           patch-configure-umask
rec_description:        在 configure 脚本中移除 `umask 077` 前缀，
                        将 `(umask 077 && mktemp -d "./confXXXXXX")` 改为 `(mktemp -d "./confXXXXXX")`。
                        同时将 `(umask 077 && mkdir "$tmp")` 改为 `(mkdir "$tmp")`。
                        对于 GNU cat/sort stdin 问题：创建 sort wrapper（临时文件中转）
                        和 cat symlink（指向 /bin/cat 即 toybox 版本）。
rec_command:            |
  # 修复 configure 中的 umask 077:
  sed -i 's/(umask 077 && mktemp -d/(mktemp -d/' configure
  sed -i 's/(umask 077 && mkdir/(mkdir/' configure
  # 修复 GNU cat stdout 问题:
  ln -sf /bin/cat ~/usr/local/bin/cat
  # 修复 GNU sort stdin 问题: 创建 wrapper

rec_auto_fix:           false
rec_impl:               patch-configure

fallback_priority:      2
fallback_approach:      cat-sort-wrapper
fallback_description:   用 /bin/cat (toybox) 替代 GNU cat，用 sort wrapper 替代 GNU sort。
                        Wrapper 原理：stdin 写入临时文件后用真实 sort 处理文件。
fallback_command:      |
  ln -sf /bin/cat ~/usr/local/bin/cat
  # sort wrapper: cat > tempfile && sort.real tempfile
fallback_auto_fix:     false
fallback_impl:          command-wrapper

forbid_1_pattern:      手动修改 config.status（生成文件）
forbid_1_reason:        config.status 是 configure 生成的，每次 configure 都会重新生成
forbid_1_consequence:   补丁无法在干净构建中持久化

# Layer 4: 原则引用
principles:             P-AUTOTOOLS-001,P-PLATFORM-001

# 关系图
causes:                 [E002]
caused_by:              []
similar_to:             [E046]
conflicts_with:         []
prerequisite_of:        []

# 元数据
doc_file:               doc/E100.md
last_updated:           2026-06-01
source_event:           lcdf-typetools 2.110 编译发现