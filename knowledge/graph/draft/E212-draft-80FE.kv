#====================================================================
# E212.kv — Rust linker defaults to -lstdc++ on OHOS but only libc++ exists
# Created by: Agent 80FE
# Date: 2026-07-03
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E212
trigger_tool:           cargo|rustc|cc|ld
phase:                  linking
error_signature:        ld\.lld: error: unable to find library -lstdc\+\+|linker .cc. not found|"always" progress requires a width key|Cannot determine rustc sysroot

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               build-system-compatibility|platform|rust
match_keywords:         lstdc++, libc++, rust, cargo, ld.lld, linker, ohos, aarch64-unknown-linux-ohos, cc, cc not found, progress width, harmonybrew, ohos-sdk, llvm-gcc-compat
title:                  Rust on OHOS — CI 构建环境准备

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             OHOS上构建Rust有三个根本差异: (1) 无cc命令但rustc需PATH中的cc (2) rustc默认-lstdc++但OHOS只有libc++ (3) Python进程与conan shell的PATH不一致
affected_scope:         All Rust/Cargo projects built on OHOS platform (ouch, rover, etc.)
verification_cmd:       cargo build --release 2>&1 | grep 'Finished'

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           create-libstdcxx-linker-script
rec_description:        Create libstdc++ linker scripts that redirect to libc++ in the OHOS SDK lib directory
rec_command:            见 conanfile.py 三段式: _ensure_cargo() -> _ensure_cc() -> _fix_libstdcxx() + CARGO_TERM_PROGRESS_WIDTH=80
rec_auto_fix:           true
rec_impl:               batch-command

# 回退方案
fallback_priority:      2
fallback_approach:      set-rustflags-cpp-lib
fallback_description:   Set RUSTFLAGS to explicitly link libc++ instead of libstdc++
fallback_command:       export RUSTFLAGS="-C link-arg=-lc++ -C link-arg=-lc++abi"
fallback_auto_fix:      true
fallback_impl:          env-set

# ★ 禁止策略 ★
forbid_1_pattern:       ln -s.*libstdc\+\+|ln -sf.*libstdc\+\+|self\.run\("rustc"|仅设CC环境变量
forbid_1_reason:        HMDFS does not properly track symlinks (E050), use file copies or linker scripts instead
forbid_1_consequence:   Linker still cannot find libstdc++ even after creating symlink

# ═══ Layer 4: 原则引用 ═══
principles:             P003

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E050]
conflicts_with:         []
prerequisite_of:        []

