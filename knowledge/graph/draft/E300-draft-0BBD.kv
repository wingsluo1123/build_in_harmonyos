#====================================================================
# E300.kv — Go linker mmap failure on OHOS
# 知识图谱条目 — Go 项目编译在 OHOS 上的 mmap 权限问题
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E300
trigger_tool:           ld
phase:                  linking
error_signature:        mapping output file failed: permission denied|link: mapping output file failed

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               platform|go|linker|selinux
match_keywords:         go build, mapping output file failed, permission denied, link, mmap, GODEBUG, Go linker, static ELF
title:                  Go linker mmap 输出失败 (OHOS SELinux 限制)

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             OHOS SELinux 策略限制 Go linker (cmd/link) 的 mmap(PROT_WRITE|MAP_SHARED) 系统调用，导致 Go 编译器无法将链接结果映射到输出文件。Go linker 使用 mmap 创建输出二进制文件，而 OHOS 上签名的静态 ELF 二进制运行在受限 SELinux 域中，该域不允许对用户文件进行 mmap 写操作。
affected_scope:         所有使用 Go 语言编译的项目 (go build/go install)，特别是生成静态 ELF 二进制的项目
verification_cmd:       GODEBUG=mmap=0 go build -o test main.go && echo "PASS" || echo "FAIL"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           set-env-var
rec_description:        设置 GODEBUG=mmap=0 禁用 Go linker 的 mmap 输出，改用 write() 系统调用写入输出文件
rec_command:            export GODEBUG=mmap=0
rec_auto_fix:           true
rec_impl:               set-env-var

# 回退方案
fallback_priority:      2
fallback_approach:       manual-patch
fallback_description:   修改 Go linker 源码 (cmd/link/internal/ld/mmap.go) 使用 write() 替代 mmap()
fallback_command:       
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       GOTOOLCHAIN=auto|GOTOOLCHAIN=go.*
forbid_1_reason:        OHOS 上下载的 Go 工具链二进制未经 ELF 签名，无法执行
forbid_1_consequence:   Go 工具链下载失败或下载后无法执行 (Permission denied)

# ═══ Layer 4: 原则引用 ═══
principles:             P-TOOLCHAIN-001

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E046]
conflicts_with:         []
prerequisite_of:        []

